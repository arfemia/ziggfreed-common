# A família de comandos de admin /zigcalendar: textos de ajuda e respostas.
# O nome do arquivo é o PREFIXO da chave: uma entrada aqui resolve como ziggfreedcommon.calendar.admin.<chave>.
# As chaves desc.* são o que a própria ajuda do motor usa para resolver um comando ou um argumento.

desc.family = Veja e teste os eventos do calendário deste servidor.
desc.list = Lista todos os eventos do calendário e se estão em andamento.
desc.status = Mostra um evento do calendário: suas datas, seu primeiro ano e suas edições até agora.
desc.force = Inicia ou para um evento do calendário agora, sem olhar as datas.
desc.force.on = Inicia um evento do calendário agora: a edição em andamento ou a próxima. Ele fica forçado até os dias dessa edição acabarem (uma edição já encerrada roda de novo pela duração de sempre), até você limpar ou até o servidor reiniciar.
desc.force.off = Para um evento do calendário agora. Ele fica parado até você limpar ou o servidor reiniciar.
desc.force.clear = Faz um evento do calendário voltar a seguir suas datas.
desc.reload = Lê o arquivo de dono do calendário de novo.
desc.arg.event = O evento do calendário, pelo nome do arquivo.

list.none = Nenhum evento do calendário carregado.
list.header = Eventos do calendário ({0}):

row.unknown = Não existe evento do calendário chamado {0}.
row.off = {0}: desligado.
row.broken = {0}: não pode rodar ({1}); o registro do servidor diz por quê.
row.live = {0}: em andamento, a {1} edição, até {2}.
row.live.forced = {0}: em andamento porque foi forçado, a {1} edição, até {2}.
row.stopped = {0}: parado por um comando.
row.waiting = {0}: o próximo começa {1}.
row.done = {0}: sem edições restantes, pois o último ano com data já passou.
row.condition.forced = {0}: ativo porque foi forçado, até você limpar.
row.moon.live = {0}: ativo, a lua no mundo {1} está na fase {2}.
row.moon.waiting = {0}: esperando a lua, que está na fase {2} no mundo {1}.
row.moon.none = {0}: esperando, pois o mundo {1} ainda não tem leitura da lua.
row.events.live = {0}: ativo, pelos eventos que ele segue.
row.events.waiting = {0}: inativo, pelos eventos que ele segue.
row.events.loop = {0}: nunca ativo, pois os eventos que ele segue levam de volta a ele.

status.window = Acontece {0} todo ano, contado em {1}.
status.window.moving = Acontece {0}, contado em {1}; seus dias mudam de um ano para o outro.
status.window.several = Acontece {0}, contado em {1}; ele volta várias vezes por ano.
status.run = A edição {0}: {1} a {2}.
status.first =Primeiro ano: {0}.
status.first.none = Sem primeiro ano, então nunca acontece.
status.history = Edições até agora: {0}.
status.history.none = Nenhuma edição ainda.
status.problem = Problema: {0}.
status.note = Nota: {0}.
status.moon = Ativo enquanto a lua no mundo {0} está na fase {1} a {2}. A primeira fase é a lua cheia.
status.moon.phase = A lua no mundo {0} está na fase {1} agora; sua última fase é {2}, e a primeira é a lua cheia.
status.moon.none = O mundo {0} ainda não tem leitura da lua: ele não está carregado, ou não rodou nenhum tick desde que carregou.
status.moon.paused = O tempo está parado no mundo {0}, então a lua dele fica nesta fase até alguém acertar a hora.
status.live.any = Ativo enquanto qualquer um destes estiver ativo: {0}.
status.live.all = Ativo só enquanto todos estes estiverem ativos: {0}.
status.live.none = Inativo enquanto qualquer um destes estiver ativo: {0}.
status.live.loop = Os eventos que ele segue levam de volta a ele ({0}), então ele nunca fica ativo.
status.member.live = {0} está ativo.
status.member.waiting = {0} não está ativo.
status.member.off = {0} está desligado ou não pode rodar.
status.member.unknown = Não existe evento do calendário chamado {0}.
status.condition.noruns = Ele segue a lua ou outros eventos em vez de datas, então não tem edições.

force.unknown = Não existe evento do calendário chamado {0}.
force.absent = {0} está desligado ou não pode rodar, então forçá-lo não muda nada.
force.on.nodates = {0} não tem datas este ano, então não pode ser forçado.
force.on.done = {0} está em andamento agora. Ele fica forçado até os dias desta edição acabarem (uma edição já encerrada roda de novo pela duração de sempre), até você limpar ou até o servidor reiniciar.
force.on.condition.done = {0} está ativo agora. Ele fica forçado até você limpar ou o servidor reiniciar.
force.off.done = {0} está parado agora. Ele fica parado até você limpar ou o servidor reiniciar.
force.clear.done = {0} volta a seguir suas datas.
force.clear.condition.done = {0} volta a seguir a lua ou os eventos que ele cita.

reload.done = Arquivo de dono do calendário lido de novo.
reload.done.off = Arquivo de dono do calendário lido de novo: todos os eventos do calendário estão desligados.

