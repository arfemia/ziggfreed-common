# Die Admin-Befehlsfamilie /zigcalendar: Hilfetexte und Antworten.
# Der Dateiname ist das Schlüssel-PRÄFIX: ein Eintrag hier wird als ziggfreedcommon.calendar.admin.<key> aufgelöst.
# Die desc.*-Schlüssel nutzt die Hilfe der Engine für einen Befehl oder ein Argument.

desc.family = Sieh dir die Kalenderereignisse dieses Servers an und teste sie.
desc.list = Liste alle Kalenderereignisse auf und zeige, ob sie laufen.
desc.status = Zeige ein Kalenderereignis: seine Daten, sein erstes Jahr und seine bisherigen Läufe.
desc.force = Starte oder stoppe ein Kalenderereignis sofort, unabhängig von seinen Daten.
desc.force.on = Starte ein Kalenderereignis sofort: seinen laufenden Lauf oder den nächsten. Es bleibt erzwungen, bis die Tage dieses Laufs enden (ein schon beendeter Lauf läuft in seiner üblichen Länge noch einmal), bis du es zurücksetzt oder der Server neu startet.
desc.force.off = Stoppe ein Kalenderereignis sofort. Es bleibt gestoppt, bis du es zurücksetzt oder der Server neu startet.
desc.force.clear = Lass ein Kalenderereignis wieder seinen Daten folgen.
desc.reload = Lies die Kalender-Besitzerdatei erneut ein.
desc.arg.event = Das Kalenderereignis, über seinen Dateinamen.
list.none = Es sind keine Kalenderereignisse geladen.
list.header = Kalenderereignisse ({0}):
row.unknown = Es gibt kein Kalenderereignis namens {0}.
row.off = {0}: abgeschaltet.
row.broken = {0}: kann nicht laufen ({1}); das Serverlog nennt den Grund.
row.live = {0}: läuft, der {1}. Lauf, bis {2}.
row.live.forced = {0}: läuft, weil es erzwungen wurde, der {1}. Lauf, bis {2}.
row.stopped = {0}: durch einen Befehl gestoppt.
row.waiting = {0}: startet als Nächstes {1}.
row.done = {0}: keine Läufe mehr, da sein letztes datiertes Jahr vorbei ist.
row.condition.forced = {0}: aktiv, weil es erzwungen wurde, bis du es zurücksetzt.
row.moon.live = {0}: aktiv, der Mond in Welt {1} steht in Phase {2}.
row.moon.waiting = {0}: wartet auf den Mond, der in Welt {1} in Phase {2} steht.
row.moon.none = {0}: wartet, da Welt {1} noch keinen Mondwert hat.
row.events.live = {0}: aktiv, durch die Ereignisse, denen es folgt.
row.events.waiting = {0}: nicht aktiv, durch die Ereignisse, denen es folgt.
row.events.loop = {0}: nie aktiv, da die Ereignisse, denen es folgt, zu ihm zurückführen.
status.window = Läuft {0} jedes Jahr, gezählt in {1}.
status.window.moving = Läuft {0}, gezählt in {1}; seine Tage wandern von Jahr zu Jahr.
status.window.several = Läuft {0}, gezählt in {1}; es kehrt mehrmals im Jahr wieder.
status.run = Der {0}. Lauf: {1} bis {2}.
status.first = Erstes Jahr: {0}.
status.first.none = Kein erstes Jahr, also läuft es nie.
status.history = Bisherige Läufe: {0}.
status.history.none = Noch keine Läufe.
status.problem = Problem: {0}.
status.note = Hinweis: {0}.
status.moon = Aktiv, solange der Mond in Welt {0} in Phase {1} bis {2} steht. Die erste Phase ist der Vollmond.
status.moon.phase = Der Mond in Welt {0} steht jetzt in Phase {1}; seine letzte Phase ist {2}, die erste ist der Vollmond.
status.moon.none = Welt {0} hat noch keinen Mondwert: Sie ist nicht geladen oder hat seit dem Laden nicht getickt.
status.moon.paused = Die Zeit in Welt {0} steht still, daher bleibt ihr Mond in dieser Phase, bis jemand die Zeit setzt.
status.live.any = Aktiv, solange eines davon aktiv ist: {0}.
status.live.all = Nur aktiv, solange alle davon aktiv sind: {0}.
status.live.none = Nicht aktiv, solange eines davon aktiv ist: {0}.
status.live.loop = Die Ereignisse, denen es folgt, führen zu ihm zurück ({0}), daher ist es nie aktiv.
status.member.live = {0} ist aktiv.
status.member.waiting = {0} ist nicht aktiv.
status.member.off = {0} ist abgeschaltet oder kann nicht laufen.
status.member.unknown = Es gibt kein Kalenderereignis namens {0}.
status.condition.noruns = Es folgt dem Mond oder anderen Ereignissen statt Daten, daher hat es keine Läufe.
force.unknown = Es gibt kein Kalenderereignis namens {0}.
force.absent = {0} ist abgeschaltet oder kann nicht laufen, daher ändert Erzwingen nichts.
force.on.nodates = {0} hat dieses Jahr keine Daten und kann nicht erzwungen werden.
force.on.done = {0} läuft jetzt. Es bleibt erzwungen, bis die Tage dieses Laufs enden (ein schon beendeter Lauf läuft in seiner üblichen Länge noch einmal), bis du es zurücksetzt oder der Server neu startet.
force.on.condition.done = {0} ist jetzt aktiv. Es bleibt erzwungen, bis du es zurücksetzt oder der Server neu startet.
force.off.done = {0} ist jetzt gestoppt. Es bleibt gestoppt, bis du es zurücksetzt oder der Server neu startet.
force.clear.done = {0} folgt wieder seinen Daten.
force.clear.condition.done = {0} folgt wieder dem Mond oder den Ereignissen, die es nennt.
reload.done = Die Kalender-Besitzerdatei wurde erneut eingelesen.
reload.done.off = Die Kalender-Besitzerdatei wurde erneut eingelesen: Alle Kalenderereignisse sind abgeschaltet.

