# La famiglia di comandi admin /zigcalendar: testi di aiuto e risposte.
# Il nome del file è il PREFISSO della chiave: una voce qui si risolve come ziggfreedcommon.calendar.admin.<key>.
# Le chiavi desc.* sono quelle che l'aiuto del motore usa per un comando o un argomento.

desc.family = Vedi e prova gli eventi del calendario di questo server.
desc.list = Elenca ogni evento del calendario e se è in corso.
desc.status = Mostra un evento del calendario: le sue date, il primo anno e le edizioni finora.
desc.force = Avvia o ferma subito un evento del calendario, qualunque cosa dicano le sue date.
desc.force.on = Avvia subito un evento del calendario: l'edizione in corso, oppure la prossima. Resta forzato finché non finiscono i giorni di quell'edizione (un'edizione già finita riparte per la sua durata abituale), finché non lo annulli o finché il server non si riavvia.
desc.force.off = Ferma subito un evento del calendario. Resta fermo finché non lo annulli o il server si riavvia.
desc.force.clear = Fa seguire di nuovo le sue date a un evento del calendario.
desc.reload = Rilegge il file del proprietario del calendario.
desc.arg.event = L'evento del calendario, tramite il nome del suo file.
list.none = Nessun evento del calendario caricato.
list.header = Eventi del calendario ({0}):
row.unknown = Non esiste nessun evento del calendario chiamato {0}.
row.off = {0}: disattivato.
row.broken = {0}: non può partire ({1}); il log del server ne spiega il motivo.
row.live = {0}: in corso, edizione {1}, fino al {2}.
row.live.forced = {0}: in corso perché forzato, edizione {1}, fino al {2}.
row.stopped = {0}: fermato da un comando.
row.waiting = {0}: prossimo inizio {1}.
row.done = {0}: nessuna edizione rimasta, perché il suo ultimo anno con date è passato.
row.condition.forced = {0}: in corso perché forzato, finché non lo annulli.
row.moon.live = {0}: in corso, la luna nel mondo {1} è nella fase {2}.
row.moon.waiting = {0}: in attesa della luna, che nel mondo {1} è nella fase {2}.
row.moon.none = {0}: in attesa, perché il mondo {1} non ha ancora una lettura della luna.
row.events.live = {0}: in corso, per gli eventi che segue.
row.events.waiting = {0}: non in corso, per gli eventi che segue.
row.events.loop = {0}: mai in corso, perché gli eventi che segue riportano a lui.
status.window = Si svolge {0} ogni anno, contato in {1}.
status.window.moving = Si svolge {0}, contato in {1}; i suoi giorni cambiano da un anno all'altro.
status.window.several = Si svolge {0}, contato in {1}; torna più volte l'anno.
status.run = L'edizione {0}: dal {1} al {2}.
status.first = Primo anno: {0}.
status.first.none = Nessun primo anno, quindi non parte mai.
status.history = Edizioni finora: {0}.
status.history.none = Ancora nessuna edizione.
status.problem = Problema: {0}.
status.note = Nota: {0}.
status.moon = In corso finché la luna nel mondo {0} è nelle fasi da {1} a {2}. La prima fase è la luna piena.
status.moon.phase = La luna nel mondo {0} è ora nella fase {1}; la sua ultima fase è la {2}, e la prima è la luna piena.
status.moon.none = Il mondo {0} non ha ancora una lettura della luna: non è caricato, oppure non ha ancora avuto un tick dopo il caricamento.
status.moon.paused = Il tempo è in pausa nel mondo {0}, quindi la sua luna resta in questa fase finché qualcuno non imposta l'ora.
status.live.any = In corso finché uno di questi è in corso: {0}.
status.live.all = In corso solo finché tutti questi sono in corso: {0}.
status.live.none = Non in corso finché uno di questi è in corso: {0}.
status.live.loop = Gli eventi che segue riportano a lui ({0}), quindi non è mai in corso.
status.member.live = {0} è in corso.
status.member.waiting = {0} non è in corso.
status.member.off = {0} è disattivato o non può partire.
status.member.unknown = Non esiste nessun evento del calendario chiamato {0}.
status.condition.noruns = Segue la luna o altri eventi invece delle date, quindi non ha edizioni.
force.unknown = Non esiste nessun evento del calendario chiamato {0}.
force.absent = {0} è disattivato o non può partire, quindi forzarlo non cambia nulla.
force.on.nodates = {0} non ha date quest'anno, quindi non si può forzare.
force.on.done ={0} è in corso adesso. Resta forzato finché non finiscono i giorni di questa edizione (un'edizione già finita riparte per la sua durata abituale), finché non lo annulli o finché il server non si riavvia.
force.on.condition.done = {0} è in corso adesso. Resta forzato finché non lo annulli o il server si riavvia.
force.off.done = {0} è fermo adesso. Resta fermo finché non lo annulli o il server si riavvia.
force.clear.done = {0} segue di nuovo le sue date.
force.clear.condition.done = {0} segue di nuovo la luna o gli eventi che nomina.
reload.done = File del proprietario del calendario riletto.
reload.done.off = File del proprietario del calendario riletto: ogni evento del calendario è disattivato.

