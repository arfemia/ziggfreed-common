# The /zigcalendar admin command family: help text and answers.
# The file name is the key PREFIX: an entry here resolves as ziggfreedcommon.calendar.admin.<key>.
# The desc.* keys are what the engine's own help resolves a command or an argument through.

desc.family = See and test this server's calendar events.
desc.list = List every calendar event and whether it is running.
desc.status = Show one calendar event: its dates, its first year and its runs so far.
desc.force = Run or stop a calendar event now, whatever its dates say.
desc.force.on = Run a calendar event now: its run going on, or its next one. It stays forced until that run's days end (a run already over runs again for its usual length), until you clear it, or until the server restarts.
desc.force.off = Stop a calendar event now. It stays stopped until you clear it or the server restarts.
desc.force.clear = Let a calendar event follow its dates again.
desc.reload = Read the calendar owner file again.
desc.arg.event = The calendar event, by its file name.

list.none = No calendar events are loaded.
list.header = Calendar events ({0}):

row.unknown = There is no calendar event named {0}.
row.off = {0}: switched off.
row.broken = {0}: cannot run ({1}); the server log says why.
row.live = {0}: running, the {1} run, through {2}.
row.live.forced = {0}: running because it was forced on, the {1} run, through {2}.
row.stopped = {0}: stopped by a command.
row.waiting = {0}: next starts {1}.
row.done = {0}: no runs left, since its last dated year has passed.
row.condition.forced = {0}: live because it was forced on, until you clear it.
row.moon.live = {0}: live, the moon in world {1} is in phase {2}.
row.moon.waiting = {0}: waiting for the moon, which is in phase {2} in world {1}.
row.moon.none = {0}: waiting, since world {1} has no moon reading yet.
row.events.live = {0}: live, by the events it follows.
row.events.waiting = {0}: not live, by the events it follows.
row.events.loop = {0}: never live, since the events it follows lead back to it.

status.window = Runs {0} every year, counted in {1}.
status.window.moving = Runs {0}, counted in {1}; its days move from year to year.
status.window.several = Runs {0}, counted in {1}; it comes round several times a year.
status.run = The {0} run: {1} to {2}.
status.first = First year: {0}.
status.first.none = No first year, so it never runs.
status.history = Runs so far: {0}.
status.history.none = No runs yet.
status.problem = Problem: {0}.
status.note = Note: {0}.
status.moon = Live while the moon in world {0} is in phase {1} to {2}. The first phase is the full moon.
status.moon.phase = The moon in world {0} is in phase {1} now; its last phase is {2}, and the first is the full moon.
status.moon.none = World {0} has no moon reading yet: it is not loaded, or has not ticked since it loaded.
status.moon.paused = Time is paused in world {0}, so its moon stays in this phase until someone sets the time.
status.live.any = Live while any of these is live: {0}.
status.live.all = Live only while all of these are live: {0}.
status.live.none = Not live while any of these is live: {0}.
status.live.loop = The events it follows lead back to it ({0}), so it is never live.
status.member.live = {0} is live.
status.member.waiting = {0} is not live.
status.member.off = {0} is switched off or cannot run.
status.member.unknown = There is no calendar event named {0}.
status.condition.noruns = It follows the moon or other events rather than dates, so it has no runs.

force.unknown = There is no calendar event named {0}.
force.absent = {0} is switched off or cannot run, so forcing it changes nothing.
force.on.nodates = {0} has no dates this year, so it cannot be forced on.
force.on.done = {0} is running now. It stays forced until this run's days end (a run already over runs again for its usual length), until you clear it, or until the server restarts.
force.on.condition.done = {0} is live now. It stays forced until you clear it or the server restarts.
force.off.done = {0} is stopped now. It stays stopped until you clear it or the server restarts.
force.clear.done = {0} follows its dates again.
force.clear.condition.done = {0} follows the moon or the events it names again.

reload.done = Read the calendar owner file again.
reload.done.off = Read the calendar owner file again: every calendar event is switched off.
