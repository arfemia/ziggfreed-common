# A naptár játékosoknak szóló szavai: hogyan nevezzük a naptári értékre vonatkozó feltételt, és
# hogyan szól a részvételi lépés, ha a saját fájlja nem ad mondatot.
# A fájlnév a kulcs ELŐTAGJA: az itteni bejegyzés ziggfreedcommon.calendar.<key> néven oldódik fel.

factor.calendar_live = egy futó naptári esemény
factor.calendar_year = egy futó naptári esemény éve
factor.feature = egy funkció, amelyet ez a szerver bekapcsolt

# A részvételi lépés: az {1} a megnevezett esemény. A .any változat akkor szól, ha a lépés nem nevez eseményt.
objective.calendar_attended = Vegyél részt itt: {1}
objective.calendar_attended.any = Vegyél részt egy naptári eseményen

