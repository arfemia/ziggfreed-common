# A /zigcalendar admin parancscsalád: súgószövegek és válaszok.
# A fájlnév a kulcs ELŐTAGJA: az itteni bejegyzés ziggfreedcommon.calendar.admin.<key> néven oldódik fel.
# A desc.* kulcsokon keresztül oldja fel a játék saját súgója a parancsokat és argumentumokat.

desc.family = A szerver naptári eseményeinek megtekintése és tesztelése.
desc.list = Felsorolja az összes naptári eseményt, és hogy fut-e.
desc.status = Egy naptári esemény adatai: dátumai, első éve és eddigi futásai.
desc.force = Naptári esemény azonnali indítása vagy leállítása, a dátumaitól függetlenül.
desc.force.on = Naptári esemény azonnali indítása: a futó futása marad, vagy a következő indul. Kényszerítve marad, amíg az a futás napjai véget nem érnek (egy már lezárult futás a szokásos hosszáig újra fut), amíg fel nem oldod, vagy a szerver újra nem indul.
desc.force.off = Naptári esemény azonnali leállítása. Leállítva marad, amíg fel nem oldod, vagy a szerver újra nem indul.
desc.force.clear = A naptári esemény újra követi a dátumait.
desc.reload = A naptár tulajdonosi fájljának újraolvasása.
desc.arg.event = A naptári esemény a fájlneve szerint.

