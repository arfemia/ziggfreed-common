# La familia de comandos de administración /zigcalendar: texto de ayuda y respuestas.
# El nombre del archivo es el PREFIJO de la clave: una entrada de aquí se resuelve como ziggfreedcommon.calendar.admin.<clave>.
# Las claves desc.* son las que la ayuda del motor usa para un comando o un argumento.

desc.family = Consulta y prueba los eventos del calendario de este servidor.
desc.list = Lista todos los eventos del calendario y si están en curso.
desc.status = Muestra un evento del calendario: sus fechas, su primer año y sus ediciones hasta ahora.
desc.force = Inicia o detiene un evento del calendario ahora, sin importar sus fechas.
desc.force.on = Inicia un evento del calendario ahora: su edición en curso, o la siguiente. Sigue forzado hasta que terminen los días de esa edición (una edición ya terminada se celebra de nuevo con su duración habitual), hasta que lo borres o hasta que el servidor se reinicie.
desc.force.off = Detiene un evento del calendario ahora. Sigue detenido hasta que lo borres o el servidor se reinicie.
desc.force.clear = Hace que un evento del calendario vuelva a seguir sus fechas.
desc.reload = Vuelve a leer el archivo del propietario del calendario.
desc.arg.event = El evento del calendario, por el nombre de su archivo.

list.none = No hay eventos del calendario cargados.
list.header = Eventos del calendario ({0}):

row.unknown = No hay ningún evento del calendario llamado {0}.
row.off = {0}: desactivado.
row.broken = {0}: no puede ejecutarse ({1}); el registro del servidor explica por qué.
row.live = {0}: en curso, la edición {1}, hasta {2}.
row.live.forced = {0}: en curso porque se forzó, la edición {1}, hasta {2}.
row.stopped = {0}: detenido por un comando.
row.waiting = {0}: empieza {1}.
row.done = {0}: no quedan ediciones, porque ya pasó su último año con fechas.
row.condition.forced = {0}: activo porque se forzó, hasta que lo borres.
row.moon.live = {0}: activo, la luna del mundo {1} está en la fase {2}.
row.moon.waiting = {0}: espera a la luna, que está en la fase {2} en el mundo {1}.
row.moon.none = {0}: en espera, porque el mundo {1} aún no tiene lectura de la luna.
row.events.live = {0}: activo, por los eventos que sigue.
row.events.waiting = {0}: no activo, por los eventos que sigue.
row.events.loop = {0}: nunca activo, porque los eventos que sigue llevan de vuelta a él.

status.window = Se celebra {0} cada año, contado en {1}.
status.window.moving = Se celebra {0}, contado en {1}; sus días cambian de un año a otro.
status.window.several = Se celebra {0}, contado en {1}; vuelve varias veces al año.
status.run = La edición de {0}: {1} a {2}.
status.first = Primer año: {0}.
status.first.none = Sin primer año, así que nunca se celebra.
status.history = Ediciones hasta ahora: {0}.
status.history.none = Aún no se ha celebrado.
status.problem = Problema: {0}.
status.note = Nota: {0}.
status.moon = Activo mientras la luna del mundo {0} está en la fase {1} a {2}. La primera fase es la luna llena.
status.moon.phase = La luna del mundo {0} está ahora en la fase {1}; su última fase es la {2}, y la primera es la luna llena.
status.moon.none = El mundo {0} aún no tiene lectura de la luna: no está cargado, o no ha avanzado ningún tick desde que se cargó.
status.moon.paused = El tiempo está en pausa en el mundo {0}, así que su luna sigue en esta fase hasta que alguien fije la hora.
status.live.any = Activo mientras cualquiera de estos esté activo: {0}.
status.live.all = Activo solo mientras todos estos estén activos: {0}.
status.live.none = No activo mientras cualquiera de estos esté activo: {0}.
status.live.loop = Los eventos que sigue llevan de vuelta a él ({0}), así que nunca está activo.
status.member.live = {0} está activo.
status.member.waiting = {0} no está activo.
status.member.off = {0} está desactivado o no puede ejecutarse.
status.member.unknown = No hay ningún evento del calendario llamado {0}.
status.condition.noruns = Sigue la luna u otros eventos en lugar de fechas, así que no tiene ediciones.

force.unknown = No hay ningún evento del calendario llamado {0}.
force.absent = {0} está desactivado o no puede ejecutarse, así que forzarlo no cambia nada.
force.on.nodates = {0} no tiene fechas este año, así que no se puede forzar.
force.on.done = {0} está en curso ahora. Sigue forzado hasta que terminen los días de esta edición (una edición ya terminada se celebra de nuevo con su duración habitual), hasta que lo borres o hasta que el servidor se reinicie.
force.on.condition.done = {0} está activo ahora. Sigue forzado hasta que lo borres o el servidor se reinicie.
force.off.done = {0} está detenido ahora. Sigue detenido hasta que lo borres o el servidor se reinicie.
force.clear.done = {0} vuelve a seguir sus fechas.
force.clear.condition.done = {0} vuelve a seguir la luna o los eventos que nombra.

reload.done = Se volvió a leer el archivo del propietario del calendario.
reload.done.off = Se volvió a leer el archivo del propietario del calendario: todos los eventos del calendario están desactivados.

