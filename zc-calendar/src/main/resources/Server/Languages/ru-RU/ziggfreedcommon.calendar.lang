# Слова календаря для игрока: как называется требование к показанию календаря и как читается
# шаг посещения, если его собственный файл не задаёт фразу.
# Имя файла служит ПРЕФИКСОМ ключа: запись здесь читается как ziggfreedcommon.calendar.<key>.

factor.calendar_live = идущее событие календаря
factor.calendar_year = год идущего события календаря
factor.feature = функция, включённая на этом сервере

# Шаг посещения: {1} - событие, которое он называет. Вариант .any читается, если шаг не называет событие.
objective.calendar_attended = Посетите: {1}
objective.calendar_attended.any = Посетите событие календаря

