# Админ-команды /zigcalendar: текст справки и ответы.
# Имя файла служит ПРЕФИКСОМ ключа: запись здесь читается как ziggfreedcommon.calendar.admin.<key>.
# Ключи desc.* использует собственная справка движка для команды и её аргументов.

desc.family = Просмотр и проверка событий календаря этого сервера.
desc.list = Список всех событий календаря и признак, идёт ли событие.
desc.status = Показать одно событие календаря: даты, первый год и прошлые запуски.
desc.force = Запустить или остановить событие календаря сейчас, независимо от дат.
desc.force.on = Запустить событие календаря сейчас. Оно остаётся принудительным, пока вы не снимете флаг или сервер не перезапустится.
desc.force.off = Остановить событие календаря сейчас. Оно остаётся остановленным, пока вы не снимете флаг или сервер не перезапустится.
desc.force.clear = Вернуть событие календаря к его датам.
desc.reload = Заново прочитать файл владельца календаря.
desc.arg.event = Событие календаря, по имени файла.

list.none = События календаря не загружены.
list.header = События календаря ({0}):

row.unknown = События календаря с именем {0} нет.
row.off = {0}: отключено.
row.broken = {0}: запуск невозможен ({1}); причина в журнале сервера.
row.live = {0}: идёт, запуск {1}, до {2}.
row.live.forced = {0}: идёт, потому что включено принудительно, запуск {1}, до {2}.
row.stopped = {0}: остановлено командой.
row.waiting = {0}: следующий запуск {1}.

status.window = Идёт {0} каждый год, отсчёт по: {1}.
status.first = Первый год: {0}.
status.first.none = Первого года нет, поэтому событие не запустится.
status.history = Прошлые запуски: {0}.
status.history.none = Запусков ещё не было.
status.problem = Проблема: {0}.

force.unknown = События календаря с именем {0} нет.
force.absent = {0} отключено или не может запуститься, так что принуждение ничего не изменит.
force.on.done = {0} теперь идёт. Оно остаётся принудительным, пока вы не снимете флаг или сервер не перезапустится.
force.off.done = {0} теперь остановлено. Оно остаётся остановленным, пока вы не снимете флаг или сервер не перезапустится.
force.clear.done = {0} снова следует своим датам.

reload.done = Файл владельца календаря прочитан заново.
reload.done.off = Файл владельца календаря прочитан заново: все события календаря отключены.

