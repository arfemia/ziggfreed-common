$C = "../Common.ui";
$Z = "../Common/ZigButtons.ui";

// One compact achievement row (the achievements tab's list, feats, and the overview's recent /
// nearest / pinned blocks). Clicking the name (#Open) selects the achievement into the detail
// column; the body content lives THERE, so this row keeps only strip, icon, name, worth, a status
// or date, the pin, and a slim progress bar.
//
// The name button blends into the row (its Default matches the row fill) and only lights on
// hover; the SELECTED row is retinted from Java (row background + name colour).

@ZigAchOpenStyle = ButtonStyle(
  Default: (Background: #1a2233),
  Hovered: (Background: #243144),
  Pressed: (Background: #141c26),
  Sounds: $C.@ButtonSounds
);

// Pin button pill (Button, no LabelStyle): the waypoint-marker icon lives in the nested
// #PinIconOff / #PinIconOn groups, retinted per-state from Java.
@ZigAchPinStyle = ButtonStyle(
  Default: (Background: #1a2233),
  Hovered: (Background: #243144),
  Pressed: (Background: #0f1723),
  Sounds: $C.@ButtonSounds
);

Group #ZigAchRow {
  LayoutMode: Top;
  Background: #1a2233;
  Padding: (Full: 10);
  Anchor: (Bottom: 4);

  Group #Head {
    LayoutMode: Left;
    Anchor: (Height: 30);

    Group #CategoryStrip {
      Anchor: (Width: 3, Height: 26);
      Background: #4a9eff;
    }

    Group { Anchor: (Width: 8); }

    Button #PinBtn {
      Anchor: (Width: 22, Height: 22);
      Style: @ZigAchPinStyle;

      Group #PinIconOff {
        Anchor: (Width: 14, Height: 14, Left: 4, Top: 4);
        Background: (TexturePath: "RespawnPointArrow.png", Color: #6f7d8c);
        Visible: true;
      }
      Group #PinIconOn {
        Anchor: (Width: 14, Height: 14, Left: 4, Top: 4);
        Background: (TexturePath: "RespawnPointArrow.png", Color: #ffffff);
        Visible: false;
      }
    }

    Group { Anchor: (Width: 6); }

    Group #IconSlot {
      Anchor: (Width: 28, Height: 28);
      Visible: false;
      ItemGrid #Icon {
        Anchor: (Width: 28, Height: 28);
        SlotsPerRow: 1;
        AreItemsDraggable: false;
        DisplayItemQuantity: false;
        Style: $Z.@ZigIconGrid28;
      }
    }

    Group { Anchor: (Width: 8); }

    Button #Open {
      FlexWeight: 1;
      Anchor: (Height: 28);
      LayoutMode: Left;
      Style: @ZigAchOpenStyle;

      Label #Label {
        Text: "";
        FlexWeight: 1;
        Anchor: (Height: 28);
        Style: (FontSize: 14, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Start, VerticalAlignment: Center);
      }
    }

    Group { Anchor: (Width: 4); }

    Label #Points {
      Text: "";
      Anchor: (Width: 62);
      Style: (FontSize: 12, TextColor: #ffd24a, RenderBold: true, HorizontalAlignment: End, VerticalAlignment: Center);
    }

    Group { Anchor: (Width: 4); }

    Label #Date {
      Text: "";
      Anchor: (Width: 78);
      Style: (FontSize: 11, TextColor: #96a9be, HorizontalAlignment: End, VerticalAlignment: Center);
    }

    Group { Anchor: (Width: 4); }

    Label #Status {
      Text: "";
      Anchor: (Width: 92);
      Style: (FontSize: 12, TextColor: #96a9be, RenderBold: true, HorizontalAlignment: End, VerticalAlignment: Center);
    }
  }

  Group #BarRow {
    LayoutMode: Left;
    Anchor: (Height: 14, Top: 4);
    Padding: (Left: 11);

    Group #BarOuter {
      FlexWeight: 1;
      Anchor: (Height: 8);
      Background: "../Common/ProgressBar.png";
      ProgressBar #Bar {
        BarTexturePath: "../Common/ProgressBarFill.png";
        Value: 0.0;
      }
    }
    Group { Anchor: (Width: 8); }
    Label #BarText {
      Text: "";
      Anchor: (Width: 120, Height: 14);
      Style: (FontSize: 11, TextColor: #8fa6bd, HorizontalAlignment: End, VerticalAlignment: Center);
    }
  }

  Group #ClaimRow {
    LayoutMode: Right;
    Anchor: (Height: 26, Top: 4);
    Visible: false;

    Button #ClaimBtn {
      Style: $Z.@ZigRichPrimaryBtnStyle;
      Anchor: (Width: 150, Height: 24);
      Label #Label {
        FlexWeight: 1;
        Text: "";
        Style: (FontSize: 12, TextColor: #ffcc4a, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center);
      }
    }
  }
}
