$C = "../Common.ui";
$F = "../Common/ZigFrames.ui";
$Z = "../Common/ZigButtons.ui";
$ZT = "../Common/ZigType.ui";

// The Use Gates admin page (com.ziggfreed.common.objectives.admin.UseGateAdminPage): one row per feature the
// installed use gates hide behind, then one per use gate, each an appended Pages/ZigFormToggleRow.ui (the shared
// settings-form toggle row) painted from Java - its name, a hint line, and an on/off toggle. A page of rows at a
// time; #Pager steps through the pages.
//
// #Rows is the appendable list container and MUST stay childless here: rows are addressed by indexed parent
// ("#Rows[0] #Toggle"), so a pre-authored child would shift every index. #Empty is the page-level note an
// empty store shows instead of rows. All text is set from Java on .TextSpans, and every labeled button is a
// Button + inner #Label.
//
// Shipped once in ziggfreed-common; neutral Zig* ids. Smoke-test in-game.

$C.@PageOverlay {}

$F.@ZigDecoratedFrame {
  @CloseButton = true;
  @Ornaments = true;
  Anchor: (Width: 820, Height: 680);

  #Content {
    Anchor: (Top: 0);
    LayoutMode: Top;
    Padding: (Full: 18);

    Label #Title {
      Text: "";
      Anchor: (Height: 32, Bottom: 2);
      Style: (FontSize: $ZT.@ZigFontTitle, TextColor: #ffd97a, RenderBold: true, VerticalAlignment: Center);
    }

    Label #Subtitle {
      Text: "";
      Anchor: (Height: 36, Bottom: 10);
      Style: (FontSize: $ZT.@ZigFontCaption, TextColor: #93a4b8, VerticalAlignment: Center, Wrap: true);
    }

    Group { Anchor: (Height: 1, Bottom: 12); Background: #1e2a36; }

    Group #GatePanel {
      FlexWeight: 1;
      LayoutMode: Top;
      Padding: (Full: 12);
      Background: (TexturePath: "../Common/ContainerPanelPatch.png", Border: 4);

      Group #Rows {
        FlexWeight: 1;
        LayoutMode: TopScrolling;
        ScrollbarStyle: $C.@DefaultScrollbarStyle;
        Padding: (Right: 4);
      }

      Label #Empty {
        Text: "";
        Visible: false;
        Anchor: (Height: 40, Top: 8);
        Style: (FontSize: $ZT.@ZigFontCaption, TextColor: #8696a8, HorizontalAlignment: Center, Wrap: true);
      }
    }

    Group #Footer {
      Anchor: (Height: 36, Top: 12);
      LayoutMode: Left;

      Group #Pager {
        LayoutMode: Left;
        Anchor: (Width: 460);

        Button #PrevButton {
          Style: $Z.@ZigRichRowBtnStyle;
          Anchor: (Width: 130, Height: 32);
          Label #Label {
            FlexWeight: 1;
            Text: "";
            Style: (FontSize: $ZT.@ZigFontBody, TextColor: #e6eef7, HorizontalAlignment: Center, VerticalAlignment: Center);
          }
        }

        Label #PageLabel {
          Text: "";
          Anchor: (Width: 180, Height: 32);
          Style: (FontSize: $ZT.@ZigFontBody, TextColor: #93a4b8, HorizontalAlignment: Center, VerticalAlignment: Center);
        }

        Button #NextButton {
          Style: $Z.@ZigRichRowBtnStyle;
          Anchor: (Width: 130, Height: 32);
          Label #Label {
            FlexWeight: 1;
            Text: "";
            Style: (FontSize: $ZT.@ZigFontBody, TextColor: #e6eef7, HorizontalAlignment: Center, VerticalAlignment: Center);
          }
        }
      }

      Group { FlexWeight: 1; }

      Button #BackButton {
        Style: $Z.@ZigRichRowBtnStyle;
        Anchor: (Width: 140, Height: 32);
        Label #Label {
          FlexWeight: 1;
          Text: "";
          Style: (FontSize: $ZT.@ZigFontBody, TextColor: #e6eef7, HorizontalAlignment: Center, VerticalAlignment: Center);
        }
      }
    }
  }
}
