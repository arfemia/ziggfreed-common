// One criterion line in the achievement detail column: a met/unmet tick, the criterion's own
// picture and line, and its count. Colours are set from Java per state.
//
// The icon slot is hidden until a criterion has a picture to show. Two sibling widgets, exactly one
// of which is ever visible, both driven by ui/icon/IconRenderer: #IcoItem draws an item's own
// generated icon from a plain item id, and #IcoTex draws a Common-rooted texture path - which is how
// a creature is shown, from the still the client renders of it. #IcoTex carries a fallback so a
// creature that never had one rendered still lines up.

Group #ZigAchCriterionRow {
  LayoutMode: Left;
  Anchor: (Height: 22, Bottom: 2);
  Padding: (Left: 11, Right: 4);

  Label #StatusTick {
    Text: "";
    Anchor: (Width: 14);
    Style: (FontSize: 12, TextColor: #6a7a8e, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center);
  }

  Group #LineIconSlot {
    Anchor: (Width: 18, Height: 18, Right: 6);
    Visible: false;

    ItemIcon #IcoItem {
      Anchor: (Width: 18, Height: 18);
      Visible: false;
    }

    AssetImage #IcoTex {
      Anchor: (Width: 18, Height: 18);
      Visible: false;
      FallbackTexturePath: "UI/Custom/Pages/Memories/MissingIcon.png";
    }
  }

  Label #CritText {
    Text: "";
    FlexWeight: 1;
    Style: (FontSize: 14, TextColor: #96a9be, VerticalAlignment: Center);
  }

  Label #CritProgress {
    Text: "";
    Anchor: (Width: 90, Height: 22);
    Style: (FontSize: 12, TextColor: #b6c9de, HorizontalAlignment: End, VerticalAlignment: Center);
  }
}
