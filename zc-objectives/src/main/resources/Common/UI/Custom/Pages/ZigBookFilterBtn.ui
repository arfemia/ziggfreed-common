$Z = "../Common/ZigButtons.ui";

// One filter button of the Objective Book's quest-list filter bar (categories and statuses
// alike), appended into #CategoryBar / #StatusBar and addressed by index ("#CategoryBar[0]").
// A rich Button + inner #Label so its text is set from Java as a client-resolved Message
// (ZigRichButton.text); the page tints the active one the same way it tints the tabs.

Button #ZigBookFilterBtn {
  Style: $Z.@ZigRichRowBtnStyle;
  Anchor: (Width: 96, Height: 26, Right: 6);
  Label #Label {
    FlexWeight: 1;
    Text: "";
    Style: (FontSize: 12, TextColor: #e6eef7, HorizontalAlignment: Center, VerticalAlignment: Center);
  }
}
