$Z = "../Common/ZigButtons.ui";

// One Objective Book entry (appended into #List; see ObjectiveBookPage). Addressed per row via
// the INDEXED PARENT ("#List[0] #Name"), so the bare descendant ids below are safe across many
// rows and across mods.
//
// The step slots are FIXED, not appended: a page update can restyle an element that already
// exists but can never add one, so four step rows (#StepRow0..3, each an objective line #Step0..3
// plus its own count #StepProgress0..3) are baked in and hidden when unused. MAX_STEPS in Java
// MUST match that count; anything past it is summarised by #StepMore.
//
// The count in #Progress is the primary reading of how far along an entry is. The bar underneath
// (#BarTrack / #BarFill) is decoration on top of it: the page sets the fill width from Java.

Group #ZigObjectiveRow {
  LayoutMode: Top;
  Anchor: (Bottom: 6);
  Padding: (Horizontal: 10, Vertical: 8);
  Background: (TexturePath: "../Common/Buttons/Secondary.png", Border: 12, Color: #2a3442);

  Group #Head {
    LayoutMode: Left;
    Anchor: (Height: 26);

    Group #IconSlot {
      Anchor: (Width: 24, Height: 24, Right: 8);
      Visible: false;
      ItemGrid #Icon {
        Anchor: (Width: 24, Height: 24);
        SlotsPerRow: 1;
        AreItemsDraggable: false;
        DisplayItemQuantity: false;
      }
    }

    Label #Name {
      FlexWeight: 1;
      Text: "";
      Style: (FontSize: 14, TextColor: #e6eef7, RenderBold: true, VerticalAlignment: Center);
    }

    Label #Progress {
      Anchor: (Width: 84);
      Text: "";
      Visible: false;
      Style: (FontSize: 13, TextColor: #e6d6a0, VerticalAlignment: Center, HorizontalAlignment: End);
    }

    Label #Status {
      Anchor: (Width: 150);
      Text: "";
      Visible: false;
      Style: (FontSize: 12, TextColor: #8696a8, VerticalAlignment: Center, HorizontalAlignment: End);
    }

    Button #Action {
      Style: $Z.@ZigRichPrimaryBtnStyle;
      Anchor: (Width: 104, Height: 26, Left: 8);
      Visible: false;
      Label #Label {
        FlexWeight: 1;
        Text: "";
        Style: (FontSize: 12, TextColor: #eef4fb, HorizontalAlignment: Center, VerticalAlignment: Center);
      }
    }

    // Secondary per-row buttons an ACTIVE quest offers: pin/unpin on the tracker, and drop the
    // quest. Hidden unless the page shows them.
    Button #Track {
      Style: $Z.@ZigRichRowBtnStyle;
      Anchor: (Width: 76, Height: 26, Left: 6);
      Visible: false;
      Label #Label {
        FlexWeight: 1;
        Text: "";
        Style: (FontSize: 11, TextColor: #cfe0f2, HorizontalAlignment: Center, VerticalAlignment: Center);
      }
    }

    Button #Abandon {
      Style: $Z.@ZigRichRowBtnStyle;
      Anchor: (Width: 26, Height: 26, Left: 6);
      Visible: false;
      Label #Label {
        FlexWeight: 1;
        Text: "";
        Style: (FontSize: 12, TextColor: #ff9a8a, HorizontalAlignment: Center, VerticalAlignment: Center);
      }
    }
  }

  Label #Flavor {
    Text: "";
    Visible: false;
    Anchor: (Height: 18, Top: 2);
    Style: (FontSize: 11, TextColor: #93a4b8, VerticalAlignment: Center, Wrap: true);
  }

  Group #BarTrack {
    Anchor: (Height: 4, Top: 6);
    Visible: false;
    Background: #1e2a36;
    Group #BarFill {
      Anchor: (Width: 0, Height: 4);
      Background: #5e86bd;
    }
  }

  Group #StepRow0 {
    LayoutMode: Left;
    Anchor: (Height: 18, Top: 4);
    Visible: false;
    Label #Step0 { FlexWeight: 1; Text: ""; Style: (FontSize: 12, TextColor: #c6d4e4, VerticalAlignment: Center); }
    Label #StepProgress0 { Anchor: (Width: 84); Text: ""; Style: (FontSize: 12, TextColor: #8fa6bd, VerticalAlignment: Center, HorizontalAlignment: End); }
  }

  Group #StepRow1 {
    LayoutMode: Left;
    Anchor: (Height: 18, Top: 2);
    Visible: false;
    Label #Step1 { FlexWeight: 1; Text: ""; Style: (FontSize: 12, TextColor: #c6d4e4, VerticalAlignment: Center); }
    Label #StepProgress1 { Anchor: (Width: 84); Text: ""; Style: (FontSize: 12, TextColor: #8fa6bd, VerticalAlignment: Center, HorizontalAlignment: End); }
  }

  Group #StepRow2 {
    LayoutMode: Left;
    Anchor: (Height: 18, Top: 2);
    Visible: false;
    Label #Step2 { FlexWeight: 1; Text: ""; Style: (FontSize: 12, TextColor: #c6d4e4, VerticalAlignment: Center); }
    Label #StepProgress2 { Anchor: (Width: 84); Text: ""; Style: (FontSize: 12, TextColor: #8fa6bd, VerticalAlignment: Center, HorizontalAlignment: End); }
  }

  Group #StepRow3 {
    LayoutMode: Left;
    Anchor: (Height: 18, Top: 2);
    Visible: false;
    Label #Step3 { FlexWeight: 1; Text: ""; Style: (FontSize: 12, TextColor: #c6d4e4, VerticalAlignment: Center); }
    Label #StepProgress3 { Anchor: (Width: 84); Text: ""; Style: (FontSize: 12, TextColor: #8fa6bd, VerticalAlignment: Center, HorizontalAlignment: End); }
  }

  Label #StepMore {
    Text: "";
    Visible: false;
    Anchor: (Height: 16, Top: 2);
    Style: (FontSize: 11, TextColor: #8696a8, VerticalAlignment: Center);
  }
}
