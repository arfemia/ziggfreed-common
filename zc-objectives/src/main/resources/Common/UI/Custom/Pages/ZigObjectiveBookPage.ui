$C = "../Common.ui";
$F = "../Common/ZigFrames.ui";
$Z = "../Common/ZigButtons.ui";

// The Objective Book page (com.ziggfreed.common.objectives.book.ObjectiveBookPage): a two-tab
// menu of this server's quests and achievements. A title, a two-button tab bar (#TabQuests /
// #TabAchievements, each a rich Button + inner #Label so its text substitutes params), an
// optional summary line, a scrollable list that the page appends Pages/ZigObjectiveRow.ui into,
// and a single empty-state line used both for "nothing here yet" and for "another mod runs
// progression on this server".
// Shipped once in ziggfreed-common; neutral Zig* ids. Smoke-test in-game.

$C.@PageOverlay {}
$F.@ZigDecoratedFrame {
  @CloseButton = true;
  Anchor: (Width: 760, Height: 620);

  #Content {
    Label #Title {
      Text: "";
      Anchor: (Height: 30, Bottom: 8);
      Style: (FontSize: 20, TextColor: #ffd97a, RenderBold: true);
    }

    // Tab bar: quests on the left, achievements on the right. The page tints the active tab
    // from Java (UiRetint.retintButtonStates + the inner #Label colour), so there is no second
    // "active" style to drift out of sync.
    Group #TabBar {
      LayoutMode: Left;
      Anchor: (Height: 34, Bottom: 8);

      Button #TabQuests {
        Style: $Z.@ZigRichRowBtnStyle;
        Anchor: (Width: 180, Height: 34, Right: 6);
        Label #Label {
          FlexWeight: 1;
          Text: "";
          Style: (FontSize: 13, TextColor: #e6eef7, HorizontalAlignment: Center, VerticalAlignment: Center);
        }
      }

      Button #TabAchievements {
        Style: $Z.@ZigRichRowBtnStyle;
        Anchor: (Width: 180, Height: 34);
        Label #Label {
          FlexWeight: 1;
          Text: "";
          Style: (FontSize: 13, TextColor: #e6eef7, HorizontalAlignment: Center, VerticalAlignment: Center);
        }
      }
    }

    // The quest-list filter bar (hidden on the achievements tab): a row of category buttons the
    // page appends into #CategoryBar, then a search field + button + clear, the tag dropdown, and
    // the status buttons appended into #StatusBar. Every control is bound from Java with the full
    // filter state.
    Group #FilterBar {
      Visible: false;
      LayoutMode: Top;
      Anchor: (Height: 72, Bottom: 6);

      Group #CategoryBar {
        LayoutMode: Left;
        Anchor: (Height: 28, Bottom: 8);
      }

      Group #SearchRow {
        LayoutMode: Left;
        Anchor: (Height: 28);

        $C.@TextField #SearchField {
          Anchor: (Width: 170, Height: 26);
          Padding: (Left: 8, Right: 8);
          Style: (FontSize: 12, TextColor: #b6c9de);
        }

        Group { Anchor: (Width: 4); }

        Button #SearchBtn {
          Style: $Z.@ZigRichRowBtnStyle;
          Anchor: (Width: 74, Height: 26);
          Label #Label {
            FlexWeight: 1;
            Text: "";
            Style: (FontSize: 12, TextColor: #e6eef7, HorizontalAlignment: Center, VerticalAlignment: Center);
          }
        }

        Group { Anchor: (Width: 4); }

        Button #ClearSearchBtn {
          Style: $Z.@ZigRichRowBtnStyle;
          Anchor: (Width: 26, Height: 26);
          Visible: false;
          Label #Label {
            FlexWeight: 1;
            Text: "";
            Style: (FontSize: 12, TextColor: #ff9a8a, HorizontalAlignment: Center, VerticalAlignment: Center);
          }
        }

        Group { Anchor: (Width: 8); }

        $C.@DropdownBox #TagFilter {
          Anchor: (Width: 140, Height: 26);
        }

        Group { Anchor: (Width: 8); }

        Group #StatusBar {
          FlexWeight: 1;
          LayoutMode: Left;
        }
      }
    }

    // A one-line summary above the list (the achievement tab shows earned/total points here).
    Label #Summary {
      Text: "";
      Visible: false;
      Anchor: (Height: 20, Bottom: 6);
      Style: (FontSize: 13, TextColor: #b6c9de, VerticalAlignment: Center);
    }

    Group { Anchor: (Height: 1, Bottom: 8); Background: #1e2a36; }

    Group #List {
      FlexWeight: 1;
      LayoutMode: TopScrolling;
      ScrollbarStyle: $C.@DefaultScrollbarStyle;
      Padding: (Right: 4);
    }

    Label #EmptyState {
      Text: "";
      Visible: false;
      Anchor: (Height: 22, Top: 6);
      Style: (FontSize: 13, TextColor: #8696a8, HorizontalAlignment: Center, Wrap: true);
    }
  }
}
