$C = "../Common.ui";
$F = "../Common/ZigFrames.ui";
$ZX = "../Common/ZigText.ui";
$ZW = "../Common/ZigKit.ui";

// The Objective Book's shell (com.ziggfreed.common.objectives.book.ObjectiveBookPage), inside the shared menu
// frame: the frame's rail on the left (ui/menu/ZigMenu paints it, with the book's Quests or Achievements tab
// selected), then one column of the book's own.
//
// #Header is the band every tab shares: the owner's logo first (#BrandingLogo, ONE scaled AssetImage in the
// logo's 260:97 shape at the band's height, hidden, a blank fallback), then the page title in #TitleContainer, a
// one-sentence #PageSubtitle, and three stat blocks the active tab fills. A consumer's right-mode branding writes
// #BrandingLogo (its AssetPath, then shows it), #PanelTitle (the server name) and #BrandingDescriptionRight (the
// description, shown); the page writes its own title first, so the branding wins. #BrandingDescriptionRight keeps
// its fixed 17px line here, since the band's height is fixed: a description longer than one line is cut off in the
// book, where the Settings tab lets it wrap. #TabBody is empty here: the active tab appends its own document into it
// (Pages/ZigBookJournal.ui or Pages/ZigBookAchievements.ui). #BookEmpty shows across the body instead when there
// is no progress to show.
//
// The frame owns the size and the rail; book/LedgerLayout holds this column's numbers and LedgerLayoutTest holds
// them to this document.

$C.@PageOverlay {}

$F.@ZigMenuFrame {
  #Content {
    Group #RightPanel {
      FlexWeight: 1;
      LayoutMode: Top;
      Padding: (Full: 4);

      Group #Header {
        LayoutMode: Left;
        Anchor: (Height: 60, Bottom: 12);

        AssetImage #BrandingLogo {
          Anchor: (Width: 161, Height: 60, Right: 12);
          Visible: false;
          FallbackTexturePath: "UI/Custom/Common/Glyphs/Blank.png";
        }

        Group #TitleBlock {
          FlexWeight: 1;
          LayoutMode: Top;

          Group #TitleContainer {
            LayoutMode: Left;
            Anchor: (Height: 26);

            Label #PanelTitle {
              Text: "";
              FlexWeight: 1;
              Style: $ZX.@ZigTitleStyle;
            }
          }

          Label #PageSubtitle {
            Text: "";
            Visible: false;
            Anchor: (Height: 17);
            Style: $ZX.@ZigCaptionStyle;
          }

          Label #BrandingDescriptionRight {
            Text: "";
            Visible: false;
            Anchor: (Height: 17);
            Style: $ZX.@ZigCaptionStyle;
          }
        }

        $ZW.@ZigStat #Stat0 {
          Visible: false;
        }

        Group #StatGap0 {
          Anchor: (Width: 8);
        }

        $ZW.@ZigStat #Stat1 {
          Visible: false;
        }

        Group #StatGap1 {
          Anchor: (Width: 8);
        }

        $ZW.@ZigStat #Stat2 {
          Visible: false;
        }
      }

      Group #TabBody {
        Anchor: (Height: 896);
        LayoutMode: Top;
      }

      $ZW.@ZigEmptyState #BookEmpty {
        Visible: false;
        FlexWeight: 1;
      }
    }
  }
}
