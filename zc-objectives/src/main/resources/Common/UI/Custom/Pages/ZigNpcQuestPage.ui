$C = "../Common.ui";
$F = "../Common/ZigFrames.ui";
$ZK = "../Common/ZigTokens.ui";
$ZX = "../Common/ZigText.ui";
$ZW = "../Common/ZigKit.ui";

// The NPC quest page (com.ziggfreed.common.objectives.questlist.ZigNpcQuestPage): what a character has to offer,
// as a list on the left and the quest being read on the right, built from the same kit pieces as the Objective
// Book's Quests tab, so a quest reads the same at its giver and in the book.
//
// LEFT, #LeftPanel (450 wide; a consumer's theme retints its patch): the character's name, the count, the Here /
// Mine segments (#TabHere, #TabMine), and #QuestList, where com.ziggfreed.common.ui.kit.LedgerPainter appends one
// Pages/ZigLedgerSection.ui per section and a Pages/ZigLedgerRow.ui per quest. The segments stay on screen when a
// list is empty, so there is always a way to the other list. At 450 a row's title reads on one line with its pin,
// and its meta line ("Hallow's Eve - Daily - Old Jack") reads whole beside the trail's 92.
//
// RIGHT, #RightPanel (710 wide, padded to a 640 page): #Page, the kit's reading page (@ZigDetailPage: the header
// with the Track toggle, progress, the quest's text, its blocks, and the action bar), painted by
// com.ziggfreed.common.ui.kit.DetailPainter; and #PageEmpty, the kit's empty state, shown in its place when a list
// has nothing on it. The page never spells a template's child ids: the kit's painters own them.

$C.@PageOverlay {}

$F.@ZigDecoratedFrame {
  @CloseButton = true;
  @Ornaments = true;
  Anchor: (Width: 1160, Height: 850);

  #Content {
    Anchor: (Top: 0);
    LayoutMode: Left;
    Padding: (Full: 0);

    Group #LeftPanel {
      Anchor: (Width: 450);
      Background: (TexturePath: "../Common/ContainerPanelPatch.png", Border: 4);
      LayoutMode: Top;
      Padding: (Full: $ZK.@ZigSpace4);

      Label #NpcHeader {
        Anchor: (Bottom: $ZK.@ZigSpace1);
        Text: "";
        Style: $ZX.@ZigTitleStyle;
      }

      Label #QuestCount {
        Anchor: (Height: 18, Bottom: $ZK.@ZigSpace3);
        Text: "";
        Style: $ZX.@ZigCaptionStyle;
      }

      Group #TabBar {
        LayoutMode: Left;
        Anchor: (Height: $ZK.@ZigControlHeight, Bottom: $ZK.@ZigSpace3);

        $ZW.@ZigSegment #TabHere {
          @Anchor = (Right: $ZK.@ZigSpace2);
        }

        $ZW.@ZigSegment #TabMine {}
      }

      Group #ListRule {
        Anchor: (Height: 1, Bottom: $ZK.@ZigSpace2);
        Background: (Color: $ZK.@ZigDivider);
      }

      Group #QuestList {
        FlexWeight: 1;
        LayoutMode: TopScrolling;
        ScrollbarStyle: $C.@DefaultScrollbarStyle;
        Padding: (Right: $ZK.@ZigSpace2);
      }
    }

    Group #RightPanel {
      FlexWeight: 1;
      LayoutMode: Top;
      Padding: (Horizontal: 35, Vertical: $ZK.@ZigSpace3);

      $ZW.@ZigDetailPage #Page {
        FlexWeight: 1;
      }

      $ZW.@ZigEmptyState #PageEmpty {
        FlexWeight: 1;
        Visible: false;
      }
    }
  }
}
