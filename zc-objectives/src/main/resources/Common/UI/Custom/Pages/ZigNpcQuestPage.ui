$C = "../Common.ui";
$F = "../Common/ZigFrames.ui";
$Z = "../Common/ZigButtons.ui";

// The NPC quest page (com.ziggfreed.common.objectives.questlist.ZigNpcQuestPage): what a character
// has to offer, as a list on the left and the one being read on the right.
//
// LEFT: the character's name, a count, a two-button tab bar (#TabHere / #TabMine), and the scrolling
// #QuestList the page appends Pages/ZigNpcQuestRow.ui into. #EmptyListLabel carries the one line an
// empty list shows; the tab bar stays visible behind it, since hiding it would leave no route to the
// other list.
//
// RIGHT: #RightPanel, hidden outright when there is nothing selected. Its three appended containers
// (#ObjectivesSection, #RewardsList, #RequirementsSection) all take Pages/ZigNpcQuestLine.ui rows,
// and the page CLEARS each one before re-rendering, so a second render for a different quest cannot
// collide with the rows of the first.
//
// Every labeled button here is a Button + inner Label #Label, never a TextButton: a quest title, a
// count and a reward line are all parameterized Messages, and those only substitute on .TextSpans.
// The action buttons default Visible:false and the page flips exactly the ones a state offers, so
// there is never a control that does nothing.
//
// Shipped once in ziggfreed-common; neutral Zig* ids. Smoke-test in-game.

$C.@PageOverlay {}

$F.@ZigDecoratedFrame {
  @CloseButton = true;
  @Ornaments = true;
  Anchor: (Width: 1050, Height: 850);

  #Content {
    Anchor: (Top: 0);
    LayoutMode: Left;
    Padding: (Full: 0);

    Group #LeftPanel {
      Anchor: (Width: 340);
      Background: (TexturePath: "../Common/ContainerPanelPatch.png", Border: 4);
      LayoutMode: Top;
      Padding: (Full: 14);

      Label #NpcHeader {
        Text: "";
        Anchor: (Height: 32, Bottom: 4);
        Style: (FontSize: 20, TextColor: #ffd97a, RenderBold: true, VerticalAlignment: Center);
      }

      Label #QuestCount {
        Text: "";
        Anchor: (Height: 20, Bottom: 8);
        Style: (FontSize: 12, TextColor: #93a4b8, VerticalAlignment: Center);
      }

      Group #TabBar {
        LayoutMode: Left;
        Anchor: (Height: 30, Bottom: 8);

        Button #TabHere {
          Style: $Z.@ZigRichRowBtnStyle;
          FlexWeight: 1;
          Anchor: (Height: 28, Right: 6);
          Label #Label {
            FlexWeight: 1;
            Text: "";
            Style: (FontSize: 13, TextColor: #e6eef7, HorizontalAlignment: Center, VerticalAlignment: Center);
          }
        }

        Button #TabMine {
          Style: $Z.@ZigRichRowBtnStyle;
          FlexWeight: 1;
          Anchor: (Height: 28);
          Label #Label {
            FlexWeight: 1;
            Text: "";
            Style: (FontSize: 13, TextColor: #e6eef7, HorizontalAlignment: Center, VerticalAlignment: Center);
          }
        }
      }

      Group { Anchor: (Height: 1, Bottom: 8); Background: #1e2a36; }

      Group #QuestList {
        FlexWeight: 1;
        LayoutMode: TopScrolling;
        ScrollbarStyle: $C.@DefaultScrollbarStyle;
        Padding: (Right: 4);
      }

      Label #EmptyListLabel {
        Text: "";
        Visible: false;
        Anchor: (Height: 40, Top: 8);
        Style: (FontSize: 13, TextColor: #8696a8, HorizontalAlignment: Center, Wrap: true);
      }
    }

    Group #RightPanel {
      FlexWeight: 1;
      LayoutMode: Top;
      Padding: (Full: 20);

      Label #DetailTitle {
        Text: "";
        Anchor: (Height: 30, Bottom: 4);
        Style: (FontSize: 22, TextColor: #ffd97a, RenderBold: true, VerticalAlignment: Center);
      }

      Label #DetailStatus {
        Text: "";
        Anchor: (Height: 20, Bottom: 8);
        Style: (FontSize: 13, TextColor: #96a9be, RenderBold: true, LetterSpacing: 1, VerticalAlignment: Center);
      }

      Group { Anchor: (Height: 1, Bottom: 12); Background: #1e2a36; }

      Label #Flavor {
        Text: "";
        Visible: false;
        Anchor: (Bottom: 12);
        Style: (FontSize: 14, TextColor: #b6c9de, Wrap: true);
      }

      Label #ObjectivesHeader {
        Text: "";
        Anchor: (Height: 20, Bottom: 6);
        Style: (FontSize: 12, TextColor: #4a6a8e, RenderBold: true, LetterSpacing: 1, VerticalAlignment: Center);
      }

      Group #ObjectivesSection {
        LayoutMode: Top;
        Anchor: (Bottom: 12);
      }

      Label #RewardsHeader {
        Text: "";
        Visible: false;
        Anchor: (Height: 20, Bottom: 6);
        Style: (FontSize: 12, TextColor: #4a6a8e, RenderBold: true, LetterSpacing: 1, VerticalAlignment: Center);
      }

      Group #RewardsList {
        LayoutMode: Top;
        Anchor: (Bottom: 12);
      }

      Label #RequirementsHeader {
        Text: "";
        Visible: false;
        Anchor: (Height: 20, Bottom: 6);
        Style: (FontSize: 12, TextColor: #ff9944, RenderBold: true, LetterSpacing: 1, VerticalAlignment: Center);
      }

      Group #RequirementsSection {
        LayoutMode: Top;
        Anchor: (Bottom: 12);
      }

      Group { FlexWeight: 1; }

      Group #ActionRow {
        LayoutMode: Left;
        Anchor: (Height: 40);

        Button #AcceptBtn {
          Style: $Z.@ZigRichPrimaryBtnStyle;
          Anchor: (Width: 130, Height: 36, Right: 8);
          Visible: false;
          Label #Label {
            FlexWeight: 1;
            Text: "";
            Style: (FontSize: 14, TextColor: #eef4fb, HorizontalAlignment: Center, VerticalAlignment: Center);
          }
        }

        Button #TurnInBtn {
          Style: $Z.@ZigRichPrimaryBtnStyle;
          Anchor: (Width: 130, Height: 36, Right: 8);
          Visible: false;
          Label #Label {
            FlexWeight: 1;
            Text: "";
            Style: (FontSize: 14, TextColor: #eef4fb, HorizontalAlignment: Center, VerticalAlignment: Center);
          }
        }

        Button #ClaimBtn {
          Style: $Z.@ZigRichPrimaryBtnStyle;
          Anchor: (Width: 130, Height: 36, Right: 8);
          Visible: false;
          Label #Label {
            FlexWeight: 1;
            Text: "";
            Style: (FontSize: 14, TextColor: #eef4fb, HorizontalAlignment: Center, VerticalAlignment: Center);
          }
        }

        Button #TrackBtn {
          Style: $Z.@ZigRichRowBtnStyle;
          Anchor: (Width: 120, Height: 36, Right: 8);
          Visible: false;
          Label #Label {
            FlexWeight: 1;
            Text: "";
            Style: (FontSize: 14, TextColor: #c6d4e4, HorizontalAlignment: Center, VerticalAlignment: Center);
          }
        }

        Button #AbandonBtn {
          Style: $Z.@ZigRichRowBtnStyle;
          Anchor: (Width: 120, Height: 36);
          Visible: false;
          Label #Label {
            FlexWeight: 1;
            Text: "";
            Style: (FontSize: 14, TextColor: #c6d4e4, HorizontalAlignment: Center, VerticalAlignment: Center);
          }
        }

        Group { FlexWeight: 1; }
      }
    }
  }
}
