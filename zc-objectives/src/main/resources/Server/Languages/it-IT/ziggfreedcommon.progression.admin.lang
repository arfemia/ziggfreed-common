# La famiglia di comandi /zigprogress: testi di aiuto, elenchi e risposte.
# Il nome del file è il PREFISSO della chiave: una voce qui si risolve come ziggfreedcommon.progression.admin.<key>.
# Le chiavi desc.* sono quelle con cui l'aiuto del server descrive un comando o un argomento.

desc.family = Consultare e amministrare le missioni, i traguardi e i ricordi di dialogo di questo server.
desc.reload = Rileggere e ripubblicare gli asset condivisi di missioni e traguardi.
desc.quest = Missioni: il catalogo, il diario di un giocatore e gli interventi di amministrazione su di esso.
desc.quest.list = Elencare tutte le missioni del catalogo condiviso.
desc.quest.give = Avviare una missione per un giocatore, che ne soddisfi i requisiti o no.
desc.quest.reset = Cancellare quanto un giocatore ha su una missione, o su tutte.
desc.quest.complete = Chiudere una missione per un giocatore e pagarla.
desc.quest.status = Mostrare a che punto è ogni missione per un giocatore.
desc.quest.accept = Accettare una missione, se il giocatore ne soddisfa i requisiti.
desc.quest.claim = Riscuotere le ricompense di una missione terminata.
desc.quest.abandon = Abbandonare una missione che il giocatore ha in corso.
desc.achievement = Traguardi: il catalogo, il registro di un giocatore e gli interventi di amministrazione su di esso.
desc.achievement.list = Elencare tutti i traguardi del catalogo condiviso.
desc.achievement.status = Mostrare a che punto è ogni traguardo per un giocatore.
desc.achievement.unlock = Assegnare un traguardo a un giocatore, che i criteri siano soddisfatti o no.
desc.achievement.revoke = Ritirare un traguardo a un giocatore.
desc.achievement.reset = Cancellare l'intero registro dei traguardi di un giocatore.
desc.memories = Ricordi di dialogo: ciò che le conversazioni ricordano di un giocatore.
desc.memories.forget = Dimenticare tutto ciò che ogni conversazione ricorda di un giocatore.
desc.arg.player = Il giocatore su cui agire. Per impostazione predefinita, tu.
desc.arg.quest = L'id della missione.
desc.arg.quest_or_all = Un id di missione, oppure 'all'.
desc.arg.quest_filter = Mostrare solo questa missione.
desc.arg.achievement = L'id del traguardo.
desc.arg.tag = Mostrare solo il contenuto con questa etichetta.
desc.arg.everyone = Tutti i giocatori online, in ogni mondo.

