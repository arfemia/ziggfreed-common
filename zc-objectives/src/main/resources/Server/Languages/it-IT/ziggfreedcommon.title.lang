# Le righe dei titoli rivolte al giocatore: come un titolo sta attorno al nome di un giocatore e come si legge la ricompensa di un titolo.
# Il nome del file è il PREFISSO della chiave: una voce qui si risolve come ziggfreedcommon.title.<key>.
# Un titolo prende il nome da title.<id>.name nel file lang che lo include (altrimenti il suo id scritto per esteso),
# è descritto da title.<id>.flavor e collocato attorno al nome di un giocatore da title.<id>.display, il cui {0}
# è il nome. La riga display qui sotto è il ripiego per un titolo che non include una propria riga display:
# {0} è il nome del giocatore e {1} quello del titolo.

display = {0}, {1}
chip = Titolo: {0}
factor.title_earned = un titolo ottenuto
factor.title_shown = un titolo mostrato accanto al tuo nome
unlocked = Titolo sbloccato: {0}
unlocked_hint = Scegli il titolo da mostrare nelle Impostazioni, sotto Titolo.
picker.title = Titoli
picker.subtitle = Scegli il titolo mostrato accanto al tuo nome nei menu e nelle classifiche.
picker.subtitle_chat = Scegli il titolo mostrato accanto al tuo nome nei menu, nelle classifiche e nella chat.
picker.preview = Appari come: {0}
picker.on = Mostrato
picker.off = Mostra
picker.back = Indietro
picker.shown = Ora mostri {0}.
picker.cleared = Ora non è mostrato nessun titolo.
picker.not_kept = Non è stato possibile conservare la tua scelta. Rientra e riprova.
picker.settings_heading = Titolo
picker.settings_tile = Il tuo titolo
picker.settings_wearing = Mostri {0}
picker.settings_none = Nessun titolo mostrato
picker.settings_wearing_count = Mostri {0} ({1, number} di {2, number} ottenuti)
picker.settings_none_count = Nessun titolo mostrato ({0, number} di {1, number} ottenuti)
picker.earned_count = Ottenuti ({0, number} di {1, number})

# I riquadri dei titoli ottenuti e i titoli ancora da ottenere. In from, {0} è l'obiettivo che dà il titolo,
# {1} il conteggio del giocatore e {2} il suo obiettivo numerico.
picker.not_earned = Non ancora ottenuti
picker.show_none = Non mostrare nessuno
picker.from = Da "{0}", {1, number} / {2, number}
picker.none_yet = Ancora nessun titolo. Ecco da dove viene ciascuno:
picker.none_on_server = Su questo server non ci sono titoli da ottenere.
picker.collect = Ottienilo da "{0}"
