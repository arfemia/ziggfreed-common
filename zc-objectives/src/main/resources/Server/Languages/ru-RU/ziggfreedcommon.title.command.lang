# Команды /zigtitle: текст справки и ответы.
# Имя файла служит ПРЕФИКСОМ ключа: запись здесь читается как ziggfreedcommon.title.command.<key>.
# Ключи desc.* использует собственная справка движка для команды и её аргументов.

desc.family = Выдать, отозвать и перечислить титулы игрока, а также открыть выбор титула.
desc.grant = Открыть игроку титул.
desc.revoke = Забрать титул у игрока.
desc.list = Перечислить открытые титулы игрока.
desc.open = Открыть выбор титула, где вы выбираете титул, показываемый рядом с вашим именем.
desc.arg.player = Игрок, к которому применить команду. По умолчанию вы.
desc.arg.title = Id титула.
player.needed = Укажите игрока через --player=<name>.
player.offline = Этого игрока нет в сети, а его титулы хранятся в его собственной сущности.
player.no_record = У {0} нет записи титулов, в которую можно писать.
title.needed = Укажите титул через --title=<id>.
title.refused = '{0}' не годится как id титула: в нём есть '|' или ':', которые зарезервированы форматом сохранения.
grant.done = Титул '{1}' открыт для {0}.
grant.already = У {0} уже есть титул '{1}'.
grant.unknown = Ничто из загруженного не задаёт титул '{0}'; он всё равно открыт, на случай если пакет с ним загрузится позже.
revoke.done = Титул '{1}' забран у {0}.
revoke.absent = У {0} не было титула '{1}'.
list.header = Открытые титулы {0} ({1}):
list.row = - {0}
list.row_shown = - {0} (показан)
list.none = У {0} нет открытых титулов.
open.needs_player = Открыть выбор титула может только игрок.
open.failed = Не удалось открыть выбор титула.

