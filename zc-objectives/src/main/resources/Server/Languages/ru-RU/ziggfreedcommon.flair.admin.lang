# Семейство админ-команд /zigflair: справка и ответы.
# Имя файла - это ПРЕФИКС ключа: запись здесь разрешается как ziggfreedcommon.flair.admin.<key>.
# Ключи desc.* - то, через что справка сервера разрешает команду или аргумент.

desc.family = Выдать, отозвать и перечислить косметические флеры игрока.
desc.grant = Открыть флер игроку.
desc.revoke = Забрать флер у игрока.
desc.list = Перечислить флеры, открытые игроком.
desc.arg.player = Игрок, к которому применяется команда. По умолчанию - вы.
desc.arg.flair = Идентификатор флера.

player.needed = Укажите игрока через --player=<name>.
player.offline = Этот игрок не в сети, а его флеры хранятся на его собственной сущности.
player.no_record = У {0} нет записи флеров, в которую можно писать.
flair.needed = Укажите флер через --flair=<id>.
flair.refused = '{0}' - непригодный идентификатор флера: он содержит '|' или ':', которые зарезервированы форматом сохранения.

grant.done = Флер '{1}' открыт для {0}.
grant.already = У {0} уже есть флер '{1}'.
grant.unknown = Ничто из загруженного не называет флер '{0}'; он всё равно открыт, на случай если пакет с ним загрузится позже.
revoke.done = Флер '{1}' забран у {0}.
revoke.absent = У {0} не было флера '{1}'.
list.header = Флеры, открытые {0} ({1}):
list.row = - {0}
list.none = У {0} нет открытых флеров.
