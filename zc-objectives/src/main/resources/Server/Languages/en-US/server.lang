# Ziggfreed Common, additions to Hytale's own "server" language namespace, en-US.
# This file's basename ("server") targets the engine's built-in namespace, not the library's
# "ziggfreedcommon" one. Server-shipped .lang files merge per key into a namespace, so this file
# adds only new keys and never overrides one the engine owns.
#
# The in-game trigger-volume inspector names a condition type by
# customUI.triggerVolumeEffectEditor.conditionType.<TypeId>, an effect type by
# customUI.triggerVolumeEffectEditor.effectType.<TypeId>, and each field of an effect by
# customUI.triggerVolumeEffectEditor.field.<TypeId>.<Key>, with .tooltip for its hover text. The jar
# keeps only the first server.lang it finds, so every module's Type names live here, zc-instance's
# dungeon room kit included.
customUI.triggerVolumeEffectEditor.conditionType.ZigRequires = Requires
customUI.triggerVolumeEffectEditor.conditionType.ZigHasEffect = Wears Effect
customUI.triggerVolumeEffectEditor.effectType.ZigCheckpoint = Dungeon Checkpoint
customUI.triggerVolumeEffectEditor.effectType.ZigRunMilestone = Dungeon Milestone
customUI.triggerVolumeEffectEditor.effectType.ZigRewardChest = Dungeon Reward Chest
customUI.triggerVolumeEffectEditor.effectType.ZigFeedback = Show Feedback

customUI.triggerVolumeEffectEditor.field.ZigCheckpoint.RespawnOffset = Respawn Offset
customUI.triggerVolumeEffectEditor.field.ZigCheckpoint.RespawnYaw = Respawn Yaw
customUI.triggerVolumeEffectEditor.field.ZigCheckpoint.HealEffect = Heal Effect
customUI.triggerVolumeEffectEditor.field.ZigCheckpoint.BannerTitleKey = Banner Title Key
customUI.triggerVolumeEffectEditor.field.ZigCheckpoint.BannerSubtitleKey = Banner Subtitle Key
customUI.triggerVolumeEffectEditor.field.ZigCheckpoint.RespawnOffset.tooltip = Where the party respawns, in blocks from the volume's position. Leave it at 0 to use the position itself.
customUI.triggerVolumeEffectEditor.field.ZigCheckpoint.RespawnYaw.tooltip = Which way the party faces when it respawns, in degrees. 0 faces north.
customUI.triggerVolumeEffectEditor.field.ZigCheckpoint.HealEffect.tooltip = The effect every member gets when the checkpoint is reached. Leave it empty for the short checkpoint heal.
customUI.triggerVolumeEffectEditor.field.ZigCheckpoint.BannerTitleKey.tooltip = A lang key for the banner's headline. Leave it empty for the default headline.
customUI.triggerVolumeEffectEditor.field.ZigCheckpoint.BannerSubtitleKey.tooltip = A lang key for the line under the headline. Leave it empty for the default line.

customUI.triggerVolumeEffectEditor.field.ZigRunMilestone.Id = Milestone
customUI.triggerVolumeEffectEditor.field.ZigRunMilestone.Placement = Placement
customUI.triggerVolumeEffectEditor.field.ZigRunMilestone.Id.tooltip = What happened: Room_Cleared, Puzzle_Solved or Secret_Found, which the results list, or any name of your own.
customUI.triggerVolumeEffectEditor.field.ZigRunMilestone.Placement.tooltip = Counts once per run under this name. Leave it empty to count this volume on its own.

customUI.triggerVolumeEffectEditor.field.ZigRewardChest.Chest = Chest
customUI.triggerVolumeEffectEditor.field.ZigRewardChest.Offset = Offset
customUI.triggerVolumeEffectEditor.field.ZigRewardChest.OpenerLootable = Opener Loot Table
customUI.triggerVolumeEffectEditor.field.ZigRewardChest.OpenerTitleKey = Opener Title Key
customUI.triggerVolumeEffectEditor.field.ZigRewardChest.Placement = Placement
customUI.triggerVolumeEffectEditor.field.ZigRewardChest.Chest.tooltip = The reward chest file that rises, by its file name. Everyone in the run's area finds their own share in it. Leave it empty to raise nothing.
customUI.triggerVolumeEffectEditor.field.ZigRewardChest.Offset.tooltip = Where the chest stands, in blocks from the volume's position, on the floor. Use the middle of a block (2.5, not 2). Leave it at 0 to use the position itself.
customUI.triggerVolumeEffectEditor.field.ZigRewardChest.OpenerLootable.tooltip = A loot table rolled only for the player who set the volume off, waiting for them in the same chest. Leave it empty for none.
customUI.triggerVolumeEffectEditor.field.ZigRewardChest.OpenerTitleKey.tooltip = A lang key for the title of the opener's own reward. Leave it empty for the default word.
customUI.triggerVolumeEffectEditor.field.ZigRewardChest.Placement.tooltip = Rises once per run under this name. Leave it empty to count this volume on its own.

customUI.triggerVolumeEffectEditor.field.ZigFeedback.Moment = Moment
customUI.triggerVolumeEffectEditor.field.ZigFeedback.Radius = Radius
customUI.triggerVolumeEffectEditor.field.ZigFeedback.Moment.tooltip = The feedback moment to show, by its file name. Leave it empty to show nothing.
customUI.triggerVolumeEffectEditor.field.ZigFeedback.Radius.tooltip = How far from where it fired a player is shown it, in blocks. Set it to 0 to show it only to the player who set it off.

customUI.triggerVolumeEffectEditor.field.ZigHasEffect.Effect = Effect
customUI.triggerVolumeEffectEditor.field.ZigHasEffect.Wears = Wears It
customUI.triggerVolumeEffectEditor.field.ZigHasEffect.Effect.tooltip = The effect to look for on whoever set the volume off.
customUI.triggerVolumeEffectEditor.field.ZigHasEffect.Wears.tooltip = On, the condition holds while they wear the effect. Off, while they do not.
