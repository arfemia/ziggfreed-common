grant.done = Titel '{1}' für {0} freigeschaltet.
grant.already = {0} hat den Titel '{1}' bereits.
grant.unknown = Nichts Geladenes definiert einen Titel '{0}'; er wird trotzdem freigeschaltet, falls das Pack, das ihn liefert, später lädt.
revoke.done = {0} wurde der Titel '{1}' weggenommen.
revoke.absent = {0} hatte den Titel '{1}' nicht.
list.header = Titel, die {0} freigeschaltet hat ({1}):
list.row = - {0}
