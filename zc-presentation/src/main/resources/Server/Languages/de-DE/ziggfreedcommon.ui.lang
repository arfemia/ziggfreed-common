# Words the shared UI widgets under Common/UI/Custom/Common/*.ui put on screen.
# The file name is the key PREFIX: an entry here resolves as ziggfreedcommon.ui.<key>.

search.button = Suchen
search.clear = Leeren

# The shared progress-bar panel (Common/UI/Custom/Hud/ZigHudBars.ui): the gain beside a bar. A
# bare signed number, grouped by the player's own client, so the value reads the same everywhere.
hud.bar.gain = +{0, number}

# The same gain from ten thousand up, arriving already written compact ("12.3k") because the wide
# panel's gain column has no room for the grouped form; the entry only signs it.
hud.bar.gain.compact = +{0}
hud.bar.loss = -{0, number}

menu.desc = Öffne dein Menü mit Quests, Erfolgen und mehr.
menu.open.needsPlayer = Nur ein Spieler kann das Menü öffnen.
menu.open.nothing = Auf diesem Server gibt es im Menü noch nichts zu öffnen.
menu.settings = Einstellungen
settings.title = Einstellungen
settings.description = Deine eigenen Entscheidungen auf diesem Server. Jede wird sofort gespeichert, sobald du sie änderst.
settings.notifications = Benachrichtigungen
settings.level = Quests und Erfolge
settings.level.hint = Wie viele Quest- und Erfolgsmeldungen du siehst. Abgeschlossene Quests und Belohnungen werden angezeigt, außer du wählst Keine. Eine Quest, die du verfolgst, zeigt keine Meldungen in der Ecke, solange der Tracker sie anzeigt; in einem Menü erscheinen sie weiterhin.
settings.level.everyupdate = Jede Änderung
settings.level.milestones = Meilensteine
settings.level.finishes = Abschlüsse
settings.level.none = Keine
settings.show = Anzeigen

# Das Seiten-Kit (ui/kit): ein langer Abschnitt endet in einer Zeile, die die nächsten Zeilen zeigt, eine Liste,
# deren Filter jede Zeile ausblenden, sagt das und bietet an, sie zurückzusetzen, und ein Fortschrittsblock
# zeigt eine Anzahl und einen Prozentwert.
kit.show_more = {0, number} weitere anzeigen
kit.nothing_matches = Keine Treffer
kit.nothing_matches_line = Hier passt nichts zu diesen Filtern. Setze sie zurück, um wieder alles zu sehen.
kit.clear_filters = Filter zurücksetzen
kit.count = {0, number} / {1, number}
kit.percent = {0, number}%
