# Words the shared UI widgets under Common/UI/Custom/Common/*.ui put on screen.
# The file name is the key PREFIX: an entry here resolves as ziggfreedcommon.ui.<key>.

search.button = Buscar
search.clear = Borrar

# The shared progress-bar panel (Common/UI/Custom/Hud/ZigHudBars.ui): the gain beside a bar. A
# bare signed number, grouped by the player's own client, so the value reads the same everywhere.
hud.bar.gain = +{0, number}

# The same gain from ten thousand up, arriving already written compact ("12.3k") because the wide
# panel's gain column has no room for the grouped form; the entry only signs it.
hud.bar.gain.compact = +{0}
hud.bar.loss = -{0, number}
menu.desc = Abre tu menú de misiones, logros y más.
menu.open.needsPlayer = Solo un jugador puede abrir el menú.
menu.open.nothing = Aún no hay nada que abrir en el menú de este servidor.
menu.settings = Ajustes
settings.title = Ajustes
settings.description = Tus propias elecciones en este servidor. Cada una se guarda en cuanto la cambias.
settings.notifications = Notificaciones
settings.level = Misiones y logros
settings.level.hint = Cuántos avisos de misiones y logros ves. Las misiones terminadas y las recompensas se muestran salvo que elijas Ninguno. Una misión que sigues no muestra avisos en la esquina mientras el rastreador la muestra; dentro de un menú siguen apareciendo.
settings.level.everyupdate = Cada avance
settings.level.milestones = Hitos
settings.level.finishes = Finales
settings.level.none = Ninguno
settings.show = Mostrar

# El kit de páginas (ui/kit): una sección larga termina en una fila que muestra las siguientes, una lista cuyos filtros
# ocultan todas las filas lo dice y ofrece borrarlos, y un bloque de progreso muestra un recuento y un porcentaje.
kit.show_more = Mostrar {0, number} más
kit.nothing_matches = Nada coincide
kit.nothing_matches_line = Nada de aquí encaja con estos filtros. Bórralos para volver a verlo todo.
kit.clear_filters = Borrar filtros
kit.count = {0, number} / {1, number}
kit.percent = {0, number}%
