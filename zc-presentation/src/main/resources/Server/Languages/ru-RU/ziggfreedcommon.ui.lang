# Words the shared UI widgets under Common/UI/Custom/Common/*.ui put on screen.
# The file name is the key PREFIX: an entry here resolves as ziggfreedcommon.ui.<key>.

search.button = Поиск
search.clear = Очистить

# The shared progress-bar panel (Common/UI/Custom/Hud/ZigHudBars.ui): the gain beside a bar. A
# bare signed number, grouped by the player's own client, so the value reads the same everywhere.
hud.bar.gain = +{0, number}

# The same gain from ten thousand up, arriving already written compact ("12.3k") because the wide
# panel's gain column has no room for the grouped form; the entry only signs it.
hud.bar.gain.compact = +{0}
hud.bar.loss = -{0, number}

menu.desc = Открыть меню заданий, достижений и не только.
menu.open.needsPlayer = Открыть меню может только игрок.
menu.open.nothing = На этом сервере в меню пока нечего открывать.
menu.settings = Настройки
settings.title = Настройки
settings.description = Ваши личные настройки на этом сервере. Каждая сохраняется сразу, как вы её меняете.
settings.notifications = Уведомления
settings.level = Задания и достижения
settings.level.hint = Сколько уведомлений о заданиях и достижениях вы видите. Завершённые задания и награды показываются, пока вы не выберете «Нет». Отслеживаемое задание не даёт уведомлений в углу, пока его показывает трекер; внутри меню они всё равно появляются.
settings.level.everyupdate = Каждое изменение
settings.level.milestones = Вехи
settings.level.finishes = Завершения
settings.level.none = Нет
settings.show = Показывать

# Набор страниц (ui/kit): длинный раздел заканчивается строкой, которая показывает следующие строки; список,
# фильтры которого скрыли все строки, говорит об этом и предлагает их сбросить; блок прогресса читает счёт и процент.
kit.show_more = Показать ещё {0, number}
kit.nothing_matches = Ничего не подходит
kit.nothing_matches_line = Здесь ничего не подходит под эти фильтры. Сбросьте их, чтобы снова увидеть всё.
kit.clear_filters = Сбросить фильтры
kit.count = {0, number} / {1, number}
kit.percent = {0, number}%
