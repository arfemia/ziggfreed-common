kit.show_more = Mostra altri {0, number}
kit.nothing_matches = Nessuna corrispondenza
kit.nothing_matches_line = Qui niente corrisponde a questi filtri. Cancellali per rivedere tutto.
kit.clear_filters = Cancella filtri
kit.count = {0, number} / {1, number}
kit.percent = {0, number}%
