# Words the shared UI widgets under Common/UI/Custom/Common/*.ui put on screen.
# The file name is the key PREFIX: an entry here resolves as ziggfreedcommon.ui.<key>.

search.button = Rechercher
search.clear = Effacer

# The shared progress-bar panel (Common/UI/Custom/Hud/ZigHudBars.ui): the gain beside a bar. A
# bare signed number, grouped by the player's own client, so the value reads the same everywhere.
hud.bar.gain = +{0, number}

# The same gain from ten thousand up, arriving already written compact ("12.3k") because the wide
# panel's gain column has no room for the grouped form; the entry only signs it.
hud.bar.gain.compact = +{0}
hud.bar.loss = -{0, number}

menu.desc = Ouvre votre menu de quêtes, de succès et plus encore.
menu.open.needsPlayer = Seul un joueur peut ouvrir le menu.
menu.open.nothing = Il n'y a encore rien à ouvrir dans le menu sur ce serveur.
menu.settings = Paramètres
settings.title = Paramètres
settings.description = Vos choix personnels sur ce serveur. Chacun est conservé dès que vous le changez.
settings.notifications = Notifications
settings.level = Quêtes et succès
settings.level.hint = Combien d'avis de quêtes et de succès vous voyez. Les quêtes terminées et les récompenses s'affichent sauf si vous choisissez Aucun. Une quête que vous suivez n'affiche aucun avis dans le coin tant que le suivi l'affiche ; dans un menu, ils apparaissent quand même.
settings.level.everyupdate = Chaque progrès
settings.level.milestones = Paliers
settings.level.finishes = Fins
settings.level.none = Aucun
settings.show = Afficher

# Le kit de page (ui/kit) : une longue section se termine par une ligne qui affiche les lignes suivantes, une liste
# dont les filtres masquent toutes les lignes le dit et propose de les effacer, et un bloc de progression affiche
# un compte et un pourcentage.
kit.show_more = Afficher {0, number} de plus
kit.nothing_matches = Rien ne correspond
kit.nothing_matches_line = Rien ici ne correspond à ces filtres. Effacez-les pour tout revoir.
kit.clear_filters = Effacer les filtres
kit.count = {0, number} / {1, number}
kit.percent = {0, number} %
