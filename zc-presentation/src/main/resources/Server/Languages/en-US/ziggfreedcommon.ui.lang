# Words the shared UI widgets under Common/UI/Custom/Common/*.ui put on screen.
# The file name is the key PREFIX: an entry here resolves as ziggfreedcommon.ui.<key>.

search.button = Search
search.clear = Clear

# The shared progress-bar panel (Common/UI/Custom/Hud/ZigHudBars.ui): the gain beside a bar. A
# bare signed number, grouped by the player's own client, so the value reads the same everywhere.
hud.bar.gain = +{0, number}

# The same gain from ten thousand up, arriving already written compact ("12.3k") because the wide
# panel's gain column has no room for the grouped form; the entry only signs it.
hud.bar.gain.compact = +{0}

# The shared menu's command, /ziggui. menu.desc is what the engine's help shows for it.
menu.desc = Open your menu of quests, achievements and more.
menu.open.needsPlayer = Only a player can open the menu.
menu.open.nothing = There is nothing to open in the menu on this server yet.

# The shared menu's Settings tab (settings/page/SettingsPage): a player's own choices for this server,
# each kept the moment it changes. The level.* words are the notification level's four choices.
menu.settings = Settings
settings.title = Settings
settings.description = Your own choices on this server. Each one is kept the moment you change it.
settings.notifications = Notifications
settings.level = Quests and achievements
settings.level.hint = How many quest and achievement notices you see. Finished quests and rewards show unless you pick None. A quest you are tracking shows no notices in the corner while the tracker shows it; inside a menu they still appear.
settings.level.everyupdate = Every update
settings.level.milestones = Milestones
settings.level.finishes = Finishes
settings.level.none = None
settings.show = Show

# The page kit (ui/kit): a long section ends in a row that shows the next rows, a list whose filters hide
# every row says so and offers to clear them, and a progress block reads a count and a percent.
kit.show_more = Show {0, number} more
kit.nothing_matches = Nothing matches
kit.nothing_matches_line = Nothing here fits these filters. Clear them to see everything again.
kit.clear_filters = Clear filters
kit.count = {0, number} / {1, number}
kit.percent = {0, number}%
