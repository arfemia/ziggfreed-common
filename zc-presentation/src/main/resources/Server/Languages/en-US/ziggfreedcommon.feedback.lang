# The library's own default feedback moments (Server/ZiggfreedCommon/FeedbackMoments/*.json).
# The file name is the key PREFIX: an entry here resolves as ziggfreedcommon.feedback.<key>.

quest.completed = Quest complete: {0}
quest.parked = Quest complete: {0}. Come back to collect your reward.
quest.parked.no_space = Quest complete: {0}. Make room to collect your reward.
quest.claimed = Rewards collected: {0}
quest.objective_progressed = {0} ({1}/{2})
quest.objective_finished = Objective complete: {0}
achievement.unlocked = Achievement earned: {0}
achievement.points = {0} points
achievement.claimed = Achievement rewards collected: {0}
achievement.server_first_lost = Somebody else got there first: {0}
rewards.more = +{0} more
encounter.engaged = Engaged: {0}
encounter.engaged.members = {0, number} against it.
encounter.phase_changed = {0} enters {1}
encounter.defeated = {0} is down
encounter.defeated.share = Your share: {0}%, in {1, number} seconds.
encounter.wiped = {0} outlasted you
encounter.wiped.seconds = {0, number} seconds in. It is still there.
