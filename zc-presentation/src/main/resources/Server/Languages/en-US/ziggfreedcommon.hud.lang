settings.enabled = On for everyone
settings.offset_x = Offset X
settings.offset_y = Offset Y
settings.columns = Columns
settings.rows_per_column = Rows per column
settings.server_note = A blank field keeps the spot's own value. Save applies to everyone at once, and writes mods/ziggfreedcommon/hud-bar-panels.json.
settings.saved = Saved. Every player's panels moved.
settings.save_failed = Could not write the owner file. Nothing changed.
