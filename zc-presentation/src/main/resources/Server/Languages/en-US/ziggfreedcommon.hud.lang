# The shared HUD bar panels: the spots they can sit at, the settings page that moves them, and the
# /zighud command family. The file name is the key PREFIX: an entry here resolves as
# ziggfreedcommon.hud.<key>. The desc.* keys are what the engine's own help resolves a command or
# an argument through.

# The spots shipped under Server/ZiggfreedCommon/HudSpots/, as the pickers list them.
spot.top_left = Top left
spot.top_right = Top right
spot.bottom_left = Bottom left

# The three panels, as the pickers and the answers name them.
panel.activity_ledger = Crafting progress
panel.world_bars = XP and reputation gains
# The short stack in the middle of the screen (Center_Bars): a reputation change made while a menu,
# a shop, a board or a conversation was open, shown once it closes.
panel.center_bars = Reputation changes in menus

# The HUD settings page.
settings.title = HUD bars
settings.subtitle = Where the bar panels sit, and which ones show.
settings.back = Back
settings.save = Save
settings.on = On
settings.off = Off
settings.spot = Where it sits
settings.server_spot = Server's choice
settings.shipped_spot = As shipped
settings.server_spot_hint = The spot everyone gets unless they pick their own.
settings.enabled = On for everyone
settings.offset_x = Offset X
settings.offset_y = Offset Y
settings.columns = Columns
settings.rows_per_column = Rows per column
settings.gap_after_row = Band after row
settings.gap_pixels = Band height
settings.cutout_column = Column with a cut
settings.cutout_rows = Cells cut from it
settings.min_height = Least height
settings.color = Color
settings.color_hint = Six hex digits, or eight with how see-through it is last. #ffffff is the frame as shipped.
settings.server_note = A blank field keeps the spot's own value. Save applies to everyone at once, and writes mods/ziggfreedcommon/hud-panels.json.
settings.saved = Saved. Every player's panels moved.
settings.save_failed = Could not write the owner file. Nothing changed.
settings.invalid_number = {0} needs a whole number, or nothing at all.
settings.invalid_color = {0} needs a hex color like #ffffff or #ffffffb8, or nothing at all.
settings.panel_on = {0} is on for everyone.
settings.panel_off = {0} is off for everyone.
settings.not_kept = That could not be kept. Reconnect and try again.

# The /zighud family: help text and answers.
desc.family = Open your settings, or move and hide the shared HUD displays.
desc.open = Open your settings.
desc.place = Put a panel at a named spot, for yourself.
desc.hide = Hide a panel for yourself, or every panel.
desc.show = Show a panel you hid, or every panel.
desc.default = Set the spot a panel sits at for everyone.
desc.arg.panel = The panel: Activity_Ledger (the activity ledger), World_Bars (the world bars) or Center_Bars (reputation changes made in a menu).
desc.arg.placement = The spot, by its id, or "server" to follow the server's choice.
desc.arg.player = Whose HUD to change. Defaults to you.
desc.arg.panel_or_all = The panel, or "all" for every panel. Defaults to all.

open.needsPlayer = Run this in game: the settings are yours, and the console has no HUD.
open.failed = The settings could not be opened.
player.needed = Name a player with --player=<name>, or run this in game.
player.offline = That player is not online.
panel.unknown = No panel is called "{0}". Use Activity_Ledger, World_Bars or Center_Bars.
spot.unknown = No spot is called "{0}".
spot.unfit = {0} was not measured for {1}, so it is not offered there.
place.done = {0} now sits at {1}.
place.cleared = {0} follows the server's choice again.
place.unchanged = That is already how it is.
hide.done = {0} is hidden.
hide.all = Every panel is hidden.
show.done = {0} shows again.
show.all = Every panel shows again.
default.done = {0} sits at {1} for everyone. Written to {2}.
default.cleared = {0} sits where its shipped file says again. Written to {1}.
default.failed = Could not write to {0}. The file was left as it was.

# The quest tracker's two spots (Server/ZiggfreedCommon/HudSpots/Quest_Tracker_*.json), as the
# Settings tab lists them.
spot.quest_tracker_right = Right
spot.quest_tracker_left = Left

# The Settings tab's tile for whoever may change the server's HUD layout, opening the HUD settings page.
settings.layout_tile = Server HUD layout
settings.layout_tile_line = Where the HUD sits for everyone

# /zighud on a choice the server has fixed for everyone (player-settings.json or a panel's Player group).
place.locked = The server has fixed where {0} sits.
hide.locked = The server has fixed whether {0} shows.
