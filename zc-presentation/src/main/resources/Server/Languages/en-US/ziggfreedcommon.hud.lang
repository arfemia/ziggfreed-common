# The shared HUD bar panels: the spots they can sit at, the settings page that moves them, and the
# /zighud command family. The file name is the key PREFIX: an entry here resolves as
# ziggfreedcommon.hud.<key>. The desc.* keys are what the engine's own help resolves a command or
# an argument through.

# The spots shipped under Server/ZiggfreedCommon/HudBarPlacements/, as the pickers list them.
placement.top_left = Top left
placement.top_right = Top right
placement.bottom_left = Bottom left

# The two panels, as the pickers and the answers name them.
panel.default = Activity ledger
panel.grid = World bars

# The HUD settings page.
settings.title = HUD bars
settings.subtitle = Where the bar panels sit, and which ones show.
settings.tab.mine = Mine
settings.tab.server = Server
settings.back = Back
settings.save = Save
settings.on = On
settings.off = Off
settings.hide_all = Hide every bar
settings.hide_all_hint = Every panel stays hidden until you switch this off again.
settings.show_panel = Show this panel
settings.spot = Where it sits
settings.spot_hint = Pick a spot of your own, or keep the server's.
settings.server_spot = Server's choice
settings.shipped_spot = As shipped
