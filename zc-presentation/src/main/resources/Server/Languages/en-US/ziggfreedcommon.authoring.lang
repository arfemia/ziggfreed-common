# The authoring kit (zc-presentation authoring/): the creative Authoring Tools tab, the wizard every in-game
# editor opens in, the Inspect Tool and /zigauthor.
# The file name is the key PREFIX: an entry here resolves as ziggfreedcommon.authoring.<key>.

# The creative tab (Server/Item/Category/CreativeLibrary/Zig_Authoring.json) and its two groups.
category.tools = Authoring Tools
category.inspect.name = Inspect
category.inspect.description = Point at a block, creature or item to see the names you write in quests and other content.
category.editors.name = Editors
category.editors.description = Point at a block, creature or NPC to start making something with it.

# When a tool refuses. {0} is the permission node the tool needs.
tool.creative = Authoring tools only work in creative mode.
tool.permission = You need the {0} permission to use this tool.
tool.nothing = This tool has nothing to open on this server.

# The wizard frame. In wizard.step, {2} is the step's name.
wizard.step = Step {0, number} of {1, number}: {2}
wizard.search = Search the lists below
wizard.back = Back
wizard.next = Next
wizard.save = Save
wizard.close = Close
wizard.on = On
wizard.off = Off
wizard.preview = Preview
wizard.preview.empty = Nothing to show yet.
wizard.pick = Pick in the world: {0}
wizard.save_failed = That couldn't be saved. The server log says why.
wizard.nothing = There's nothing to save yet.
wizard.busy = Still saving. Give it a second.
# {0} is the permission node the save needs.
wizard.save_permission = You need the {0} permission to save this.

# Picking from the world. {0} is the field being filled.
pick.start = Click a block or creature with an authoring tool to fill in {0}. Click the air to go back without picking.
pick.done = Filled in {0}.
pick.miss = That doesn't fit {0}, so nothing changed.
pick.cancelled = Nothing picked, so nothing changed.

