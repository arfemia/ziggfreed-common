// The stacked bar panel in the left column (ziggfreed-common, zc-presentation:
// ui/hud/bar/HudBarStackHud over the shared ui/hud/bar/HudBarHud). The running ledger of whatever a
// player is in the middle of: a row appears the moment a mod reports a value moved, dressed by what
// that mod says about it, and goes away when it stops moving. Nothing is authored for a row to
// appear; Server/ZiggfreedCommon/HudBars/*.json is an optional per-row override and
// Server/ZiggfreedCommon/HudBarPanels/Default.json names the spot this panel sits at.
//
// A row that draws a fill is two lines: its name with the gain beside it, and the bar underneath
// between its two end captions. A row about an item is the first line alone, with #Bar hidden.
// Fill rows sit above item rows. The panel hides when nothing is showing.
//
// CHROME: the native ObjectivePanelContainer.png patch, the same one the quest tracker, the zone
// card and the mob inspector draw, copied in beside this file because a Custom UI document resolves
// texture paths only under Common/UI/Custom/ - nothing under the game's own Game/Interface tree is
// reachable from here.
//
// The document path and every root id are prefixed Zig*: the client's UI namespace is flat across
// mods, so a generic name could be clobbered by another mod's HUD document. Slots are positional
// (#ZigBarCol<c> holding #ZigBarC<c>R<r>) and addressed by index from Java; the counts MUST match
// HudBarStackHud.LAYOUT. Text is pushed on .TextSpans, the fill and the pulse are Anchor width
// pushes and their colour a .Background.Color retint, so no texture ships for a bar itself.
//
// GEOMETRY is stated once below and referenced by every slot, so a re-tune is a single edit. Two
// columns of thirteen; 12 of horizontal padding and a 296-wide column, so the panel is 320 wide
// with one column open and 628 with both; a 228-wide track between two 30-wide captions, padded a
// pixel each side, so a fill spans 226 (HudBarStackHud.LAYOUT's trackInnerWidthPx). Keep them in
// step: a fill width pushed past its track simply overflows it. The panel also never draws shorter
// than 124, the height of the zone difficulty card it sits over, so even a single row covers that
// card rather than leaving its lower half showing.
$Z = "../Common/ZigButtons.ui";

@BarLabelStyle = (FontSize: 13, TextColor: #e6e9ee, RenderBold: true, LetterSpacing: 1, HorizontalAlignment: Start, VerticalAlignment: Center);

@BarGainStyle = (FontSize: 13, TextColor: #ffd24a, RenderBold: true, LetterSpacing: 1, HorizontalAlignment: End, VerticalAlignment: Center);

// The two words at a bar's ends: what its reading counts from, and what it counts toward. Dim and
// small, because they are a scale beside the bar and never the thing being read.
@BarCapStyle = (FontSize: 11, TextColor: #9fb0c4, RenderBold: true, VerticalAlignment: Center, HorizontalAlignment: Center);

// The dressing that makes a bar read as a bar rather than a coloured rectangle, all of it
// COLOUR-AGNOSTIC so it sits over any fill colour a mod picks at runtime. The native linear
// ProgressBar element carries no colour of its own and every vanilla HUD bar ships one fill image
// per colour, neither of which can serve a row whose colour is only known when it moves - so the
// fill stays a retinted Group and earns its finish from these three overlays instead: a dark well
// behind it, a highlight across its top, and a shade along its bottom.
@TrackWell = #05080c(0.72);
@Gloss = #ffffff(0.22);
@BaseShade = #000000(0.22);

@RowAnchor = (Top: 5, Width: 296);
@LineAnchor = (Height: 18);
@IconAnchor = (Width: 18, Height: 18);
@GainAnchor = (Width: 96, Height: 18);
@BarAnchor = (Top: 2, Height: 10, Width: 296);
@CapAnchor = (Width: 30, Height: 10);
@CapGapAnchor = (Width: 4);
@TrackAnchor = (Width: 228, Height: 8);
@FillAnchor = (Left: 0, Top: 0, Bottom: 0, Width: 0);
@GlossAnchor = (Left: 0, Right: 0, Top: 0, Height: 3);
@BaseAnchor = (Left: 0, Right: 0, Bottom: 0, Height: 1);
@PulseAnchor = (Left: 0, Top: 0, Bottom: 0, Width: 0);

// The floor under the panel's own height. This panel sits at the same top-left origin as the zone
// difficulty card a companion mod draws and is transparent behind its frame, so a ledger of one or
// two rows would leave the bottom of that card showing below it. The zero-width spacer carrying
// this anchor holds the panel at that card's 124: 100 here plus the 12 of vertical padding at each
// end. It is a floor and nothing more, so a busier ledger still sizes to its own content.
@FloorAnchor = (Width: 0, Height: 100);

// The wrapper carries LayoutMode: Top so the heightless-anchored panel inside sizes to its content
// instead of stretching from its Top anchor to the screen bottom.
Group #ZigHudBarsParent {
  LayoutMode: Top;

  Group #ZigHudBarsPanel {
    // Static fallback anchor only (NO Height - content-sized); the runtime paint always pushes its
    // own, at the width of however many columns are actually in use.
    Anchor: (Width: 320, Left: 16, Top: 90);
    LayoutMode: Left;
    Padding: (Horizontal: 12, Vertical: 12);
    Background: (TexturePath: "ObjectivePanelContainer.png", Border: 15);
    Visible: false;

      // Zero width, so it holds the panel to its floor height without widening it.
      Group #ZigHudBarsFloor { Anchor: @FloorAnchor; }

      Group #ZigBarCol0 {
        Anchor: (Width: 296);
        LayoutMode: Top;
        Visible: false;
        Group #ZigBarC0R0 {
          Anchor: @RowAnchor;
          LayoutMode: Top;
          Visible: false;
          Group #Line {
            Anchor: @LineAnchor;
            LayoutMode: Left;
            ItemGrid #IcoItem { Visible: false; Anchor: @IconAnchor; SlotsPerRow: 1; AreItemsDraggable: false; DisplayItemQuantity: false; Style: $Z.@ZigIconGrid18; }
            AssetImage #IcoTex { Visible: false; Anchor: @IconAnchor; FallbackTexturePath: "UI/Custom/Pages/Memories/MissingIcon.png"; }
            Group #IcoGap { Visible: false; Anchor: (Width: 4); }
            Label #Label { Text: ""; FlexWeight: 1; Style: @BarLabelStyle; }
            Label #Gain { Text: ""; Visible: false; Anchor: @GainAnchor; Style: @BarGainStyle; }
          }
          Group #Bar {
            Anchor: @BarAnchor;
            LayoutMode: Left;
            Visible: false;
            Label #Lead { Text: ""; Anchor: @CapAnchor; Style: @BarCapStyle; }
            Group { Anchor: @CapGapAnchor; }
            Group #Track {
              Anchor: @TrackAnchor;
              Padding: (Full: 1);
              Background: @TrackWell;
              Group #Fill {
                Anchor: @FillAnchor;
                Background: #7fb2e0;
                Group #Gloss { Anchor: @GlossAnchor; Background: @Gloss; }
                Group #Base { Anchor: @BaseAnchor; Background: @BaseShade; }
              }
              Group #Pulse { Visible: false; Anchor: @PulseAnchor; Background: #ffffff; }
            }
            Group { Anchor: @CapGapAnchor; }
            Label #Trail { Text: ""; Anchor: @CapAnchor; Style: @BarCapStyle; }
          }
        }
        Group #ZigBarC0R1 {
          Anchor: @RowAnchor;
          LayoutMode: Top;
          Visible: false;
