$C = "../Common.ui";
$ZT = "ZigType.ui";
$ZK = "ZigTokens.ui";
$ZX = "ZigText.ui";

// Every colour in this document is a token of ZigTokens.ui, but the item-grid ladder's own durability colours
// at its end, which the HUDs read and which stay as they are. A tint MULTIPLIES the native patch under it, so
// the white tint ($ZK.@ZigInkBright) draws the game's own button as it is (the Chapter screen's), and it keeps the
// Color leaf a page retints from Java.

// ── ziggfreed-common shared RICH-ROW button style (Button + inner Label) ──────
// Imported per page as:  $Z = "../Common/ZigButtons.ui";  then  Style: $Z.@ZigRichRowBtnStyle;
//
// The generic clickable-list-ROW companion to the ZigRichButton primitive
// (com.ziggfreed.common.ui.ZigRichButton). A `ButtonStyle` (backgrounds + Sounds
// only, NO LabelStyle) for the vanilla `Button` ELEMENT - which, unlike a
// `TextButton`, wraps a child `Label #Label` whose text is pushed via .TextSpans so
// PARAMETERIZED / composite localized text actually substitutes (a TextButton .Text
// prints the literal "{0}{1}").
//
// THEME-TINTABLE: the native Secondary.png 9-slice patch with a per-state white
// Color tint - the SAME retint-ready form as @ZigOptionBtnStyle, so a theme can
// recolour each row via UiRetint.retintButtonStates (overwriting
// .Style.{Default,Hovered,Pressed}.Background.Color) exactly like the dialogue option
// rows. A FLAT hex `Background: #rrggbb` would NOT be tintable (no .Color
// sub-property) - hence the patch. The per-row TEXT style (font / colour / alignment)
// lives on each consumer's inner `#Label`; a selected-row accent is set from Java by
// tinting this instance's .Style.Default.Background.Color (NOT by replacing .Background
// with a bare String, which red-Xes) + the #Label colour. The 9-slice needs a row
// height >= ~24px to render cleanly. For a tab/filter look use the vanilla
// $C.@TertiaryButtonStyle instead. Keep Sounds or the row is silent on click.
@ZigRichRowBtnStyle = ButtonStyle(
  Default: (Background: PatchStyle(TexturePath: "../Common/Buttons/Secondary.png", Border: 12, Color: $ZK.@ZigInkBright)),
  Hovered: (Background: PatchStyle(TexturePath: "../Common/Buttons/Secondary_Hovered.png", Border: 12, Color: $ZK.@ZigInkBright)),
  Pressed: (Background: PatchStyle(TexturePath: "../Common/Buttons/Secondary_Pressed.png", Border: 12, Color: $ZK.@ZigInkBright)),
  Sounds: $C.@ButtonSounds
);

// PRIMARY-CTA variant of the rich row, for a footer / hero call-to-action (Switch
// Class, Accept, View Leaderboard): the game's Primary.png patch, white-tinted in the
// same retint-ready form as @ZigRichRowBtnStyle, so a theme recolours it the same
// way. Pair with the @ZigRichBtn component (or a Button + Label #Label) below.
@ZigRichPrimaryBtnStyle = ButtonStyle(
  Default: (Background: PatchStyle(TexturePath: "../Common/Buttons/Primary.png", Border: 12, Color: $ZK.@ZigInkBright)),
  Hovered: (Background: PatchStyle(TexturePath: "../Common/Buttons/Primary_Hovered.png", Border: 12, Color: $ZK.@ZigInkBright)),
  Pressed: (Background: PatchStyle(TexturePath: "../Common/Buttons/Primary_Pressed.png", Border: 12, Color: $ZK.@ZigInkBright)),
  Sounds: $C.@ButtonSounds
);

// ── ziggfreed-common reusable RICH BUTTON component (icon + label) ────────────
// Imported per page as:  $Z = "../Common/ZigButtons.ui";  then instantiated:
//   $Z.@ZigRichBtn #MyBtn { @Style = $Z.@ZigRichPrimaryBtnStyle; @LabelStyle = (...); }
//
// A `Button` (clickable container, see ZigRichButton) wrapping an OPTIONAL leading
// icon, the text `Label #Label`, and an OPTIONAL trailing icon. Both icon slots are
// Visible:false until populated from Java via ZigRichButton.iconStart / .iconEnd - so
// the SAME component places an icon at the START or the END (or neither / both) with
// no per-consumer .ui variant. Text is pushed via ZigRichButton.text (.TextSpans).
// Overridable params: @Style (ButtonStyle), @LabelStyle, @Anchor, @Height, @IconSize.
@ZigRichBtn = Button {
  @Style = @ZigRichRowBtnStyle;
  @LabelStyle = (FontSize: $ZT.@ZigFontBody, TextColor: $ZK.@ZigInkStrong, RenderBold: false, HorizontalAlignment: Start, VerticalAlignment: Center);
  @Anchor = Anchor();
  @Height = 28;
  @IconSize = 16;
  Style: @Style;
  Anchor: (...@Anchor, Height: @Height);
  LayoutMode: Left;
  Padding: (Horizontal: 8);

  // Leading icon - a UI glyph texture set + shown by ZigRichButton.iconStart.
  Group #IconStart {
    Anchor: (Width: @IconSize, Height: @IconSize, Right: 6);
    Visible: false;
  }

  Label #Label {
    FlexWeight: 1;
    Text: "";
    Anchor: (Height: @Height);
    Style: @LabelStyle;
  }

  // Trailing icon - set + shown by ZigRichButton.iconEnd.
  Group #IconEnd {
    Anchor: (Width: @IconSize, Height: @IconSize, Left: 6);
    Visible: false;
  }
};

// ── ziggfreed-common shared PIN / TRACK glyph pill ────────────────────────────
// Imported per page as:  $Z = "../Common/ZigButtons.ui";  then  Style: $Z.@ZigPinBtnStyle;
//
// The small square pill behind a pin / track toggle (a quest row's track button, an
// achievement row's pin, the achievement detail header's pin). A `ButtonStyle`
// (backgrounds + Sounds only, NO LabelStyle): the glyph itself is BAKED in each
// consumer's template as nested #PinIconOff / #PinIconOn groups (a TexturePath pushed
// from Java renders a red X), and Java flips the variants + retints these per-state
// backgrounds (gold when on, steel when off). At rest it is the kit's row surface in
// its three states. Keep Sounds or the pill is silent.
@ZigPinBtnStyle = ButtonStyle(
  Default: (Background: $ZK.@ZigSurfaceRow),
  Hovered: (Background: $ZK.@ZigSurfaceRowHover),
  Pressed: (Background: $ZK.@ZigSurfaceRowPressed),
  Sounds: $C.@ButtonSounds
);

// ── ziggfreed-common shared dialogue option button style (de-MMO'd) ───────────
// Imported per page as:  $M = "../Common/ZigButtons.ui";  then  Style: $M.@ZigOptionBtnStyle;
//
// The native Secondary.png 9-slice patch (Border: 12) with a white tint (the patch
// as drawn); the dialogue page overwrites the per-state .Background.Color from Java
// (DialogueOptionStyle) per the option's decisive action kind. Texture paths are
// "../Common/Buttons/..." - because Common/ and Pages/ are siblings under Custom/,
// they resolve to the game's Common/Buttons whether the engine resolves relative to
// this file or the consuming page. MUST keep Sounds: $C.@ButtonSounds or the button
// is silent on click.

// Dialogue option row button - left-aligned label, the native patch, non-bold.
@ZigOptionBtnStyle = TextButtonStyle(
  Default: (Background: PatchStyle(TexturePath: "../Common/Buttons/Secondary.png", Border: 12, Color: $ZK.@ZigInkBright), LabelStyle: (FontSize: $ZT.@ZigFontBody, TextColor: $ZK.@ZigInkStrong, RenderBold: false, HorizontalAlignment: Start, VerticalAlignment: Center)),
  Hovered: (Background: PatchStyle(TexturePath: "../Common/Buttons/Secondary_Hovered.png", Border: 12, Color: $ZK.@ZigInkBright), LabelStyle: (FontSize: $ZT.@ZigFontBody, TextColor: $ZK.@ZigInkBright, RenderBold: false, HorizontalAlignment: Start, VerticalAlignment: Center)),
  Pressed: (Background: PatchStyle(TexturePath: "../Common/Buttons/Secondary_Pressed.png", Border: 12, Color: $ZK.@ZigInkBright), LabelStyle: (FontSize: $ZT.@ZigFontBody, TextColor: $ZK.@ZigInkStrong, RenderBold: false, HorizontalAlignment: Start, VerticalAlignment: Center)),
  Sounds: $C.@ButtonSounds
);

// The Button twin of @ZigOptionBtnStyle, for a conversation's answer row and the party page's action
// buttons, whose words go on a Label's .TextSpans so a number, a plural or a nested name reads right. A
// `ButtonStyle` (the same patch and per-state tints, Sounds, NO LabelStyle) for a `Button` wrapping a
// `Label #Label` (ZigRichButton); the label's text style lives on that Label, and the dialogue page retints
// each row's backgrounds from Java exactly as it did the TextButton rows.
@ZigRichOptionBtnStyle = ButtonStyle(
  Default: (Background: PatchStyle(TexturePath: "../Common/Buttons/Secondary.png", Border: 12, Color: $ZK.@ZigInkBright)),
  Hovered: (Background: PatchStyle(TexturePath: "../Common/Buttons/Secondary_Hovered.png", Border: 12, Color: $ZK.@ZigInkBright)),
  Pressed: (Background: PatchStyle(TexturePath: "../Common/Buttons/Secondary_Pressed.png", Border: 12, Color: $ZK.@ZigInkBright)),
  Sounds: $C.@ButtonSounds
);

// ── ziggfreed-common shared segmented tab / filter button ─────────────────────
// Imported per page as:  $M = "../Common/ZigButtons.ui";  then  Style: $M.@ZigTabBtnStyle;
//
// A center-aligned sibling of @ZigOptionBtnStyle for tab / filter rows (a leaderboard's
// party-size tabs, a paged list's category chips). ONE style covers active + inactive:
// the page overwrites the ACTIVE tab's per-state .Background.Color from Java to a brighter
// tint (the same technique DialoguePage uses to paint an option row by its action kind),
// so there is no separate active style to drift. An unchosen tab is unlit: the patch
// darkened by the unlit mark's slate, so the tint a page lights the chosen one with reads
// brighter. Keep Sounds or the tab is silent on click.
@ZigTabBtnStyle = TextButtonStyle(
  Default: (Background: PatchStyle(TexturePath: "../Common/Buttons/Secondary.png", Border: 12, Color: $ZK.@ZigMarkUnlit), LabelStyle: (FontSize: $ZT.@ZigFontBody, TextColor: $ZK.@ZigInkBody, RenderBold: false, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Hovered: (Background: PatchStyle(TexturePath: "../Common/Buttons/Secondary_Hovered.png", Border: 12, Color: $ZK.@ZigMarkUnlit), LabelStyle: (FontSize: $ZT.@ZigFontBody, TextColor: $ZK.@ZigInkBright, RenderBold: false, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Pressed: (Background: PatchStyle(TexturePath: "../Common/Buttons/Secondary_Pressed.png", Border: 12, Color: $ZK.@ZigMarkUnlit), LabelStyle: (FontSize: $ZT.@ZigFontBody, TextColor: $ZK.@ZigInkStrong, RenderBold: false, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Sounds: $C.@ButtonSounds
);

// The Button twin of @ZigTabBtnStyle, for a tab whose name carries parameters (a leaderboard's season
// tab: an event's name and a year), which only a Label's .TextSpans substitutes. A `ButtonStyle` (the
// same patch and per-state tints, Sounds, NO LabelStyle) for a `Button` wrapping a `Label #Label`
// (ZigRichButton); the label's text style lives on that Label, and the page retints the active tab's
// backgrounds and label from Java exactly as it does the TextButton tabs.
@ZigRichTabBtnStyle = ButtonStyle(
  Default: (Background: PatchStyle(TexturePath: "../Common/Buttons/Secondary.png", Border: 12, Color: $ZK.@ZigMarkUnlit)),
  Hovered: (Background: PatchStyle(TexturePath: "../Common/Buttons/Secondary_Hovered.png", Border: 12, Color: $ZK.@ZigMarkUnlit)),
  Pressed: (Background: PatchStyle(TexturePath: "../Common/Buttons/Secondary_Pressed.png", Border: 12, Color: $ZK.@ZigMarkUnlit)),
  Sounds: $C.@ButtonSounds
);

// ── ziggfreed-common shared PRIMARY CTA button ────────────────────────────────
// Imported per page as:  $M = "../Common/ZigButtons.ui";  then  Style: $M.@ZigPrimaryBtnStyle;
//
// A CENTER-aligned sibling of @ZigOptionBtnStyle for a plain button (Back, Edit, Reset) and footer
// buttons (results-screen View Leaderboard / Play Again). Same white-tinted Secondary.png patch;
// label is centered (NOT Start - the option style is left-aligned for dialogue rows). Keep Sounds
// or the button is silent on click.
@ZigPrimaryBtnStyle = TextButtonStyle(
  Default: (Background: PatchStyle(TexturePath: "../Common/Buttons/Secondary.png", Border: 12, Color: $ZK.@ZigInkBright), LabelStyle: (FontSize: $ZT.@ZigFontBody, TextColor: $ZK.@ZigInkStrong, RenderBold: false, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Hovered: (Background: PatchStyle(TexturePath: "../Common/Buttons/Secondary_Hovered.png", Border: 12, Color: $ZK.@ZigInkBright), LabelStyle: (FontSize: $ZT.@ZigFontBody, TextColor: $ZK.@ZigInkBright, RenderBold: false, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Pressed: (Background: PatchStyle(TexturePath: "../Common/Buttons/Secondary_Pressed.png", Border: 12, Color: $ZK.@ZigInkBright), LabelStyle: (FontSize: $ZT.@ZigFontBody, TextColor: $ZK.@ZigInkStrong, RenderBold: false, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Sounds: $C.@ButtonSounds
);

// ── ziggfreed-common shared SORTABLE COLUMN-HEADER button ─────────────────────
// Imported per page as:  $M = "../Common/ZigButtons.ui";  then  Style: $M.@ZigSortHeaderBtnStyle;
//
// A MINIMAL, RIGHT-aligned, small-font clickable header for "click a column to sort" lists (the
// leaderboard Stats-view stat columns + Plays). Muted by default so it reads as a header, not a
// chip; the page paints the ACTIVE (currently-sorted) header's per-state .Background.Color from
// Java via the same style() helper that tints the tabs, so at rest it is unlit as an unchosen tab
// is. Right-aligned to line up with the numeric cells below it. Keep Sounds or it is silent.
@ZigSortHeaderBtnStyle = TextButtonStyle(
  Default: (Background: PatchStyle(TexturePath: "../Common/Buttons/Secondary.png", Border: 12, Color: $ZK.@ZigMarkUnlit), LabelStyle: (FontSize: $ZT.@ZigFontSection, TextColor: $ZK.@ZigInkMuted, RenderBold: false, HorizontalAlignment: End, VerticalAlignment: Center)),
  Hovered: (Background: PatchStyle(TexturePath: "../Common/Buttons/Secondary_Hovered.png", Border: 12, Color: $ZK.@ZigMarkUnlit), LabelStyle: (FontSize: $ZT.@ZigFontSection, TextColor: $ZK.@ZigInkBright, RenderBold: false, HorizontalAlignment: End, VerticalAlignment: Center)),
  Pressed: (Background: PatchStyle(TexturePath: "../Common/Buttons/Secondary_Pressed.png", Border: 12, Color: $ZK.@ZigMarkUnlit), LabelStyle: (FontSize: $ZT.@ZigFontSection, TextColor: $ZK.@ZigInkStrong, RenderBold: false, HorizontalAlignment: End, VerticalAlignment: Center)),
  Sounds: $C.@ButtonSounds
);

// ── ziggfreed-common shared SECTION HEADER label ──────────────────────────────
// Imported per page as:  $Z = "../Common/ZigButtons.ui";  then  Style: $Z.@ZigSectionHeaderStyle;
//
// The quiet header above one section of a detail panel (OBJECTIVES, REWARDS, COST): the kit's head
// (ZigText.ui's @ZigHeadStyle: the headline face in capitals, letter-spaced, in the head ink) kept at the
// section step, 13, so it reads as a label over the lines beneath it, not as one of them, and still fits the
// narrow toolbar labels that read it. ONE constant for every such header in the family, so a page never spells
// its own and the look cannot drift between the board, the storefront and the quest pages. A header that must
// carry its own colour (a warning requirements header) spreads this and overrides the one leaf with a token:
//   Style: (...$Z.@ZigSectionHeaderStyle, TextColor: $ZK.@ZigToneDangerText);
@ZigSectionHeaderStyle = LabelStyle(...$ZX.@ZigHeadStyle, FontSize: $ZT.@ZigFontSection, VerticalAlignment: Center);

// Blank-icon-slot fix: an ItemGrid with no Style renders nothing. This ladder gives every
// ItemGrid in the library a ready-made style; a page picks the rung matching its own
// ItemGrid's Anchor Width/Height (18, 20, 22, 24, or 28). Imported per page as:
// $Z = "../Common/ZigButtons.ui";  then  Style: $Z.@ZigIconGrid20;
@ZigIconGrid18 = ItemGridStyle(
  SlotSize: 18,
  SlotIconSize: 16,
  SlotSpacing: 0,
  SlotBackground: "../Common/ContainerPanelPatch.png",
  QuantityPopupSlotOverlay: "../Common/ContainerPanelPatch.png",
  BrokenSlotBackgroundOverlay: "../Common/ContainerPanelPatch.png",
  BrokenSlotIconOverlay: "../Common/ContainerPanelPatch.png",
  DefaultItemIcon: "../Common/ContainerPanelPatch.png",
  DurabilityBar: "../Common/ContainerPanelPatch.png",
  DurabilityBarBackground: "../Common/ContainerPanelPatch.png",
  DurabilityBarAnchor: (Bottom: 0, Left: 0, Width: 0, Height: 0),
  DurabilityBarColorStart: #a63232,
  DurabilityBarColorEnd: #63b649,
  EphemeralIconPatch: "../Common/ContainerPanelPatch.png",
  EphemeralIconAnchor: (Bottom: 0, Left: 0, Width: 0, Height: 0)
);

@ZigIconGrid20 = ItemGridStyle(
  SlotSize: 20,
  SlotIconSize: 18,
  SlotSpacing: 0,
  SlotBackground: "../Common/ContainerPanelPatch.png",
  QuantityPopupSlotOverlay: "../Common/ContainerPanelPatch.png",
  BrokenSlotBackgroundOverlay: "../Common/ContainerPanelPatch.png",
  BrokenSlotIconOverlay: "../Common/ContainerPanelPatch.png",
  DefaultItemIcon: "../Common/ContainerPanelPatch.png",
  DurabilityBar: "../Common/ContainerPanelPatch.png",
  DurabilityBarBackground: "../Common/ContainerPanelPatch.png",
  DurabilityBarAnchor: (Bottom: 0, Left: 0, Width: 0, Height: 0),
  DurabilityBarColorStart: #a63232,
  DurabilityBarColorEnd: #63b649,
  EphemeralIconPatch: "../Common/ContainerPanelPatch.png",
  EphemeralIconAnchor: (Bottom: 0, Left: 0, Width: 0, Height: 0)
);

@ZigIconGrid22 = ItemGridStyle(
  SlotSize: 22,
  SlotIconSize: 20,
  SlotSpacing: 0,
  SlotBackground: "../Common/ContainerPanelPatch.png",
  QuantityPopupSlotOverlay: "../Common/ContainerPanelPatch.png",
  BrokenSlotBackgroundOverlay: "../Common/ContainerPanelPatch.png",
  BrokenSlotIconOverlay: "../Common/ContainerPanelPatch.png",
  DefaultItemIcon: "../Common/ContainerPanelPatch.png",
  DurabilityBar: "../Common/ContainerPanelPatch.png",
  DurabilityBarBackground: "../Common/ContainerPanelPatch.png",
  DurabilityBarAnchor: (Bottom: 0, Left: 0, Width: 0, Height: 0),
  DurabilityBarColorStart: #a63232,
  DurabilityBarColorEnd: #63b649,
  EphemeralIconPatch: "../Common/ContainerPanelPatch.png",
  EphemeralIconAnchor: (Bottom: 0, Left: 0, Width: 0, Height: 0)
);

@ZigIconGrid24 = ItemGridStyle(
  SlotSize: 24,
  SlotIconSize: 22,
  SlotSpacing: 0,
  SlotBackground: "../Common/ContainerPanelPatch.png",
  QuantityPopupSlotOverlay: "../Common/ContainerPanelPatch.png",
  BrokenSlotBackgroundOverlay: "../Common/ContainerPanelPatch.png",
  BrokenSlotIconOverlay: "../Common/ContainerPanelPatch.png",
  DefaultItemIcon: "../Common/ContainerPanelPatch.png",
  DurabilityBar: "../Common/ContainerPanelPatch.png",
  DurabilityBarBackground: "../Common/ContainerPanelPatch.png",
  DurabilityBarAnchor: (Bottom: 0, Left: 0, Width: 0, Height: 0),
  DurabilityBarColorStart: #a63232,
  DurabilityBarColorEnd: #63b649,
  EphemeralIconPatch: "../Common/ContainerPanelPatch.png",
  EphemeralIconAnchor: (Bottom: 0, Left: 0, Width: 0, Height: 0)
);

@ZigIconGrid28 = ItemGridStyle(
  SlotSize: 28,
  SlotIconSize: 24,
  SlotSpacing: 0,
  SlotBackground: "../Common/ContainerPanelPatch.png",
  QuantityPopupSlotOverlay: "../Common/ContainerPanelPatch.png",
  BrokenSlotBackgroundOverlay: "../Common/ContainerPanelPatch.png",
  BrokenSlotIconOverlay: "../Common/ContainerPanelPatch.png",
  DefaultItemIcon: "../Common/ContainerPanelPatch.png",
  DurabilityBar: "../Common/ContainerPanelPatch.png",
  DurabilityBarBackground: "../Common/ContainerPanelPatch.png",
  DurabilityBarAnchor: (Bottom: 0, Left: 0, Width: 0, Height: 0),
  DurabilityBarColorStart: #a63232,
  DurabilityBarColorEnd: #63b649,
  EphemeralIconPatch: "../Common/ContainerPanelPatch.png",
  EphemeralIconAnchor: (Bottom: 0, Left: 0, Width: 0, Height: 0)
);
