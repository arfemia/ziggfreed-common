$C = "../Common.ui";
$ZT = "ZigType.ui";

// ── ziggfreed-common shared decorated panel frame (de-MMO'd) ──────────────────
// Imported per page as:  $F = "../Common/ZigFrames.ui";  then used as a container:
//   $F.@ZigDecoratedFrame { @CloseButton = true; Anchor: (...); #Content { ...body... } }
//
// Uses ContainerFullPatch.png (the native standalone @Panel patch, finished on ALL
// four sides) so the border reads clean with NO header bar - the right base for a
// page that shows its title in the body. The top/bottom rune flourishes are direct
// children of the frame (not nested in a #Title), optional via @Ornaments. Texture
// paths "../Common/..." resolve to the game's Common set whether the engine resolves
// relative to this file or the consuming page.

@ZigDecoratedFrame = Group {
  @CloseButton = false;
  @Ornaments = true;

  Group #Content {
    LayoutMode: Top;
    Anchor: (Top: 0);
    Padding: (Full: 18);
    Background: (TexturePath: "../Common/ContainerFullPatch.png", Border: 20);
  }

  Group #DecorTop {
    Anchor: (Width: 236, Height: 11, Top: -6);
    Background: "../Common/ContainerDecorationTop.png";
    Visible: @Ornaments;
  }
  Group #DecorBottom {
    Anchor: (Width: 236, Height: 11, Bottom: -6);
    Background: "../Common/ContainerDecorationBottom.png";
    Visible: @Ornaments;
  }

  Button #CloseButton {
    Anchor: (Width: 32, Height: 32, Top: -8, Right: -8);
    Style: (
      Default: (Background: "../Common/ContainerCloseButton.png"),
      Hovered: (Background: "../Common/ContainerCloseButtonHovered.png"),
      Pressed: (Background: "../Common/ContainerCloseButtonPressed.png"),
      Sounds: $C.@ButtonsCancel
    );
    Visible: @CloseButton;
  }
};

// ── the label styles ──────────────────────────────────────────────────────────
// Four label styles for the shared menu frame and every page that wants to read like it: caption, body,
// heading and title, each sized from the family's type scale (Common/ZigType.ui, imported as $ZT), so nothing
// a player reads is under its 13px floor. Spread one and override a leaf:
// Style: (...$F.@ZigBodyLabelStyle, TextColor: #ffffff);. The colours are the menu's default palette
// (com.ziggfreed.common.ui.menu.MenuPalette), vanilla's own label grey and white; a page on the menu frame gets
// them repainted from the palette in force.
@ZigCaptionLabelStyle = LabelStyle(FontSize: $ZT.@ZigFontCaption, TextColor: #96a9be, VerticalAlignment: Center);
@ZigBodyLabelStyle = LabelStyle(FontSize: $ZT.@ZigFontBody, TextColor: #96a9be, VerticalAlignment: Center);
@ZigHeadingLabelStyle = LabelStyle(FontSize: $ZT.@ZigFontHeading, TextColor: #96a9be, RenderBold: true, VerticalAlignment: Center);
@ZigTitleLabelStyle = LabelStyle(FontSize: $ZT.@ZigFontTitle, TextColor: #ffffff, RenderBold: true, VerticalAlignment: Center);

// ── the shared menu frame (com.ziggfreed.common.ui.menu.ZigMenu) ──────────────
// Imported per page as:  $F = "../Common/ZigFrames.ui";  then
//   $F.@ZigMenuFrame { #Content { Group #RightPanel { ... } Group #SidePanel { ... } } }
//
// ONE size for every page on the rail (com.ziggfreed.common.ui.menu.MenuFrame holds the same numbers and a
// test holds the two together). The rail is the first child of #Content, on vanilla's faint dark pane, then
// vanilla's vertical separator; a page adds its own columns to #Content after them, the way a page adds
// children to any template child. The rail's rows are appended into #MenuList from Java
// (Pages/ZigMenuTab.ui, by index); the three branding hosts keep their ids, so a branding template appended
// into #BrandingContainerLeft lands where it always has. A page never sets the frame's Anchor, LayoutMode or
// Padding. The pane's colour is a palette token that ZigMenu.paint pushes after any frame paint.
@ZigMenuFrame = Group {
  @CloseButton = true;
  @Ornaments = true;
  Anchor: (Width: 1570, Height: 1000);

  Group #Content {
    LayoutMode: Left;
    Anchor: (Top: 0);
    Padding: (Full: 12);
    Background: (TexturePath: "../Common/ContainerFullPatch.png", Border: 20);

    Group #MenuRail {
      Anchor: (Width: 250);
      Background: (Color: #000000(0.15));
      LayoutMode: Top;
      Padding: (Full: 8);

      Group #BrandingContainerLeft {
        Visible: false;
      }

      Label #BrandingServerName {
        Text: "";
        Visible: false;
        Anchor: (Height: 20, Bottom: 2);
        Style: (...@ZigBodyLabelStyle, TextColor: #ffffff, RenderBold: true);
      }

      Label #BrandingDescription {
        Text: "";
        Visible: false;
        Anchor: (Height: 18, Bottom: 8);
        Style: @ZigCaptionLabelStyle;
      }

      Group #MenuList {
        FlexWeight: 1;
        LayoutMode: TopScrolling;
        ScrollbarStyle: $C.@DefaultScrollbarStyle;
        Padding: (Right: 4);
      }
    }

    // Vanilla's vertical separator between the rail and the page (Common.ui's @VerticalSeparator, with
    // Pages/Point/PointInspectorPage.ui's 8px either side); MenuFrame.BODY_WIDTH leaves room for it.
    $C.@VerticalSeparator #MenuSeparator {
      Anchor: (Width: 6, Top: -2, Left: 8, Right: 8);
    }
  }

  Group #DecorTop {
    Anchor: (Width: 236, Height: 11, Top: -6);
    Background: "../Common/ContainerDecorationTop.png";
    Visible: @Ornaments;
  }
  Group #DecorBottom {
    Anchor: (Width: 236, Height: 11, Bottom: -6);
    Background: "../Common/ContainerDecorationBottom.png";
    Visible: @Ornaments;
  }

  Button #CloseButton {
    Anchor: (Width: 32, Height: 32, Top: -8, Right: -8);
    Style: (
      Default: (Background: "../Common/ContainerCloseButton.png"),
      Hovered: (Background: "../Common/ContainerCloseButtonHovered.png"),
      Pressed: (Background: "../Common/ContainerCloseButtonPressed.png"),
      Sounds: $C.@ButtonsCancel
    );
    Visible: @CloseButton;
  }
};
