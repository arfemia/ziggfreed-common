$ZT = "../Common/ZigType.ui";
$ZK = "../Common/ZigTokens.ui";
$ZX = "../Common/ZigText.ui";
$ZW = "../Common/ZigKit.ui";

// One item an item-cost confirm page asks for (com.ziggfreed.common.ui.confirm.ItemCostConfirmPage), 140 wide,
// appended into the page's #CostList and addressed by index as "#CostList[i]". The summon screen's key slot:
//   #Slot        76 x 76 on vanilla's Memories tiles: #SlotReady (TileComplete) once the player holds enough,
//                #SlotShort (TileDefault) while not; exactly one visible
//   #Pic         the item's 64px picture, painted through IconRenderer.applyPlainIcon
//   #Name        the item's own name
//   #Have        held over needed, green, while the player holds enough
//   #Short       held over needed, red, while they hold too few; exactly one of the two visible

Group #ZigItemCostRow {
  LayoutMode: Top;
  Anchor: (Width: 140, Left: $ZK.@ZigSpace1, Right: $ZK.@ZigSpace1);

  Group #SlotRow {
    LayoutMode: Center;
    Anchor: (Height: 76);

    Group #Slot {
      Anchor: (Width: 76, Height: 76);
      LayoutMode: Full;

      Group #SlotReady {
        Anchor: (Full: 0);
        Background: (TexturePath: "../Pages/Memories/Tiles/TileComplete.png", Border: 8);
        Visible: false;
      }

      Group #SlotShort {
        Anchor: (Full: 0);
        Background: (TexturePath: "../Pages/Memories/Tiles/TileDefault.png", Border: 8);
      }

      $ZW.@ZigPicture #Pic {
        @Size = $ZK.@ZigPicLarge;
        @Anchor = (Left: 6, Top: 6);
      }
    }
  }

  Label #Name {
    Anchor: (Top: $ZK.@ZigSpace1);
    Text: "";
    Style: (...$ZX.@ZigBodyStyle, HorizontalAlignment: Center, Wrap: true);
  }

  Label #Have {
    Text: "";
    Style: (FontSize: $ZT.@ZigFontBody, TextColor: $ZK.@ZigToneDoneText, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center);
  }

  Label #Short {
    Text: "";
    Visible: false;
    Style: (FontSize: $ZT.@ZigFontBody, TextColor: $ZK.@ZigToneDangerText, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center);
  }
}
