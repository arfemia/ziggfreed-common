$Z = "../Common/ZigButtons.ui";

// One row of a selectable list: a quest list, a storefront's catalogue, a board's contracts.
// Appended into a page's list container and addressed per row via the INDEXED PARENT
// ("#MyList[0] #RowBtn"), so the bare descendant ids below are safe across many rows and across
// mods.
//
// ONE template for BOTH kinds of row. A content row and a section heading differ in what they SAY
// rather than in what they are, and a page update can restyle an element that already exists but
// can never add one - so a list mixing templates would give two different child sets at one index
// and a partial update would address the wrong thing.
//
// A SECTION HEADING is the same row with its button and dot hidden and #SectionLabel shown;
// #SectionMeta carries a short line under a heading (a rotating shelf's countdown) and stays
// hidden everywhere else. A content row does the reverse (the authored defaults below). A heading
// that shows #SectionMeta must also GROW the row from Java - set the row root's Anchor to
// (Height: 54, Bottom: 2) - or the meta line paints over the row below it.
//
// #RowBtn is a Button + inner Label #Label, never a TextButton: a row title is a parameterized
// Message and only substitutes on .TextSpans. The selected-row accent is set from Java on the
// button's per-state tints plus the inner label, never by replacing the background wholesale.
//
// #RowBtn keeps a right MARGIN and a right PADDING, and #RowBadge keeps a fixed width: the title
// flexes, the badge does not, and the gap between them is what stops a long title reading as one
// word with the badge. The badge width (80px today) is meant to be the SMALLEST that fits the
// longest badge string any locale ships at FontSize 12, across the three families that share it:
// a board's grade word, a daily-limit badge, and "{0} left". Which of them is longest depends on
// the locale, so measure in game before trusting any one of them to be the floor.
// If a longer badge word has to fit, widen the badge rather than letting it clip; if every locale
// shortens, narrow it and the title grows on its own.

Group #ZigSelectRow {
  LayoutMode: Top;
  Anchor: (Height: 38, Bottom: 2);

  Group #RowLine {
    LayoutMode: Left;
    Anchor: (Height: 36);

    Group #StatusDot {
      Anchor: (Width: 6, Height: 6, Top: 15, Left: 4);
      Background: #96a9be;
    }

    Button #RowBtn {
      Style: $Z.@ZigRichRowBtnStyle;
      FlexWeight: 1;
      Anchor: (Height: 36, Right: 4);
      Padding: (Left: 14, Right: 8);
      LayoutMode: Left;

      Label #Label {
        FlexWeight: 1;
        Text: "";
        Anchor: (Height: 36);
        Style: (FontSize: 14, TextColor: #b6c9de, VerticalAlignment: Center);
      }
    }

    Label #SectionLabel {
      FlexWeight: 1;
      Text: "";
      Visible: false;
      Anchor: (Height: 36);
      Padding: (Left: 4);
      Style: (FontSize: 12, TextColor: #c2d4e8, RenderBold: true, LetterSpacing: 1, VerticalAlignment: Center);
    }

    Label #RowBadge {
      Text: "";
      Visible: false;
      Anchor: (Width: 80, Height: 36);
      Style: (FontSize: 12, TextColor: #c8a86a, HorizontalAlignment: End, VerticalAlignment: Center);
    }
  }

  Label #SectionMeta {
    Text: "";
    Visible: false;
    Anchor: (Height: 18);
    Padding: (Left: 4);
    Style: (FontSize: 12, TextColor: #9fb3c8, VerticalAlignment: Center);
  }
}
