$ZK = "../Common/ZigTokens.ui";
$ZX = "../Common/ZigText.ui";
$ZS = "../Common/ZigStyles.ui";
$ZW = "../Common/ZigKit.ui";

// One row of a kit list (a quest, an achievement, a season, a skill's tier), appended by
// com.ziggfreed.common.ui.kit.LedgerPainter into a section's #Rows and addressed by index as
// "#Rows[i] #Select", so a page never spells these ids. 56 high, it fills its parent's width.
//
// Vanilla's World Event list row (Pages/WorldEvent/WorldEventListRow.ui): one Button, #Select, holds the whole
// row, so a click anywhere on it selects it, and it swaps between ZigRowStyle and ZigRowSelectedStyle by
// reference (Common/ZigStyles.ui). Inside it, left to right:
//   #Accent   a 4px bar in the row's tone (its one colour; a tone's fill is pushed onto its Background)
//   #Pic      the 32px picture slot, painted through IconRenderer.applyPlainIcon (no tooltip, no rarity square)
//   #Title    the name, one line, ended with "..."; #Mark beside it shows #Pinned or #Tracked
//   #Meta     one line under the title ("3 / 10 ghouls", "Tier 3 of 5")
//   #BarTrack a 4px progress bar under the meta, hidden without progress
//   #Trail    92 wide at the end: #Value (points, a count) over #State (the tone's state word)
// No other button and no tooltip in a row: a label with a tooltip would swallow the row's click.

Group #ZigLedgerRow {
  LayoutMode: Left;
  Anchor: (Height: $ZK.@ZigRowHeight, Bottom: $ZK.@ZigSpace1);

  Button #Select {
    FlexWeight: 1;
    LayoutMode: Left;
    Padding: (Right: $ZK.@ZigSpace3);
    Style: $ZS.@ZigRowStyle;

    Group #Accent {
      Anchor: (Width: 4, Right: 10);
      Background: (Color: $ZK.@ZigToneBlockedFill);
    }

    $ZW.@ZigPicture #Pic {
      @Size = $ZK.@ZigPicRow;
      @Anchor = (Top: 12, Right: 10);
    }

    Group #Body {
      FlexWeight: 1;
      LayoutMode: Top;
      Padding: (Top: 7);

      Group #TitleLine {
        LayoutMode: Left;
        Anchor: (Height: 22);

        Label #Title {
          FlexWeight: 1;
          Text: "";
          Style: $ZX.@ZigRowTitleStyle;
        }

        Group #Mark {
          Anchor: (Width: 16, Height: 16, Top: 3, Left: 6);
          LayoutMode: Full;
          Visible: false;

          Group #Pinned {
            Anchor: (Full: 0);
            Background: (TexturePath: "../Common/Glyphs/PinFilled.png", Color: $ZK.@ZigAccent);
            Visible: false;
          }

          Group #Tracked {
            Anchor: (Full: 0);
            Background: (TexturePath: "../Common/Glyphs/Pin.png", Color: $ZK.@ZigInkSection);
            Visible: false;
          }
        }
      }

      Label #Meta {
        Anchor: (Height: 18);
        Text: "";
        Style: (...$ZX.@ZigCaptionStyle, Wrap: true, WrapMaxLines: 1);
      }

      $ZW.@ZigProgressBar #BarTrack {
        @Height = 4;
        @Anchor = (Top: 2, Right: 8);
        Visible: false;
      }
    }

    Group #Trail {
      Anchor: (Width: 92, Left: $ZK.@ZigSpace2);
      LayoutMode: Top;
      Padding: (Top: 9);

      Label #Value {
        Anchor: (Height: 19);
        Text: "";
        Style: $ZX.@ZigCountStyle;
      }

      Label #State {
        Anchor: (Height: 19);
        Text: "";
        Style: $ZS.@ZigStateStyle;
      }
    }
  }
}
