$C = "../Common.ui";
$ZT = "../Common/ZigType.ui";

// One row of the shared menu's rail (com.ziggfreed.common.ui.menu.ZigMenu), appended by index into the
// frame's #MenuList and addressed as "#MenuList[i] #TabBtn", so a tab's id never becomes an element id.
//
// Vanilla's own left-rail row (Pages/WorldEvent/WorldEventNavButton.ui, Pages/UIGallery/CategoryButton.ui):
// 32 high and 4 below, 10 in from each side, a body-size (14) uppercase label that shrinks to fit (never under
// the 13 floor; every size is a Common/ZigType.ui step), a
// faint dark fill under the cursor; the selected tab is vanilla's bold label under the gold gradient mask on
// the same fill, with a slim bar beside it so it reads by shape and not only colour.
//
// ONE template for every kind of row; ZigMenu shows one child and hides the rest:
//   #TabBtn       a tab: a Button with an inner Label #Label on .TextSpans (ui/ZigRichButton), never a
//                 TextButton; no resting fill, the hover fill on Hovered and Pressed, click sounds.
//   #TabSelected  the selected tab: a Group (no click, no hover) with #Marker, its picture and #SelectedLabel,
//                 whose mask no Java push can set, so it is authored here.
//   #Header       a section heading: vanilla's section label (13, bold, uppercase).
//   #Rule         the gap between the consumer's section and the library's tabs: vanilla's 1px separator.
// Every colour here is a ui/menu/MenuPalette default (an alpha one spelled #rrggbb(a)), and ZigMenu repaints
// each from the palette in force on every build (ZigMenuDocumentsTest). A picture slot (#TabIconSlot,
// #SelIconSlot) takes an optional 28px picture, centred in the row, through ui/icon/IconRenderer.applyPlainIcon;
// it ships hidden, and a tab never shows a picture without its label. The picture is an AssetImage of the item's
// own icon texture, which only displays: an ItemGrid would show the item's tooltip and rarity square on the tab,
// and an ItemIcon draws blank (UiIconWidgetHygieneTest).

@TabLabelStyle = LabelStyle(FontSize: $ZT.@ZigFontBody, TextColor: #96a9be, RenderUppercase: true, VerticalAlignment: Center, ShrinkTextToFit: true, MinShrinkTextToFitFontSize: $ZT.@ZigFontCaption);
@SelectedLabelStyle = LabelStyle(FontSize: $ZT.@ZigFontBody, TextColor: #ffffff, RenderBold: true, RenderUppercase: true, VerticalAlignment: Center, ShrinkTextToFit: true, MinShrinkTextToFitFontSize: $ZT.@ZigFontCaption);
@SectionLabelStyle = LabelStyle(FontSize: $ZT.@ZigFontSection, TextColor: #96a9be, RenderBold: true, RenderUppercase: true, VerticalAlignment: End);

Group #ZigMenuTab {
  LayoutMode: Top;
  Anchor: (Height: 32, Bottom: 4);

  Button #TabBtn {
    Anchor: (Height: 32);
    Padding: (Horizontal: 10);
    LayoutMode: Left;
    Style: ButtonStyle(
      Default: (Background: (Color: #000000(0))),
      Hovered: (Background: (Color: #000000(0.2))),
      Pressed: (Background: (Color: #000000(0.2))),
      Sounds: $C.@ButtonSounds
    );

    Group #TabIconSlot {
      Anchor: (Width: 28, Height: 28, Top: 2, Right: 8);
      Visible: false;

      AssetImage #IcoTex {
        Anchor: (Width: 28, Height: 28);
        Visible: false;
        FallbackTexturePath: "UI/Custom/Pages/Memories/MissingIcon.png";
      }
    }

    Label #Label {
      FlexWeight: 1;
      Text: "";
      Anchor: (Height: 32);
      Style: @TabLabelStyle;
    }
  }

  Group #TabSelected {
    Anchor: (Height: 32);
    LayoutMode: Left;
    Padding: (Right: 10);
    Background: (Color: #000000(0.2));
    Visible: false;

    Group #Marker {
      Anchor: (Width: 3, Height: 32);
      Background: (Color: #e8a93b);
    }

    // The bar plus this gap is the button's 10 of padding, so a picture and a label line up with the tabs'.
    Group {
      Anchor: (Width: 7);
    }

    Group #SelIconSlot {
      Anchor: (Width: 28, Height: 28, Top: 2, Right: 8);
      Visible: false;

      AssetImage #IcoTex {
        Anchor: (Width: 28, Height: 28);
        Visible: false;
        FallbackTexturePath: "UI/Custom/Pages/Memories/MissingIcon.png";
      }
    }

    Label #SelectedLabel {
      FlexWeight: 1;
      Text: "";
      Anchor: (Height: 32);
      Style: @SelectedLabelStyle;
      MaskTexturePath: $C.@TextHighlightGradientMask;
    }
  }

  Label #Header {
    Text: "";
    Visible: false;
    Anchor: (Height: 32);
    Padding: (Left: 2);
    Style: @SectionLabelStyle;
  }

  Group #Rule {
    Anchor: (Top: 15, Height: 1);
    Background: (Color: #2b3542);
    Visible: false;
  }
}
