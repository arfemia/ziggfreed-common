$C = "../Common.ui";
$ZT = "../Common/ZigType.ui";
$ZK = "../Common/ZigTokens.ui";

// One row of the shared menu's rail (com.ziggfreed.common.ui.menu.ZigMenu), appended by index into the
// frame's #MenuList and addressed as "#MenuList[i] #TabBtn", so a tab's id never becomes an element id.
//
// Vanilla's own left-rail row (Pages/WorldEvent/WorldEventNavButton.ui, Pages/UIGallery/CategoryButton.ui):
// 32 high and 4 below, 10 in from each side, a body-size (14) uppercase label that shrinks to fit (never under
// the 13 floor; every size is a Common/ZigType.ui step). The fills are the Chapter look's list row, so the rail
// reads as the kit's lists do: the row's hover under the cursor, and the selected tab vanilla's bold label under
// the gold gradient mask on the kit's warm selected row, with a slim gold bar beside it (the selected row's gold
// edge) so it reads by shape and not only colour.
//
// ONE template for every kind of row; ZigMenu shows one child and hides the rest:
//   #TabBtn       a tab: a Button with an inner Label #Label on .TextSpans (ui/ZigRichButton), never a
//                 TextButton; no resting fill, the row's hover fill on Hovered and Pressed, click sounds.
//   #TabSelected  the selected tab: a Group (no click, no hover) with #Marker, its picture and #SelectedLabel,
//                 whose mask no Java push can set, so it is authored here.
//   #Header       a section heading: vanilla's section label (13, bold, uppercase).
//   #Rule         the gap between the consumer's section and the library's tabs: vanilla's 1px separator.
// A tab's label sits in a Top column (#TabText, #SelText) over its second line, #SubLine (ui/menu/MenuSubline):
// a 16px picture slot (#SubIconSlot) before a caption-step label (#SubLabel) eliding on one line, vanilla's
// 20-high value line (Pages/WorldEvent/WorldEventCoordinateRow.ui). It ships hidden, so it takes no room and a
// row stays 32; ZigMenu shows it only for a tab that gives a line, and then pushes the row, the tab's host and
// the selected bar to 52 as whole Anchors, so the fills and the click cover both lines. Vanilla grows a list row
// the same way: Pages/TriggerVolume/TriggerVolumeBrowseVolumeRow.ui (a Button row, a FlexWeight Top text column
// over a hidden second line) and TriggerVolumeInspectorPage, which pushes the row's whole Anchor taller.
// Every ink, the bar, the rule and the three fills (none at rest, @ZigSurfaceClear; the hover fill,
// @ZigSurfaceRowHover; the selected fill, @ZigSurfaceRowSelected) are Common/ZigTokens.ui tokens, the same values
// ui/menu/MenuPalette's defaults name (HEADER and SELECTED for the two fills); ZigMenu repaints each from the palette
// in force on every build, the selected fill always the kit's (ZigMenuPaintTest). A picture slot (#TabIconSlot,
// #SelIconSlot) takes an optional 28px picture, centred in the row, through ui/icon/IconRenderer.applyPlainIcon;
// it ships hidden, and a tab never shows a picture without its label. The picture is an AssetImage of the item's
// own icon texture, which only displays: an ItemGrid would show the item's tooltip and rarity square on the tab,
// and an ItemIcon draws blank (UiIconWidgetHygieneTest).

@TabLabelStyle = LabelStyle(FontSize: $ZT.@ZigFontBody, TextColor: $ZK.@ZigInkMuted, RenderUppercase: true, VerticalAlignment: Center, ShrinkTextToFit: true, MinShrinkTextToFitFontSize: $ZT.@ZigFontCaption);
@SelectedLabelStyle = LabelStyle(FontSize: $ZT.@ZigFontBody, TextColor: $ZK.@ZigInkBright, RenderBold: true, RenderUppercase: true, VerticalAlignment: Center, ShrinkTextToFit: true, MinShrinkTextToFitFontSize: $ZT.@ZigFontCaption);
@SectionLabelStyle = LabelStyle(FontSize: $ZT.@ZigFontSection, TextColor: $ZK.@ZigInkMuted, RenderBold: true, RenderUppercase: true, VerticalAlignment: End);
@SubLabelStyle = LabelStyle(FontSize: $ZT.@ZigFontCaption, TextColor: $ZK.@ZigInkMuted, VerticalAlignment: Center, Wrap: true, WrapMaxLines: 1);

Group #ZigMenuTab {
  LayoutMode: Top;
  Anchor: (Height: 32, Bottom: 4);

  Button #TabBtn {
    Anchor: (Height: 32);
    Padding: (Horizontal: 10);
    LayoutMode: Left;
    Style: ButtonStyle(
      Default: (Background: (Color: $ZK.@ZigSurfaceClear)),
      Hovered: (Background: (Color: $ZK.@ZigSurfaceRowHover)),
      Pressed: (Background: (Color: $ZK.@ZigSurfaceRowHover)),
      Sounds: $C.@ButtonSounds
    );

    Group #TabIconSlot {
      Anchor: (Width: 28, Height: 28, Top: 2, Right: 8);
      Visible: false;

      AssetImage #IcoTex {
        Anchor: (Width: 28, Height: 28);
        Visible: false;
        FallbackTexturePath: "UI/Custom/Pages/Memories/MissingIcon.png";
      }
    }

    Group #TabText {
      FlexWeight: 1;
      LayoutMode: Top;

      Label #Label {
        Text: "";
        Anchor: (Height: 32);
        Style: @TabLabelStyle;
      }

      Group #SubLine {
        Anchor: (Height: 20);
        LayoutMode: Left;
        Visible: false;

        Group #SubIconSlot {
          Anchor: (Width: 16, Height: 16, Top: 2, Right: 6);
          Visible: false;

          AssetImage #IcoTex {
            Anchor: (Width: 16, Height: 16);
            Visible: false;
            FallbackTexturePath: "UI/Custom/Pages/Memories/MissingIcon.png";
          }
        }

        Label #SubLabel {
          FlexWeight: 1;
          Text: "";
          Style: @SubLabelStyle;
        }
      }
    }
  }

  Group #TabSelected {
    Anchor: (Height: 32);
    LayoutMode: Left;
    Padding: (Right: 10);
    Background: (Color: $ZK.@ZigSurfaceRowSelected);
    Visible: false;

    Group #Marker {
      Anchor: (Width: 3, Height: 32);
      Background: (Color: $ZK.@ZigAccent);
    }

    // The bar plus this gap is the button's 10 of padding, so a picture and a label line up with the tabs'.
    Group {
      Anchor: (Width: 7);
    }

    Group #SelIconSlot {
      Anchor: (Width: 28, Height: 28, Top: 2, Right: 8);
      Visible: false;

      AssetImage #IcoTex {
        Anchor: (Width: 28, Height: 28);
        Visible: false;
        FallbackTexturePath: "UI/Custom/Pages/Memories/MissingIcon.png";
      }
    }

    Group #SelText {
      FlexWeight: 1;
      LayoutMode: Top;

      Label #SelectedLabel {
        Text: "";
        Anchor: (Height: 32);
        Style: @SelectedLabelStyle;
        MaskTexturePath: $C.@TextHighlightGradientMask;
      }

      Group #SubLine {
        Anchor: (Height: 20);
        LayoutMode: Left;
        Visible: false;

        Group #SubIconSlot {
          Anchor: (Width: 16, Height: 16, Top: 2, Right: 6);
          Visible: false;

          AssetImage #IcoTex {
            Anchor: (Width: 16, Height: 16);
            Visible: false;
            FallbackTexturePath: "UI/Custom/Pages/Memories/MissingIcon.png";
          }
        }

        Label #SubLabel {
          FlexWeight: 1;
          Text: "";
          Style: @SubLabelStyle;
        }
      }
    }
  }

  Label #Header {
    Text: "";
    Visible: false;
    Anchor: (Height: 32);
    Padding: (Left: 2);
    Style: @SectionLabelStyle;
  }

  Group #Rule {
    Anchor: (Top: 15, Height: 1);
    Background: (Color: $ZK.@ZigDivider);
    Visible: false;
  }
}
