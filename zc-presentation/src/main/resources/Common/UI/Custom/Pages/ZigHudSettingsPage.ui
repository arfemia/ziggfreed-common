$C = "../Common.ui";
$F = "../Common/ZigFrames.ui";
$Z = "../Common/ZigButtons.ui";

// The HUD settings page (com.ziggfreed.common.ui.hud.settings.HudSettingsPage): where the shared
// bar panels sit and which of them show. Two tabs painted from Java into ONE row container:
//
//   Mine     a hide-every-bar switch, then per panel a spot picker and a show switch, each kept
//            the moment it changes.
//   Server   (only when the consumer's audience says the viewer may) per panel an on-for-everyone
//            switch, a spot picker and one field per inline leaf (the offsets, the spread, the
//            band, the cut, the least height, the colour), written by #SaveButton into the owner
//            file for everyone.
//
// #Rows is the appendable list container and MUST stay childless here: rows are the shared
// Pages/ZigForm*Row.ui templates, addressed by indexed parent ("#Rows[3] #Dropdown"), so a
// pre-authored child would shift every index. All text is set from Java on .TextSpans, and every
// labeled button is a Button + inner #Label.
//
// Shipped once in ziggfreed-common; neutral Zig* ids. Smoke-test in-game.

$C.@PageOverlay {}

$F.@ZigDecoratedFrame {
  @CloseButton = true;
  @Ornaments = true;
  Anchor: (Width: 720, Height: 640);

  #Content {
    Anchor: (Top: 0);
    LayoutMode: Top;
    Padding: (Full: 18);

    Label #Title {
      Text: "";
      Anchor: (Height: 32, Bottom: 2);
      Style: (FontSize: 20, TextColor: #ffd97a, RenderBold: true, VerticalAlignment: Center);
    }

    Label #Subtitle {
      Text: "";
      Anchor: (Height: 20, Bottom: 10);
      Style: (FontSize: 12, TextColor: #93a4b8, VerticalAlignment: Center);
    }

    Group #Tabs {
      LayoutMode: Left;
      Anchor: (Height: 34, Bottom: 10);

      Button #TabMine {
        Style: $Z.@ZigRichRowBtnStyle;
        Anchor: (Width: 150, Height: 30, Right: 8);
        Label #Label {
          FlexWeight: 1;
          Text: "";
          Style: (FontSize: 13, TextColor: #e6eef7, HorizontalAlignment: Center, VerticalAlignment: Center);
        }
      }

      Button #TabServer {
        Style: $Z.@ZigRichRowBtnStyle;
        Anchor: (Width: 150, Height: 30);
        Label #Label {
          FlexWeight: 1;
          Text: "";
          Style: (FontSize: 13, TextColor: #e6eef7, HorizontalAlignment: Center, VerticalAlignment: Center);
        }
      }
    }

    Group { Anchor: (Height: 1, Bottom: 12); Background: #1e2a36; }

    Group #Rows {
      FlexWeight: 1;
      LayoutMode: TopScrolling;
      ScrollbarStyle: $C.@DefaultScrollbarStyle;
      Padding: (Right: 4);
    }

    Group #Footer {
      Anchor: (Height: 36, Top: 12);
      LayoutMode: Left;

      Button #BackButton {
        Style: $Z.@ZigRichRowBtnStyle;
        Anchor: (Width: 140, Height: 32);
        Label #Label {
          FlexWeight: 1;
          Text: "";
          Style: (FontSize: 13, TextColor: #e6eef7, HorizontalAlignment: Center, VerticalAlignment: Center);
        }
      }

      Group { FlexWeight: 1; }

      Button #SaveButton {
        Style: $Z.@ZigRichPrimaryBtnStyle;
        Anchor: (Width: 160, Height: 32);
        Visible: false;
        Label #Label {
          FlexWeight: 1;
          Text: "";
          Style: (FontSize: 13, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center);
        }
      }
    }
  }
}
