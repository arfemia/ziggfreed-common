$C = "../Common.ui";
$ZK = "../Common/ZigTokens.ui";
$ZX = "../Common/ZigText.ui";
$ZS = "../Common/ZigStyles.ui";
$ZW = "../Common/ZigKit.ui";

// The kit's compact row (an overview strip, a tracked or pinned panel), 44 high: Pages/ZigLedgerRow.ui's ids
// without its #Body column (no #Meta line), the title and its bar on one line. Appended by
// com.ziggfreed.common.ui.kit.LedgerPainter and addressed by index as "#Rows[i] #Select", like the standard row;
// a painter treats the two alike, so every id it addresses here matches that row's.
//
// Like the standard row it fixes no height: the root and #Select size to their tallest part over #RowStrut,
// a zero-wide Group 44 high, and #Title is a FlexWeight Label with no Height that wraps to two lines, the second
// ended with "...". A one-line title sits centred in the 44 row as it always did; a second line grows the row only
// if the client draws the two lines taller than 44. #Pic, #Mark and #BarTrack keep their
// Top anchors and #Trail stacks from the top, so they stay where they were: #Value over #StatePill, the state
// word on its tone's pill as in the standard row. Pages/ZigLedgerRow.ui names the client's and vanilla's
// documents each shape comes from, and says how the selected row's gold #Edge and the row's one #Action work; here
// the action is 32 high, to keep the compact row's 44. A shown #Action adds 168 px to the row's fixed parts (313 with
// the edge and the pin), so a compact row carrying one goes only into a host about 540 px wide or more, else its
// two-line title can fall under one ellipsis and crash the client (M560); a list of rows with actions takes the
// standard row.

Group #ZigLedgerRowCompact {
  LayoutMode: Left;
  Anchor: (Bottom: $ZK.@ZigSpace1);

  Button #Select {
    FlexWeight: 1;
    LayoutMode: Left;
    Padding: (Right: 10);
    Style: $ZS.@ZigRowStyle;

    Group #RowStrut {
      Anchor: (Width: 0, Height: $ZK.@ZigCompactRowHeight);
    }

    Group #Edge {
      Anchor: (Width: 3);
      Background: (Color: $ZK.@ZigSurfaceClear);
    }

    Group #Accent {
      Anchor: (Width: 4, Right: $ZK.@ZigSpace2);
      Background: (Color: $ZK.@ZigToneBlockedFill);
    }

    $ZW.@ZigPicture #Pic {
      @Size = $ZK.@ZigPicLine;
      @Anchor = (Top: 8, Right: $ZK.@ZigSpace2);
    }

    Label #Title {
      FlexWeight: 1;
      Text: "";
      Style: $ZX.@ZigLedgerTitleStyle;
    }

    Group #Mark {
      Anchor: (Width: 16, Height: 16, Top: 14, Left: $ZK.@ZigSpace1);
      LayoutMode: Full;
      Visible: false;

      Group #Pinned {
        Anchor: (Full: 0);
        Background: (TexturePath: "../Common/Glyphs/PinFilled.png", Color: $ZK.@ZigAccent);
        Visible: false;
      }

      Group #Tracked {
        Anchor: (Full: 0);
        Background: (TexturePath: "../Common/Glyphs/Pin.png", Color: $ZK.@ZigInkSection);
        Visible: false;
      }
    }

    $ZW.@ZigProgressBar #BarTrack {
      @Height = 4;
      @Anchor = (Width: 96, Top: 20, Left: $ZK.@ZigSpace2);
      Visible: false;
    }

    Group #Trail {
      Anchor: (Width: 120, Left: $ZK.@ZigSpace2);
      LayoutMode: Top;
      Padding: (Top: 3);

      Label #Value {
        Anchor: (Height: 19);
        Text: "";
        Style: $ZX.@ZigCountStyle;
      }

      Group #StatePill {
        Anchor: (Height: 20, Top: 1);
        LayoutMode: Left;
        Padding: (Horizontal: 4);
        Background: (TexturePath: "../Common/Kit/Pill.png", Border: 8, Color: $ZK.@ZigSurfaceScrim);
        Visible: false;

        Label #State {
          FlexWeight: 1;
          Anchor: (Height: 20);
          Text: "";
          Style: (...$ZS.@ZigStateStyle, HorizontalAlignment: Center);
        }
      }
    }

    Button #Action {
      Anchor: (Width: 160, Height: $ZK.@ZigControlHeight, Top: 6, Left: $ZK.@ZigSpace2);
      Style: $ZS.@ZigButtonSecondaryStyle;
      TextTooltipStyle: $C.@DefaultTextTooltipStyle;
      Visible: false;

      Label #Label {
        FlexWeight: 1;
        Text: "";
        Style: $ZX.@ZigButtonLabelStyle;
      }
    }
  }
}
