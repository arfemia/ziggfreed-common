$ZM = "../Common/ZigForm.ui";

// ── ziggfreed-common appendable SETTINGS-FORM toggle row ──────────────────────
// Appended by SettingsForm.buildRows into a consumer's list container:
//   cmd.append("#MyForm", "Pages/ZigFormToggleRow.ui");
// then addressed by the INDEXED PARENT (e.g. "#MyForm[0] #Toggle"), so the bare
// descendant ids below are safe across many rows AND across mods (the ZigListRow rule).
//
// The TOGGLE row: a flexing label (#Title) plus an instant on/off button (#Toggle,
// Common/ZigForm.ui's @ZigToggle, 96 by 30).
// #Toggle's OWN inner #Label (On/Off state text) is what SettingsUiUtil.setToggle
// paints - the row label stays #Title so the two ids never collide. #Row wraps the
// control line (LayoutMode: Left) so an optional #Hint sub-label can sit below it
// (LayoutMode: Top on the root); #Hint starts hidden and collapses to zero height
// until SettingsForm.buildRows/applyHint paints + shows it.

Group #ZigFormToggleRow {
  LayoutMode: Top;
  Anchor: (Bottom: 5);

  $ZM.@ZigFormRow #Row {
    Label #Title {
      FlexWeight: 1;
      Text: "";
      Style: $ZM.@ZigFormLabelStyle;
    }

    $ZM.@ZigToggle #Toggle {}
  }

  Label #Hint {
    Visible: false;
    Text: "";
    Padding: (Right: 96);
    Style: (...$ZM.@ZigFormNoteStyle, Wrap: true);
  }
}
