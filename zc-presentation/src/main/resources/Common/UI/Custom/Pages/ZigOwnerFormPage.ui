$C = "../Common.ui";
$F = "../Common/ZigFrames.ui";
$ZX = "../Common/ZigText.ui";
$ZS = "../Common/ZigStyles.ui";
$ZM = "../Common/ZigForm.ui";

// The owner form (com.ziggfreed.common.ui.form.OwnerFormPage): one owner file's settings, drawn from an owner form
// file (Server/ZiggfreedCommon/OwnerForms/), on the band with the frame's hero filled by the form's title. Each setting
// is the kit's owner leaf row (Pages/ZigFormLeafRow.ui, FormLeafPainter); a section's heading and note are the settings
// form's own rows (Pages/ZigFormHeaderRow.ui, Pages/ZigFormNoteRow.ui). #OwnerFormFields is the appendable list and
// MUST stay childless here. #OwnerFormStatus is the line a save or a reset answers on. Back returns to the owner menu,
// Save writes what changed. Every pushed word is on .TextSpans; OwnerFormPaint paints it all, which KitSelectorsTest
// walks.
//
// A form of the Entries shape first lists its entries in #OwnerFormFields, one Pages/ZigFormEntryRow.ui each (Edit
// opens that entry's settings on this same page, whose Back returns to the list), with Save hidden; #OwnerFormAdd, the
// line for adding an entry by a new id, shows only where the form allows it.
//
// #OwnerFormAudit shows how many problems the content audit a form names finds in what it edits, and #OwnerFormPreview,
// under the settings, what the values on the screen would do (a preview the form names), kept up as the owner types.
// Both stay hidden for a form that names neither.

$C.@PageOverlay {}

$F.@ZigDecoratedFrame {
  @CloseButton = true;
  Anchor: (Width: 960, Height: 820);

  #Content {
    Label #OwnerFormAudit {
      Visible: false;
      Text: "";
      Anchor: (Bottom: 8);
      Style: (...$ZX.@ZigBodyStyle, HorizontalAlignment: Center, Wrap: true);
    }

    Label #OwnerFormStatus {
      Visible: false;
      Text: "";
      Anchor: (Bottom: 8);
      Style: (...$ZX.@ZigBodyStyle, HorizontalAlignment: Center, Wrap: true);
    }

    $ZM.@ZigFormRow #OwnerFormAdd {
      @Anchor = (Bottom: 12);
      Visible: false;

      Label #OwnerFormAddLabel {
        FlexWeight: 1;
        Text: %ziggfreedcommon.ui.owner.form.entries.add.label;
        Style: $ZM.@ZigFormLabelStyle;
      }

      $C.@TextField #OwnerFormAddId {
        Anchor: (Width: 300, Height: 30);
        Padding: (Horizontal: 8);
      }

      Group {
        Anchor: (Width: 8);
      }

      Button #OwnerFormAddButton {
        Anchor: (Width: 140, Height: 30);
        Style: $ZS.@ZigButtonSecondaryStyle;

        Label #Label {
          FlexWeight: 1;
          Text: %ziggfreedcommon.ui.owner.form.entries.add;
          Style: $ZX.@ZigButtonLabelStyle;
        }
      }
    }

    Group #OwnerFormFields {
      FlexWeight: 1;
      LayoutMode: TopScrolling;
      ScrollbarStyle: $C.@DefaultScrollbarStyle;
      Padding: (Right: 12);
    }

    Label #OwnerFormPreview {
      Visible: false;
      Text: "";
      Anchor: (Top: 10);
      Style: (...$ZX.@ZigBodyStyle, HorizontalAlignment: Center, Wrap: true);
    }

    Group #OwnerFormFooter {
      LayoutMode: Left;
      Anchor: (Height: 40, Top: 12);

      Button #OwnerFormBack {
        Anchor: (Width: 180, Height: 40);
        Style: $ZS.@ZigButtonSecondaryStyle;

        Label #Label {
          FlexWeight: 1;
          Text: %ziggfreedcommon.ui.owner.form.back;
          Style: $ZX.@ZigButtonLabelStyle;
        }
      }

      Group {
        FlexWeight: 1;
      }

      Button #OwnerFormSave {
        Anchor: (Width: 220, Height: 40);
        Style: $ZS.@ZigButtonPrimaryStyle;

        Label #Label {
          FlexWeight: 1;
          Text: %ziggfreedcommon.ui.owner.form.save;
          Style: $ZX.@ZigButtonLabelStyle;
        }
      }
    }
  }
}
