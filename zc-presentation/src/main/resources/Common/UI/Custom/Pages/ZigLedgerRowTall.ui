$ZK = "../Common/ZigTokens.ui";
$ZX = "../Common/ZigText.ui";
$ZS = "../Common/ZigStyles.ui";
$ZW = "../Common/ZigKit.ui";

// The kit's tall row (a list whose meta line runs long: the Almanac's seasons, "On now - 27 days left"), 74 high
// with a one-line title: Pages/ZigLedgerRow.ui with its #Meta always keeping room for a second line, so every row
// of a list is the same height. Appended by com.ziggfreed.common.ui.kit.LedgerPainter and addressed by index as
// "#Rows[i] #Select", like the standard row; a painter treats the two alike, so every id here matches that row's.
// The kit's named meta styles are one line, so the painter recolours this #Meta by its colour leaf alone
// (RowSize.metaWraps) and never swaps its style.
//   #RowStrut an empty, zero-wide Group 74 high: the row's least height
//   #Accent   a 4px bar: the row's tone, the gold accent of a featured row, or hidden (RowAccent)
//   #Pic      the 32px picture slot, painted through IconRenderer.applyPlainIcon
//   #Title    the name, up to two lines, a longer one ending its second line with "..."; #Mark after it shows #Pinned or #Tracked
//   #MetaLine #Kind (the 14px glyph: #Star, #Scroll or #Clock), then #Meta, two lines high under the title, a
//             longer one ending its second line with "..."
//   #BarTrack a 4px progress bar under the meta, hidden without progress
//   #Trail    92 wide at the end: #Value over #StatePill, the state word #State on its tone's pill (narrower
//             than the standard row's 120, since the Almanac, its one host, paints no state pill)
// No other button and no tooltip in a row: a label with a tooltip would swallow the row's click.
// Like the standard row it fixes no height and grows to fit a title on two lines, over #RowStrut and the
// title line's #TitleStrut; Pages/ZigLedgerRow.ui says how, and which client and vanilla documents each shape
// comes from.

Group #ZigLedgerRowTall {
  LayoutMode: Left;
  Anchor: (Bottom: $ZK.@ZigSpace1);

  Button #Select {
    FlexWeight: 1;
    LayoutMode: Left;
    Padding: (Right: $ZK.@ZigSpace3);
    Style: $ZS.@ZigRowStyle;

    Group #RowStrut {
      Anchor: (Width: 0, Height: $ZK.@ZigTallRowHeight);
    }

    Group #Accent {
      Anchor: (Width: 4, Right: 10);
      Background: (Color: $ZK.@ZigToneBlockedFill);
    }

    $ZW.@ZigPicture #Pic {
      @Size = $ZK.@ZigPicRow;
      @Anchor = (Top: 12, Right: 10);
    }

    Group #Body {
      FlexWeight: 1;
      LayoutMode: Top;
      Padding: (Top: 7);

      Group #TitleLine {
        LayoutMode: Left;

        Group #TitleStrut {
          Anchor: (Width: 0, Height: 22);
        }

        Label #Title {
          FlexWeight: 1;
          Text: "";
          Style: $ZX.@ZigLedgerTitleStyle;
        }

        Group #Mark {
          Anchor: (Width: 16, Height: 16, Top: 3, Left: 6);
          LayoutMode: Full;
          Visible: false;

          Group #Pinned {
            Anchor: (Full: 0);
            Background: (TexturePath: "../Common/Glyphs/PinFilled.png", Color: $ZK.@ZigAccent);
            Visible: false;
          }

          Group #Tracked {
            Anchor: (Full: 0);
            Background: (TexturePath: "../Common/Glyphs/Pin.png", Color: $ZK.@ZigInkSection);
            Visible: false;
          }
        }
      }

      Group #MetaLine {
        LayoutMode: Left;

        Group #MetaStrut {
          Anchor: (Width: 0, Height: 18);
        }

        Group #Kind {
          Anchor: (Width: 14, Height: 14, Top: 2, Right: 5);
          LayoutMode: Full;
          Visible: false;

          Group #Star {
            Anchor: (Full: 0);
            Background: (TexturePath: "../Common/Glyphs/Star.png", Color: $ZK.@ZigAccent);
            Visible: false;
          }

          Group #Scroll {
            Anchor: (Full: 0);
            Background: (TexturePath: "../Common/Glyphs/Quest.png", Color: $ZK.@ZigInkMuted);
            Visible: false;
          }

          Group #Clock {
            Anchor: (Full: 0);
            Background: (TexturePath: "../Common/Glyphs/Clock.png", Color: $ZK.@ZigInkSection);
            Visible: false;
          }
        }

        Label #Meta {
          FlexWeight: 1;
          Anchor: (Height: 36);
          Text: "";
          Style: (...$ZX.@ZigCaptionStyle, VerticalAlignment: Start, Wrap: true, WrapMaxLines: 2);
        }
      }

      $ZW.@ZigProgressBar #BarTrack {
        @Height = 4;
        @Anchor = (Top: 2, Right: 8);
        Visible: false;
      }
    }

    Group #Trail {
      Anchor: (Width: 92, Left: $ZK.@ZigSpace2);
      LayoutMode: Top;
      Padding: (Top: 9);

      Label #Value {
        Anchor: (Height: 19);
        Text: "";
        Style: $ZX.@ZigCountStyle;
      }

      Group #StatePill {
        Anchor: (Height: 20, Top: 1);
        LayoutMode: Left;
        Padding: (Horizontal: 4);
        Background: (TexturePath: "../Common/Kit/Pill.png", Border: 8, Color: $ZK.@ZigSurfaceScrim);
        Visible: false;

        Label #State {
          FlexWeight: 1;
          Anchor: (Height: 20);
          Text: "";
          Style: (...$ZS.@ZigStateStyle, HorizontalAlignment: Center);
        }
      }
    }
  }
}
