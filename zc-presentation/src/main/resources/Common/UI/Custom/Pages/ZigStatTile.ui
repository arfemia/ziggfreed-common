$ZK = "../Common/ZigTokens.ui";
$ZX = "../Common/ZigText.ui";
$ZW = "../Common/ZigKit.ui";

// One counted thing (a season's tally, a statistic, a standing), 216 x 128: the Chapter look's figure tile, on the
// game's own panel patch (Common/ContainerFullPatch.png, finished on all four sides, as the panel frame draws it),
// appended by com.ziggfreed.common.ui.kit.TilePainter into a wrapping grid and addressed by index as
// "#Grid[i] #StatTile": the 40px picture (#Pic, painted through IconRenderer.applyPlainIcon, and hidden with no picture
// so the figure takes its room) beside the figure (#Figure, at the end, in its tone's colour when the tile has one),
// the thing's name in two lines (#Name), a caption ("1,204 in all") and, when the server counts it too, a faint server
// line (#Server, hidden otherwise). The padding keeps the words inside the patch's frame.

Group #ZigStatTile {
  Anchor: (Width: 216, Height: 128, Right: $ZK.@ZigSpace2, Bottom: $ZK.@ZigSpace2);

  Group #StatTile {
    Anchor: (Full: 0);
    LayoutMode: Top;
    Padding: (Top: 10, Bottom: 8, Horizontal: 14);
    Background: (TexturePath: "../Common/ContainerFullPatch.png", Border: 20);

    Group #StatHead {
      LayoutMode: Left;
      Anchor: (Height: $ZK.@ZigPicTile);

      $ZW.@ZigPicture #Pic {
        @Size = $ZK.@ZigPicTile;
        @Anchor = (Right: $ZK.@ZigSpace2);
      }

      Label #Figure {
        FlexWeight: 1;
        Anchor: (Height: $ZK.@ZigPicTile);
        Text: "";
        Style: $ZX.@ZigFigureStyle;
      }
    }

    Label #Name {
      Anchor: (Top: $ZK.@ZigSpace1, Height: 34);
      Text: "";
      Style: (...$ZX.@ZigBodyStyle, VerticalAlignment: Start, Wrap: true, WrapMaxLines: 2);
    }

    Label #Caption {
      Anchor: (Height: 16);
      Text: "";
      Style: (...$ZX.@ZigCaptionStyle, Wrap: true, WrapMaxLines: 1);
    }

    Label #Server {
      Anchor: (Height: 16);
      Text: "";
      Visible: false;
      Style: $ZX.@ZigFaintStyle;
    }
  }
}
