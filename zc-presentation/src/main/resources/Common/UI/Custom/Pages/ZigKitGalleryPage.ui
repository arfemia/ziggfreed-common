$C = "../Common.ui";
$F = "../Common/ZigFrames.ui";
$ZK = "../Common/ZigTokens.ui";
$ZX = "../Common/ZigText.ui";
$ZS = "../Common/ZigStyles.ui";
$ZW = "../Common/ZigKit.ui";
$Z = "../Common/ZigButtons.ui";
$K = "../Common/ZigCards.ui";
$ZM = "../Common/ZigForm.ui";

// The kit gallery (com.ziggfreed.common.ui.kit.gallery.KitGalleryPage, /zigkit gallery, owners only): every piece of
// the page kit in every state it can be shown in, with sample words, on the band (@ZigDecoratedFrame), so the look
// is reviewed in one place. The frame's hero is shown, filled by the kit's HeroPainter. Under it a scrolling body
// holds one section per kind of piece: the type (every text style of Common/ZigText.ui and the styles the other kit
// documents name), the tones (state words, fills and pills), the buttons (each look, at rest and switched off; a
// locked button that still answers a press; the switches on, off, unreadable and locked; hover and press by the
// pointer), list rows (the kit's ledger rows in every tone, selected with its gold edge, pinned, tracked, faint, a
// closed section and a capped one; tall and compact rows; notice rows with their one button, ready and switched off),
// view tabs (the game's header tabs, one locked) and segments (choice tiles), the tiles (every tile style and a card
// that is one button, then the kit's figure tiles (one in gold, one whose figure takes the room of a picture it does not
// have), collection, keepsake, item slot, pay slot, chest slot and ware tiles), tier
// cards (open, a daily, one only to be read that never lights gold, and a locked one) and pay marks (full, half, a
// quarter, none), a card, the figures, the reading page (with its progress block, section headers and action bar),
// bullet lines (a long name and a long line each ending in "..."), and an empty state.
// The panel frame (@ZigPanelFrame) is the gallery's second view, Pages/ZigKitGalleryPanel.ui.
//
// Every word is a key of ziggfreedcommon.ui.lang (gallery.*); the static ones are written inline here, the painted
// ones are pushed by the page. Every appended template is painted by its kit painter, which owns its ids; this
// document names only its own hosts and buttons. KitSelectorsTest walks every selector the page sends.

$C.@PageOverlay {}

$F.@ZigDecoratedFrame {
  @CloseButton = true;
  Anchor: (Width: 1200, Height: 900);

  #Content {
    Group #GalleryBar {
      LayoutMode: Left;
      Anchor: (Height: 40, Bottom: 12);

      Group {
        FlexWeight: 1;
      }

      Button #GalleryPanelButton {
        Anchor: (Width: 280, Height: 40);
        Style: $ZS.@ZigButtonSecondaryStyle;

        Label #Label {
          FlexWeight: 1;
          Text: %ziggfreedcommon.ui.gallery.panel.open;
          Style: $ZX.@ZigButtonLabelStyle;
        }
      }
    }

    Group #GalleryBody {
      FlexWeight: 1;
      LayoutMode: TopScrolling;
      ScrollbarStyle: $C.@DefaultScrollbarStyle;
      Padding: (Right: 12);

      // ── Type ──
      Label {
        Anchor: (Height: 32, Bottom: 8);
        Text: %ziggfreedcommon.ui.gallery.head.type;
        Style: $ZX.@ZigHeadStyle;
      }

      Group {
        LayoutMode: Left;
        Anchor: (Height: 44);

        Label {
          Text: %ziggfreedcommon.ui.gallery.text.displaytitle;
          Style: $ZX.@ZigDisplayTitleStyle;
          MaskTexturePath: $C.@TextHighlightGradientMask;
        }
      }

      Group {
        LayoutMode: Left;
        Anchor: (Height: 40);

        Label {
          Text: %ziggfreedcommon.ui.gallery.text.cardtitle;
          Style: $ZX.@ZigCardTitleStyle;
          MaskTexturePath: $C.@TextHighlightGradientMask;
        }
      }

      Label {
        Anchor: (Height: 44);
        Text: %ziggfreedcommon.ui.gallery.text.herotitle;
        Style: $ZX.@ZigHeroTitleStyle;
      }

      Label {
        Anchor: (Height: 32);
        Text: %ziggfreedcommon.ui.gallery.text.title;
        Style: $ZX.@ZigTitleStyle;
      }

      Label {
        Anchor: (Height: 28);
        Text: %ziggfreedcommon.ui.gallery.text.tagline;
        Style: $ZX.@ZigTaglineStyle;
      }

      Label {
        Anchor: (Height: 28);
        Text: %ziggfreedcommon.ui.gallery.text.mark;
        Style: $ZX.@ZigMarkStyle;
      }

      Label {
        Anchor: (Height: 28);
        Text: %ziggfreedcommon.ui.gallery.text.head;
        Style: $ZX.@ZigHeadStyle;
      }

      Label {
        Anchor: (Height: 28);
        Text: %ziggfreedcommon.ui.gallery.text.sectionlabel;
        Style: $ZX.@ZigSectionLabelStyle;
      }

      Label {
        Anchor: (Height: 24);
        Text: %ziggfreedcommon.ui.gallery.text.smallcaps;
        Style: $ZX.@ZigSmallCapsStyle;
      }

      Label {
        Anchor: (Height: 28);
        Text: %ziggfreedcommon.ui.gallery.text.subtitle;
        Style: $ZX.@ZigSubtitleStyle;
      }

      Label {
        Anchor: (Height: 26);
        Text: %ziggfreedcommon.ui.gallery.text.heading;
        Style: $ZX.@ZigHeadingStyle;
      }

      Label {
        Anchor: (Height: 48);
        Text: %ziggfreedcommon.ui.gallery.text.lead;
        Style: $ZX.@ZigLeadStyle;
      }

      Label {
        Anchor: (Height: 26);
        Text: %ziggfreedcommon.ui.gallery.text.rowtitle;
        Style: $ZX.@ZigRowTitleStyle;
      }

      Label {
        Anchor: (Height: 26);
        Text: %ziggfreedcommon.ui.gallery.text.ledgertitle;
        Style: $ZX.@ZigLedgerTitleStyle;
      }

      Label {
        Anchor: (Height: 26);
        Text: %ziggfreedcommon.ui.gallery.text.tilename;
        Style: $ZX.@ZigTileNameStyle;
      }

      Label {
        Anchor: (Height: 26);
        Text: %ziggfreedcommon.ui.gallery.text.bulletname;
        Style: $ZX.@ZigBulletNameStyle;
      }

      Label {
        Anchor: (Height: 26);
        Text: %ziggfreedcommon.ui.gallery.text.bulletline;
        Style: $ZX.@ZigBulletLineStyle;
      }

      Label {
        Anchor: (Height: 24);
        Text: %ziggfreedcommon.ui.gallery.text.body;
        Style: $ZX.@ZigBodyStyle;
      }

      Label {
        Anchor: (Height: 24);
        Text: %ziggfreedcommon.ui.gallery.text.caption;
        Style: $ZX.@ZigCaptionStyle;
      }

      Label {
        Anchor: (Height: 24);
        Text: %ziggfreedcommon.ui.gallery.text.faint;
        Style: $ZX.@ZigFaintStyle;
      }

      Group {
        LayoutMode: Left;
        Anchor: (Height: 40);

        Label #GalFigure {
          Anchor: (Width: 240);
          Text: "";
          Style: $ZX.@ZigFigureStyle;
        }

        Label #GalFigureAccent {
          Anchor: (Width: 240);
          Text: "";
          Style: $ZS.@ZigFigureAccentStyle;
        }

        Label #GalCount {
          Anchor: (Width: 240);
          Text: "";
          Style: $ZX.@ZigCountStyle;
        }
      }

      Label {
        Anchor: (Height: 24, Top: 8);
        Text: %ziggfreedcommon.ui.gallery.text.frametitle;
        Style: $F.@ZigTitleLabelStyle;
      }

      Label {
        Anchor: (Height: 24);
        Text: %ziggfreedcommon.ui.gallery.text.frameheading;
        Style: $F.@ZigHeadingLabelStyle;
      }

      Label {
        Anchor: (Height: 24);
        Text: %ziggfreedcommon.ui.gallery.text.framebody;
        Style: $F.@ZigBodyLabelStyle;
      }

      Label {
        Anchor: (Height: 24);
        Text: %ziggfreedcommon.ui.gallery.text.framecaption;
        Style: $F.@ZigCaptionLabelStyle;
      }

      Label {
        Anchor: (Height: 24, Top: 8);
        Text: %ziggfreedcommon.ui.gallery.text.cardheader;
        Style: $K.@ZigCardHeaderStyle;
      }

      Label {
        Anchor: (Height: 26);
        Text: %ziggfreedcommon.ui.gallery.text.pagetitle;
        Style: $K.@ZigPageTitleStyle;
      }

      Label {
        Anchor: (Height: 24);
        Text: %ziggfreedcommon.ui.gallery.text.pagedescription;
        Style: $K.@ZigPageDescriptionStyle;
      }

      Label {
        Anchor: (Height: 24);
        Text: %ziggfreedcommon.ui.gallery.text.sectionheader;
        Style: $Z.@ZigSectionHeaderStyle;
      }

      Label {
        Anchor: (Height: 24);
        Text: %ziggfreedcommon.ui.gallery.text.formheader;
        Style: $ZM.@ZigFormHeaderStyle;
      }

      Label {
        Anchor: (Height: 24);
        Text: %ziggfreedcommon.ui.gallery.text.formlabel;
        Style: $ZM.@ZigFormLabelStyle;
      }

      Label {
        Anchor: (Height: 24);
        Text: %ziggfreedcommon.ui.gallery.text.formnote;
        Style: $ZM.@ZigFormNoteStyle;
      }

      // ── Tones ──
      Label {
        Anchor: (Height: 32, Top: 20, Bottom: 8);
        Text: %ziggfreedcommon.ui.gallery.head.tones;
        Style: $ZX.@ZigHeadStyle;
      }

      Group {
        LayoutMode: Left;
        Anchor: (Height: 24, Bottom: 8);

        Label {
          Anchor: (Width: 120);
          Text: %ziggfreedcommon.ui.gallery.tone.neutral;
          Style: $ZS.@ZigStateStyle;
        }

        Label {
          Anchor: (Width: 120);
          Text: %ziggfreedcommon.ui.gallery.tone.active;
          Style: $ZS.@ZigStateActiveStyle;
        }

        Label {
          Anchor: (Width: 120);
          Text: %ziggfreedcommon.ui.gallery.tone.collect;
          Style: $ZS.@ZigStateCollectStyle;
        }

        Label {
          Anchor: (Width: 120);
          Text: %ziggfreedcommon.ui.gallery.tone.done;
          Style: $ZS.@ZigStateDoneStyle;
        }

        Label {
          Anchor: (Width: 120);
          Text: %ziggfreedcommon.ui.gallery.tone.live;
          Style: $ZS.@ZigStateLiveStyle;
        }

        Label {
          Anchor: (Width: 120);
          Text: %ziggfreedcommon.ui.gallery.tone.available;
