      Group {
        LayoutMode: Left;
        Anchor: (Bottom: 12);

        Group #GalPaySlots {
          LayoutMode: Left;
          Anchor: (Right: 24);
        }

        Group #GalChestSlots {
          LayoutMode: Left;
        }
      }

      Group #GalWareSections {
        LayoutMode: Top;
        Anchor: (Bottom: 12);
      }

      // ── Tier cards and pay marks ──
      Label {
        Anchor: (Height: 32, Top: 20, Bottom: 8);
        Text: %ziggfreedcommon.ui.gallery.head.tiercards;
        Style: $ZX.@ZigHeadStyle;
      }

      Group #GalTierCards {
        LayoutMode: Left;
        Anchor: (Height: 576, Bottom: 12);
      }

      Label {
        Anchor: (Height: 24, Bottom: 6);
        Text: %ziggfreedcommon.ui.gallery.head.paymarks;
        Style: $ZX.@ZigCaptionStyle;
      }

      Group #GalPayMarks {
        LayoutMode: Left;
        Anchor: (Height: 66, Bottom: 12);
      }

      // ── Cards ──
      Label {
        Anchor: (Height: 32, Top: 20, Bottom: 8);
        Text: %ziggfreedcommon.ui.gallery.head.cards;
        Style: $ZX.@ZigHeadStyle;
      }

      $K.@ZigSectionCard {
        LayoutMode: Left;

        $K.@ZigTile #GalCardTile {}
      }

      // ── Figures ──
      Label {
        Anchor: (Height: 32, Top: 20, Bottom: 8);
        Text: %ziggfreedcommon.ui.gallery.head.figures;
        Style: $ZX.@ZigHeadStyle;
      }

      Group {
        LayoutMode: Left;
        Anchor: (Height: 78, Bottom: 12);

        $ZW.@ZigStat #GalStatPlain {
          @Anchor = (Right: 16);
        }

        $ZW.@ZigStat #GalStatGold {
          @Anchor = (Right: 16);
        }

        $ZW.@ZigStatTwoLine #GalStatTwo {
          @Anchor = (Right: 16);
        }
      }

      // ── Reading page and empty state: the reading page shows the progress block, a section header over each
      // block, every line's tick, the badges, the header toggle and the action bar ──
      Label {
        Anchor: (Height: 32, Top: 20, Bottom: 8);
        Text: %ziggfreedcommon.ui.gallery.head.reading;
        Style: $ZX.@ZigHeadStyle;
      }

      Group {
        Anchor: (Height: 560, Bottom: 12);
        Background: (Color: $ZK.@ZigSurfacePane);

        $ZW.@ZigDetailPage #GalDetail {}
      }

      Label {
        Anchor: (Height: 24, Bottom: 6);
        Text: %ziggfreedcommon.ui.gallery.head.bullets;
        Style: $ZX.@ZigCaptionStyle;
      }

      Group #GalBullets {
        LayoutMode: Top;
        Anchor: (Width: 480, Bottom: 12);
      }

      Label {
        Anchor: (Height: 32, Top: 20, Bottom: 8);
        Text: %ziggfreedcommon.ui.gallery.head.empty;
        Style: $ZX.@ZigHeadStyle;
      }

      Group {
        Anchor: (Height: 300, Bottom: 24);
        Background: (Color: $ZK.@ZigSurfacePane);

        $ZW.@ZigEmptyState #GalEmpty {}
      }
    }
  }
}
