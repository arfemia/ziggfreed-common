        Button #GalTabOn {
          Anchor: (Width: 160, Height: 32, Right: 10);
          Style: $Z.@ZigRichTabBtnStyle;

          Label #Label {
            FlexWeight: 1;
            Text: %ziggfreedcommon.ui.gallery.button.tabon;
