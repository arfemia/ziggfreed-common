      }

      Label {
        Anchor: (Height: 24, Top: 8, Bottom: 6);
        Text: %ziggfreedcommon.ui.gallery.head.compactrows;
        Style: $ZX.@ZigCaptionStyle;
      }

      Group #GalRowsCompact {
        LayoutMode: Top;
      }

      Label {
        Anchor: (Height: 24, Top: 8, Bottom: 6);
        Text: %ziggfreedcommon.ui.gallery.head.notices;
        Style: $ZX.@ZigCaptionStyle;
      }

      Group #GalNotices {
        LayoutMode: Top;
      }

      // ── Tabs and segments ──
      Label {
        Anchor: (Height: 32, Top: 20, Bottom: 8);
        Text: %ziggfreedcommon.ui.gallery.head.tabs;
        Style: $ZX.@ZigHeadStyle;
      }

      Group #GalViews {
        LayoutMode: Left;
        Anchor: (Height: 40, Bottom: 12);
      }

      Group #GalSegments {
        LayoutMode: Left;
        Anchor: (Height: 32, Bottom: 12);
      }

      Group #GalSegmentsTwo {
        LayoutMode: Left;
        Anchor: (Height: 44, Bottom: 12);
      }

      // ── Tiles ──
      Label {
        Anchor: (Height: 32, Top: 20, Bottom: 8);
        Text: %ziggfreedcommon.ui.gallery.head.tiles;
        Style: $ZX.@ZigHeadStyle;
      }

      Group {
        LayoutMode: Left;
        Anchor: (Height: 120, Bottom: 12);

        Button {
          Anchor: (Width: 180, Height: 120, Right: 10);
          Style: $ZS.@ZigTileStyle;
          Padding: (Full: 12);

          Label {
            Text: %ziggfreedcommon.ui.gallery.tile.default;
            Style: (...$ZX.@ZigTileNameStyle, HorizontalAlignment: Center);
          }
        }

        Button {
          Anchor: (Width: 180, Height: 120, Right: 10);
          Style: $ZS.@ZigTileCompleteStyle;
          Padding: (Full: 12);

          Label {
            Text: %ziggfreedcommon.ui.gallery.tile.complete;
            Style: (...$ZX.@ZigTileNameStyle, HorizontalAlignment: Center);
          }
        }

        Button {
          Anchor: (Width: 180, Height: 120, Right: 10);
          Style: $ZS.@ZigTileWarmStyle;
          Padding: (Full: 12);

          Label {
            Text: %ziggfreedcommon.ui.gallery.tile.warm;
            Style: (...$ZX.@ZigTileNameStyle, HorizontalAlignment: Center);
          }
        }

        Button {
          Anchor: (Width: 180, Height: 120, Right: 10);
          Style: $ZS.@ZigTileSelectedStyle;
          Padding: (Full: 12);

          Label {
            Text: %ziggfreedcommon.ui.gallery.tile.selected;
            Style: (...$ZX.@ZigTileNameStyle, HorizontalAlignment: Center);
          }
        }

        Button {
          Anchor: (Width: 180, Height: 120, Right: 10);
          Style: $ZS.@ZigTierCardStyle;
          Padding: (Full: 12);

          Label {
            Text: %ziggfreedcommon.ui.gallery.tile.tiercard;
            Style: (...$ZX.@ZigTileNameStyle, HorizontalAlignment: Center);
          }
        }

        Button {
          Anchor: (Width: 180, Height: 120, Right: 10);
          Style: $ZS.@ZigCardButtonStyle;
          Padding: (Full: 12);

          Label {
            Text: %ziggfreedcommon.ui.gallery.tile.cardbutton;
            Style: (...$ZX.@ZigTileNameStyle, HorizontalAlignment: Center);
          }
        }
      }

      Group #GalStatTiles {
        LayoutMode: LeftWrap;
        Anchor: (Bottom: 12);
      }

      Group #GalCollection {
        LayoutMode: LeftWrap;
        Anchor: (Bottom: 12);
      }

      Group #GalKeepsakes {
        LayoutMode: LeftWrap;
        Anchor: (Bottom: 12);
      }

      Group #GalItemSlots {
        LayoutMode: LeftWrap;
        Anchor: (Bottom: 12);
      }

      Label {
        Anchor: (Height: 24, Bottom: 6);
        Text: %ziggfreedcommon.ui.gallery.head.payslots;
