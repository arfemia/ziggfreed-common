      Group {
        LayoutMode: Left;
        Anchor: (Height: 16, Bottom: 10);
        Padding: (Left: 128);

        Group {
          Anchor: (Width: 112, Height: 16, Right: 8);
          Background: (Color: $ZK.@ZigToneActiveFill);
        }

        Group {
          Anchor: (Width: 112, Height: 16, Right: 8);
          Background: (Color: $ZK.@ZigToneCollectFill);
        }

        Group {
          Anchor: (Width: 112, Height: 16, Right: 8);
          Background: (Color: $ZK.@ZigToneDoneFill);
        }

        Group {
          Anchor: (Width: 112, Height: 16, Right: 8);
          Background: (Color: $ZK.@ZigToneLiveFill);
        }

        Group {
          Anchor: (Width: 112, Height: 16, Right: 8);
          Background: (Color: $ZK.@ZigToneAvailableFill);
        }

        Group {
          Anchor: (Width: 112, Height: 16, Right: 8);
          Background: (Color: $ZK.@ZigToneWaitingFill);
        }

        Group {
          Anchor: (Width: 112, Height: 16, Right: 8);
          Background: (Color: $ZK.@ZigToneBlockedFill);
        }

        Group {
          Anchor: (Width: 112, Height: 16, Right: 8);
          Background: (Color: $ZK.@ZigToneDangerFill);
