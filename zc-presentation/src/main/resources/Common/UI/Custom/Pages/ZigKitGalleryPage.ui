            Style: $ZX.@ZigButtonLabelStyle;
          }
        }

        Button #GalSecondary {
          Anchor: (Width: 200, Height: 40, Right: 10);
          Style: $ZS.@ZigButtonSecondaryStyle;

          Label #Label {
            FlexWeight: 1;
            Text: %ziggfreedcommon.ui.gallery.button.secondary;
            Style: $ZX.@ZigButtonLabelStyle;
          }
        }

        Button #GalCollect {
          Anchor: (Width: 200, Height: 40, Right: 10);
          Style: $ZS.@ZigButtonCollectStyle;

          Label #Label {
            FlexWeight: 1;
            Text: %ziggfreedcommon.ui.gallery.button.collect;
            Style: $ZX.@ZigButtonLabelStyle;
          }
        }

        Button #GalDanger {
          Anchor: (Width: 200, Height: 40, Right: 10);
          Style: $ZS.@ZigButtonDangerStyle;

          Label #Label {
            FlexWeight: 1;
            Text: %ziggfreedcommon.ui.gallery.button.danger;
            Style: $ZX.@ZigButtonLabelStyle;
          }
        }
      }

      Label {
        Anchor: (Height: 24, Bottom: 6);
        Text: %ziggfreedcommon.ui.gallery.head.disabled;
        Style: $ZX.@ZigCaptionStyle;
      }

      Group {
        LayoutMode: Left;
        Anchor: (Height: 40, Bottom: 10);

        Button #GalPrimaryOff {
          Anchor: (Width: 200, Height: 40, Right: 10);
          Style: $ZS.@ZigButtonPrimaryStyle;

          Label #Label {
            FlexWeight: 1;
            Text: %ziggfreedcommon.ui.gallery.button.primary;
            Style: $ZX.@ZigButtonLabelStyle;
          }
        }

        Button #GalSecondaryOff {
          Anchor: (Width: 200, Height: 40, Right: 10);
          Style: $ZS.@ZigButtonSecondaryStyle;

          Label #Label {
            FlexWeight: 1;
            Text: %ziggfreedcommon.ui.gallery.button.secondary;
            Style: $ZX.@ZigButtonLabelStyle;
          }
        }

        Button #GalCollectOff {
          Anchor: (Width: 200, Height: 40, Right: 10);
          Style: $ZS.@ZigButtonCollectStyle;

          Label #Label {
            FlexWeight: 1;
            Text: %ziggfreedcommon.ui.gallery.button.collect;
            Style: $ZX.@ZigButtonLabelStyle;
          }
        }

        Button #GalDangerOff {
          Anchor: (Width: 200, Height: 40, Right: 10);
          Style: $ZS.@ZigButtonDangerStyle;

          Label #Label {
            FlexWeight: 1;
            Text: %ziggfreedcommon.ui.gallery.button.danger;
            Style: $ZX.@ZigButtonLabelStyle;
          }
        }
      }

      Label {
        Anchor: (Height: 24, Bottom: 6);
        Text: %ziggfreedcommon.ui.gallery.head.locked;
        Style: $ZX.@ZigCaptionStyle;
      }

      Group {
        LayoutMode: Left;
        Anchor: (Height: 40, Bottom: 10);

        Button #GalLocked {
          Anchor: (Width: 200, Height: 40, Right: 10);
          Style: $ZS.@ZigButtonLockedStyle;

          Label #Label {
            FlexWeight: 1;
            Text: %ziggfreedcommon.ui.gallery.button.locked;
            Style: $ZS.@ZigButtonLockedLabelStyle;
          }
        }
      }

      Label {
        Anchor: (Height: 24, Bottom: 6);
        Text: %ziggfreedcommon.ui.gallery.head.morebuttons;
        Style: $ZX.@ZigCaptionStyle;
      }

      Group {
        LayoutMode: Left;
        Anchor: (Height: 32, Bottom: 10);

        Button {
          Anchor: (Width: 180, Height: 32, Right: 10);
          Style: $Z.@ZigRichRowBtnStyle;

          Label {
            FlexWeight: 1;
            Text: %ziggfreedcommon.ui.gallery.button.richrow;
            Style: (...$ZX.@ZigBodyStyle, TextColor: $ZK.@ZigInkStrong, HorizontalAlignment: Center);
          }
        }

        Button {
          Anchor: (Width: 180, Height: 32, Right: 10);
          Style: $Z.@ZigRichPrimaryBtnStyle;

          Label {
            FlexWeight: 1;
            Text: %ziggfreedcommon.ui.gallery.button.richprimary;
            Style: (...$ZX.@ZigBodyStyle, TextColor: $ZK.@ZigInkBright, HorizontalAlignment: Center);
          }
        }

        Button {
          Anchor: (Width: 180, Height: 32, Right: 10);
          Style: $Z.@ZigRichOptionBtnStyle;

          Label {
            FlexWeight: 1;
            Text: %ziggfreedcommon.ui.gallery.button.option;
            Style: (...$ZX.@ZigBodyStyle, TextColor: $ZK.@ZigInkStrong, HorizontalAlignment: Start);
