      // ── List rows ──
      Label {
        Anchor: (Height: 32, Top: 20, Bottom: 8);
        Text: %ziggfreedcommon.ui.gallery.head.rows;
        Style: $ZX.@ZigHeadStyle;
      }

      Group #GalRows {
        LayoutMode: Top;
      }

      Label {
        Anchor: (Height: 24, Top: 8, Bottom: 6);
        Text: %ziggfreedcommon.ui.gallery.head.tallrows;
