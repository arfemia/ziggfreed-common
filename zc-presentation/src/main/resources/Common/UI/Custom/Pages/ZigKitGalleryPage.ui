          Style: $ZS.@ZigRowTitleOnSelectedStyle;
        }

        Label {
          Anchor: (Width: 200);
          Text: %ziggfreedcommon.ui.gallery.tone.onselected;
          Style: $ZS.@ZigStateOnSelectedStyle;
        }
      }

      // ── Buttons ──
      Label {
        Anchor: (Height: 32, Top: 20, Bottom: 8);
        Text: %ziggfreedcommon.ui.gallery.head.buttons;
        Style: $ZX.@ZigHeadStyle;
      }

      Group {
        LayoutMode: Left;
        Anchor: (Height: 40, Bottom: 10);

        Button #GalPrimary {
          Anchor: (Width: 200, Height: 40, Right: 10);
          Style: $ZS.@ZigButtonPrimaryStyle;

          Label #Label {
            FlexWeight: 1;
