      Group #GalleryPills {
        LayoutMode: Left;
        Anchor: (Height: 24, Bottom: 10);

        $ZW.@ZigPill #GalPillNeutral {
          @Anchor = (Right: 8);
        }

        $ZW.@ZigPill #GalPillActive {
          @Anchor = (Right: 8);
        }

        $ZW.@ZigPill #GalPillCollect {
          @Anchor = (Right: 8);
        }

        $ZW.@ZigPill #GalPillDone {
          @Anchor = (Right: 8);
        }

        $ZW.@ZigPill #GalPillLive {
          @Anchor = (Right: 8);
        }

        $ZW.@ZigPill #GalPillAvailable {
          @Anchor = (Right: 8);
        }

        $ZW.@ZigPill #GalPillWaiting {
          @Anchor = (Right: 8);
        }

        $ZW.@ZigPill #GalPillBlocked {
          @Anchor = (Right: 8);
        }

        $ZW.@ZigPill #GalPillDanger {
          @Anchor = (Right: 8);
        }
