        Anchor: (Height: 32, Bottom: 10);

        $Z.@ZigRichBtn #GalRich {
          @Anchor = (Width: 220, Right: 10);
          @Height = 32;
        }

        $ZM.@ZigToggle #GalToggleOn {
          @Anchor = (Right: 10);
        }

        $ZM.@ZigToggle #GalToggleOff {
          @Anchor = (Right: 10);
        }

        $ZM.@ZigToggle #GalToggleUnknown {
          @Anchor = (Right: 10);
        }

        $ZM.@ZigToggle #GalToggleLocked {
          @Anchor = (Right: 10);
        }
