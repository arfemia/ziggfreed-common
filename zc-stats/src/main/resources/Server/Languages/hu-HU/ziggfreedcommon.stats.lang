# The player stat store: what each of the library's stats is called, and the /zigstats command family.
# The file name is the key PREFIX: an entry here resolves as ziggfreedcommon.stats.<key>.
# The command.desc.* keys are what the engine's own help resolves a command or an argument through.

mob_kills = Legyőzött Mobok
blocks_broken = Feltört Blokkok
blocks_placed = Lehelyezett Blokkok
items_crafted = Elkészített Tárgyak
items_pickedup = Felvett Tárgyak
npcs_talked = Beszélgetések Karakterekkel
encounters_defeated = Legyőzött Főellenségek
encounter_attempts = Főellenség-harcok
encounters_won = Győzelmek
encounter_best_time = Legjobb idő
encounter_best_share = Legjobb részesedés
encounter_damage_dealt = Sebzés
quests_completed = Teljesített Küldetések
rounds_won = Megnyert Körök
deaths = Halálok
playtime_seconds = Játékidő
objectives_completed = Teljesített Célok

# What each stat counts: the tooltip over its column on Records (a stat's name key with .tip added).
# A tooltip prints a parameter as written, so none of these takes one.
mob_kills.tip = Minden mob, amit legyőztél, a halakkal együtt.
blocks_broken.tip = Minden blokk, amit feltörtél, kivéve a lehelyezetteket.
blocks_placed.tip = Minden blokk, amit lehelyeztél.
items_crafted.tip = Minden tárgy, amit kézzel elkészítettél.
items_pickedup.tip = Minden tárgy, amit felvettél, kivéve a lehelyezett blokkokból valókat.
npcs_talked.tip = Ahányszor beszélgetésbe kezdtél egy karakterrel.
encounters_defeated.tip = Minden főellenség-harc, amelynek megnyerésében segítettél.
encounter_attempts.tip = Minden főellenség-harc, amelyben részt vettél, megnyerted vagy elvesztetted.
encounters_won.tip = Hányszor segítettél legyőzni ezt a főellenséget.
encounter_best_time.tip = A leggyorsabb győzelmed ez ellen a főellenség ellen.
encounter_best_share.tip = A legnagyobb részesedésed egy győzelemből ez ellen a főellenség ellen, 100-ból.
encounter_damage_dealt.tip = A sebzés, amit a győzelmeid során okoztál ennek a főellenségnek.
quests_completed.tip = Minden küldetés, amit leadtál, és a jutalmát felvetted.
rounds_won.tip = Minden minijáték-kör, amelyet megnyertél.
deaths.tip = Hányszor haltál meg.
playtime_seconds.tip = Mennyi időt töltöttél ezen a szerveren.
objectives_completed.tip = A játék saját céljai, amelyeket teljesítettél.

command.desc.family = Egy játékos összegyűjtött statisztikáinak lekérdezése.
command.desc.show = Felsorolja a játékos minden statisztikáját, azzal a kulccsal, amellyel egy feltétel nevezné.
command.desc.arg.player = A lekérdezendő játékos. Alapértelmezés: te.

command.player.needed = Add meg a játékost így: --player=<name>.
command.player.offline = Ez a játékos nincs fenn. A statisztikák csak a világban lévő játékosból olvashatók.
command.show.off = A statisztikák ki vannak kapcsolva ezen a szerveren ($Enabled a mods/ziggfreedcommon/stats.json fájlban).
command.show.none = {0}: még nincs statisztika.
command.show.header = {0} statisztikái ({1, number}):
command.show.row = - {0}: {1, number}
