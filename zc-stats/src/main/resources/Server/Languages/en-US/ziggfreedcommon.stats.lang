# The player stat store: what each of the library's stats is called, and the /zigstats command family.
# The file name is the key PREFIX: an entry here resolves as ziggfreedcommon.stats.<key>.
# The command.desc.* keys are what the engine's own help resolves a command or an argument through.

mob_kills = Mobs Defeated
blocks_broken = Blocks Broken
blocks_placed = Blocks Placed
items_crafted = Items Crafted
items_pickedup = Items Picked Up
npcs_talked = Characters Talked To
encounters_defeated = Bosses Defeated
encounter_attempts = Boss Fights
encounters_won = Wins
encounter_best_time = Best Time
encounter_best_share = Best Share
encounter_damage_dealt = Damage
quests_completed = Quests Completed
rounds_won = Rounds Won
dungeon_runs_started = Dungeon Runs Started
dungeon_runs_completed = Dungeon Runs Cleared
dungeon_runs_failed = Dungeon Runs Failed
deaths = Deaths
playtime_seconds = Playtime
objectives_completed = Objectives Completed

# What each stat counts: the tooltip over its column on Records (a stat's name key with .tip added).
# A tooltip prints a parameter as written, so none of these takes one.
mob_kills.tip = Every mob you have defeated, fish included.
blocks_broken.tip = Every block you have broken, except ones you placed.
blocks_placed.tip = Every block you have placed.
items_crafted.tip = Every item you have crafted by hand.
items_pickedup.tip = Every item you have picked up, except from blocks you placed.
npcs_talked.tip = Every time you have started talking to a character.
encounters_defeated.tip = Every boss fight you have helped win.
encounter_attempts.tip = Every boss fight you have taken part in, won or lost.
encounters_won.tip = How many times you have helped defeat this boss.
encounter_best_time.tip = Your fastest win against this boss.
encounter_best_share.tip = Your biggest share of a win against this boss, out of 100.
encounter_damage_dealt.tip = The damage you have dealt this boss across your wins.
quests_completed.tip = Every quest you have turned in and collected.
rounds_won.tip = Every minigame round you have won.
deaths.tip = How many times you have died.
playtime_seconds.tip = How long you have spent on this server.
objectives_completed.tip = The game's own objectives you have completed.

command.desc.family = Look up the stats a player has gathered.
command.desc.show = List every stat a player holds, by the key a condition would name.
command.desc.arg.player = The player to look up. Defaults to you.

command.player.needed = Name a player with --player=<name>.
command.player.offline = That player is not online. Stats are read from a player who is in the world.
command.show.off = Stats are switched off on this server ($Enabled in mods/ziggfreedcommon/stats.json).
command.show.none = {0} has no stats yet.
command.show.header = {0}'s stats ({1, number}):
command.show.row = - {0}: {1, number}
