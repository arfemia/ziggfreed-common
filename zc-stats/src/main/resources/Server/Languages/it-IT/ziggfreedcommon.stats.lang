# The player stat store: what each of the library's stats is called, and the /zigstats command family.
# The file name is the key PREFIX: an entry here resolves as ziggfreedcommon.stats.<key>.
# The command.desc.* keys are what the engine's own help resolves a command or an argument through.

mob_kills = Mob Sconfitti
blocks_broken = Blocchi Rotti
blocks_placed = Blocchi Piazzati
items_crafted = Oggetti Fabbricati
items_pickedup = Oggetti Raccolti
npcs_talked = Dialoghi con Personaggi
encounters_defeated = Boss Sconfitti
encounter_attempts = Scontri con i boss
encounters_won = Vittorie
encounter_best_time = Miglior tempo
encounter_best_share = Miglior quota
encounter_damage_dealt = Danni
encounter_deathless_wins = Vittorie Senza Morire
encounter_killing_blows = Colpi Finali
encounter_first_win = Prima Vittoria
encounter_wipes = Scontri con i Boss Persi
quests_completed = Missioni Completate
rounds_won = Round Vinti
rounds_played = Round Giocati
dungeon_runs_started = Partite di Dungeon Iniziate
dungeon_runs_completed = Partite di Dungeon Completate
dungeon_runs_failed = Partite di Dungeon Fallite
dungeon_best_time = Completamento Più Veloce
deaths = Morti
playtime_seconds = Tempo di Gioco
objectives_completed = Obiettivi Completati

# What each stat counts: the tooltip over its column on Records (a stat's name key with .tip added).
# A tooltip prints a parameter as written, so none of these takes one.
mob_kills.tip = Ogni mob che hai sconfitto, pesci compresi.
blocks_broken.tip = Ogni blocco che hai rotto, tranne quelli che hai piazzato tu.
blocks_placed.tip = Ogni blocco che hai piazzato.
items_crafted.tip = Ogni oggetto che hai fabbricato a mano.
items_pickedup.tip = Ogni oggetto che hai raccolto, tranne quelli dai blocchi che hai piazzato.
npcs_talked.tip = Ogni volta che hai iniziato a parlare con un personaggio.
encounters_defeated.tip = Ogni scontro con un boss che hai aiutato a vincere.
encounter_attempts.tip = Ogni scontro con un boss a cui hai preso parte, vinto o perso.
encounters_won.tip = Scontri con i boss che hai aiutato a vincere.
encounter_best_time.tip = La tua vittoria più veloce contro questo boss.
encounter_best_share.tip = La tua quota più alta in una vittoria contro questo boss, su 100.
encounter_damage_dealt.tip = I danni che hai inflitto ai boss negli scontri che hai vinto.
encounter_deathless_wins.tip = Scontri con i boss che hai aiutato a vincere senza morire nemmeno una volta.
encounter_killing_blows.tip = Scontri con i boss che hai vinto assestando tu l'ultimo colpo.
encounter_first_win.tip = Quando hai aiutato per la prima volta a sconfiggere questo boss.
encounter_wipes.tip = Scontri con i boss a cui hai preso parte e che hai perso.
quests_completed.tip = Ogni missione che hai consegnato e di cui hai ritirato la ricompensa.
rounds_won.tip = Ogni round di minigioco che hai vinto.
rounds_played.tip = Ogni round di minigioco che hai giocato fino in fondo, vinto o perso.
dungeon_best_time.tip = La tua partita più veloce completata in questo dungeon.
deaths.tip = Quante volte sei morto.
playtime_seconds.tip = Quanto tempo hai passato su questo server.
objectives_completed.tip = Gli obiettivi del gioco che hai completato.

command.desc.family = Cerca le statistiche che un giocatore ha accumulato.
command.desc.show = Elenca ogni statistica di un giocatore, con la chiave che userebbe una condizione.
command.desc.arg.player = Il giocatore da cercare. Predefinito: tu.

command.player.needed = Indica un giocatore con --player=<name>.
command.player.offline = Quel giocatore non è online. Le statistiche si leggono da un giocatore che è nel mondo.
command.show.off = Le statistiche sono disattivate su questo server ($Enabled in mods/ziggfreedcommon/stats.json).
command.show.none = {0} non ha ancora statistiche.
command.show.header = Statistiche di {0} ({1, number}):
command.show.row = - {0}: {1, number}
