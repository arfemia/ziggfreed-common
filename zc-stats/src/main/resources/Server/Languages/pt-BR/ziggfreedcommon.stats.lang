# The player stat store: what each of the library's stats is called, and the /zigstats command family.
# The file name is the key PREFIX: an entry here resolves as ziggfreedcommon.stats.<key>.
# The command.desc.* keys are what the engine's own help resolves a command or an argument through.

mob_kills = Mobs Derrotados
blocks_broken = Blocos Quebrados
blocks_placed = Blocos Colocados
items_crafted = Itens Fabricados
items_pickedup = Itens Coletados
npcs_talked = Conversas com Personagens
encounters_defeated = Chefes Derrotados
encounter_attempts = Lutas de Chefe
encounters_won = Vitórias
encounter_best_time = Melhor Tempo
encounter_best_share = Melhor Parte
encounter_damage_dealt = Dano
encounter_deathless_wins = Vitórias sem Morrer
encounter_killing_blows = Golpes Finais
encounter_first_win = Primeira Vitória
encounter_wipes = Lutas de Chefe Perdidas
quests_completed = Missões Concluídas
rounds_won = Rodadas Vencidas
rounds_played = Rodadas Jogadas
dungeon_runs_started = Partidas de Masmorra Iniciadas
dungeon_runs_completed = Partidas de Masmorra Concluídas
dungeon_runs_failed = Partidas de Masmorra Fracassadas
dungeon_best_time = Conclusão Mais Rápida
deaths = Mortes
playtime_seconds = Tempo de Jogo
objectives_completed = Objetivos Concluídos

# What each stat counts: the tooltip over its column on Records (a stat's name key with .tip added).
# A tooltip prints a parameter as written, so none of these takes one.
mob_kills.tip = Todo mob que você derrotou, peixes incluídos.
blocks_broken.tip = Todo bloco que você quebrou, exceto os que você colocou.
blocks_placed.tip = Todo bloco que você colocou.
items_crafted.tip = Todo item que você fabricou à mão.
items_pickedup.tip = Todo item que você coletou, exceto os de blocos que você colocou.
npcs_talked.tip = Cada vez que você começou a conversar com um personagem.
encounters_defeated.tip = Toda luta de chefe que você ajudou a vencer.
encounter_attempts.tip = Toda luta de chefe de que você participou, vencida ou perdida.
encounters_won.tip = Lutas de chefe que você ajudou a vencer.
encounter_best_time.tip = Sua vitória mais rápida contra este chefe.
encounter_best_share.tip = Sua maior parte numa vitória contra este chefe, de 100.
encounter_damage_dealt.tip = O dano que você causou aos chefes nas lutas que venceu.
encounter_deathless_wins.tip = Lutas de chefe que você ajudou a vencer sem morrer nenhuma vez.
encounter_killing_blows.tip = Lutas de chefe que você venceu dando o último golpe.
encounter_first_win.tip = Quando você ajudou a derrotar este chefe pela primeira vez.
encounter_wipes.tip = Lutas de chefe de que você participou e perdeu.
quests_completed.tip = Toda missão que você entregou e recebeu a recompensa.
rounds_won.tip = Toda rodada de minijogo que você venceu.
rounds_played.tip = Toda rodada de minijogo que você jogou até o fim, vencida ou perdida.
dungeon_best_time.tip = Sua conclusão mais rápida desta masmorra.
deaths.tip = Quantas vezes você morreu.
playtime_seconds.tip = Quanto tempo você passou neste servidor.
objectives_completed.tip = Os objetivos do próprio jogo que você concluiu.

command.desc.family = Consulta as estatísticas que um jogador reuniu.
command.desc.show = Lista cada estatística de um jogador, pela chave que uma condição citaria.
command.desc.arg.player = O jogador a consultar. O padrão é você.

command.player.needed = Indique um jogador com --player=<name>.
command.player.offline = Esse jogador não está online. As estatísticas são lidas de um jogador que está no mundo.
command.show.off = As estatísticas estão desligadas neste servidor ($Enabled em mods/ziggfreedcommon/stats.json).
command.show.none = {0} ainda não tem estatísticas.
command.show.header = Estatísticas de {0} ({1, number}):
command.show.row = - {0}: {1, number}
