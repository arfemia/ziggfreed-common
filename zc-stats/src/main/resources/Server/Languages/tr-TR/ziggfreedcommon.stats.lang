objectives_completed.tip = Tamamladığın oyunun kendi hedefleri.

command.desc.family = Bir oyuncunun topladığı istatistiklere bak.
command.desc.show = Bir oyuncunun tuttuğu her istatistiği, bir koşulun adlandıracağı anahtarla listele.
command.desc.arg.player = Bakılacak oyuncu. Varsayılan sensin.

command.player.needed = --player=<name> ile bir oyuncu belirt.
command.player.offline = O oyuncu çevrimiçi değil. İstatistikler dünyada olan bir oyuncudan okunur.
command.show.off = İstatistikler bu sunucuda kapalı (mods/ziggfreedcommon/stats.json içinde $Enabled).
command.show.none = {0} oyuncusunun henüz istatistiği yok.
command.show.header = {0} oyuncusunun istatistikleri ({1, number}):
