# The player stat store: what each of the library's stats is called, and the /zigstats command family.
# The file name is the key PREFIX: an entry here resolves as ziggfreedcommon.stats.<key>.
# The command.desc.* keys are what the engine's own help resolves a command or an argument through.

mob_kills = Mobs Derrotados
blocks_broken = Bloques Rotos
blocks_placed = Bloques Colocados
items_crafted = Objetos Fabricados
items_pickedup = Objetos Recogidos
npcs_talked = Charlas con Personajes
encounters_defeated = Jefes Derrotados
encounter_attempts = Combates contra Jefes
encounters_won = Victorias
encounter_best_time = Mejor Tiempo
encounter_best_share = Mejor Parte
encounter_damage_dealt = Daño
encounter_deathless_wins = Victorias sin Morir
encounter_killing_blows = Golpes Finales
encounter_first_win = Primera Victoria
encounter_wipes = Combates contra Jefes Perdidos
quests_completed = Misiones Completadas
rounds_won = Rondas Ganadas
rounds_played = Rondas Jugadas
dungeon_runs_started = Partidas de Mazmorra Empezadas
dungeon_runs_completed = Partidas de Mazmorra Superadas
dungeon_runs_failed = Partidas de Mazmorra Falladas
dungeon_best_time = Superación Más Rápida
deaths = Muertes
playtime_seconds = Tiempo de Juego
objectives_completed = Objetivos Completados

# What each stat counts: the tooltip over its column on Records (a stat's name key with .tip added).
# A tooltip prints a parameter as written, so none of these takes one.
mob_kills.tip = Todos los mobs que has derrotado, peces incluidos.
blocks_broken.tip = Todos los bloques que has roto, salvo los que colocaste tú.
blocks_placed.tip = Todos los bloques que has colocado.
items_crafted.tip = Todos los objetos que has fabricado a mano.
items_pickedup.tip = Todos los objetos que has recogido, salvo los de bloques que colocaste tú.
npcs_talked.tip = Todas las veces que has empezado a hablar con un personaje.
encounters_defeated.tip = Todos los combates contra jefes que has ayudado a ganar.
encounter_attempts.tip = Todos los combates contra jefes en los que has participado, ganados o perdidos.
encounters_won.tip = Combates contra jefes que has ayudado a ganar.
encounter_best_time.tip = Tu victoria más rápida contra este jefe.
encounter_best_share.tip = Tu mayor parte en una victoria contra este jefe, sobre 100.
encounter_damage_dealt.tip = El daño que has infligido a jefes en los combates que ganaste.
encounter_deathless_wins.tip = Combates contra jefes que has ayudado a ganar sin morir ni una vez.
encounter_killing_blows.tip = Combates contra jefes que ganaste dando tú el último golpe.
encounter_first_win.tip = Cuándo ayudaste por primera vez a derrotar a este jefe.
encounter_wipes.tip = Combates contra jefes en los que participaste y perdiste.
quests_completed.tip = Todas las misiones que has entregado y cobrado.
rounds_won.tip = Todas las rondas de minijuego que has ganado.
rounds_played.tip = Todas las rondas de minijuego que has jugado hasta el final, ganadas o perdidas.
dungeon_best_time.tip = Tu partida más rápida superada de esta mazmorra.
deaths.tip = Cuántas veces has muerto.
playtime_seconds.tip = Cuánto tiempo has pasado en este servidor.
objectives_completed.tip = Los objetivos propios del juego que has completado.

command.desc.family = Consulta las estadísticas que ha reunido un jugador.
command.desc.show = Lista todas las estadísticas de un jugador, por la clave que nombraría una condición.
command.desc.arg.player = El jugador que se consulta. Por defecto, tú.

command.player.needed = Indica un jugador con --player=<name>.
command.player.offline = Ese jugador no está conectado. Las estadísticas se leen de un jugador que está en el mundo.
command.show.off = Las estadísticas están desactivadas en este servidor ($Enabled en mods/ziggfreedcommon/stats.json).
command.show.none = {0} aún no tiene estadísticas.
command.show.header = Estadísticas de {0} ({1, number}):
command.show.row = - {0}: {1, number}
