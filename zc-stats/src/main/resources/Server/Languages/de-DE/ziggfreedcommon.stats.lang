# The player stat store: what each of the library's stats is called, and the /zigstats command family.
# The file name is the key PREFIX: an entry here resolves as ziggfreedcommon.stats.<key>.
# The command.desc.* keys are what the engine's own help resolves a command or an argument through.

mob_kills = Besiegte Mobs
blocks_broken = Abgebaute Blöcke
blocks_placed = Platzierte Blöcke
items_crafted = Hergestellte Gegenstände
items_pickedup = Aufgesammelte Gegenstände
npcs_talked = Gespräche mit Figuren
encounters_defeated = Besiegte Bosse
encounter_attempts = Bosskämpfe
encounters_won = Siege
encounter_best_time = Beste Zeit
encounter_best_share = Bester Anteil
encounter_damage_dealt = Schaden
encounter_deathless_wins = Siege ohne Tod
encounter_killing_blows = Todesstöße
encounter_first_win = Erster Sieg
encounter_wipes = Verlorene Bosskämpfe
quests_completed = Abgeschlossene Quests
rounds_won = Gewonnene Runden
rounds_played = Gespielte Runden
dungeon_runs_started = Begonnene Dungeon-Läufe
dungeon_runs_completed = Abgeschlossene Dungeon-Läufe
dungeon_runs_failed = Gescheiterte Dungeon-Läufe
dungeon_best_time = Schnellster Abschluss
deaths = Tode
playtime_seconds = Spielzeit
objectives_completed = Abgeschlossene Ziele

# What each stat counts: the tooltip over its column on Records (a stat's name key with .tip added).
# A tooltip prints a parameter as written, so none of these takes one.
mob_kills.tip = Jeder Mob, den du besiegt hast, Fische eingeschlossen.
blocks_broken.tip = Jeder Block, den du abgebaut hast, außer denen, die du platziert hast.
blocks_placed.tip = Jeder Block, den du platziert hast.
items_crafted.tip = Jeder Gegenstand, den du von Hand hergestellt hast.
items_pickedup.tip = Jeder Gegenstand, den du aufgesammelt hast, außer von Blöcken, die du platziert hast.
npcs_talked.tip = Jedes Mal, wenn du ein Gespräch mit einer Figur begonnen hast.
encounters_defeated.tip = Jeder Bosskampf, den du mit gewonnen hast.
encounter_attempts.tip = Jeder Bosskampf, an dem du teilgenommen hast, gewonnen oder verloren.
encounters_won.tip = Bosskämpfe, die du mit gewonnen hast.
encounter_best_time.tip = Dein schnellster Sieg gegen diesen Boss.
encounter_best_share.tip = Dein größter Anteil an einem Sieg gegen diesen Boss, von 100.
encounter_damage_dealt.tip = Der Schaden, den du Bossen in den Kämpfen zugefügt hast, die du gewonnen hast.
encounter_deathless_wins.tip = Bosskämpfe, die du mit gewonnen hast, ohne ein einziges Mal zu sterben.
encounter_killing_blows.tip = Bosskämpfe, die du gewonnen hast, indem du selbst den letzten Treffer gelandet hast.
encounter_first_win.tip = Wann du zum ersten Mal geholfen hast, diesen Boss zu besiegen.
encounter_wipes.tip = Bosskämpfe, an denen du teilgenommen und die du verloren hast.
quests_completed.tip = Jede Quest, die du abgegeben und eingelöst hast.
rounds_won.tip = Jede Minispiel-Runde, die du gewonnen hast.
rounds_played.tip = Jede Minispiel-Runde, die du bis zum Ende gespielt hast, gewonnen oder verloren.
dungeon_best_time.tip = Dein schnellster abgeschlossener Lauf dieses Dungeons.
deaths.tip = Wie oft du gestorben bist.
playtime_seconds.tip = Wie lange du auf diesem Server verbracht hast.
objectives_completed.tip = Die spieleigenen Ziele, die du abgeschlossen hast.

command.desc.family = Sieh nach, welche Statistiken ein Spieler gesammelt hat.
command.desc.show = Liste jede Statistik eines Spielers auf, mit dem Schlüssel, den eine Bedingung nennen würde.
command.desc.arg.player = Der Spieler, den du nachschlägst. Standard bist du.

command.player.needed = Nenne einen Spieler mit --player=<name>.
command.player.offline = Dieser Spieler ist nicht online. Statistiken werden bei einem Spieler gelesen, der in der Welt ist.
command.show.off = Statistiken sind auf diesem Server abgeschaltet ($Enabled in mods/ziggfreedcommon/stats.json).
command.show.none = {0} hat noch keine Statistiken.
command.show.header = Statistiken von {0} ({1, number}):
command.show.row = - {0}: {1, number}
