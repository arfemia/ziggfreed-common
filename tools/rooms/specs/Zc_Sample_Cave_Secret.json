{
  "$Comment": [
    "A sample overlay for build_room.py: a small Magic Ruins cave end walled off by a skill lock. Using the wall with",
    "Mining 30 opens it and counts Secret_Found; anyone short of it is told what opens it (the HintKey). Inside, a",
    "checkpoint statue and a rune order's clue, painted when the room's logic is placed.",
    "Build it with --base-prefabs pointing at vanilla's Server/Prefabs folder. The lang keys are placeholders a pack",
    "replaces with its own."
  ],
  "Id": "Zc_Sample_Cave_Secret",
  "Label": "Sample cave secret",
  "Base": {
    "Prefab": "Dungeon.Magic_Ruins.Structured_Cave.End_Small.Magic_Ruins_Structured_Cave_End_Small_001",
    "Room": "Zc_Kit_Magic_Ruins_Structured_Cave_End_Small"
  },
  "Overlay": "ZiggfreedCommon.Samples.Zc_Sample_Cave_Secret_Overlay",
  "Room": {
    "Roles": ["Room", "Secret"],
    "Tags": {"Secret": ["Mining"]}
  },
  "Logic": [
    {
      "Template": "SkillLock",
      "Lock": [
        {"Min": {"X": -2, "Y": 1, "Z": -1}, "Max": {"X": 1, "Y": 3, "Z": -1}},
        {"Min": {"X": 2, "Y": 2, "Z": -1}, "Max": {"X": 2, "Y": 3, "Z": -1}}
      ],
      "Param": "Level_Mining",
      "Min": 30,
      "HintKey": "server.sample.skill_lock.mining"
    },
    {
      "Template": "Checkpoint",
      "Region": {"Min": {"X": -1, "Y": 1, "Z": -4}, "Max": {"X": 3, "Y": 3, "Z": -3}},
      "Respawn": {"X": 1, "Z": -3, "OnFloor": true},
      "Yaw": 180,
      "TitleKey": "server.sample.checkpoint.title",
      "Statue": {"X": -1, "Z": -3, "OnFloor": true}
    },
    {
      "Template": "RuneClue",
      "Canvas": {"X": -2, "Z": -2, "OnFloor": true},
      "Glyphs": ["Rune_A", "Rune_B", "Rune_C"],
      "Variants": [[0, 1, 2], [2, 0, 1], [1, 2, 0]]
    }
  ]
}
