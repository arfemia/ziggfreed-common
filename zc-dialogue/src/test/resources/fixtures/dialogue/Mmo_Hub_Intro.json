{
  "Name": "mmo_hub_intro",
  "$Comment": "The guide at world spawn, and the same character standing in the Forgotten Temple. Start is declared in sections: the two temple beats outrank everything (the first is played once per instance and credits the meeting, the second is the safety net that can always credit it), the quest rows drive the whole main chain from the quests own state, the two Then beats are the steady state, and menu is the screen of last resort. gather_the_basics writes Ready as true, which sends the player to this characters quest list with that quest highlighted rather than handing it in inside the conversation.",
  "Memories": {
    "temple_greeted": { "Where": { "GameplayConfig": ["ForgottenTemple"] } }
  },
  "Start": {
    "First": [
      {
        "Node": "temple_greet",
        "When": [
          { "Type": "World", "Where": { "GameplayConfig": ["ForgottenTemple"] } },
          { "Type": "NotRemembered", "Memory": "temple_greeted" }
        ]
      },
      {
        "Node": "temple_meet",
        "When": [
          { "Type": "World", "Where": { "GameplayConfig": ["ForgottenTemple"] } },
          { "Type": "QuestState", "Quest": "meet_at_the_temple", "State": "ACTIVE" }
        ]
      }
    ],
    "Quests": {
      "getting_started": { "Offerable": "greet", "Active": "greet" },
      "craft_starter_tools": {
        "Ready": "tools_ready",
        "Offerable": "briefing",
        "Active": "briefing"
      },
      "meet_at_the_temple": { "Ready": "temple_ready" },
      "make_camp": { "Ready": "camp_ready" },
      "home_cooking": { "Ready": "cook_ready" },
      "prove_your_mettle": { "Ready": "mettle_ready" },
      "gather_the_basics": {
        "Ready": true,
        "Offerable": "tools_to_gather",
        "Active": "gather_brief"
      },
      "into_the_fray": { "Offerable": "gather_to_combat", "Active": "combat_brief" },
      "climbing_the_ranks": { "Offerable": "combat_to_ranks", "Active": "ranks_brief" }
    },
    "Then": [
      {
        "Node": "bounty_intro",
        "When": [
          { "Type": "QuestState", "Quest": "craft_starter_tools", "State": "COMPLETED" },
          { "Type": "HasActiveBounties" }
        ]
      },
      {
        "Node": "tools_done",
        "When": [
          { "Type": "QuestState", "Quest": "craft_starter_tools", "State": "COMPLETED" }
        ]
      }
    ],
    "Fallback": "menu"
  },
  "Nodes": {
    "greet": {
      "TextKey": "dialogue.mmo_hub_intro.greet.text",
      "Options": [
        {
          "LabelKey": "dialogue.mmo_hub_intro.greet.opt.learn",
          "Open": "Onboarding"
        },
        {
          "LabelKey": "dialogue.mmo_hub_intro.greet.opt.skip",
          "Do": [
            { "Complete": "getting_started" },
            { "Accept": "craft_starter_tools" },
            { "Goto": "briefing" }
          ]
        }
      ]
    },
    "briefing": {
      "TextKey": "dialogue.mmo_hub_intro.briefing.text",
      "IncludeOptions": ["hub_footer"]
    },
    "tools_ready": {
      "TextKey": "dialogue.mmo_hub_intro.tools_ready.text",
      "Options": [
        {
          "LabelKey": "dialogue.mmo_hub_intro.tools_ready.opt.turnin",
          "Do": [
            { "TurnIn": "craft_starter_tools" },
            { "Goto": "tools_to_gather" }
          ]
        },
        {
          "LabelKey": "dialogue.mmo_hub_intro.opt.quests",
          "Open": { "Type": "Quests", "Npc": "mmo_hub" }
        }
      ],
      "IncludeOptions": ["open_menu"]
    },
    "menu": {
      "TextKey": "dialogue.mmo_hub_intro.menu.text",
      "IncludeOptions": ["hub_footer"]
    },
    "bounty_intro": {
      "TextKey": "dialogue.mmo_hub_intro.bounty_intro.text",
      "Options": [
        {
          "LabelKey": "dialogue.mmo_hub_intro.bounty_intro.opt.hub",
          "Open": "Hub"
        }
      ],
      "IncludeOptions": ["hub_footer"]
    },
    "tools_done": {
      "TextKey": "dialogue.mmo_hub_intro.tools_done.text",
      "IncludeOptions": ["hub_footer"]
    },
    "tools_to_gather": {
      "TextKey": "dialogue.mmo_hub_intro.tools_to_gather.text",
      "Options": [
        {
          "LabelKey": "dialogue.mmo_hub_intro.tools_to_gather.opt.accept",
          "Do": [
            { "Accept": "gather_the_basics" },
            { "Goto": "gather_brief" }
          ]
        }
      ],
      "IncludeOptions": ["open_menu"]
    },
    "gather_brief": {
      "TextKey": "dialogue.mmo_hub_intro.gather_brief.text",
      "IncludeOptions": ["hub_footer"]
    },
    "gather_to_combat": {
      "TextKey": "dialogue.mmo_hub_intro.gather_to_combat.text",
      "Options": [
        {
          "LabelKey": "dialogue.mmo_hub_intro.gather_to_combat.opt.accept",
          "Do": [{ "Accept": "into_the_fray" }, { "Goto": "combat_brief" }]
        }
      ],
      "IncludeOptions": ["open_menu"]
    },
    "combat_brief": {
      "TextKey": "dialogue.mmo_hub_intro.combat_brief.text",
      "IncludeOptions": ["hub_footer"]
    },
    "combat_to_ranks": {
      "TextKey": "dialogue.mmo_hub_intro.combat_to_ranks.text",
      "Options": [
        {
          "LabelKey": "dialogue.mmo_hub_intro.combat_to_ranks.opt.accept",
          "Do": [
            { "Accept": "climbing_the_ranks" },
            { "Goto": "ranks_brief" }
          ]
        }
      ],
      "IncludeOptions": ["open_menu"]
    },
    "ranks_brief": {
      "TextKey": "dialogue.mmo_hub_intro.ranks_brief.text",
      "IncludeOptions": ["hub_footer"]
    },
    "quests_offer": {
      "TextKey": "dialogue.mmo_hub_intro.quests_offer.text",
      "Options": [
        {
          "LabelKey": "dialogue.mmo_hub_intro.odd_jobs.opt.camp",
          "Conditions": [
            {
              "Type": "QuestState",
              "Quest": "make_camp",
              "State": "NOT_STARTED"
            }
          ],
          "Do": [{ "Accept": "make_camp" }, { "Goto": "camp_brief" }]
        },
        {
          "LabelKey": "dialogue.mmo_hub_intro.odd_jobs.opt.mettle",
          "Conditions": [
            {
              "Type": "QuestState",
              "Quest": "prove_your_mettle",
              "State": "NOT_STARTED"
            }
          ],
          "Do": [
            { "Accept": "prove_your_mettle" },
            { "Goto": "mettle_brief" }
          ]
        },
        {
          "LabelKey": "dialogue.mmo_hub_intro.odd_jobs.opt.cook",
          "Conditions": [
            {
              "Type": "QuestState",
              "Quest": "make_camp",
              "State": "COMPLETED"
            },
            {
              "Type": "QuestState",
              "Quest": "home_cooking",
              "State": "NOT_STARTED"
            }
          ],
          "Do": [{ "Accept": "home_cooking" }, { "Goto": "cook_brief" }]
        },
        {
          "LabelKey": "dialogue.mmo_hub_intro.quests_offer.opt.temple",
          "Conditions": [
            {
              "Type": "QuestState",
              "Quest": "meet_at_the_temple",
              "State": "NOT_STARTED"
            }
          ],
          "Do": [
            { "Accept": "meet_at_the_temple" },
            { "Goto": "temple_brief" }
          ]
        },
        {
          "LabelKey": "dialogue.mmo_hub_intro.quests_offer.opt.viewall",
          "Style": "neutral",
          "Open": { "Type": "Quests", "Npc": "mmo_hub" }
        }
      ]
    },
    "camp_brief": {
      "TextKey": "dialogue.mmo_hub_intro.camp_brief.text",
      "IncludeOptions": ["hub_footer"]
    },
    "cook_brief": {
      "TextKey": "dialogue.mmo_hub_intro.cook_brief.text",
      "IncludeOptions": ["hub_footer"]
    },
    "mettle_brief": {
      "TextKey": "dialogue.mmo_hub_intro.mettle_brief.text",
      "IncludeOptions": ["hub_footer"]
    },
    "camp_ready": {
      "TextKey": "dialogue.mmo_hub_intro.camp_ready.text",
      "Options": [
        {
          "LabelKey": "dialogue.mmo_hub_intro.opt.turnin",
          "Do": [{ "TurnIn": "make_camp" }, { "Goto": "quests_offer" }]
        },
        {
          "LabelKey": "dialogue.mmo_hub_intro.opt.quests",
          "Open": { "Type": "Quests", "Npc": "mmo_hub" }
        }
      ],
      "IncludeOptions": ["open_menu"]
    },
    "cook_ready": {
      "TextKey": "dialogue.mmo_hub_intro.cook_ready.text",
      "Options": [
        {
          "LabelKey": "dialogue.mmo_hub_intro.opt.turnin",
          "Do": [{ "TurnIn": "home_cooking" }, { "Goto": "quests_offer" }]
        },
        {
          "LabelKey": "dialogue.mmo_hub_intro.opt.quests",
          "Open": { "Type": "Quests", "Npc": "mmo_hub" }
        }
      ],
      "IncludeOptions": ["open_menu"]
    },
    "mettle_ready": {
      "TextKey": "dialogue.mmo_hub_intro.mettle_ready.text",
      "Options": [
        {
          "LabelKey": "dialogue.mmo_hub_intro.opt.turnin",
          "Do": [
            { "TurnIn": "prove_your_mettle" },
            { "Goto": "quests_offer" }
          ]
        },
        {
          "LabelKey": "dialogue.mmo_hub_intro.opt.quests",
          "Open": { "Type": "Quests", "Npc": "mmo_hub" }
        }
      ],
      "IncludeOptions": ["open_menu"]
    },
    "temple_brief": {
      "TextKey": "dialogue.mmo_hub_intro.temple_brief.text",
      "IncludeOptions": ["hub_footer"]
    },
    "temple_greet": {
      "TextKey": "dialogue.mmo_hub_intro.temple_greet.text",
      "Options": [
        {
          "LabelKey": "dialogue.mmo_hub_intro.temple_greet.opt.hail",
          "Actions": [
            { "Type": "MarkTalked", "Target": "@self" },
            { "Type": "Remember", "Memory": "temple_greeted" },
            { "Type": "Goto", "Node": "temple_talk" }
          ]
        }
      ],
      "IncludeOptions": ["open_menu"]
    },
    "temple_meet": {
      "TextKey": "dialogue.mmo_hub_intro.temple_greet.text",
      "Options": [
        {
          "LabelKey": "dialogue.mmo_hub_intro.temple_greet.opt.hail",
          "Actions": [
            { "Type": "MarkTalked", "Target": "@self" },
            { "Type": "Goto", "Node": "temple_talk" }
          ]
        }
      ],
      "IncludeOptions": ["open_menu"]
    },
    "temple_talk": {
      "TextKey": "dialogue.mmo_hub_intro.temple_talk.text",
      "IncludeOptions": ["open_menu"]
    },
    "temple_ready": {
      "TextKey": "dialogue.mmo_hub_intro.temple_ready.text",
      "Options": [
        {
          "LabelKey": "dialogue.mmo_hub_intro.opt.turnin",
          "Do": [
            { "TurnIn": "meet_at_the_temple" },
            { "Goto": "quests_offer" }
          ]
        },
        {
          "LabelKey": "dialogue.mmo_hub_intro.opt.quests",
          "Open": { "Type": "Quests", "Npc": "mmo_hub" }
        }
      ],
      "IncludeOptions": ["open_menu"]
    }
  },
  "Fragments": {
    "$Comment": "Shared option groups, written once and pulled into a screen with IncludeOptions, which appends them after the screen's own lines. hub_footer is the full footer every steady screen carries: 'I have returned' only while something can be handed in here, then one 'Got any quests?' line written as two mutually exclusive branches (the offer screen when this character has something to give, the quest list otherwise), then 'open menu'. open_menu is that last row alone, for the screens that lead with their own accept or hand-in line.",
    "hub_footer": [
      {
        "LabelKey": "dialogue.mmo_hub_intro.opt.returned",
        "Style": "accept",
        "Conditions": [{ "Type": "HasReadyToTurnIn" }],
        "Open": { "Type": "Quests", "Npc": "mmo_hub" }
      },
      {
        "LabelKey": "dialogue.mmo_hub_intro.opt.quests",
        "Style": "neutral",
        "Conditions": [{ "Type": "HasOfferableQuests" }],
        "Goto": "quests_offer"
      },
      {
        "LabelKey": "dialogue.mmo_hub_intro.opt.quests",
        "Style": "neutral",
        "Conditions": [
          { "Type": "Not", "Of": [{ "Type": "HasOfferableQuests" }] }
        ],
        "Open": { "Type": "Quests", "Npc": "mmo_hub" }
      },
      { "LabelKey": "dialogue.mmo_hub_intro.menu.opt.open", "Open": "Hub" }
    ],
    "open_menu": [
      { "LabelKey": "dialogue.mmo_hub_intro.menu.opt.open", "Open": "Hub" }
    ]
  }
}
