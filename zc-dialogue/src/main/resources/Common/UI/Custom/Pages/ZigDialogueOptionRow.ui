$C = "../Common.ui";
$M = "../Common/ZigButtons.ui";
$ZK = "../Common/ZigTokens.ui";
$ZX = "../Common/ZigText.ui";
$ZW = "../Common/ZigKit.ui";

// One answer line, appended into #OptionsList (see DialoguePage). Its words go on #OptionBtn #Label's
// .TextSpans (ZigRichButton), so a number, a plural or a nested name in an answer reads right. Its button
// tint is overwritten from Java (the answer's DialogueOptionStyle theme, or its Presentation.Color). The picture at its
// start says what the answer DOES (DialogueOptionGlyphs): Java reveals exactly ONE of the hidden
// #Ico* glyphs, because a texture path lives in markup (a "../Common/..." path set from Java does not
// resolve and renders a red X).
//   #IcoTalk      talks on (a Goto)                   #IcoFarewell  says goodbye (a Close)
//   #IcoAccept    takes a quest                       #IcoTurnIn    hands one in
//   #IcoQuest     opens a quest list                  #IcoShop      opens a shop
//   #IcoBoard     opens a board                       #IcoStanding  opens a reputation
//   #IcoBook      opens something to read             #IcoTrophy    opens achievements or records
//   #IcoOpen      opens any other screen              #IcoContinue  the plain arrow, by its token
// The six kind glyphs are white textures from tools/ui/make_ui_textures.py, tinted here; the others are
// the client's own. Every tint is a kit token (Common/ZigTokens.ui): an accept the done tone, a hand-in the active
// tone, talking on the body ink, goodbye the muted ink, and a screen it opens the gold of a lit mark. A
// Presentation.Icon.Item draws instead in #OptPic, the kit's plain picture painted through IconRenderer.applyPlainIcon:
// the item's own icon, with no item tooltip and no rarity square.

Group #DialogueOptionRow {
  LayoutMode: Left;
  Anchor: (Height: 40, Bottom: 4);

  Group #OptIcon {
    Anchor: (Width: 28, Height: 22, Top: 9, Left: 14);
    Group #IcoAccept   { Anchor: (Width: 14, Height: 14, Top: 4, Left: 2); Background: (TexturePath: "../Common/Checkmark.png", Color: $ZK.@ZigToneDoneText); Visible: false; }
    Group #IcoTurnIn   { Anchor: (Width: 14, Height: 14, Top: 4, Left: 2); Background: (TexturePath: "../Common/Checkmark.png", Color: $ZK.@ZigToneActiveText); Visible: false; }
    Group #IcoContinue { Anchor: (Width: 14, Height: 14, Top: 4, Left: 2); Background: (TexturePath: "../Common/ContainerTitleArrow.png", Color: $ZK.@ZigInkBody); Visible: false; }
    Group #IcoOpen     { Anchor: (Width: 14, Height: 14, Top: 4, Left: 2); Background: (TexturePath: "../Common/ContainerTitleArrow.png", Color: $ZK.@ZigMarkLit); Visible: false; }
    Group #IcoFarewell { Anchor: (Width: 14, Height: 14, Top: 4, Left: 2); Background: (TexturePath: "../Common/ClearInputIcon.png", Color: $ZK.@ZigInkMuted); Visible: false; }
    Group #IcoTalk     { Anchor: (Width: 18, Height: 18, Top: 2, Left: 0); Background: (TexturePath: "../Common/Glyphs/Talk.png", Color: $ZK.@ZigInkBody); Visible: false; }
    Group #IcoQuest    { Anchor: (Width: 18, Height: 18, Top: 2, Left: 0); Background: (TexturePath: "../Common/Glyphs/Quest.png", Color: $ZK.@ZigMarkLit); Visible: false; }
    Group #IcoShop     { Anchor: (Width: 18, Height: 18, Top: 2, Left: 0); Background: (TexturePath: "../Common/Glyphs/Bag.png", Color: $ZK.@ZigMarkLit); Visible: false; }
    Group #IcoBoard    { Anchor: (Width: 18, Height: 18, Top: 2, Left: 0); Background: (TexturePath: "../Common/Glyphs/Board.png", Color: $ZK.@ZigMarkLit); Visible: false; }
    Group #IcoStanding { Anchor: (Width: 18, Height: 18, Top: 2, Left: 0); Background: (TexturePath: "../Common/Glyphs/Star.png", Color: $ZK.@ZigMarkLit); Visible: false; }
    Group #IcoBook     { Anchor: (Width: 18, Height: 18, Top: 2, Left: 0); Background: (TexturePath: "../Common/Glyphs/Book.png", Color: $ZK.@ZigMarkLit); Visible: false; }
    Group #IcoTrophy   { Anchor: (Width: 18, Height: 18, Top: 2, Left: 0); Background: (TexturePath: "../Common/Glyphs/Trophy.png", Color: $ZK.@ZigMarkLit); Visible: false; }
    $ZW.@ZigPicture #OptPic {
      @Size = 20;
      @Anchor = (Top: 1, Left: 0);
    }
  }

  Button #OptionBtn {
    FlexWeight: 1;
    Anchor: (Height: 40);
    Padding: (Left: 16);
    Style: $M.@ZigRichOptionBtnStyle;
    Label #Label {
      FlexWeight: 1;
      Text: "";
      Style: (...$ZX.@ZigBodyStyle, TextColor: $ZK.@ZigInkStrong, HorizontalAlignment: Start);
    }
  }
}
