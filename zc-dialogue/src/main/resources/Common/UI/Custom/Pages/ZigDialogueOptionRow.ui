$C = "../Common.ui";
$M = "../Common/ZigButtons.ui";
$ZW = "../Common/ZigKit.ui";

// One answer line, appended into #OptionsList (see DialoguePage). Its button tint is overwritten
// from Java (the answer's DialogueOptionStyle theme, or its Presentation.Color). The picture at its
// start says what the answer DOES (DialogueOptionGlyphs): Java reveals exactly ONE of the hidden
// #Ico* glyphs, because a texture path lives in markup (a "../Common/..." path set from Java does not
// resolve and renders a red X).
//   #IcoTalk      talks on (a Goto)                   #IcoFarewell  says goodbye (a Close)
//   #IcoAccept    takes a quest                       #IcoTurnIn    hands one in
//   #IcoQuest     opens a quest list                  #IcoShop      opens a shop
//   #IcoBoard     opens a board                       #IcoStanding  opens a reputation
//   #IcoBook      opens something to read             #IcoTrophy    opens achievements or records
//   #IcoOpen      opens any other screen              #IcoContinue  the plain arrow, by its token
// The six kind glyphs are white textures from tools/ui/make_ui_textures.py, tinted here; the others are
// the client's own. A Presentation.Icon.Item draws instead in #OptPic, the kit's plain picture painted
// through IconRenderer.applyPlainIcon: the item's own icon, with no item tooltip and no rarity square.

Group #DialogueOptionRow {
  LayoutMode: Left;
  Anchor: (Height: 40, Bottom: 4);

  Group #OptIcon {
    Anchor: (Width: 28, Height: 22, Top: 9, Left: 14);
    Group #IcoAccept   { Anchor: (Width: 14, Height: 14, Top: 4, Left: 2); Background: (TexturePath: "../Common/Checkmark.png", Color: #4aff7f); Visible: false; }
    Group #IcoTurnIn   { Anchor: (Width: 14, Height: 14, Top: 4, Left: 2); Background: (TexturePath: "../Common/Checkmark.png", Color: #5ab0ff); Visible: false; }
    Group #IcoContinue { Anchor: (Width: 14, Height: 14, Top: 4, Left: 2); Background: (TexturePath: "../Common/ContainerTitleArrow.png", Color: #b6c9de); Visible: false; }
    Group #IcoOpen     { Anchor: (Width: 14, Height: 14, Top: 4, Left: 2); Background: (TexturePath: "../Common/ContainerTitleArrow.png", Color: #ffd97a); Visible: false; }
    Group #IcoFarewell { Anchor: (Width: 14, Height: 14, Top: 4, Left: 2); Background: (TexturePath: "../Common/ClearInputIcon.png", Color: #8696a8); Visible: false; }
    Group #IcoTalk     { Anchor: (Width: 18, Height: 18, Top: 2, Left: 0); Background: (TexturePath: "../Common/Glyphs/Talk.png", Color: #b6c9de); Visible: false; }
    Group #IcoQuest    { Anchor: (Width: 18, Height: 18, Top: 2, Left: 0); Background: (TexturePath: "../Common/Glyphs/Quest.png", Color: #ffd97a); Visible: false; }
    Group #IcoShop     { Anchor: (Width: 18, Height: 18, Top: 2, Left: 0); Background: (TexturePath: "../Common/Glyphs/Bag.png", Color: #ffd97a); Visible: false; }
    Group #IcoBoard    { Anchor: (Width: 18, Height: 18, Top: 2, Left: 0); Background: (TexturePath: "../Common/Glyphs/Board.png", Color: #ffd97a); Visible: false; }
    Group #IcoStanding { Anchor: (Width: 18, Height: 18, Top: 2, Left: 0); Background: (TexturePath: "../Common/Glyphs/Star.png", Color: #ffd97a); Visible: false; }
    Group #IcoBook     { Anchor: (Width: 18, Height: 18, Top: 2, Left: 0); Background: (TexturePath: "../Common/Glyphs/Book.png", Color: #ffd97a); Visible: false; }
    Group #IcoTrophy   { Anchor: (Width: 18, Height: 18, Top: 2, Left: 0); Background: (TexturePath: "../Common/Glyphs/Trophy.png", Color: #ffd97a); Visible: false; }
    $ZW.@ZigPicture #OptPic {
      @Size = 20;
      @Anchor = (Top: 1, Left: 0);
    }
  }

  TextButton #OptionBtn {
    FlexWeight: 1;
    Anchor: (Height: 40);
    Padding: (Left: 16);
    Style: $M.@ZigOptionBtnStyle;
  }
}
