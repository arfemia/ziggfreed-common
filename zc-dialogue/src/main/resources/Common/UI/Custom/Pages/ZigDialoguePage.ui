$C = "../Common.ui";
$F = "../Common/ZigFrames.ui";
$ZK = "../Common/ZigTokens.ui";
$ZX = "../Common/ZigText.ui";

// Generic branching NPC dialogue page: the character's name as the band frame's hero, an optional note under it, then
// one scrolling body holding what the character says over the answers the player can give. Answer rows
// (Pages/ZigDialogueOptionRow.ui) are appended from Java, the implicit Farewell row last. Shipped once in
// ziggfreed-common and resolved client-side across the merged asset tree, so any consumer mod that
// opens com.ziggfreed.common.dialogue.page.DialoguePage renders this without shipping its own copy.
// Neutral names (Zig*) avoid colliding with a consumer's own Pages/DialoguePage.ui when both jars are
// installed.
//
// The name is the frame's #Hero (the headline under the game's gold text gradient, over the game's rule), painted
// through com.ziggfreed.common.ui.kit.HeroPainter; a conversation whose character has no name leaves it hidden. The
// frame is 690 high, so with the band's head and foot (78 each) it fits a 1080 screen, and under the hero the body
// holds a one-line text and about ten answers.
//
// Nothing in the body has a fixed height. #TextPanel is as tall as its wrapped words and #OptionsList
// as tall as its rows, both stacked in #Body, the one scroller: a one-line text leaves room for about
// ten answers with no scrollbar, and a long text still reads whole, the body scrolling under it. The
// note under the name (#ActiveQuestHint) wraps onto a second line the same way, over a 22px strut.

$C.@PageOverlay {}
// The band frame, its hero the character's name.
$F.@ZigDecoratedFrame {
  @CloseButton = true;
  Anchor: (Width: 720, Height: 690);

  #Content {
    // Optional note under the name (hidden until a header source the conversation names returns a
    // Message; #HintText is then set from Java): what the player is doing on a quest this character gave.
    Group #ActiveQuestHint {
      LayoutMode: Left;
      Anchor: (Bottom: 8);
      Visible: false;

      Group #HintStrut {
        Anchor: (Width: 0, Height: 22);
      }

      Group #HintIcon {
        Anchor: (Width: 16, Height: 16, Top: 3);
        Background: (TexturePath: "../Common/Glyphs/Quest.png", Color: $ZK.@ZigMarkLit);
      }

      Label #HintText {
        FlexWeight: 1;
        Padding: (Left: 8, Top: 2);
        Text: "";
        Style: (...$ZX.@ZigCaptionStyle, TextColor: $ZK.@ZigInkBody, Wrap: true);
      }
    }

    Group #Body {
      FlexWeight: 1;
      LayoutMode: TopScrolling;
      ScrollbarStyle: $C.@DefaultScrollbarStyle;
      Padding: (Right: 6);

      Group #TextPanel {
        LayoutMode: Top;
        Anchor: (Bottom: 12);
        Background: (TexturePath: "../Common/ContainerPanelPatch.png", Border: 4);
        Padding: (Full: 14);

        Label #NodeText {
          Text: "";
          Style: (...$ZX.@ZigBodyStyle, TextColor: $ZK.@ZigInkStrong, Wrap: true);
        }
      }

      // Decorative divider between the dialogue text and the answers.
      $C.@PanelSeparatorFancy { Anchor: (Bottom: 10); }

      Group #OptionsList {
        LayoutMode: Top;
      }
    }
  }
}
