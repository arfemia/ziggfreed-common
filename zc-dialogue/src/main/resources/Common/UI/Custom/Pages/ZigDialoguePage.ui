$C = "../Common.ui";
$F = "../Common/ZigFrames.ui";
$ZT = "../Common/ZigType.ui";

// Generic branching NPC dialogue page: the character's name, an optional note under it, then one
// scrolling body holding what the character says over the answers the player can give. Answer rows
// (Pages/ZigDialogueOptionRow.ui) are appended from Java, the implicit Farewell row last. Shipped once in
// ziggfreed-common and resolved client-side across the merged asset tree, so any consumer mod that
// opens com.ziggfreed.common.dialogue.page.DialoguePage renders this without shipping its own copy.
// Neutral names (Zig*) avoid colliding with a consumer's own Pages/DialoguePage.ui when both jars are
// installed.
//
// Nothing in the body has a fixed height. #TextPanel is as tall as its wrapped words and #OptionsList
// as tall as its rows, both stacked in #Body, the one scroller: a one-line text leaves room for about
// ten answers with no scrollbar, and a long text still reads whole, the body scrolling under it. The
// note under the name (#ActiveQuestHint) wraps onto a second line the same way, over a 22px strut.

$C.@PageOverlay {}
// Shared decorated frame (top + bottom rune flourishes; no header bar).
$F.@ZigDecoratedFrame {
  @CloseButton = true;
  Anchor: (Width: 720, Height: 640);

  #Content {
    Label #NpcName {
      Text: "";
      Anchor: (Height: 30, Bottom: 6);
      Style: (FontSize: $ZT.@ZigFontTitle, TextColor: #ffd97a, RenderBold: true);
    }

    // Optional note under the name (hidden until a header source the conversation names returns a
    // Message; #HintText is then set from Java): what the player is doing on a quest this character gave.
    Group #ActiveQuestHint {
      LayoutMode: Left;
      Anchor: (Bottom: 8);
      Visible: false;

      Group #HintStrut {
        Anchor: (Width: 0, Height: 22);
      }

      Group #HintIcon {
        Anchor: (Width: 16, Height: 16, Top: 3);
        Background: (TexturePath: "../Common/Glyphs/Quest.png", Color: #ffd97a);
      }

      Label #HintText {
        FlexWeight: 1;
        Padding: (Left: 8, Top: 2);
        Text: "";
        Style: (FontSize: $ZT.@ZigFontCaption, TextColor: #b6c9de, Wrap: true);
      }
    }

    Group { Anchor: (Height: 1, Bottom: 10); Background: #1e2a36; }

    Group #Body {
      FlexWeight: 1;
      LayoutMode: TopScrolling;
      ScrollbarStyle: $C.@DefaultScrollbarStyle;
      Padding: (Right: 6);

      Group #TextPanel {
        LayoutMode: Top;
        Anchor: (Bottom: 12);
        Background: (TexturePath: "../Common/ContainerPanelPatch.png", Border: 4);
        Padding: (Full: 14);

        Label #NodeText {
          Text: "";
          Style: (FontSize: $ZT.@ZigFontBody, TextColor: #d7e4f0, Wrap: true);
        }
      }

      // Decorative divider between the dialogue text and the answers.
      $C.@PanelSeparatorFancy { Anchor: (Bottom: 10); }

      Group #OptionsList {
        LayoutMode: Top;
      }
    }
  }
}
