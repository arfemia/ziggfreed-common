$C = "../Common.ui";
$F = "../Common/ZigFrames.ui";
$ZK = "../Common/ZigTokens.ui";
$ZX = "../Common/ZigText.ui";
$ZS = "../Common/ZigStyles.ui";
$ZW = "../Common/ZigKit.ui";

// The Almanac (com.ziggfreed.common.almanac.page.AlmanacPage): every season this server runs on the left, the
// one being read on the right, inside the shared menu frame (its rail first, the Almanac tab selected; the frame
// owns the size, the padding and the close button). page/AlmanacLayout holds this document's numbers and
// AlmanacPageDocumentTest holds the two together, and every id the page addresses.
//
// LEFT (#LeftColumn, 300): the title and its lead; #BannerCard, the cross-season achievement (hidden until one is
// in circulation or earned); #SeasonList, where the kit's LedgerPainter appends a section per group (On now, then
// All seasons) of Pages/ZigLedgerRowTall.ui rows (the kit's tall row, so a season's meta line runs onto a second
// line); #Glance, the year at a glance, twelve month rows each holding one
// Pages/ZigAlmanacMonthMark.ui dot per season running that month (a click opens the first); #RecordCard, seasons
// taken part in and keepsakes earned, under the list.
//
// RIGHT (#RightColumn, 962): the kit's hero plate #Hero (art, or a hero composed from item pictures appended onto
// its #HeroItems, or the season's own picture; then the chip, the name, the dates, a monthly or weekly season's next
// run on #HeroNext, and the accent strip), over
// #SeasonBody, which scrolls: the flavor, then #Sections, where the page appends one template per part in the
// order the season's page writes them (Pages/ZigAlmanacTallies.ui, Pages/ZigAlmanacKeepsakes.ui,
// Pages/ZigAlmanacAchievements.ui, Pages/ZigAlmanacLinks.ui, Pages/ZigAlmanacBanner.ui,
// Pages/ZigAlmanacCollection.ui), each addressed #Sections[i] #Id.
//
// #AlmanacEmpty takes the right column's place, and the list's, when no season is listed. Every pick (a season,
// a year, a month) reopens the page, so every build is a full one.

// One month row of the year at a glance: the month's short name, then its marks. A click opens the first season
// marked there.
@AlmanacMonth = Button {
  Anchor: (Height: 22);
  LayoutMode: Left;
  Padding: (Horizontal: $ZK.@ZigSpace2);
  Style: $ZS.@ZigSectionHeadStyle;

  Label #Label {
    Anchor: (Width: 48, Height: 22);
    Text: "";
    Style: $ZX.@ZigCaptionStyle;
  }

  Group #Marks {
    FlexWeight: 1;
    LayoutMode: Left;
    Anchor: (Height: 22);
  }
};

$C.@PageOverlay {}

$F.@ZigMenuFrame {
  #Content {
    Group #LeftColumn {
      Anchor: (Width: 300);
      LayoutMode: Top;
      Padding: (Full: 12);

      Label #AlmanacTitle {
        Anchor: (Height: 28, Bottom: 4);
        Text: "";
        Style: (...$ZX.@ZigTitleStyle, VerticalAlignment: Center, WrapMaxLines: 1);
      }

      Label #AlmanacLead {
        Anchor: (Height: 34, Bottom: 12);
        Text: "";
        Style: (...$ZX.@ZigCaptionStyle, VerticalAlignment: Start, Wrap: true, WrapMaxLines: 2);
      }

      Group #BannerCard {
        Anchor: (Height: 84, Bottom: 12);
        LayoutMode: Left;
        Padding: (Full: $ZK.@ZigSpace3);
        Background: (Color: $ZK.@ZigSurfaceRow);
        Visible: false;

        $ZW.@ZigPicture #BannerPic {
          @Size = $ZK.@ZigPicTile;
          @Anchor = (Top: 10, Right: $ZK.@ZigSpace3);
        }

        Group #BannerText {
          FlexWeight: 1;
          LayoutMode: Top;

          Label #BannerName {
            Anchor: (Height: 22);
            Text: "";
            Style: (...$ZX.@ZigRowTitleStyle, TextColor: $ZK.@ZigAccent);
          }

          Label #BannerMeta {
            Anchor: (Height: 18);
            Text: "";
            Style: (...$ZX.@ZigCaptionStyle, Wrap: true, WrapMaxLines: 1);
          }

          $ZW.@ZigProgressBar #BannerBar {
            @Height = 4;
            @Anchor = (Top: $ZK.@ZigSpace2);
          }
        }
      }

      Group #SeasonList {
        FlexWeight: 1;
        LayoutMode: TopScrolling;
        ScrollbarStyle: $C.@DefaultScrollbarStyle;
        Padding: (Right: 4);
      }

      Group #Glance {
        Anchor: (Height: 288, Top: 12);
        LayoutMode: Top;

        Label #GlanceTitle {
          Anchor: (Height: 24);
          Text: "";
          Style: $ZX.@ZigSectionLabelStyle;
        }

        @AlmanacMonth #Month1 {}
        @AlmanacMonth #Month2 {}
        @AlmanacMonth #Month3 {}
        @AlmanacMonth #Month4 {}
        @AlmanacMonth #Month5 {}
        @AlmanacMonth #Month6 {}
        @AlmanacMonth #Month7 {}
        @AlmanacMonth #Month8 {}
        @AlmanacMonth #Month9 {}
        @AlmanacMonth #Month10 {}
        @AlmanacMonth #Month11 {}
        @AlmanacMonth #Month12 {}
      }

      Group #RecordCard {
        Anchor: (Height: 100, Top: 12);
        LayoutMode: Top;
        Padding: (Top: 8, Bottom: 8, Horizontal: $ZK.@ZigSpace3);
        Background: (Color: $ZK.@ZigSurfaceRow);

        Label #RecordTitle {
          Anchor: (Height: 18, Bottom: 2);
          Text: "";
          Style: $ZX.@ZigSectionLabelStyle;
        }

        Group #RecordFigures {
          LayoutMode: Left;
          Anchor: (Height: 64);

          Group #RecordSeasons {
            FlexWeight: 1;
            LayoutMode: Top;

            Label #RecordSeasonsValue {
              Anchor: (Height: 28);
              Text: "";
              Style: (...$ZX.@ZigFigureStyle, HorizontalAlignment: Start);
            }

            Label #RecordSeasonsLabel {
              Anchor: (Height: 34);
              Text: "";
              Style: (...$ZX.@ZigCaptionStyle, VerticalAlignment: Start, Wrap: true, WrapMaxLines: 2);
            }
          }

          Group #RecordKeepsakes {
            FlexWeight: 1;
            LayoutMode: Top;
            Anchor: (Left: $ZK.@ZigSpace2);

            Label #RecordKeepsakesValue {
              Anchor: (Height: 28);
              Text: "";
              Style: (...$ZX.@ZigFigureStyle, HorizontalAlignment: Start);
            }

            Label #RecordKeepsakesLabel {
              Anchor: (Height: 34);
              Text: "";
              Style: (...$ZX.@ZigCaptionStyle, VerticalAlignment: Start, Wrap: true, WrapMaxLines: 2);
            }
          }
        }
      }
    }

    Group #RightColumn {
      Anchor: (Width: 962, Left: 12);
      LayoutMode: Top;

      $ZW.@ZigHeroPlate #Hero {}

      Group #SeasonBody {
        FlexWeight: 1;
        LayoutMode: TopScrolling;
        ScrollbarStyle: $C.@DefaultScrollbarStyle;
        Padding: (Left: 24, Right: 32, Top: 16, Bottom: 16);

        Label #Flavor {
          Anchor: (Bottom: $ZK.@ZigSpace4);
          Text: "";
          Visible: false;
          Style: (...$ZX.@ZigLeadStyle, WrapMaxLines: 3);
        }

        Group #Sections {
          LayoutMode: Top;
        }
      }
    }

    $ZW.@ZigEmptyState #AlmanacEmpty {
      Visible: false;
      FlexWeight: 1;
      Anchor: (Left: 12);
    }
  }
}
