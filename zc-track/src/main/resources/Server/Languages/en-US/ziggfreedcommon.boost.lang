# What a boost says. The file name is the key PREFIX: an entry here resolves as ziggfreedcommon.boost.<key>.

# What a boost is called when its file names no title of its own.
name.personal = Boost
name.server = Server Boost

# What a boost lifts, when it names one track or category: that name. {0} the first one it names.
target.all = everything
target.none = nothing
target.more = {0} and more

# A length of time. {0} the hours, minutes or seconds, {1} the minutes or seconds after it.
time.hours = {0, number}h {1, number}m
time.hours_only = {0, number}h
time.minutes = {0, number}m {1, number}s
time.minutes_only = {0, number}m
time.seconds = {0, number}s

# A boost starting. {0} the boost, {1} its percent, {2} what it lifts, {3} how long it runs.
started.personal = {0} has started: +{1, number}% {2} for {3}.
started.server = {0} has started for everyone: +{1, number}% {2} for {3}.

# A Boost reward in a reward list. {0} its percent, {1} what it lifts, {2} how long it runs.
reward.line = +{0, number}% {1} for {2}

# Why a boost did not start. {0} the boost; in refused.cooldown {1} how long is left; in the two full lines {0}
# the most that may run at once.
refused.unknown = That boost is not on this server.
refused.standing = {0} is always on, so there is nothing to start.
refused.untimed = {0} has no length, so it cannot be started.
refused.season = {0} is not running right now.
refused.locked = You do not meet what {0} needs yet.
refused.not_live = Your boosts could not be read just now. Try again in a moment.
refused.cooldown = You can start {0} again in {1}.
refused.stack = {0} is already running as many times as it can.
refused.personal_full = You already have {0, number} {0, plural, one {boost} other {boosts}} running, the most you can have at once.
refused.server_full = The server already has {0, number} {0, plural, one {boost} other {boosts}} running, the most it can have at once.
refused.needs_player = {0} lifts one player, so it has to be started by a player.

# A boost token's tooltip, when the token carries its own numbers. {0} what it starts, as a reward reads.
token.description = Use it to start {0}.

# The library's boost token item (Zig_Boost_Token), before a token's own tooltip line says what it starts.
item.name = Boost Token
item.description = Hold right-click to use it and start the boost it carries.

# A boost reward that could not start yet. {0} the boost.
waits = {0} could not start yet, so it is waiting in your Claims.

# A Claim's title. {0} the boost.
claim.waiting = {0}
claim.reward = {0}

# /zigboost, the admin family. The command.desc.* keys are what the engine's own help resolves a command or an
# argument's description from.
command.desc.family = Start boosts for players, give boost tokens, or start a boost of your own.
command.desc.start = Start a boost for a player, the way a boost item would.
command.desc.arg.player = The player, who has to be online. Defaults to you.
command.desc.arg.boost = The boost, by its id.
command.desc.arg.percent = How much it lifts by, as a percent, in place of the boost's own.
command.desc.arg.seconds = How long it runs, in seconds, in place of the boost's own.
command.desc.arg.track = The one track it lifts, out of those the boost lifts. Leave it out for all of them.
command.player.needed = Name a player with --player=<name>.
command.player.offline = That player is not in a world right now. Try again in a moment.
command.boost.needed = Name a boost with --boost=<id>.
# In command.start.done {0} is the boost and {1} the player; in command.start.refused {0} is the player.
command.start.done = Started {0} for {1}.
command.start.refused = Could not start that boost for {0}.
command.desc.give = Give a player boost tokens that start a boost when used.
command.desc.arg.quantity = How many tokens, up to one full stack. Defaults to 1.
# In command.give.done {0} is how many, {1} the boost and {2} the player.
command.give.done = Gave {0, number} {0, plural, one {token} other {tokens}} for {1} to {2}.
command.give.unknown = That boost is not on this server, or it runs on its own, so no token can start it.
command.give.refused = Could not give {0} the tokens. Their bag may be full, and nothing landed at their feet.
command.desc.own = Start a boost you may start yourself, or list them.
command.desc.arg.own = The boost, by its id. Leave it out to list the boosts you may start.
command.own.needs_player = Only a player can start a boost of their own.
command.own.none = There is no boost you can start yourself right now.
command.own.list = Boosts you can start with /zigboost own --boost=<id>:
# In command.own.line {0} is the boost and {1} its id; in command.own.line_wait {2} is how long is left.
command.own.line = {0} ({1})
command.own.line_wait = {0} ({1}), ready again in {2}
command.own.refused = That boost did not start.
# The boost settings screen on the owner menu (OwnerForms/Boost_Settings.json), which edits boost-settings.json.
form.settings.title = Boost Settings
form.settings.desc = How boosts add up, how many can run at once, and when your start command runs.
form.settings.heading.stacking = Adding up
form.settings.cap = Cap, as a percent
form.settings.cap.hint = The most every boost on one track adds up to. Zero turns every boost off. A mod's own bonus does not count toward it.
form.settings.highest = Strongest only
form.settings.highest.hint = On counts only the strongest server boost and the strongest personal one on a track, added together.
form.settings.heading.limits = How many can run
form.settings.personal = Personal boosts
form.settings.personal.hint = How many boosts one player can have running at once. Zero lets nobody start one.
form.settings.server = Server boosts
form.settings.server.hint = How many server boosts can run at once. Zero lets nobody start one.
form.settings.heading.start = When a boost starts
form.settings.start.note = A server command of your own that runs as the console whenever any mod's boost starts: an announcement, a webhook, a reward. Write the command itself in boost-settings.json, under Default, OnStart, Command; this screen only switches it and says when it runs.
form.settings.start.on = Run your command
form.settings.start.on.hint = On runs the command from boost-settings.json each time a boost starts.
form.settings.start.personal = On personal boosts
form.settings.start.personal.hint = Run it when a player's own boost starts.
form.settings.start.server = On server boosts
form.settings.start.server.hint = Run it when a server boost starts.
form.settings.start.replaces = Replaces the announcement
form.settings.start.replaces.hint = On keeps the usual line to everyone off when a server boost starts, for a command that announces it instead.
# The boost templates screen on the owner menu (OwnerForms/Boost_Templates.json), which edits boosts.json one boost
