# give.own.personal and give.own.server {0} is what the boost gives on its own, as a reward reads; in
# give.bad_percent and give.bad_minutes {0} is the most it can be.
form.templates.title = Boost Templates
form.templates.desc = The boosts players can switch on themselves
form.templates.enabled = Switched on
form.templates.enabled.hint = On unless you switch it off. Off takes the boost away: nobody can start it, and one already running stops.
form.templates.heading.gives = What it gives
form.templates.percent = Percent more
form.templates.percent.hint = How much more every gain on what it lifts earns while it runs. 50 is half as much again, 100 doubles it.
form.templates.seconds = Length, in seconds
form.templates.seconds.hint = How long it runs once started. 1800 is half an hour.
form.templates.heading.stack = Starting it again
form.templates.cooldown = Wait, in seconds
form.templates.cooldown.hint = How long a player waits after starting it before they can start it again. Zero is no wait.
form.templates.max = Running at once
form.templates.max.hint = How many of it can run at once for one player, or for the server when it is a server boost. Zero sets no limit of its own.
