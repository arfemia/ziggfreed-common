$C = "../Common.ui";
$F = "../Common/ZigFrames.ui";
$ZK = "../Common/ZigTokens.ui";
$ZX = "../Common/ZigText.ui";
$ZW = "../Common/ZigKit.ui";

// A player's stances (com.ziggfreed.common.track.stance.StancePage), built from the kit's pieces the way the tree page
// is.
//
// TOP, #StanceHeader: the stance's picture (#StancePic), its name (#StanceName), a line on what it is for
// (#StanceLead), and two kit figures, the slots open (#SlotsOpen) and the faces held (#FacesHeld).
//
// #StanceTabs: the kit's view tabs (Pages/ZigViewTab.ui, appended by ViewTabPainter), one per stance shown. A thin rule
// (#TabRule) under them.
//
// LEFT, #LeftPanel (450 wide): #StanceList, the kit's list (LedgerPainter): the slots, then a section per kind of face
// with the faces the player owns.
//
// RIGHT, #RightPanel: #Page, the kit's reading page (@ZigDetailPage, painted by DetailPainter): what a face adds while
// held and what holding and releasing it cost, Hold and Release in its action bar; a slot's state and what opens it.
// #PageEmpty, the kit's empty state, in its place when there is nothing to read. The page never spells a template's
// child ids: the kit's painters own them.

$C.@PageOverlay {}

$F.@ZigDecoratedFrame {
  @CloseButton = true;
  @Ornaments = true;
  Anchor: (Width: 1160, Height: 850);

  #Content {
    Anchor: (Top: 0);
    LayoutMode: Top;

    Group #StanceHeader {
      LayoutMode: Left;
      Anchor: (Height: 64, Bottom: $ZK.@ZigSpace2);

      $ZW.@ZigPicture #StancePic {
        @Size = $ZK.@ZigPicHeader;
        @Anchor = (Top: 8, Right: $ZK.@ZigSpace3);
      }

      Group #StanceHeadText {
        FlexWeight: 1;
        LayoutMode: Top;

        Label #StanceName {
          Anchor: (Height: 28);
          Text: "";
          Style: (...$ZX.@ZigTitleStyle, WrapMaxLines: 1);
        }

        Label #StanceLead {
          Anchor: (Height: 18);
          Text: "";
          Style: (...$ZX.@ZigCaptionStyle, Wrap: true, WrapMaxLines: 1);
        }
      }

      $ZW.@ZigStat #SlotsOpen {}

      $ZW.@ZigStat #FacesHeld {
        @Anchor = (Left: $ZK.@ZigSpace3);
      }
    }

    Group #StanceTabs {
      LayoutMode: Left;
      Anchor: (Height: 40);
    }

    Group #TabRule {
      Anchor: (Height: 1, Bottom: $ZK.@ZigSpace2);
      Background: (Color: $ZK.@ZigDivider);
    }

    Group #StanceBody {
      FlexWeight: 1;
      LayoutMode: Left;

      Group #LeftPanel {
        Anchor: (Width: 450);
        Background: (TexturePath: "../Common/ContainerPanelPatch.png", Border: 4);
        LayoutMode: Top;
        Padding: (Full: $ZK.@ZigSpace3);

        Group #StanceList {
          FlexWeight: 1;
          LayoutMode: TopScrolling;
          ScrollbarStyle: $C.@DefaultScrollbarStyle;
          Padding: (Right: $ZK.@ZigSpace2);
        }
      }

      Group #RightPanel {
        FlexWeight: 1;
        LayoutMode: Top;
        Padding: (Horizontal: 35, Vertical: $ZK.@ZigSpace2);

        $ZW.@ZigDetailPage #Page {
          FlexWeight: 1;
        }

        $ZW.@ZigEmptyState #PageEmpty {
          FlexWeight: 1;
          Visible: false;
        }
      }
    }
  }
}
