$C = "../Common.ui";
$F = "../Common/ZigFrames.ui";
$M = "../Common/ZigButtons.ui";
$ZT = "../Common/ZigType.ui";

// The generic leaderboard page (com.ziggfreed.common.instance.leaderboard.LeaderboardPage) on the shared
// menu's rail: the page builds from this document instead of Pages/ZigLeaderboardPage.ui when its deps
// name a rail tab (LeaderboardPageDeps.menuTab), as the encounter board's Records does. A board with no
// tab keeps the standalone document and its own 860 x 700 frame.
//
// The frame's rail comes first (ui/menu/ZigMenu paints it, with the deps' tab selected), then ONE column
// holding exactly the standalone document's body: the same elements, the same ids, the same order
// (LeaderboardMenuDocumentTest holds the two one for one, since the page addresses either with the same
// commands). Change the body in both documents together. The frame owns the size, the padding and the
// close button.

$C.@PageOverlay {}

$F.@ZigMenuFrame {
  #Content {
    Group {
      FlexWeight: 1;
      LayoutMode: Top;
      Padding: (Full: 18);

      Label #Title {
        Text: "";
        Anchor: (Height: 30, Bottom: 8);
        Style: (FontSize: $ZT.@ZigFontTitle, TextColor: #ffd97a, RenderBold: true);
      }

      // "Which leaderboard" selectors: a primary axis (difficulty) over a secondary axis (party size),
      // each with a leading label so the row's purpose is unambiguous.
      Group #GroupRow {
        LayoutMode: Left;
        Anchor: (Height: 34, Bottom: 6);
        Label #GroupLabel { Anchor: (Width: 84); Padding: (Left: 2); Visible: false; Text: ""; Style: (FontSize: $ZT.@ZigFontBody, TextColor: #8696a8, VerticalAlignment: Center); }
        Group #GroupBar { FlexWeight: 1; LayoutMode: Left; }
      }

      Group #TabRow {
        LayoutMode: Left;
        Anchor: (Height: 34, Bottom: 8);
        Label #TabLabel { Anchor: (Width: 84); Padding: (Left: 2); Visible: false; Text: ""; Style: (FontSize: $ZT.@ZigFontBody, TextColor: #8696a8, VerticalAlignment: Center); }
        Group #TabBar { FlexWeight: 1; LayoutMode: Left; }
      }

      // Divider: separates "which leaderboard" (above) from "how it is shown" (below).
      Group { Anchor: (Height: 1, Bottom: 8); Background: #1e2a36; }

      // "How it is shown" controls: the sort metric (left) and the Rankings/Stats view (right edge).
      Group #ControlBar {
        LayoutMode: Left;
        Anchor: (Height: 30, Bottom: 10);

        Label #SortLabel { Anchor: (Width: 48); Padding: (Left: 2); Visible: false; Text: ""; Style: (FontSize: $ZT.@ZigFontBody, TextColor: #8696a8, VerticalAlignment: Center); }
        Group #SortGroup {
          LayoutMode: Left;
          FlexWeight: 1;
          TextButton #SortBest  { Anchor: (Width: 108, Right: 6); Text: ""; Style: $M.@ZigTabBtnStyle; }
          TextButton #SortTotal { Anchor: (Width: 108, Right: 6); Text: ""; Style: $M.@ZigTabBtnStyle; }
          TextButton #SortTime  { Anchor: (Width: 108, Right: 6); Text: ""; Style: $M.@ZigTabBtnStyle; }
        }

        Label #ViewLabel { Anchor: (Width: 44); Text: ""; Visible: false; Style: (FontSize: $ZT.@ZigFontBody, TextColor: #8696a8, VerticalAlignment: Center, HorizontalAlignment: End); }
        Group #ViewGroup {
          LayoutMode: Left;
          Anchor: (Width: 226);
          TextButton #ViewRankings { Anchor: (Width: 108, Right: 6); Text: ""; Style: $M.@ZigTabBtnStyle; }
          TextButton #ViewStats    { Anchor: (Width: 108);          Text: ""; Style: $M.@ZigTabBtnStyle; }
        }
      }

      // Rankings column header.
      Group #TableHeader {
        LayoutMode: Left;
        Anchor: (Height: 22, Bottom: 4);
        Label #HdrRank   { Anchor: (Width: 48);  Padding: (Left: 10); Text: ""; Style: (FontSize: $ZT.@ZigFontSection, TextColor: #8696a8, VerticalAlignment: Center); }
        Label #HdrPlayer { FlexWeight: 1;        Padding: (Left: 4);  Text: ""; Style: (FontSize: $ZT.@ZigFontSection, TextColor: #8696a8, VerticalAlignment: Center); }
        Label #HdrTotal  { Anchor: (Width: 100); Text: ""; Style: (FontSize: $ZT.@ZigFontSection, TextColor: #8696a8, VerticalAlignment: Center, HorizontalAlignment: End); }
        Label #HdrScore  { Anchor: (Width: 90);  Text: ""; Style: (FontSize: $ZT.@ZigFontSection, TextColor: #8696a8, VerticalAlignment: Center, HorizontalAlignment: End); }
        Label #HdrTime   { Anchor: (Width: 70);  Text: ""; Style: (FontSize: $ZT.@ZigFontSection, TextColor: #8696a8, VerticalAlignment: Center, HorizontalAlignment: End); }
        Label #HdrPlays  { Anchor: (Width: 60);  Padding: (Right: 10); Text: ""; Style: (FontSize: $ZT.@ZigFontSection, TextColor: #8696a8, VerticalAlignment: Center, HorizontalAlignment: End); }
      }

      // Stats column header (4 generic stat cells; the page hides the unused ones). The stat cells +
      // Plays are clickable sort headers (TextButton @ZigSortHeaderBtnStyle): the page binds each to
      // set the active sort metric and tints the active one from Java (style()). Rank/Player stay Labels.
      Group #StatsHeader {
        LayoutMode: Left;
        Visible: false;
        Anchor: (Height: 22, Bottom: 4);
        Label      #SHdrRank   { Anchor: (Width: 48);  Padding: (Left: 10); Text: ""; Style: (FontSize: $ZT.@ZigFontSection, TextColor: #8696a8, VerticalAlignment: Center); }
        Label      #SHdrPlayer { FlexWeight: 1;        Padding: (Left: 4);  Text: ""; Style: (FontSize: $ZT.@ZigFontSection, TextColor: #8696a8, VerticalAlignment: Center); }
        TextButton #SHdrCol0   { Anchor: (Width: 110); Text: ""; Style: $M.@ZigSortHeaderBtnStyle; }
        TextButton #SHdrCol1   { Anchor: (Width: 110); Text: ""; Style: $M.@ZigSortHeaderBtnStyle; }
        TextButton #SHdrCol2   { Anchor: (Width: 110); Text: ""; Style: $M.@ZigSortHeaderBtnStyle; }
        TextButton #SHdrCol3   { Anchor: (Width: 110); Text: ""; Style: $M.@ZigSortHeaderBtnStyle; }
        TextButton #SHdrPlays  { Anchor: (Width: 60);  Padding: (Right: 10); Text: ""; Style: $M.@ZigSortHeaderBtnStyle; }
      }

      Group { Anchor: (Height: 1, Bottom: 6); Background: #1e2a36; }

      Group #LeaderboardList {
        FlexWeight: 1;
        LayoutMode: TopScrolling;
        ScrollbarStyle: $C.@DefaultScrollbarStyle;
        Padding: (Right: 4);
      }

      Label #EmptyState {
        Text: "";
        Visible: false;
        Anchor: (Height: 22, Top: 6);
        Style: (FontSize: $ZT.@ZigFontCaption, TextColor: #8696a8, HorizontalAlignment: Center);
      }

      Group { Anchor: (Height: 1, Top: 8); Background: #1e2a36; }
      Label #YourRank {
        Text: "";
        Anchor: (Height: 24, Top: 6);
        Style: (FontSize: $ZT.@ZigFontBody, TextColor: #ffd97a, VerticalAlignment: Center, HorizontalAlignment: Center);
      }
    }
  }
}
