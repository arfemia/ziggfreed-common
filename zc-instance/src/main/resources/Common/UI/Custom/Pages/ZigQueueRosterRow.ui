$ZK = "../Common/ZigTokens.ui";
$ZX = "../Common/ZigText.ui";

// One queue roster row (appended into #RosterList; see PlayModePage): a player's name on the kit's row surface. The
// initiator's name is tinted from Java with the kit's lit gold (ZigTokens.MARK_LIT), on the Label's own style.

Group #ZigQueueRosterRow {
  LayoutMode: Left;
  Anchor: (Height: 36, Bottom: $ZK.@ZigSpace1);
  Padding: (Horizontal: $ZK.@ZigSpace3);
  Background: (Color: $ZK.@ZigSurfaceRow);

  Label #RowName {
    FlexWeight: 1;
    Anchor: (Height: 36);
    Text: "";
    Style: $ZX.@ZigRowTitleStyle;
  }
}
