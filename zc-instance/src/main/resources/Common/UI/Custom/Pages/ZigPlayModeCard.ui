$ZK = "../Common/ZigTokens.ui";
$ZX = "../Common/ZigText.ui";
$ZS = "../Common/ZigStyles.ui";
$ZW = "../Common/ZigKit.ui";

// One Play-screen mode card (appended into #ModeCards; see PlayModePage), 180 x 232, a card you click: the whole
// card is ONE button (#CardBtn, the click target Java binds per mode) on the kit's card style (Common/ZigStyles.ui
// @ZigTierCardStyle: the game's Memories tile at rest, its gold Selected tile under the cursor). Inside it, top to
// bottom: the mode's picture (#CardIcon, the kit's plain picture slot, painted through
// ui/icon/IconRenderer.applyPlainIcon, so it only displays and the button keeps the click; hidden with none), its
// name (#Label, flat gold capitals, two lines at most) and a one-line-or-more description (#CardSub).

Group #ZigPlayModeCard {
  Anchor: (Width: 180, Height: 232, Left: $ZK.@ZigSpace1, Right: $ZK.@ZigSpace1);

  // The name button: a Button holding a Label #Label whose words go on .TextSpans (ZigRichButton).
  Button #CardBtn {
    Anchor: (Full: 0);
    LayoutMode: Top;
    Padding: (Horizontal: $ZK.@ZigSpace3, Top: $ZK.@ZigSpace4, Bottom: $ZK.@ZigSpace3);
    Style: $ZS.@ZigTierCardStyle;

    Group #CardIconWrap {
      LayoutMode: Center;
      Anchor: (Height: $ZK.@ZigPicHeader, Bottom: $ZK.@ZigSpace3);

      $ZW.@ZigPicture #CardIcon {
        @Size = $ZK.@ZigPicHeader;
      }
    }

    Label #Label {
      Anchor: (Height: 52, Bottom: $ZK.@ZigSpace2);
      Text: "";
      Style: (...$ZX.@ZigTitleStyle, HorizontalAlignment: Center, VerticalAlignment: Center);
    }

    Label #CardSub {
      FlexWeight: 1;
      Text: "";
      Style: (...$ZX.@ZigCaptionStyle, HorizontalAlignment: Center, VerticalAlignment: Start, Wrap: true);
    }
  }
}
