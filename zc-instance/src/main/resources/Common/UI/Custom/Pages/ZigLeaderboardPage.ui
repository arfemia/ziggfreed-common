$C = "../Common.ui";
$F = "../Common/ZigFrames.ui";
$ZK = "../Common/ZigTokens.ui";
$ZX = "../Common/ZigText.ui";
$ZS = "../Common/ZigStyles.ui";
$ZW = "../Common/ZigKit.ui";

// The generic leaderboard page (com.ziggfreed.common.instance.leaderboard.LeaderboardPage) in its own
// 860 x 700 frame, for a board whose deps name no rail tab (Kweebec's). Its body is exactly the menu
// document's (Pages/ZigLeaderboardMenuPage.ui): the same elements, the same ids, the same order, held one for
// one by LeaderboardMenuDocumentTest, so change the two together. That document's header comment describes
// every part. Only #Board's padding differs, since this frame pads its own content. Shipped once in
// ziggfreed-common; neutral Zig* ids.

// A column header's words: the view tab's name, wrapping onto a second line rather than cut off, in a 44px header.
// Every header column is at least a figure column's share of the row, far wider than the one ellipsis under which
// a two-line label would crash the client (the ui rule).
@HeadStyle = LabelStyle(...$ZS.@ZigViewTabLabelStyle, ShrinkTextToFit: false, Wrap: true, WrapMaxLines: 2);
@HeadEndStyle = LabelStyle(...@HeadStyle, HorizontalAlignment: End);

// A column header that sorts the list: the view tab's faint pane, its name at the end like the figures under
// it, #Mark before the name on the sorted column.
@SortHeader = Button {
  FlexWeight: 1;
  Anchor: (Height: 44, Left: 4);
  LayoutMode: Left;
  Padding: (Horizontal: 10);
  Style: $ZS.@ZigViewTabStyle;
  TextTooltipStyle: $C.@DefaultTextTooltipStyle;

  Group #Mark {
    Anchor: (Width: 12, Height: 12, Top: 16, Right: 4);
    Background: (TexturePath: "../Common/Glyphs/ChevronDown.png", Color: $ZK.@ZigAccent);
    Visible: false;
  }

  Label #Label {
    FlexWeight: 1;
    Anchor: (Height: 44);
    Text: "";
    Style: @HeadEndStyle;
  }
};

$C.@PageOverlay {}

$F.@ZigDecoratedFrame {
  @CloseButton = true;
  Anchor: (Width: 860, Height: 700);

  #Content {
    Group #Board {
      FlexWeight: 1;
      LayoutMode: Top;

      Label #Title {
        Anchor: (Height: 28, Bottom: 2);
        Text: "";
        Style: (...$ZX.@ZigTitleStyle, VerticalAlignment: Center, WrapMaxLines: 1);
      }

      Label #Lead {
        Anchor: (Height: 20);
        Text: "";
        Visible: false;
        Style: (...$ZX.@ZigCaptionStyle, Wrap: true, WrapMaxLines: 1);
      }

      Group #GroupRow {
        LayoutMode: Top;
        Anchor: (Top: 12);

        Label #GroupLabel {
          Anchor: (Height: 22);
          Text: "";
          Visible: false;
          Style: $ZX.@ZigSectionLabelStyle;
        }

        Group #GroupBar {
          LayoutMode: LeftWrap;
        }
      }

      Group #GroupRule {
        Anchor: (Height: 1);
        Background: (Color: $ZK.@ZigDivider);
        Visible: false;
      }

      Group #TabRow {
        LayoutMode: Top;
        Anchor: (Top: 12);

        Label #TabLabel {
          Anchor: (Height: 22);
          Text: "";
          Visible: false;
          Style: $ZX.@ZigSectionLabelStyle;
        }

        Group #TabBar {
          LayoutMode: LeftWrap;
        }
      }

      Group #SplitRow {
        LayoutMode: Left;
        Anchor: (Height: 44, Top: 12);
        Visible: false;

        Group #SplitBar {
          FlexWeight: 1;
          LayoutMode: Left;
        }

        $C.@DropdownBox #Pick {
          Anchor: (Width: 240, Height: 32, Top: 6);
        }
      }

      Group #ControlBar {
        LayoutMode: Left;
        Anchor: (Height: 54, Top: 12);
        Visible: false;

        Group #SortGroup {
          FlexWeight: 1;
          LayoutMode: Top;

          Label #SortLabel {
            Anchor: (Height: 22);
            Text: "";
            Visible: false;
            Style: $ZX.@ZigSectionLabelStyle;
          }

          Group #SortBar {
            LayoutMode: Left;
            Anchor: (Height: $ZK.@ZigControlHeight);

            $ZW.@ZigSegment #SortBest {
              @Anchor = (Right: 6);
            }

            $ZW.@ZigSegment #SortTotal {
              @Anchor = (Right: 6);
            }

            $ZW.@ZigSegment #SortTime {}
          }
        }

        Group #ViewGroup {
          Anchor: (Width: 270);
          LayoutMode: Top;

          Label #ViewLabel {
            Anchor: (Height: 22);
            Text: "";
            Visible: false;
            Style: $ZX.@ZigSectionLabelStyle;
          }

          Group #ViewBar {
            LayoutMode: Left;
            Anchor: (Height: $ZK.@ZigControlHeight);

            $ZW.@ZigSegment #ViewRankings {
              @Anchor = (Right: 6);
            }

            $ZW.@ZigSegment #ViewStats {}
          }
        }
      }

      Group #YouStrip {
        LayoutMode: Top;
        Anchor: (Top: 14);
        Padding: (Horizontal: $ZK.@ZigSpace4, Vertical: 10);
        Background: (TexturePath: "../Common/ContainerPanelPatch.png", Border: 4);
        Visible: false;

        Group #YouHead {
          LayoutMode: Left;
          Anchor: (Height: 20);

          Label #YouHeading {
            FlexWeight: 1;
            Text: "";
            Style: (...$ZX.@ZigSectionLabelStyle, Wrap: true, WrapMaxLines: 1);
          }

          Label #YourRank {
            FlexWeight: 1;
            Text: "";
            Style: (...$ZX.@ZigCaptionStyle, HorizontalAlignment: End, Wrap: true, WrapMaxLines: 1);
          }
        }

        Group #YouFigures {
          LayoutMode: Left;
          Anchor: (Height: 78, Top: 4);

          $ZW.@ZigStatTwoLine #YouPlace {}

          $ZW.@ZigStatTwoLine #YouStat0 {
            @Anchor = (Left: $ZK.@ZigSpace2);
          }

          $ZW.@ZigStatTwoLine #YouStat1 {
            @Anchor = (Left: $ZK.@ZigSpace2);
          }

          $ZW.@ZigStatTwoLine #YouStat2 {
            @Anchor = (Left: $ZK.@ZigSpace2);
          }

          $ZW.@ZigStatTwoLine #YouStat3 {
            @Anchor = (Left: $ZK.@ZigSpace2);
          }
        }

        Label #YouHint {
          Anchor: (Height: 24, Top: 4);
          Text: "";
          Visible: false;
          Style: (...$ZX.@ZigBodyStyle, Wrap: true, WrapMaxLines: 1);
        }
      }

      Group #TableHeader {
        LayoutMode: Left;
        Anchor: (Height: 44, Top: 14, Bottom: 4);
        Padding: (Right: 4);
        Visible: false;

        Label #HdrRank {
          Anchor: (Width: 72);
          Padding: (Left: 12);
          Text: "";
          Style: @HeadStyle;
        }

        Label #HdrPlayer {
          FlexWeight: 2;
          Padding: (Left: 4);
          Text: "";
          Style: @HeadStyle;
        }

        Label #HdrTotal {
          FlexWeight: 1;
          Anchor: (Left: 4);
          Padding: (Right: 10);
          Text: "";
          Style: @HeadEndStyle;
        }

        Label #HdrScore {
          FlexWeight: 1;
          Anchor: (Left: 4);
          Padding: (Right: 10);
          Text: "";
          Style: @HeadEndStyle;
        }

        Label #HdrTime {
          FlexWeight: 1;
          Anchor: (Left: 4);
          Padding: (Right: 10);
          Text: "";
          Style: @HeadEndStyle;
        }

        Label #HdrPlays {
          FlexWeight: 1;
          Anchor: (Left: 4);
          Padding: (Right: 10);
          Text: "";
          Style: @HeadEndStyle;
        }
      }

      Group #StatsHeader {
        LayoutMode: Left;
        Anchor: (Height: 44, Top: 14, Bottom: 4);
        Padding: (Right: 4);
        Visible: false;

        Label #SHdrRank {
          Anchor: (Width: 72);
          Padding: (Left: 12);
          Text: "";
          Style: @HeadStyle;
        }

        Label #SHdrPlayer {
          FlexWeight: 2;
          Padding: (Left: 4);
          Text: "";
          Style: @HeadStyle;
        }

        @SortHeader #SHdrCol0 {}
        @SortHeader #SHdrCol1 {}
        @SortHeader #SHdrCol2 {}
        @SortHeader #SHdrCol3 {}
        @SortHeader #SHdrPlays {}
      }

      Group #LeaderboardList {
        FlexWeight: 1;
        LayoutMode: TopScrolling;
        ScrollbarStyle: $C.@DefaultScrollbarStyle;
        Padding: (Right: 4);
      }

      $ZW.@ZigEmptyState #EmptyState {
        FlexWeight: 1;
        Visible: false;
      }
    }
  }
}
