$ZK = "../Common/ZigTokens.ui";
$ZX = "../Common/ZigText.ui";

// One two-cell results row (appended into #ResultsList, #BreakdownList and #StatsList; see ResultsPage), on the
// kit's row surface. Left cell (name / column label) flexes; right cell (score / value) is right-aligned. The left
// cell's colour is set per player row from Java off the kit's inks (MVP gold, a team's head ink), and the viewer's
// own row takes the kit's warm selected row through its Background (UiRetint.fill), its name white.

Group #ZigResultRow {
  LayoutMode: Left;
  Anchor: (Height: 28, Bottom: 3);
  Background: (Color: $ZK.@ZigSurfaceRow);

  Label #Cell1 {
    FlexWeight: 1;
    Padding: (Left: 12);
    Text: "";
    Style: (...$ZX.@ZigBodyStyle, TextColor: $ZK.@ZigInkStrong);
  }

  Label #Cell2 {
    Anchor: (Width: 140);
    Padding: (Right: 12);
    Text: "";
    Style: (...$ZX.@ZigBodyStyle, TextColor: $ZK.@ZigInkStrong, RenderBold: true, HorizontalAlignment: End);
  }
}
