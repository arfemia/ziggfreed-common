$ZK = "../Common/ZigTokens.ui";
$ZX = "../Common/ZigText.ui";
$ZS = "../Common/ZigStyles.ui";

// One party / invite / ask / online-roster row (appended into #PartyList; see PartyInvitePage), on the kit's row
// surface: a name, an optional owner badge and up to two action buttons (primary / secondary), all revealed,
// labelled and bound from Java per row kind:
//   invite tab   -> #RowBtnPrimary = Invite
//   party member -> #RowBtnPrimary = Remove (owner viewing others; swapped to the kit's Secondary look)
//   incoming inv -> #RowBtnPrimary = Accept, #RowBtnSecondary = Decline
//   ask to join  -> #RowBtnPrimary = Accept, #RowBtnSecondary = Decline, the row filled with the kit's warm
//                   selected surface
// The root declares its Background (the kit's row surface), so the fill Java pushes on an ask row lands. The two
// buttons default hidden; Java sets Visible, the words (on the Button's #Label .TextSpans, through ZigRichButton)
// and the event binding. Every colour is a Common/ZigTokens.ui token.

Group #ZigPartyRow {
  LayoutMode: Left;
  Anchor: (Height: 44, Bottom: $ZK.@ZigSpace1);
  Padding: (Horizontal: $ZK.@ZigSpace3);
  Background: (Color: $ZK.@ZigSurfaceRow);

  Label #RowName {
    FlexWeight: 1;
    Text: "";
    Style: $ZX.@ZigRowTitleStyle;
  }

  Label #RowBadge {
    Visible: false;
    Anchor: (Width: 90, Height: 44);
    Text: "";
    Style: (...$ZX.@ZigSmallCapsStyle, TextColor: $ZK.@ZigMarkLit, HorizontalAlignment: End);
  }

  Button #RowBtnPrimary {
    Visible: false;
    Anchor: (Width: 116, Height: 32, Top: 6, Left: $ZK.@ZigSpace2);
    Style: $ZS.@ZigButtonPrimaryStyle;

    Label #Label {
      FlexWeight: 1;
      Text: "";
      Style: $ZX.@ZigButtonLabelStyle;
    }
  }

  Button #RowBtnSecondary {
    Visible: false;
    Anchor: (Width: 116, Height: 32, Top: 6, Left: $ZK.@ZigSpace2);
    Style: $ZS.@ZigButtonSecondaryStyle;

    Label #Label {
      FlexWeight: 1;
      Text: "";
      Style: $ZX.@ZigButtonLabelStyle;
    }
  }
}
