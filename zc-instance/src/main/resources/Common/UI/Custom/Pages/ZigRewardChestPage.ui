$C = "../Common.ui";
$F = "../Common/ZigFrames.ui";
$ZW = "../Common/ZigKit.ui";

// A reward chest's one page (com.ziggfreed.common.instance.claims.RewardChestPage): everything of the player's own
// in the chest, on the kit's reading page in the decorated frame, with no menu rail.
//
// #Page is the kit's @ZigDetailPage, painted by com.ziggfreed.common.ui.kit.DetailPainter: the chest's picture,
// "Your share", how many cards it shows and the difficulty pill; the chest's own line; then one cards block across
// all the chest's Claims (a Pages/ZigTileSection.ui whose wrapping grid holds Pages/ZigRewardCard.ui cards, four a
// row in this frame's 596px): what is not an item first on the warm plate, its picture over its own line, alike ones
// summed into one card; a Pages/ZigRewardDivider.ui rule; then the items, best quality first, each on the game's own rarity slot
// with its own tooltip. A click anywhere on a card takes it; then the hint and the gold Take All on the action bar.
// #ChestEmpty, the kit's empty state, takes its place once nothing is left, the page staying open so the press's
// toast is seen. The frame owns the size, the padding and the close button. Every press reopens the page, so every
// build is a full one, and the page never spells a template's child ids: the kit's painters own them.
//
// Shipped once in ziggfreed-common; neutral Zig* ids. Smoke-test in-game.

$C.@PageOverlay {}

$F.@ZigDecoratedFrame {
  @CloseButton = true;
  @Ornaments = true;
  Anchor: (Width: 680, Height: 780);

  #Content {
    $ZW.@ZigDetailPage #Page {
      FlexWeight: 1;
    }

    $ZW.@ZigEmptyState #ChestEmpty {
      FlexWeight: 1;
      Visible: false;
    }
  }
}
