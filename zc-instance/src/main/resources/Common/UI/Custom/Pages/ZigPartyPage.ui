$C = "../Common.ui";
$F = "../Common/ZigFrames.ui";
$ZK = "../Common/ZigTokens.ui";
$ZX = "../Common/ZigText.ui";
$ZS = "../Common/ZigStyles.ui";
$S = "../Common/ZigSearchRow.ui";

// Generic party + invite screen (com.ziggfreed.common.party.page.PartyInvitePage) on the band
// (@ZigDecoratedFrame), its title in the frame's hero (the kit's HeroPainter). Two views, Party (roster,
// incoming invites, players asking to join from the viewer's party board notice, footer) and Invite (the online
// roster behind the shared search row #SearchRow), switched by the game's header tabs the kit's ViewTabPainter
// appends into #TabBar. Rows are appended from Java (Pages/ZigPartyRow.ui). Every button is a Button holding a
// Label #Label whose words go on .TextSpans (ZigRichButton). Shipped once in ziggfreed-common; neutral Zig* ids
// avoid colliding with a consumer's own Pages/*.ui when both jars are installed. Every colour is a
// Common/ZigTokens.ui token and every size a Common/ZigType.ui step through the kit's styles.

$C.@PageOverlay {}
$F.@ZigDecoratedFrame {
  @CloseButton = true;
  Anchor: (Width: 640, Height: 680);

  #Content {
    // The two views, appended by ViewTabPainter (Pages/ZigViewTab.ui, 40 high), then the kit's rule under them.
    Group #TabBar {
      LayoutMode: Left;
      Anchor: (Height: 40);
    }

    Group {
      Anchor: (Height: 1, Bottom: 8);
      Background: (Color: $ZK.@ZigDivider);
    }

    Label #MemberCount {
      Text: "";
      Visible: false;
      Anchor: (Height: 20, Bottom: 6);
      Style: $ZX.@ZigCaptionStyle;
    }

    // Search row (revealed on the Invite tab from Java): the shared search row, its field flexing across the
    // column.
    $S.@ZigSearchRow #SearchRow {
      @Anchor = (Bottom: 8);
      @SearchWidth = 90;
      Visible: false;
    }

    // Appended rows (Pages/ZigPartyRow.ui).
    Group #PartyList {
      FlexWeight: 1;
      LayoutMode: TopScrolling;
      ScrollbarStyle: $C.@DefaultScrollbarStyle;
      Padding: (Right: 4);
    }

    Label #EmptyState {
      Text: "";
      Visible: false;
      Anchor: (Top: 8);
      Style: (...$ZX.@ZigCaptionStyle, HorizontalAlignment: Center, Wrap: true);
    }

    // Footer (revealed on the Party tab from Java; the buttons toggle per role). #PrivacyBtn is the owner's
    // public/private switch (its label shows the current state; clicking flips it).
    Group #FooterRow {
      LayoutMode: Left;
      Anchor: (Height: 40, Top: 12);
      Visible: false;

      Button #QueueBtn {
        FlexWeight: 1;
        Anchor: (Height: 40, Right: 8);
        Style: $ZS.@ZigButtonPrimaryStyle;
        Visible: false;

        Label #Label {
          FlexWeight: 1;
          Text: "";
          Style: $ZX.@ZigButtonLabelStyle;
        }
      }

      Button #PrivacyBtn {
        FlexWeight: 1;
        Anchor: (Height: 40, Right: 8);
        Style: $ZS.@ZigButtonSecondaryStyle;
        Visible: false;

        Label #Label {
          FlexWeight: 1;
          Text: "";
          Style: $ZX.@ZigButtonLabelStyle;
        }
      }

      Button #DisbandBtn {
        FlexWeight: 1;
        Anchor: (Height: 40);
        Style: $ZS.@ZigButtonSecondaryStyle;
        Visible: false;

        Label #Label {
          FlexWeight: 1;
          Text: "";
          Style: $ZX.@ZigButtonLabelStyle;
        }
      }

      Button #LeaveBtn {
        FlexWeight: 1;
        Anchor: (Height: 40);
        Style: $ZS.@ZigButtonSecondaryStyle;
        Visible: false;

        Label #Label {
          FlexWeight: 1;
          Text: "";
          Style: $ZX.@ZigButtonLabelStyle;
        }
      }
    }
  }
}
