your_rank.none = Vous n'avez pas encore de record pour ce combat ici.

# The strip over the list: your place on the board and your own numbers.
you.heading = Votre position
you.place = n° {0, number}
you.place.label = Votre rang
you.players = Joueurs sur ce classement : {0, number}
# A column you can click to rank by, when the column says nothing of its own.
tip.sort = Cliquez pour classer tout le monde selon ceci.

# /zigleaderboard, la commande qui ouvre l'écran ci-dessus. Les clés command.desc.* sont celles par lesquelles
# l'aide du moteur résout une commande ou un argument.
command.desc.family = Consultez les records des combats de boss de ce serveur.
command.desc.encounter = Ouvre les records d'un combat de boss.
command.desc.arg.encounter = L'identifiant du script de rencontre du combat. Omettez-le pour ouvrir le premier combat enregistré.
command.open.needs_player = Seul un joueur peut ouvrir l'écran des records.
command.open.failed = L'écran des records n'a pas pu s'ouvrir. Réessayez dans un instant.
command.encounter.unranked = '{0}' ne garde aucun record sur ce serveur.
command.encounter.none = Aucun combat de boss n'a encore de record.
command.encounter.off = Les records sont désactivés sur ce serveur ($Enabled dans mods/ziggfreedcommon/stats.json).
command.desc.clock = Décale l'horloge du classement des records pour voir passer une semaine ou un mois. 0 la remet en place.
command.desc.arg.offset = De combien la décaler : 7d, 12h ou 30m, avec un signe moins pour reculer, ou 0.
command.clock.bad_offset = '{0}' n'est pas une durée de décalage. Essayez 7d, 12h, 30m, -1d ou 0.
command.clock.set = L'horloge du classement des records est maintenant décalée de {0} par rapport à celle du serveur.
command.clock.reset = Le classement des records est revenu sur l'horloge du serveur.
command.clock.shifted = Tant que l'horloge est décalée, les statistiques ne comptent que pour Depuis toujours. Les semaines et les mois se remplissent de nouveau après son retour à 0.
command.clock.window = {0} indique {1}
command.clock.window.none = {0} n'a pas encore commencé

menu.records = Records
