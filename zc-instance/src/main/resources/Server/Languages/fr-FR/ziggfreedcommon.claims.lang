# The Claims tab (com.ziggfreed.common.instance.claims): the rewards a player has earned and not taken
# yet, waiting until they press Claim. The file name is the key PREFIX: an entry here resolves as
# ziggfreedcommon.claims.<key>. menu.tab is a rail label: 20 characters at most once uppercased.

menu.tab = À réclamer
page.title = À réclamer
page.lead = Les récompenses que vous avez gagnées attendent ici que vous les preniez.
page.section = En attente
row.rewards = {0, number} {0, plural, one {récompense} other {récompenses}}
detail.rewards = Récompenses
detail.lead = Réclamer prend celles-ci. Tout réclamer prend tout ce qui attend.
detail.hint = Les objets ont besoin de place dans vos sacs. Ce qui ne rentre pas reste ici pour plus tard.
action.claim = Réclamer
action.claim_all = Tout réclamer
empty.title = Rien à réclamer
empty.line = Les récompenses des boss et des événements attendent ici que vous les preniez.
untitled = Récompenses

# A reward chip nothing else could name (a Claim's row, a results screen's): {0} is how many.
chip.generic = x{0, number} Récompense

# What a press says, over the page.
toast.claimed = Réclamé.
toast.claimed_all = Tout ce qui attendait a été réclamé.
toast.kept = Vos sacs sont pleins. Ce qui ne rentrait pas attend toujours ici.
toast.failed = Réclamé, mais une partie n'a pas pu être remise sur ce serveur.

# Telling a player something waits: the toast when a Claim arrives, and the notice once a session at login.
# notice.added is a Claim with no title of its own; notice.added.named one with a title, {0}; notice.added.many
# heads several Claims that arrived together, each on a row under it.
notice.added = Une récompense vous attend. Retrouvez-la sous « À réclamer » dans votre menu.
notice.added.named = {0} vous attend sous « À réclamer » dans votre menu.
notice.added.many = Des récompenses vous attendent sous « À réclamer » dans votre menu.
notice.ready = {0, number} {0, plural, one {récompense vous attend} other {récompenses vous attendent}} sous « À réclamer » dans votre menu.
# A reward from a boss that left a chest where it fell: it waits in the chest and under Claims alike. notice.added.spoils
# is a Claim with no title of its own, or the line over several; notice.added.spoils.named one with a title, {0}.
notice.added.spoils = Votre part vous attend dans le coffre où le boss est tombé, et sous « À réclamer » dans votre menu.
notice.added.spoils.named = {0} vous attend dans le coffre où le boss est tombé, et sous « À réclamer » dans votre menu.

# A boss's chest: what a won fight leaves where the boss fell, holding each player's own rewards from that fight.
# spoils.hint is the prompt over the chest; the game fills {key} with the button to press. Opening any reward chest
# shows one page: spoils.title over the chest's own line (spoils.lead for a boss's), each reward a line a click
# takes, spoils.page.hint beside the spoils.action.take_all button, and spoils.all_taken once the player has taken
# everything. spoils.empty is the line for a player with nothing in it. spoils.banner is the line under a banner
# telling a player their reward went into the chest, when the source's own file names no line of its own.
spoils.hint = Appuyez sur [{key}] pour ouvrir
spoils.title = Votre part
spoils.lead = Ce que ce boss a laissé pour vous. Ce que vous laissez ici vous attend sous « À réclamer ».
spoils.action.take_all = Tout prendre
spoils.page.hint = Cliquez sur une récompense pour la prendre, ou sur Tout prendre pour tout récupérer. Les objets ont besoin de place dans vos sacs.
spoils.all_taken = Vous avez tout pris.
spoils.empty = Rien ici ne vous attend.
spoils.banner = Votre récompense vous attend dans le coffre où le boss est tombé.
chest.lead = Ce qui vous a été laissé. Ce que vous laissez ici vous attend sous « À réclamer ».
chest.banner.title = {0} a laissé un coffre
chest.banner = Ouvrez-le pour prendre votre part. Ce que vous laissez attend sous « À réclamer ».
notice.added.chest = Votre part vous attend dans le coffre tout près, et sous « À réclamer » dans votre menu.
notice.added.chest.named = {0} vous attend dans le coffre tout près, et sous « À réclamer » dans votre menu.

# A Claim's title when /zigclaims give wrote it: {0} is the loot table's id.
title.admin = Butin de {0}

# /zigclaims, the admin family. The command.desc.* keys are what the engine's own help resolves a command
# or an argument through.
command.desc.family = Met des récompenses sous « À réclamer » chez les joueurs.
command.desc.give = Tire une table de butin et met le résultat sous « À réclamer » chez un joueur.
command.desc.arg.player = Le joueur, en ligne ou non : un nom ou un identifiant de joueur. Vous par défaut.
command.desc.arg.player.online = Le joueur, qui doit être en ligne : un nom ou un identifiant de joueur. Vous par défaut.
command.desc.arg.lootable = La table de butin à tirer, par son identifiant.
command.player.needed = Nommez un joueur avec --player=<nom>.
command.player.offline = Ce joueur n'est dans aucun monde pour le moment. Réessayez dans un instant.
command.player.unknown = Aucun joueur nommé '{0}' n'a été trouvé. Son identifiant de joueur marche aussi.
command.lootable.needed = Nommez une table de butin avec --lootable=<id>.
command.lootable.unknown = Aucune table de butin nommée '{0}' n'est chargée.
command.give.done = Sous « À réclamer » chez {1} : {2, number} {2, plural, one {récompense} other {récompenses}} de {0}.
command.give.nothing = {0} n'a rien donné à {1}, donc rien n'a été ajouté sous « À réclamer ».
command.desc.chest = Dresse un coffre de récompense à côté d'un joueur, contenant le tirage d'une table de butin pour lui.
command.desc.arg.chest = Le coffre de récompense à dresser, par son identifiant. Zc_Reward_Chest par défaut.
command.chest.unknown = Aucun coffre de récompense nommé '{0}' n'est chargé.
command.chest.done = {0} dressé à côté de {1}, contenant ce que {2} lui a donné.
command.chest.nothing = {0} n'a rien donné à {1}, donc aucun coffre n'a été dressé.
command.chest.failed = Le coffre n'a pas pu être dressé. Le journal du serveur en donne la raison.
