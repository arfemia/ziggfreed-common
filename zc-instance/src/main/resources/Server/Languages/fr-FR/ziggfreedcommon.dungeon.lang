# zc's dungeons (com.ziggfreed.common.instance.dungeon): /zigdungeon, the admin family, the words its lines
# nest, what a player is told when a way in refuses them, what to do once inside, a run's results screen and
# failure lines, and the Boss Fights tab of a fight fought in a dungeon. The file name is the key PREFIX: an
# entry here resolves as ziggfreedcommon.dungeon.<key>.

# /zigdungeon. The command.desc.* keys are what the engine's own help resolves a command or an argument through.
command.desc.family = Voir les donjons du serveur et les instances qu'ils ont ouvertes, ou entrer dans l'un d'eux.
command.desc.list = Liste chaque donjon et sa configuration.
command.desc.status = Liste les instances de donjon ouvertes en ce moment.
command.desc.close = Ferme une instance de donjon maintenant. Tous ceux qui sont dedans reviennent là où ils sont entrés.
command.desc.enter = Entrer soi-même dans un donjon, dans une zone vide.
command.desc.arg.copy = L'instance à fermer, par le nom de son monde, comme crypt-1.
command.desc.arg.dungeon = Le donjon où entrer, par son identifiant, comme crypt.
command.list.none = Aucun donjon n'est chargé.
command.list.header = {0, number} {0, plural, one {donjon} other {donjons}} :
command.list.dungeon = {0} ({1}) : {2}. Difficulté {3}, saison {4}.
command.list.place = Modèle {0}, préfabriqué {1}.
command.list.share = {0, number} {0, plural, one {zone} other {zones}} par instance, {1, number} {1, plural, one {bloc} other {blocs}} d'écart, {2, number} {2, plural, one {joueur} other {joueurs}} par zone, {3}.
command.list.run = Les joueurs arrivent en {0, number}, {1, number}, {2, number} dans leur zone. {3}. Une défaite générale {4}. Une instance se ferme {5, number} {5, plural, one {seconde} other {secondes}} après avoir été vidée.
command.status.none = Aucune instance de donjon n'est ouverte.
command.status.header = {0, number} {0, plural, one {instance} other {instances}} de donjon {0, plural, one {ouverte} other {ouvertes}} :
command.status.copy = {0} ({1}) : {2, number} sur {3, number} {3, plural, one {zone} other {zones}} utilisées, {4, number} {4, plural, one {joueur} other {joueurs}} à l'intérieur, {5, number} en route. {6}. {7}.
command.close.done = Fermeture de {0}. Tous ceux qui sont dedans reviennent là où ils sont entrés.
command.close.unknown = Aucune instance de donjon nommée {0} n'est ouverte. /zigdungeon status liste celles qui le sont.
command.enter.sent = Vous entrez dans {0}, zone {1, number} sur {2}.
command.enter.unknown = Aucun donjon nommé {0} n'est chargé. /zigdungeon list montre ceux qui le sont.
command.enter.closed = {0} est inaccessible pour le moment : il est {1}.
command.enter.no_prefab = {0} ne nomme aucun préfabriqué, donc ses zones seraient du vide.
command.enter.missing_prefab = {0} nomme le préfabriqué {1}, qu'aucun pack chargé ne fournit.
command.enter.audit_error = {0} est inaccessible : son fichier de donjon contient une erreur. Le journal du serveur dit quoi corriger.
command.enter.on_the_way = Vous êtes déjà en route vers un donjon.
command.enter.inside = Vous êtes déjà dans une zone de donjon. Quittez-la d'abord.
command.enter.full = Cette zone est pleine.
command.enter.copy_gone = Cette instance de donjon vient de se fermer. Réessayez.
command.enter.failed = L'instance de donjon n'a pas pu être ouverte, ou la téléportation a été refusée. Le journal du serveur dit pourquoi.

# Words the lines above nest.
state.open = ouvert
state.off = désactivé
state.out_of_season = fermé jusqu'à sa saison
difficulty.normal = normale
season.all_year = toute l'année
prefab.none = aucun défini
share.locked = un groupe par zone
share.open = les groupes partagent une zone tant qu'elle a de la place
run.limit = Les parties se terminent après {0, number} {0, plural, one {seconde} other {secondes}}
run.no_limit = Pas de limite de temps
wipe.fails = termine la partie
wipe.ignored = ne termine pas la partie
status.tick = Cycle de {0, number} ms en moyenne
status.tick.unknown = Durée de cycle inconnue pour le moment
status.taking = Accepte des groupes
status.empty = Vide, ferme dans {0, number} {0, plural, one {seconde} other {secondes}}
status.closing = Fermeture

# What a player is told when a way in (a block, a character, a conversation) cannot send them into a dungeon.
# {0} is the dungeon's name, {1} its season's. In entry.cost, {1} is the item the dungeon takes on the way in and
# {2} how many; the dungeon's own hint line, when it names one, shows under it.
entry.off = {0} est fermé pour le moment.
entry.out_of_season = {0} n'ouvre que pendant {1}.
entry.out_of_season.unnamed = {0} n'ouvre que pendant sa saison.
entry.full = Il n'y a plus de place pour votre groupe dans {0}.
entry.on_the_way = Vous êtes déjà en route vers un donjon.
entry.inside = Vous êtes déjà dans un donjon. Quittez-le d'abord.
entry.copy_gone = {0} s'est fermé juste quand vous êtes arrivé. Réessayez.
entry.unavailable = {0} est inaccessible pour le moment.
entry.unavailable.unnamed = Ce donjon est inaccessible pour le moment.
entry.cost = Il vous faut {1} x{2, number} pour entrer dans {0}.

# The results screen each member sees when their party clears a run. The screen paints most of these lines where
# a value cannot be filled in; only results.time (the run's length, m:ss) and results.team_total carry one.
results.cleared = Donjon terminé
results.failed = Partie échouée
results.time = Temps {0}
results.breakdown = Votre partie
results.party = Votre groupe
results.damage = Dégâts aux boss
results.bosses = Boss vaincus
results.rewards = Récompense de fin
results.no_rewards = Pas de récompense de fin cette fois.
results.pending = Vos sacs sont pleins. Le reste vous attend sous « À réclamer » dans votre menu.
results.claim = Réclamer
results.claimed = Réclamé.
results.records = Records
results.again = Rejouer
results.close = Fermer
results.team_total = Total {0, number}

clear.banner = Terminé : {0}

# What a player reads a moment after they arrive in a dungeon area while its run is going. The dungeon's name
# heads it; under it, what to do there (the dungeon's own GoalKey line, else the lines below built from what
# clears a run), then the run's rules. {0} in goal.survive and goal.time_limit is a goal.time.* length.
goal.boss = Vainquez le boss.
goal.all_bosses = Vainquez chaque boss.
goal.objective = Terminez la tâche du donjon.
goal.survive = Tenez bon pendant {0}.
goal.time_limit = Terminez en {0}, sinon la partie échoue.
goal.wipe = Si tout le monde tombe en même temps, la partie échoue.
goal.time.seconds = {0, number} {0, plural, one {seconde} other {secondes}}
goal.time.minutes = {0, number} {0, plural, one {minute} other {minutes}}
goal.time.minutes_seconds = {0, number} {0, plural, one {minute} other {minutes}} et {1, number} {1, plural, one {seconde} other {secondes}}

# What each member still in the area is told when their run fails. {0} is the dungeon's name.
run.failed.time_limit = Le temps est écoulé dans {0}. La partie a échoué.
run.failed.wipe = Tout votre groupe est tombé dans {0}. La partie a échoué.

# Records' Boss Fights, for a fight fought inside a dungeon. {0} is the fight's name, {1} the dungeon's.
records.fight = {0} dans {1}
