# The Claims tab (com.ziggfreed.common.instance.claims): the rewards a player has earned and not taken
# yet, waiting until they press Claim. The file name is the key PREFIX: an entry here resolves as
# ziggfreedcommon.claims.<key>. menu.tab is a rail label: 20 characters at most once uppercased.

menu.tab = Resgates
page.title = Resgates
page.lead = As recompensas que você ganhou ficam aqui até você pegá-las.
page.section = Esperando
row.rewards = {0, number} {0, plural, one {recompensa} other {recompensas}}
detail.rewards = Recompensas
detail.lead = Resgatar pega estas. Resgatar Tudo pega tudo o que está esperando.
detail.hint = Os itens precisam de espaço no seu inventário. O que não couber fica aqui para depois.
action.claim = Resgatar
action.claim_all = Resgatar Tudo
empty.title = Nada para resgatar
empty.line = As recompensas de chefes e eventos esperam aqui até você pegá-las.
untitled = Recompensas

# A reward chip nothing else could name (a Claim's row, a results screen's): {0} is how many.
chip.generic = x{0, number} Recompensa

# What a press says, over the page.
toast.claimed = Resgatado.
toast.claimed_all = Tudo o que estava esperando foi resgatado.
toast.kept = Seu inventário está cheio. O que não coube continua esperando aqui.
toast.failed = Resgatado, mas parte não pôde ser entregue neste servidor.

# Telling a player something waits: the toast when a Claim arrives, and the notice once a session at login.
# notice.added is a Claim with no title of its own; notice.added.named one with a title, {0}; notice.added.many
# heads several Claims that arrived together, each on a row under it.
notice.added = Uma recompensa está esperando por você. Procure em Resgates no seu menu.
notice.added.named = {0} está esperando em Resgates no seu menu.
notice.added.many = Há recompensas esperando em Resgates no seu menu.
notice.ready = {0, number} {0, plural, one {recompensa está esperando} other {recompensas estão esperando}} por você em Resgates no seu menu.
# A reward from a boss that left a chest where it fell: it waits in the chest and under Claims alike. notice.added.spoils
# is a Claim with no title of its own, or the line over several; notice.added.spoils.named one with a title, {0}.
notice.added.spoils = Sua parte está esperando no baú onde o chefe caiu, e em Resgates no seu menu.
notice.added.spoils.named = {0} está esperando no baú onde o chefe caiu, e em Resgates no seu menu.

# A boss's chest: what a won fight leaves where the boss fell, holding each player's own rewards from that fight.
# spoils.hint is the prompt over the chest; the game fills {key} with the button to press. Opening it hands over
# what is not an item at once (spoils.paid heads the list of it) and shows the items in the game's own chest
# window; spoils.empty is the line for a player with nothing in it. The spoils.title to spoils.action.take_all lines
# are the Claims page's, which the chest can show instead (the library's SpoilsView switch).
spoils.hint = Pressione [{key}] para abrir
spoils.paid = Do baú:
spoils.title = Sua parte
spoils.lead = O que este chefe deixou para você. O que você deixar aqui espera por você em Resgates.
spoils.detail.lead = Resgatar pega estes. Pegar Tudo pega tudo o que aqui é seu.
spoils.detail.hint = Os itens precisam de espaço no seu inventário. O que não couber espera em Resgates.
spoils.action.take_all = Pegar Tudo
spoils.empty = Nada aqui está esperando por você.

# A Claim's title when /zigclaims give wrote it: {0} is the loot table's id.
title.admin = Espólio de {0}

# /zigclaims, the admin family. The command.desc.* keys are what the engine's own help resolves a command
# or an argument through.
command.desc.family = Coloca recompensas nos Resgates dos jogadores.
command.desc.give = Sorteia uma tabela de espólio e coloca o que sair nos Resgates de um jogador.
command.desc.arg.player = O jogador, online ou não: um nome ou um id de jogador. Padrão: você.
command.desc.arg.lootable = A tabela de espólio a sortear, pelo id.
command.player.needed = Indique um jogador com --player=<nome>.
command.player.offline = Esse jogador não está em um mundo agora. Tente de novo daqui a pouco.
command.player.unknown = Não achei um jogador chamado '{0}'. O id do jogador também serve.
command.lootable.needed = Indique uma tabela de espólio com --lootable=<id>.
command.lootable.unknown = Nenhuma tabela de espólio chamada '{0}' está carregada.
command.give.done = Colocou {2, number} {2, plural, one {recompensa} other {recompensas}} de {0} nos Resgates de {1}.
command.give.nothing = {0} não rendeu nada para {1}, então nenhum Resgate foi criado.
