# The stat board on Records: the page's own lines, its periods and its sections.
# The file name is the key PREFIX: an entry here resolves as ziggfreedcommon.statboard.<key>.
# Every line but your_rank, the duration lines and period.season (a season tab is a rich button) is
# painted where a parameter is never substituted, so only those take one. The column words the page
# shares with the boss records come from ziggfreedcommon.leaderboard.lang.

title = Recordes
lead = Veja como você se sai diante de todos neste servidor. Clique em uma coluna para ordenar por ela.
empty = Ninguém está neste quadro ainda.
# What counts on a tab and how to get on it, for a player with no place there yet and under a board
# nobody is on. A section file names its own with HintKey; hint is for a tab that names none.
hint = Tudo nestas colunas conta. Faça qualquer coisa daqui para entrar neste quadro.
your_rank = Sua posição: #{0, number}
your_rank.none = Você ainda não está neste quadro.

# A playtime cell: hours and minutes, or minutes alone under an hour.
duration.hours = {0, number}h {1, number}m
duration.minutes = {0, number}m
# A moment cell, such as a first win: today, or how many whole days ago.
since.today = Hoje
since.days = há {0, number} {0, plural, one {dia} other {dias}}

# The period tabs (Server/ZiggfreedCommon/StatPeriods).
period.all_time = Desde Sempre
period.weekly = Esta Semana
period.monthly = Este Mês
# A season tab, one per run of a calendar event: {0} is the event's name, {1} the year the run
# belongs to, a plain number that never takes digit grouping.
period.season = {0} {1}

# The section tabs (Server/ZiggfreedCommon/StatSections).
section.combat = Combate
section.gathering = Coleta
section.adventure = Aventura
section.dungeons = Masmorras
section.renown = Renome
section.bosses = Chefes
section.combat.hint = Derrote mobs ou enfrente um chefe para entrar neste quadro. Suas mortes contam aqui também.
section.gathering.hint = Quebre ou coloque blocos, fabrique itens à mão ou colete coisas para entrar neste quadro.
section.adventure.hint = Conclua missões, converse com personagens, vença rodadas ou apenas jogue para entrar neste quadro.
section.renown.hint = Cumpra os objetivos do jogo ou conquiste prestígio com uma reputação para entrar neste quadro. O Renome conta só para Desde Sempre.
section.bosses.hint = Ajude a derrotar um chefe para entrar neste quadro.
section.dungeons.hint = Comece, conclua ou fracasse em uma partida de masmorra para entrar neste quadro.

# The Bosses tab's split: its first choice, the groups a boss sits in (Server/ZiggfreedCommon/RecordGroups),
# and a boss's party sizes. bosses.all is also the first entry of the list of bosses.
bosses.all = Todos os chefes
bosses.sizes.all = Todos os tamanhos
bosses.size.solo = Solo
bosses.size.players = {0, number} jogadores
group.seasonal = Sazonal
group.dungeon = Masmorra
group.world = Mundo
group.minigame = Minijogo

# The Dungeons tab's split: its first choice (also the first entry of the list of dungeons), and a
# dungeon's difficulties. A difficulty label a dungeon writes shows as difficulty.<label> when that key
# is here, else as written.
dungeons.all = Todas as masmorras
dungeons.difficulties.all = Todas as dificuldades
difficulty.normal = Normal
difficulty.hard = Difícil
