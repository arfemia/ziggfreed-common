# What a player is told when a way in (a block, a character, a conversation) cannot send them into a dungeon.
# {0} is the dungeon's name, {1} its season's. In entry.cost, {1} is the item the dungeon takes on the way in and
# {2} how many; the dungeon's own hint line, when it names one, shows under it.
entry.off = {0} egyelőre zárva van.
entry.out_of_season = {0} csak ekkor nyílik meg: {1}.
entry.out_of_season.unnamed = {0} csak az évadában nyílik meg.
entry.full = Nincs több hely a csapatodnak itt: {0}.
entry.on_the_way = Már úton vagy egy kazamatába.
entry.inside = Már egy kazamatában vagy. Előbb lépj ki.
entry.copy_gone = {0} éppen bezárt, mire odaértél. Próbáld újra.
entry.unavailable = {0} most nem léphető be.
entry.unavailable.unnamed = Ez a kazamata most nem léphető be.
entry.cost = {1} x{2, number} kell ahhoz, hogy belépj ide: {0}.

# The results screen each member sees when their party clears a run. The screen paints most of these lines where
# a value cannot be filled in; only results.time (the run's length, m:ss) and results.team_total carry one.
results.cleared = Kazamata teljesítve
results.failed = A futás sikertelen
results.time = Idő: {0}
results.breakdown = A futásod
results.party = A csapatod
results.damage = Sebzés a főellenségeknek
results.bosses = Legyőzött főellenségek
results.rewards = Teljesítési jutalom
results.no_rewards = Most nincs teljesítési jutalom.
results.pending = Tele van a zsákod. A többi a menüben az Átvehetők alatt vár.
results.claim = Átvétel
results.claimed = Átvéve.
results.records = Rekordok
results.again = Játssz újra
results.close = Bezárás
results.team_total = Összesen: {0, number}
clear.banner = {0} teljesítve

# What a player reads a moment after they arrive in a dungeon area while its run is going. The dungeon's name
# heads it; under it, what to do there (the dungeon's own GoalKey line, else the lines below built from what
# clears a run), then the run's rules. {0} in goal.survive and goal.time_limit is a goal.time.* length.
goal.boss = Győzd le a főellenséget.
goal.all_bosses = Győzd le az összes főellenséget.
goal.objective = Végezd el a kazamata feladatát.
goal.survive = Tarts ki ennyi ideig: {0}.
goal.time_limit = Fejezd be ennyi időn belül: {0}, különben a futás sikertelen.
goal.wipe = Ha mindenki egyszerre elesik, a futás sikertelen.
goal.time.seconds = {0, number} {0, plural, one {másodperc} other {másodperc}}
goal.time.minutes = {0, number} {0, plural, one {perc} other {perc}}
goal.time.minutes_seconds = {0, number} {0, plural, one {perc} other {perc}} és {1, number} {1, plural, one {másodperc} other {másodperc}}

# What each member still in the area is told when their run fails. {0} is the dungeon's name.
run.failed.time_limit = Letelt az idő itt: {0}. A futás sikertelen.
run.failed.wipe = Az egész csapatod elesett itt: {0}. A futás sikertelen.

# Records' Boss Fights, for a fight fought inside a dungeon. {0} is the fight's name, {1} the dungeon's.
records.fight = {0} itt: {1}
