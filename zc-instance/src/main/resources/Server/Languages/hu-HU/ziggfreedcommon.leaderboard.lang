sort.total = Összpontszám
sort.time = Leggyorsabb
view.rankings = Ranglista
view.stats = Statisztika
filter.all = Mind

# The strip over the list: your place on the board and your own numbers.
you.heading = A helyezésed
you.place = #{0, number}
you.place.label = Helyezés
you.players = Játékosok ezen a táblán: {0, number}
# A column you can click to rank by, when the column says nothing of its own.
tip.sort = Kattints, hogy mindenkit e szerint rangsorolj.

# /zigleaderboard, a parancs, amely megnyitja a fenti képernyőt. A command.desc.* kulcsokon keresztül
