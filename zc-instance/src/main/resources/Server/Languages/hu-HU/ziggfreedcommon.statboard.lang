# The stat board on Records: the page's own lines, its periods and its sections.
# The file name is the key PREFIX: an entry here resolves as ziggfreedcommon.statboard.<key>.
# Every line but your_rank, the duration lines and period.season (a season tab is a rich button) is
# painted where a parameter is never substituted, so only those take one. The column words the page
# shares with the boss records come from ziggfreedcommon.leaderboard.lang.

title = Rekordok
lead = Nézd meg, hol állsz a szerver összes játékosához képest. Kattints egy oszlopra, hogy aszerint rangsorolj.
empty = Még senki sincs ezen a táblán.
# What counts on a tab and how to get on it, for a player with no place there yet and under a board
# nobody is on. A section file names its own with HintKey; hint is for a tab that names none.
hint = Ezekben az oszlopokban minden számít. Csinálj bármit belőlük, hogy felkerülj erre a táblára.
your_rank = A helyezésed: #{0, number}
your_rank.none = Te még nem vagy ezen a táblán.

# A playtime cell: hours and minutes, or minutes alone under an hour.
duration.hours = {0, number}h {1, number}m
duration.minutes = {0, number}m
since.today = Ma
since.days = {0, number} {0, plural, one {napja} other {napja}}

# The period tabs (Server/ZiggfreedCommon/StatPeriods).
period.all_time = Mindenkori
period.weekly = Ezen a héten
period.monthly = Ebben a hónapban
# A season tab, one per run of a calendar event: {0} is the event's name, {1} the year the run
# belongs to, a plain number that never takes digit grouping.
period.season = {0} {1}

# The section tabs (Server/ZiggfreedCommon/StatSections).
section.combat = Harc
section.gathering = Gyűjtögetés
section.adventure = Kaland
section.dungeons = Kazamaták
section.renown = Hírnév
section.bosses = Főellenségek
section.combat.hint = Győzz le mobokat, vagy szállj szembe egy főellenséggel, hogy felkerülj erre a táblára. A halálaid itt is számítanak.
section.gathering.hint = Törj vagy helyezz le blokkokat, készíts tárgyakat kézzel, vagy vegyél fel dolgokat, hogy felkerülj erre a táblára.
section.adventure.hint = Teljesíts küldetéseket, beszélj karakterekkel, nyerj meg köröket, vagy egyszerűen játssz, hogy felkerülj erre a táblára.
section.renown.hint = Teljesítsd a játék céljait, vagy növeld egy hírnév állását, hogy felkerülj erre a táblára. A Hírnév csak a Mindenkori fülbe számít.
section.bosses.hint = Segíts legyőzni egy főellenséget, hogy felkerülj erre a táblára.
section.dungeons.hint = Kezdj el, teljesíts vagy bukj el egy kazamatafutást, hogy felkerülj erre a táblára.

bosses.all = Minden főellenség
bosses.sizes.all = Minden méret
bosses.size.solo = Egyedül
bosses.size.players = {0, number} játékos
group.seasonal = Szezonális
group.dungeon = Kazamata
group.world = Világ
group.minigame = Minijáték

dungeons.all = Minden kazamata
dungeons.difficulties.all = Minden nehézség
difficulty.normal = Normál
difficulty.hard = Nehéz
