col.time = Más rápido
col.plays = Combates
empty = Nadie tiene aún un récord de este combate aquí.
sort.score = Mejor parte
sort.total = Puntos totales
sort.time = Más rápido
view.rankings = Clasificación
view.stats = Estadísticas
