stat.damage_dealt = Daño infligido
stat.damage_taken = Daño recibido

# /zigleaderboard, el comando que abre la pantalla de arriba. Las claves command.desc.* son las que la
# ayuda del motor usa para un comando o un argumento.
command.desc.family = Consulta los récords de los combates contra jefes de este servidor.
command.desc.encounter = Abre los récords de un combate contra un jefe.
command.desc.arg.encounter = El id del guion de encuentro del combate. Omítelo cuando solo un combate tenga récords.
command.open.needs_player = Solo un jugador puede abrir la pantalla de récords.
command.open.failed = No se pudo abrir la pantalla de récords. Inténtalo de nuevo en un momento.
command.encounter.unranked = '{0}' no guarda récords en este servidor.
command.encounter.none = Ningún combate contra un jefe tiene aún un récord.
command.encounter.choose = Más de un combate contra un jefe tiene récords. Elige uno:
