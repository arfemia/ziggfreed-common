# The stat board on Records: the page's own lines, its periods and its sections.
# The file name is the key PREFIX: an entry here resolves as ziggfreedcommon.statboard.<key>.
# Every line but your_rank, the duration lines and period.season (a season tab is a rich button) is
# painted where a parameter is never substituted, so only those take one. The column words the page
# shares with the boss records come from ziggfreedcommon.leaderboard.lang.

title = Récords
lead = Mira cómo te clasificas entre todos los de este servidor. Haz clic en una columna para ordenar por ella.
empty = Aún no hay nadie en este tablero.
# What counts on a tab and how to get on it, for a player with no place there yet and under a board
# nobody is on. A section file names its own with HintKey; hint is for a tab that names none.
hint = Cuenta todo lo de estas columnas. Haz cualquier cosa de ahí para entrar en este tablero.
your_rank = Tu puesto: #{0, number}
your_rank.none = Aún no estás en este tablero.

# A playtime cell: hours and minutes, or minutes alone under an hour.
duration.hours = {0, number}h {1, number}m
duration.minutes = {0, number}m

# The period tabs (Server/ZiggfreedCommon/StatPeriods).
period.all_time = Todo el Tiempo
period.weekly = Esta Semana
period.monthly = Este Mes
# A season tab, one per run of a calendar event: {0} is the event's name, {1} the year the run
# belongs to, a plain number that never takes digit grouping.
period.season = {0} {1}

# The section tabs (Server/ZiggfreedCommon/StatSections).
section.combat = Combate
section.gathering = Recolección
section.adventure = Aventura
section.renown = Renombre
section.combat.hint = Derrota mobs o enfréntate a un jefe para entrar en este tablero. Tus muertes también cuentan aquí.
section.gathering.hint = Rompe o coloca bloques, fabrica objetos a mano o recoge cosas para entrar en este tablero.
section.adventure.hint = Termina misiones, habla con personajes, gana rondas o simplemente juega para entrar en este tablero.
section.renown.hint = Completa los objetivos del juego o gana prestigio con una reputación para entrar en este tablero. El Renombre cuenta solo para Todo el Tiempo.
