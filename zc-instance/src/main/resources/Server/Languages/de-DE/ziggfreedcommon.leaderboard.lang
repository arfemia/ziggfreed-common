# Der eigene Bildschirm der Bibliothek für die Rekorde eines Bosskampfs (die Zeilen, die ein Sieg in
# die Begegnungs-Bestenliste schreibt), damit sie auch auf einem Server ohne weitere Mods lesbar sind.
# Der Dateiname ist das Schlüssel-PRÄFIX: ein Eintrag hier wird als ziggfreedcommon.leaderboard.<key> aufgelöst.
# Jede Bildschirmzeile außer your_rank wird dort gemalt, wo nie ein Parameter eingesetzt wird, daher
# nimmt nur your_rank einen. Ein Kampf benennt seinen Bildschirm über den NameKey seiner Bindungszeile;
# title ist der Ersatz.

col.rank = Rang
col.player = Spieler
col.score = Bester Anteil
col.total = Gesamt
col.time = Schnellste
col.plays = Kämpfe
sort.score = Bester Anteil
sort.total = Gesamtpunkte
sort.time = Schnellste
view.rankings = Rangliste
view.stats = Statistik
filter.all = Alle

# The strip over the list: your place on the board and your own numbers.
you.heading = Dein Stand
you.place = #{0, number}
you.place.label = Dein Rang
you.players = Spieler auf dieser Tafel: {0, number}
# A column you can click to rank by, when the column says nothing of its own.
tip.sort = Klicke, um alle danach zu ordnen.

