command.open.needs_player = Nur ein Spieler kann den Rekordbildschirm öffnen.
command.open.failed = Der Rekordbildschirm konnte nicht geöffnet werden. Versuche es gleich noch einmal.
command.encounter.unranked = '{0}' führt auf diesem Server keine Rekorde.
command.encounter.none = Noch kein Bosskampf hat einen Rekord.
command.encounter.off = Rekorde sind auf diesem Server abgeschaltet ($Enabled in mods/ziggfreedcommon/stats.json).
command.desc.clock = Verschiebe die Uhr der Rekordtafel, um eine Woche oder einen Monat wechseln zu sehen. 0 stellt sie zurück.
