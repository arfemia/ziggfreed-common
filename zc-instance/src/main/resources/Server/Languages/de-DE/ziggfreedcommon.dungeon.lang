# zc's dungeons (com.ziggfreed.common.instance.dungeon): /zigdungeon, the admin family, the words its lines
# nest, what a player is told when a way in refuses them, what to do once inside, a run's results screen and
# failure lines, and the Boss Fights tab of a fight fought in a dungeon. The file name is the key PREFIX: an
# entry here resolves as ziggfreedcommon.dungeon.<key>.

# /zigdungeon. The command.desc.* keys are what the engine's own help resolves a command or an argument through.
command.desc.family = Die Dungeons dieses Servers und ihre offenen Kopien ansehen oder in einen hineingehen.
command.desc.list = Jeden Dungeon auflisten und wie er eingerichtet ist.
command.desc.status = Die gerade offenen Dungeon-Kopien auflisten.
command.desc.close = Eine Dungeon-Kopie sofort schließen. Alle darin gehen dorthin zurück, wo sie hineingekommen sind.
command.desc.enter = Selbst in einen Dungeon gehen, in einen leeren Bereich.
command.desc.arg.copy = Die zu schließende Kopie, per Weltname, etwa crypt-1.
command.desc.arg.dungeon = Der Dungeon, in den es geht, per ID, etwa crypt.
command.list.none = Es sind keine Dungeons geladen.
command.list.header = {0, number} {0, plural, one {Dungeon} other {Dungeons}}:
command.list.dungeon = {0} ({1}): {2}. Schwierigkeit {3}, Saison {4}.
command.list.place = Vorlage {0}, Prefab {1}.
command.list.share = {0, number} {0, plural, one {Bereich} other {Bereiche}} je Kopie, {1, number} {1, plural, one {Block} other {Blöcke}} Abstand, {2, number} {2, plural, one {Spieler} other {Spieler}} je Bereich, {3}.
command.list.run = Spieler landen bei {0, number}, {1, number}, {2, number} in ihrem Bereich. {3}. Ein Wipe {4}. Eine Kopie schließt {5, number} {5, plural, one {Sekunde} other {Sekunden}}, nachdem sie sich geleert hat.
command.status.none = Es sind keine Dungeon-Kopien offen.
command.status.header = {0, number} {0, plural, one {Dungeon-Kopie} other {Dungeon-Kopien}} offen:
command.status.copy = {0} ({1}): {2, number} von {3, number} {3, plural, one {Bereich} other {Bereichen}} belegt, {4, number} {4, plural, one {Spieler} other {Spieler}} drinnen, {5, number} unterwegs. {6}. {7}.
command.close.done = {0} wird geschlossen. Alle darin gehen dorthin zurück, wo sie hineingekommen sind.
command.close.unknown = Keine Dungeon-Kopie namens {0} ist offen. /zigdungeon status listet die offenen auf.
command.enter.sent = Du wirst in {0} geschickt, Bereich {1, number} von {2}.
command.enter.unknown = Kein Dungeon namens {0} ist geladen. /zigdungeon list zeigt die geladenen.
command.enter.closed = {0} kann gerade nicht betreten werden: er ist {1}.
command.enter.no_prefab = {0} nennt kein Prefab, also wären seine Bereiche ein leeres Nichts.
command.enter.missing_prefab = {0} nennt das Prefab {1}, das kein geladenes Paket mitbringt.
command.enter.audit_error = {0} kann nicht betreten werden: Seine Dungeon-Datei enthält einen Fehler. Das Server-Log sagt, was zu beheben ist.
command.enter.on_the_way = Du bist schon auf dem Weg in einen Dungeon.
command.enter.inside = Du bist schon in einem Dungeon-Bereich. Verlasse ihn zuerst.
command.enter.full = Dieser Bereich ist voll.
command.enter.copy_gone = Diese Dungeon-Kopie wurde gerade geschlossen. Versuche es noch einmal.
command.enter.failed = Die Dungeon-Kopie konnte nicht geöffnet werden, oder die Teleportation wurde abgelehnt. Das Server-Log sagt, warum.

# Words the lines above nest.
state.open = offen
state.off = abgeschaltet
state.out_of_season = geschlossen, bis seine Saison läuft
difficulty.normal = normal
season.all_year = ganzjährig
prefab.none = nicht gesetzt
share.locked = eine Gruppe je Bereich
share.open = Gruppen teilen sich einen Bereich, solange Platz ist
run.limit = Läufe enden nach {0, number} {0, plural, one {Sekunde} other {Sekunden}}
run.no_limit = Kein Zeitlimit
wipe.fails = beendet den Lauf
wipe.ignored = beendet den Lauf nicht
status.tick = Tickt durchschnittlich in {0, number} ms
status.tick.unknown = Tick-Zeit noch nicht bekannt
status.taking = Nimmt Gruppen auf
status.empty = Leer, schließt in {0, number} {0, plural, one {Sekunde} other {Sekunden}}
status.closing = Wird geschlossen

# What a player is told when a way in (a block, a character, a conversation) cannot send them into a dungeon.
# {0} is the dungeon's name, {1} its season's. In entry.cost, {1} is the item the dungeon takes on the way in and
# {2} how many; the dungeon's own hint line, when it names one, shows under it.
entry.off = {0} ist vorerst geschlossen.
entry.out_of_season = {0} öffnet nur während {1}.
entry.out_of_season.unnamed = {0} öffnet nur in seiner Saison.
entry.full = In {0} ist kein Platz mehr für deine Gruppe.
entry.on_the_way = Du bist schon auf dem Weg in einen Dungeon.
entry.inside = Du bist schon in einem Dungeon. Verlasse ihn zuerst.
entry.copy_gone = {0} wurde geschlossen, gerade als du ankamst. Versuche es noch einmal.
entry.unavailable = {0} kann gerade nicht betreten werden.
entry.unavailable.unnamed = Dieser Dungeon kann gerade nicht betreten werden.
entry.cost = Du brauchst {1} x{2, number}, um {0} zu betreten.

# The results screen each member sees when their party clears a run. The screen paints most of these lines where
# a value cannot be filled in; only results.time (the run's length, m:ss) and results.team_total carry one.
results.cleared = Dungeon abgeschlossen
results.failed = Lauf gescheitert
results.time = Zeit {0}
results.breakdown = Dein Lauf
results.party = Deine Gruppe
results.damage = Schaden an Bossen
results.bosses = Besiegte Bosse
results.rewards = Belohnung für den Abschluss
results.no_rewards = Diesmal keine Belohnung für den Abschluss.
results.pending = Deine Taschen sind voll. Der Rest wartet unter Abholungen in deinem Menü.
results.claim = Abholen
results.claimed = Abgeholt.
results.records = Rekorde
results.again = Nochmal spielen
results.close = Schließen
results.team_total = Gesamt {0, number}
# The banner in place of that screen when the dungeon's Rewards.InChest puts the reward in the boss's chest: {0} is
# the dungeon's name; the line under it is the dungeon's Text.ChestKey, else the Claims tab's spoils.banner.
clear.banner = {0} abgeschlossen

# What a player reads a moment after they arrive in a dungeon area while its run is going. The dungeon's name
# heads it; under it, what to do there (the dungeon's own GoalKey line, else the lines below built from what
# clears a run), then the run's rules. {0} in goal.survive and goal.time_limit is a goal.time.* length.
goal.boss = Besiege den Boss.
goal.all_bosses = Besiege jeden Boss.
goal.objective = Erledige die Aufgabe des Dungeons.
goal.survive = Halte {0} durch.
goal.time_limit = Schließe innerhalb von {0} ab, sonst scheitert der Lauf.
goal.wipe = Fallen alle gleichzeitig, scheitert der Lauf.
goal.time.seconds = {0, number} {0, plural, one {Sekunde} other {Sekunden}}
goal.time.minutes = {0, number} {0, plural, one {Minute} other {Minuten}}
goal.time.minutes_seconds = {0, number} {0, plural, one {Minute} other {Minuten}} und {1, number} {1, plural, one {Sekunde} other {Sekunden}}

# What each member still in the area is told when their run fails. {0} is the dungeon's name.
run.failed.time_limit = In {0} ist die Zeit abgelaufen. Der Lauf ist gescheitert.
run.failed.wipe = Deine ganze Gruppe ist in {0} gefallen. Der Lauf ist gescheitert.

# Records' Boss Fights, for a fight fought inside a dungeon. {0} is the fight's name, {1} the dungeon's.
records.fight = {0} in {1}
