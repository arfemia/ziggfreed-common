# The stat board on Records: the page's own lines, its periods and its sections.
# The file name is the key PREFIX: an entry here resolves as ziggfreedcommon.statboard.<key>.
# Every line but your_rank, the duration lines and period.season (a season tab is a rich button) is
# painted where a parameter is never substituted, so only those take one. The column words the page
# shares with the boss records come from ziggfreedcommon.leaderboard.lang.

title = Rekorde
lead = Sieh, wie du im Vergleich zu allen auf diesem Server stehst. Klicke auf eine Spalte, um danach zu ordnen.
empty = Auf dieser Tafel steht noch niemand.
# What counts on a tab and how to get on it, for a player with no place there yet and under a board
# nobody is on. A section file names its own with HintKey; hint is for a tab that names none.
hint = Alles in diesen Spalten zählt. Tu irgendetwas davon, um auf diese Tafel zu kommen.
your_rank = Dein Rang: #{0, number}
your_rank.none = Du stehst noch nicht auf dieser Tafel.

# A playtime cell: hours and minutes, or minutes alone under an hour.
duration.hours = {0, number} Std. {1, number} Min.
duration.minutes = {0, number} Min.
since.today = Heute
since.days = Vor {0, number} {0, plural, one {Tag} other {Tagen}}

# The period tabs (Server/ZiggfreedCommon/StatPeriods).
period.all_time = Gesamt
period.weekly = Diese Woche
period.monthly = Dieser Monat
# A season tab, one per run of a calendar event: {0} is the event's name, {1} the year the run
# belongs to, a plain number that never takes digit grouping.
period.season = {0} {1}

# The section tabs (Server/ZiggfreedCommon/StatSections).
section.combat = Kampf
section.gathering = Sammeln
section.adventure = Abenteuer
section.dungeons = Dungeons
section.renown = Ansehen
section.bosses = Bosse
section.combat.hint = Besiege Mobs oder fordere einen Boss heraus, um auf diese Tafel zu kommen. Deine Tode zählen hier auch.
section.gathering.hint = Baue Blöcke ab oder platziere sie, stelle Gegenstände von Hand her oder sammle Dinge auf, um auf diese Tafel zu kommen.
section.adventure.hint = Schließe Quests ab, sprich mit Figuren, gewinne Runden oder spiel einfach, um auf diese Tafel zu kommen.
section.renown.hint = Schließe die Ziele des Spiels ab oder verdiene dir Ruf bei einer Fraktion, um auf diese Tafel zu kommen. Ansehen zählt nur für Gesamt.
section.bosses.hint = Hilf, einen Boss zu besiegen, um auf diese Tafel zu kommen.
section.dungeons.hint = Beginne, schließe ab oder scheitere an einem Dungeon-Lauf, um auf diese Tafel zu kommen.

# Die Aufteilung der Boss-Tafel: ihre erste Wahl, die Gruppen, in denen ein Boss steht, und die Gruppengrößen eines Bosses.
bosses.all = Alle Bosse
bosses.sizes.all = Alle Größen
bosses.size.solo = Solo
bosses.size.players = {0, number} Spieler
group.seasonal = Saisonal
group.dungeon = Dungeon
group.world = Welt
group.minigame = Minispiel

# Die Aufteilung der Dungeon-Tafel: ihre erste Wahl und die Schwierigkeiten eines Dungeons.
dungeons.all = Alle Dungeons
dungeons.difficulties.all = Alle Schwierigkeiten
difficulty.normal = Normal
difficulty.hard = Schwer
