# What a player reads a moment after they arrive in a dungeon area while its run is going. The dungeon's name
# heads it; under it, what to do there (the dungeon's own GoalKey line, else the lines below built from what
# clears a run), then the run's rules. {0} in goal.survive and goal.time_limit is a goal.time.* length.
goal.boss = Patronu yen.
goal.all_bosses = Her patronu yen.
goal.objective = Zindanın görevini bitir.
goal.survive = {0} boyunca dayan.
goal.time_limit = {0} içinde bitir, yoksa tur başarısız olur.
goal.wipe = Herkes aynı anda düşerse tur başarısız olur.
goal.time.seconds = {0, number} {0, plural, one {saniye} other {saniye}}
goal.time.minutes = {0, number} {0, plural, one {dakika} other {dakika}}
goal.time.minutes_seconds = {0, number} {0, plural, one {dakika} other {dakika}} {1, number} {1, plural, one {saniye} other {saniye}}

# What each member still in the area is told when their run fails. {0} is the dungeon's name.
run.failed.time_limit = {0} içinde süre doldu. Tur başarısız oldu.
run.failed.wipe = Bütün partin {0} içinde düştü. Tur başarısız oldu.

# Records' Boss Fights, for a fight fought inside a dungeon. {0} is the fight's name, {1} the dungeon's.
records.fight = {0}, {1} içinde
