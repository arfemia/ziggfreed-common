# The stat board on Records: the page's own lines, its periods and its sections.
# The file name is the key PREFIX: an entry here resolves as ziggfreedcommon.statboard.<key>.
# Every line but your_rank, the duration lines and period.season (a season tab is a rich button) is
# painted where a parameter is never substituted, so only those take one. The column words the page
# shares with the boss records come from ziggfreedcommon.leaderboard.lang.

title = Rekorlar
lead = Bu sunucudaki herkese göre nerede durduğuna bak. Sıralamak için bir sütuna tıkla.
empty = Bu panoda henüz kimse yok.
# What counts on a tab and how to get on it, for a player with no place there yet and under a board
# nobody is on. A section file names its own with HintKey; hint is for a tab that names none.
hint = Bu sütunlardaki her şey sayılır. Bu panoya girmek için herhangi birini yap.
your_rank = Sıran: #{0, number}
your_rank.none = Henüz bu panoda değilsin.

# A playtime cell: hours and minutes, or minutes alone under an hour.
duration.hours = {0, number} sa {1, number} dk
duration.minutes = {0, number} dk

# The period tabs (Server/ZiggfreedCommon/StatPeriods).
period.all_time = Tüm Zamanlar
period.weekly = Bu Hafta
period.monthly = Bu Ay
# A season tab, one per run of a calendar event: {0} is the event's name, {1} the year the run
# belongs to, a plain number that never takes digit grouping.
period.season = {0} {1}

# The section tabs (Server/ZiggfreedCommon/StatSections).
section.combat = Savaş
section.gathering = Toplama
section.adventure = Macera
section.renown = Şöhret
section.combat.hint = Bu panoya girmek için mob alt et ya da bir patronla dövüş. Ölümlerin de burada sayılır.
section.gathering.hint = Bu panoya girmek için blok kır ya da yerleştir, elle eşya üret ya da bir şeyler topla.
section.adventure.hint = Bu panoya girmek için görev bitir, karakterlerle konuş, tur kazan ya da sadece oyna.
section.renown.hint = Bu panoya girmek için oyunun hedeflerini tamamla ya da bir itibarda puan kazan. Şöhret yalnızca Tüm Zamanlar'a sayılır.
