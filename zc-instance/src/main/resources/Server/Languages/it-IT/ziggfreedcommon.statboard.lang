# The stat board on Records: the page's own lines, its periods and its sections.
# The file name is the key PREFIX: an entry here resolves as ziggfreedcommon.statboard.<key>.
# Every line but your_rank, the duration lines and period.season (a season tab is a rich button) is
# painted where a parameter is never substituted, so only those take one. The column words the page
# shares with the boss records come from ziggfreedcommon.leaderboard.lang.

title = Record
lead = Guarda come ti piazzi rispetto a tutti gli altri su questo server. Clicca su una colonna per ordinare in base a essa.
empty = Nessuno è ancora in questa classifica.
# What counts on a tab and how to get on it, for a player with no place there yet and under a board
# nobody is on. A section file names its own with HintKey; hint is for a tab that names none.
hint = Tutto ciò che sta in queste colonne conta. Basta una qualsiasi di queste cose per entrare in questa classifica.
your_rank = La tua posizione: #{0, number}
your_rank.none = Non sei ancora in questa classifica.

# A playtime cell: hours and minutes, or minutes alone under an hour.
duration.hours = {0, number}h {1, number}m
duration.minutes = {0, number}m

# The period tabs (Server/ZiggfreedCommon/StatPeriods).
period.all_time = Di sempre
period.weekly = Questa settimana
period.monthly = Questo mese
# A season tab, one per run of a calendar event: {0} is the event's name, {1} the year the run
# belongs to, a plain number that never takes digit grouping.
period.season = {0} {1}

# The section tabs (Server/ZiggfreedCommon/StatSections).
section.combat = Combattimento
section.gathering = Raccolta
section.adventure = Avventura
section.renown = Fama
section.combat.hint = Sconfiggi dei mob o affronta un boss per entrare in questa classifica. Anche le tue morti contano qui.
section.gathering.hint = Rompi o piazza blocchi, fabbrica oggetti a mano o raccogli cose per entrare in questa classifica.
section.adventure.hint = Completa missioni, parla con i personaggi, vinci round o semplicemente gioca per entrare in questa classifica.
section.renown.hint = Completa gli obiettivi del gioco o guadagna stima con una reputazione per entrare in questa classifica. La Fama conta solo per Di sempre.
section.boss_fights.hint = Aiuta a sconfiggere questo boss per entrare nella sua classifica.
