# zc's dungeons (com.ziggfreed.common.instance.dungeon): /zigdungeon, the admin family, the words its lines
# nest, what a player is told when a way in refuses them, what to do once inside, a run's results screen and
# failure lines, and the Boss Fights tab of a fight fought in a dungeon. The file name is the key PREFIX: an
# entry here resolves as ziggfreedcommon.dungeon.<key>.

# /zigdungeon. The command.desc.* keys are what the engine's own help resolves a command or an argument through.
command.desc.family = Guarda i dungeon di questo server e le copie che hanno aperte, oppure entra in uno.
command.desc.list = Elenca ogni dungeon e come è impostato.
command.desc.status = Elenca le copie di dungeon aperte in questo momento.
command.desc.close = Chiude subito una copia di dungeon. Tutti quelli dentro tornano da dove sono entrati.
command.desc.enter = Entra tu stesso in un dungeon, in un'area vuota.
command.desc.arg.copy = La copia da chiudere, con il nome del suo mondo, come crypt-1.
command.desc.arg.dungeon = Il dungeon in cui entrare, con il suo id, come crypt.
command.list.none = Nessun dungeon è caricato.
command.list.header = {0, number} {0, plural, one {dungeon} other {dungeon}}:
command.list.dungeon = {0} ({1}): {2}. Difficoltà {3}, stagione {4}.
command.list.place = Modello {0}, prefab {1}.
command.list.share = {0, number} {0, plural, one {area} other {aree}} a copia, {1, number} {1, plural, one {blocco} other {blocchi}} di distanza, {2, number} {2, plural, one {giocatore} other {giocatori}} per area, {3}.
command.list.run = I giocatori arrivano a {0, number}, {1, number}, {2, number} nella loro area. {3}. Una sconfitta totale {4}. Una copia si chiude {5, number} {5, plural, one {secondo} other {secondi}} dopo che si svuota.
command.status.none = Nessuna copia di dungeon è aperta.
command.status.header = {0, number} {0, plural, one {copia} other {copie}} di dungeon {0, plural, one {aperta} other {aperte}}:
command.status.copy = {0} ({1}): {2, number} di {3, number} {3, plural, one {area} other {aree}} in uso, {4, number} {4, plural, one {giocatore} other {giocatori}} dentro, {5, number} in arrivo. {6}. {7}.
command.close.done = Chiusura di {0}. Tutti quelli dentro tornano da dove sono entrati.
command.close.unknown = Nessuna copia di dungeon chiamata {0} è aperta. /zigdungeon status elenca quelle aperte.
command.enter.sent = Ti mando dentro {0}, area {1, number} di {2}.
command.enter.unknown = Nessun dungeon chiamato {0} è caricato. /zigdungeon list mostra quelli caricati.
command.enter.closed = Non si può entrare in {0} in questo momento: è {1}.
command.enter.no_prefab = {0} non indica nessun prefab, quindi le sue aree sarebbero vuoto assoluto.
command.enter.missing_prefab = {0} indica il prefab {1}, che nessun pacchetto caricato fornisce.
command.enter.audit_error = Non si può entrare in {0}: il suo file del dungeon ha un errore. Il registro del server dice cosa correggere.
command.enter.on_the_way = Stai già entrando in un dungeon.
command.enter.inside = Sei già in un'area di dungeon. Prima esci.
command.enter.full = Quell'area è piena.
command.enter.copy_gone = Quella copia di dungeon si è appena chiusa. Riprova.
command.enter.failed = La copia di dungeon non si è potuta aprire, o il teletrasporto è stato rifiutato. Il registro del server dice perché.

# Words the lines above nest.
state.open = aperto
state.off = disattivato
state.out_of_season = chiuso finché non arriva la sua stagione
difficulty.normal = normale
season.all_year = tutto l'anno
prefab.none = nessuno impostato
share.locked = un gruppo per area
share.open = i gruppi condividono un'area finché c'è posto
run.limit = Le partite finiscono dopo {0, number} {0, plural, one {secondo} other {secondi}}
run.no_limit = Nessun limite di tempo
wipe.fails = chiude la partita
wipe.ignored = non chiude la partita
status.tick = Tick in {0, number} ms in media
status.tick.unknown = Tempo di tick non ancora noto
status.taking = Accetta gruppi
status.empty = Vuota, si chiude tra {0, number} {0, plural, one {secondo} other {secondi}}
status.closing = In chiusura

# What a player is told when a way in (a block, a character, a conversation) cannot send them into a dungeon.
# {0} is the dungeon's name, {1} its season's. In entry.cost, {1} is the item the dungeon takes on the way in and
# {2} how many; the dungeon's own hint line, when it names one, shows under it.
entry.off = {0} è chiuso per ora.
entry.out_of_season = {0} apre solo durante {1}.
entry.out_of_season.unnamed = {0} apre solo nella sua stagione.
entry.full = Non c'è più posto per il tuo gruppo in {0}.
entry.on_the_way = Stai già entrando in un dungeon.
entry.inside = Sei già in un dungeon. Prima esci.
entry.copy_gone = {0} si è chiuso proprio mentre arrivavi. Riprova.
entry.unavailable = Non si può entrare in {0} in questo momento.
entry.unavailable.unnamed = In quel dungeon non si può entrare in questo momento.
entry.cost = Ti serve {1} x{2, number} per entrare in {0}.

# The results screen each member sees when their party clears a run. The screen paints most of these lines where
# a value cannot be filled in; only results.time (the run's length, m:ss) and results.team_total carry one.
results.cleared = Dungeon completato
results.failed = Partita fallita
results.time = Tempo {0}
results.breakdown = La tua partita
results.party = Il tuo gruppo
results.damage = Danni ai boss
results.bosses = Boss sconfitti
results.rewards = Ricompensa di completamento
results.no_rewards = Nessuna ricompensa di completamento stavolta.
results.pending = Le tue borse sono piene. Il resto ti aspetta sotto Ricompense nel tuo menu.
results.claim = Ritira
results.claimed = Ritirato.
results.records = Record
results.again = Gioca Ancora
results.close = Chiudi
results.team_total = Totale {0, number}

# What a player reads a moment after they arrive in a dungeon area while its run is going. The dungeon's name
# heads it; under it, what to do there (the dungeon's own GoalKey line, else the lines below built from what
# clears a run), then the run's rules. {0} in goal.survive and goal.time_limit is a goal.time.* length.
goal.boss = Sconfiggi il boss.
goal.all_bosses = Sconfiggi ogni boss.
goal.objective = Porta a termine il compito del dungeon.
goal.survive = Resisti per {0}.
goal.time_limit = Finisci entro {0}, o la partita fallisce.
goal.wipe = Se cadete tutti insieme, la partita fallisce.
goal.time.seconds = {0, number} {0, plural, one {secondo} other {secondi}}
goal.time.minutes = {0, number} {0, plural, one {minuto} other {minuti}}
goal.time.minutes_seconds = {0, number} {0, plural, one {minuto} other {minuti}} e {1, number} {1, plural, one {secondo} other {secondi}}

# What each member still in the area is told when their run fails. {0} is the dungeon's name.
run.failed.time_limit = Il tempo è scaduto in {0}. La partita è fallita.
run.failed.wipe = Tutto il tuo gruppo è caduto in {0}. La partita è fallita.

# Records' Boss Fights, for a fight fought inside a dungeon. {0} is the fight's name, {1} the dungeon's.
records.fight = {0} in {1}
