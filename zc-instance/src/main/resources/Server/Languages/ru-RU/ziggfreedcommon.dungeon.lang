status.taking = Принимает группы
status.empty = Пусто, закроется через {0, number} {0, plural, one {секунду} few {секунды} many {секунд} other {секунды}}
status.closing = Закрывается

# What a player is told when a way in (a block, a character, a conversation) cannot send them into a dungeon.
# {0} is the dungeon's name, {1} its season's. In entry.cost, {1} is the item the dungeon takes on the way in and
# {2} how many; the dungeon's own hint line, when it names one, shows under it.
entry.off = {0} пока закрыто.
entry.out_of_season = {0} открывается только в период: {1}.
entry.out_of_season.unnamed = {0} открывается только в свой сезон.
entry.full = В {0} больше нет места для вашей группы.
entry.on_the_way = Вы уже идёте в подземелье.
entry.inside = Вы уже в подземелье. Сначала выйдите.
entry.copy_gone = {0} закрылось, как только вы пришли. Повторите.
entry.unavailable = В {0} сейчас нельзя войти.
entry.unavailable.unnamed = В это подземелье сейчас нельзя войти.
entry.cost = Чтобы войти в {0}, нужно: {1} x{2, number}.

# The results screen each member sees when their party clears a run. The screen paints most of these lines where
# a value cannot be filled in; only results.time (the run's length, m:ss) and results.team_total carry one.
results.cleared = Подземелье пройдено
results.failed = Забег провален
results.time = Время {0}
results.breakdown = Ваш забег
results.party = Ваша группа
results.damage = Урон боссам
results.bosses = Побеждено боссов
results.rewards = Награда за прохождение
results.no_rewards = На этот раз награды за прохождение нет.
results.pending = Ваши сумки полны. Остальное ждёт в разделе «Награды» вашего меню.
results.claim = Забрать
results.claimed = Забрано.
results.records = Рекорды
results.again = Играть снова
results.close = Закрыть
results.team_total = Итого {0, number}

# What a player reads a moment after they arrive in a dungeon area while its run is going. The dungeon's name
# heads it; under it, what to do there (the dungeon's own GoalKey line, else the lines below built from what
# clears a run), then the run's rules. {0} in goal.survive and goal.time_limit is a goal.time.* length.
goal.boss = Победите босса.
goal.all_bosses = Победите всех боссов.
goal.objective = Выполните задачу подземелья.
goal.survive = Продержитесь {0}.
goal.time_limit = Уложитесь в {0}, иначе забег провален.
goal.wipe = Если все падут разом, забег провален.
goal.time.seconds = {0, number} {0, plural, one {секунда} few {секунды} many {секунд} other {секунды}}
goal.time.minutes = {0, number} {0, plural, one {минута} few {минуты} many {минут} other {минуты}}
goal.time.minutes_seconds = {0, number} {0, plural, one {минута} few {минуты} many {минут} other {минуты}} и {1, number} {1, plural, one {секунда} few {секунды} many {секунд} other {секунды}}

# What each member still in the area is told when their run fails. {0} is the dungeon's name.
run.failed.time_limit = Время в {0} вышло. Забег провален.
run.failed.wipe = Вся ваша группа пала в {0}. Забег провален.

# Records' Boss Fights, for a fight fought inside a dungeon. {0} is the fight's name, {1} the dungeon's.
records.fight = {0} в {1}
