# The stat board on Records: the page's own lines, its periods and its sections.
# The file name is the key PREFIX: an entry here resolves as ziggfreedcommon.statboard.<key>.
# Every line but your_rank, the duration lines and period.season (a season tab is a rich button) is
# painted where a parameter is never substituted, so only those take one. The column words the page
# shares with the boss records come from ziggfreedcommon.leaderboard.lang.

title = Рекорды
lead = Узнайте, какое место вы занимаете среди всех игроков сервера. Нажмите на столбец, чтобы упорядочить по нему.
empty = На этой доске пока никого нет.
# What counts on a tab and how to get on it, for a player with no place there yet and under a board
# nobody is on. A section file names its own with HintKey; hint is for a tab that names none.
hint = Учитывается всё, что есть в этих столбцах. Сделайте что-нибудь из этого, чтобы попасть на эту доску.
your_rank = Ваше место: №{0, number}
your_rank.none = Вас на этой доске пока нет.

# A playtime cell: hours and minutes, or minutes alone under an hour.
duration.hours = {0, number} ч {1, number} мин
duration.minutes = {0, number} мин

# The period tabs (Server/ZiggfreedCommon/StatPeriods).
period.all_time = За всё время
period.weekly = Эта неделя
period.monthly = Этот месяц
# A season tab, one per run of a calendar event: {0} is the event's name, {1} the year the run
# belongs to, a plain number that never takes digit grouping.
period.season = {0} {1}

# The section tabs (Server/ZiggfreedCommon/StatSections).
section.combat = Бой
section.gathering = Добыча
section.adventure = Приключения
section.renown = Слава
section.combat.hint = Побеждайте мобов или бросьте вызов боссу, чтобы попасть на эту доску. Ваши смерти здесь тоже учитываются.
section.gathering.hint = Ломайте или ставьте блоки, создавайте предметы вручную или подбирайте вещи, чтобы попасть на эту доску.
section.adventure.hint = Выполняйте квесты, разговаривайте с персонажами, выигрывайте раунды или просто играйте, чтобы попасть на эту доску.
section.renown.hint = Выполняйте цели игры или повышайте репутацию, чтобы попасть на эту доску. Слава учитывается только в разделе «За всё время».
