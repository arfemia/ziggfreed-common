# The library's own words for a records screen (the column, sort and view words every records page
# shares, Records' Boss Fights included), so they read on a server running nothing else.
# The file name is the key PREFIX: an entry here resolves as ziggfreedcommon.leaderboard.<key>.
# The screen paints every line on a label's TextSpans, so a line may take a parameter, except a
# tooltip (tip.*), which prints one as written. A fight names its own screen through its binding
# row's NameKey; title is the fallback.

title = Boss Records
axis.difficulty = Difficulty
axis.players = Players
axis.sort = Sort
axis.view = View
col.rank = Rank
col.player = Player
col.score = Best Share
col.total = Total
col.time = Fastest
col.plays = Fights
empty = Nobody has a record for this fight here yet.
sort.score = Best Share
sort.total = Total Points
sort.time = Fastest
view.rankings = Rankings
view.stats = Stats
filter.all = All
your_rank = Your best: #{0, number} ({1, number})
your_rank.none = You have no record for this fight here yet.

# The strip over the list: your place on the board and your own numbers.
you.heading = Your standing
you.place = #{0, number}
you.place.label = Your rank
you.players = Players on this board: {0, number}
# A column you can click to rank by, when the column says nothing of its own.
tip.sort = Click to rank everyone by this.

# /zigleaderboard, the command that opens Records' Boss Fights. The command.desc.* keys are what the
# engine's own help resolves a command or an argument through.
command.desc.family = See the records of this server's boss fights.
command.desc.encounter = Open a boss fight's records.
command.desc.arg.encounter = The fight's encounter script id. Leave it out to open the first fight on record.
command.open.needs_player = Only a player can open the records screen.
command.open.failed = The records screen could not open. Try again in a moment.
command.encounter.unranked = '{0}' keeps no records on this server.
command.encounter.none = No boss fight has a record yet.
command.encounter.off = Records are switched off on this server ($Enabled in mods/ziggfreedcommon/stats.json).
command.desc.clock = Move the records board's clock to see a week or a month turn over. 0 puts it back.
command.desc.arg.offset = How far to move it: 7d, 12h or 30m, with a minus sign to go back, or 0.
command.clock.bad_offset = '{0}' is not a time to move by. Try 7d, 12h, 30m, -1d or 0.
command.clock.set = The records board's clock now runs {0} off the server's.
command.clock.reset = The records board is back on the server's clock.
command.clock.shifted = While the clock is shifted, stats count only toward All Time. The weeks and months fill again after you set it back to 0.
command.clock.window = {0} reads {1}
command.clock.window.none = {0} has not started yet

# The shared menu's tab for the records this server keeps (the stat board and its boss fights).
menu.records = Records
# The tab on the stat board's first row that opens the boss fights' records, and that section's name.
records.boss_fights = Boss Fights
