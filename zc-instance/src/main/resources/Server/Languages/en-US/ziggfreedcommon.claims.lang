# The Claims tab (com.ziggfreed.common.instance.claims): the rewards a player has earned and not taken
# yet, waiting until they press Claim. The file name is the key PREFIX: an entry here resolves as
# ziggfreedcommon.claims.<key>. menu.tab is a rail label: 20 characters at most once uppercased.

menu.tab = Claims
page.title = Claims
page.lead = Rewards you have earned wait here until you take them.
page.section = Waiting
row.rewards = {0, number} {0, plural, one {reward} other {rewards}}
detail.rewards = Rewards
detail.lead = Claim takes these. Claim All takes everything waiting.
detail.hint = Items need room in your bags. Whatever does not fit stays here for later.
action.claim = Claim
action.claim_all = Claim All
empty.title = Nothing to claim
empty.line = Rewards from bosses and events wait here until you take them.
untitled = Rewards

# A reward chip nothing else could name (a Claim's row, a results screen's): {0} is how many.
chip.generic = x{0, number} Reward

# What a press says, over the page.
toast.claimed = Claimed.
toast.claimed_all = Claimed everything that was waiting.
toast.kept = Your bags are full. What did not fit is still waiting here.
toast.failed = Claimed, but part of it could not be handed over on this server.

# Telling a player something waits: the toast when a Claim arrives, and the notice once a session at login.
# notice.added is a Claim with no title of its own; notice.added.named one with a title, {0}; notice.added.many
# heads several Claims that arrived together, each on a row under it.
notice.added = A reward is waiting for you. Find it under Claims in your menu.
notice.added.named = {0} is waiting under Claims in your menu.
notice.added.many = Rewards are waiting under Claims in your menu.
notice.ready = {0, number} {0, plural, one {reward is} other {rewards are}} waiting for you under Claims in your menu.
# A reward from a boss that left a chest where it fell: it waits in the chest and under Claims alike. notice.added.spoils
# is a Claim with no title of its own, or the line over several; notice.added.spoils.named one with a title, {0}.
notice.added.spoils = Your share is waiting in the chest where the boss fell, and under Claims in your menu.
notice.added.spoils.named = {0} is waiting in the chest where the boss fell, and under Claims in your menu.

# A boss's chest: what a won fight leaves where the boss fell, holding each player's own rewards from that fight.
# spoils.hint is the prompt over the chest; the game fills {key} with the button to press. Opening any reward chest
# shows one page: spoils.title over the chest's own line (spoils.lead for a boss's), each reward a line a click
# takes, spoils.page.hint beside the spoils.action.take_all button, and spoils.all_taken once the player has taken
# everything. spoils.empty is the line for a player with nothing in it. spoils.detail.lead, spoils.detail.hint,
# spoils.items_left and spoils.action.items belong to the Claims page's chest modes, which no chest opens now, and
# spoils.paid is no longer shown. spoils.banner is the line under a banner telling a player their reward went into
# the chest, when the source's own file names no line of its own.
spoils.hint = Press [{key}] to open
spoils.paid = From the chest:
spoils.title = Your share
spoils.lead = What this boss left for you. Whatever you leave here waits for you under Claims.
spoils.detail.lead = Claim takes these. Take All takes everything here that is yours.
spoils.detail.hint = Items need room in your bags. Whatever does not fit waits under Claims.
spoils.action.take_all = Take All
spoils.page.hint = Click a reward to take it, or Take All for everything. Items need room in your bags.
spoils.all_taken = You took everything.
spoils.empty = Nothing in here is waiting for you.
spoils.items_left = The rest of your share is in the chest.
spoils.action.items = Open the Chest
spoils.banner = Your reward waits in the chest where the boss fell.

# A reward chest that is not a boss's: one a rare kill, a rare break or another source leaves, holding each player's
# own share. chest.lead is the line on its page. notice.added.chest is the toast when a reward lands in it, and
# notice.added.chest.named the same for a reward with a title of its own, {0}. chest.banner.title is the banner as it
# goes up, {0} what left it (a creature, a block), over chest.banner.
chest.lead = What was left for you. Whatever you leave here waits for you under Claims.
chest.banner.title = {0} left a chest
chest.banner = Open it to take your share. Whatever you leave waits under Claims.
notice.added.chest = Your share is waiting in the chest nearby, and under Claims in your menu.
notice.added.chest.named = {0} is waiting in the chest nearby, and under Claims in your menu.

# A Claim's title when /zigclaims give wrote it: {0} is the loot table's id.
title.admin = Loot from {0}

# /zigclaims, the admin family. The command.desc.* keys are what the engine's own help resolves a command
# or an argument through.
command.desc.family = Put rewards in players' Claims.
command.desc.give = Roll a loot table and put what it lands in a player's Claims.
command.desc.arg.player = The player, online or not: a name or a player id. Defaults to you.
command.desc.arg.player.online = The player, who has to be online: a name or a player id. Defaults to you.
command.desc.arg.lootable = The loot table to roll, by its id.
command.player.needed = Name a player with --player=<name>.
command.player.offline = That player is not in a world right now. Try again in a moment.
command.player.unknown = Could not find a player called '{0}'. Their player id works too.
command.lootable.needed = Name a loot table with --lootable=<id>.
command.lootable.unknown = No loot table called '{0}' is loaded.
command.give.done = Put {2, number} {2, plural, one {reward} other {rewards}} from {0} in {1}'s Claims.
command.give.nothing = {0} landed nothing for {1}, so no Claim was written.
# /zigclaims chest. In command.chest.done {0} is the chest's id, {1} the player and {2} the loot table's id; in
# command.chest.nothing {0} is the loot table's id and {1} the player.
command.desc.chest = Stand a reward chest next to a player, holding a loot table's roll for them.
command.desc.arg.chest = The reward chest to stand, by its id. Defaults to Zc_Reward_Chest.
command.chest.unknown = No reward chest called '{0}' is loaded.
command.chest.done = Stood {0} next to {1}, holding what {2} landed for them.
command.chest.nothing = {0} landed nothing for {1}, so no chest went up.
command.chest.failed = The chest could not be stood. The server log says why.
