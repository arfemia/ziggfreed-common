$C = "../Common.ui";
$F = "../Common/ZigFrames.ui";
$Z = "../Common/ZigButtons.ui";
$ZT = "../Common/ZigType.ui";
$ZK = "../Common/ZigTokens.ui";
$ZW = "../Common/ZigKit.ui";

// The storefront page (com.ziggfreed.common.commerce.page.ZigShopPage), in the look of vanilla's Memories page
// (Pages/Memories/MemoriesPanel.ui): its size and centring, the runes pane under a grid of tiles on the left, the
// secondary container on the right for the ware being read.
//
// TOP: the shop's name and icon, then one strip holding what the buyer carries (#BalanceRow, one
// Pages/ZigCommerceChip.ui per wallet the shop authored, side by side), the two list filters (#FilterRow: a run of
// the catalogue by name, and rotating vs standing stock, hidden until there are runs) and a count.
//
// LEFT: #LeftPanel, the panel a consumer's theme repaints, holding #OfferList: one Pages/ZigTileSection.ui per run
// (rotating shelves first, each heading carrying its countdown, then the standing catalogue by category), each
// holding its Pages/ZigWareTile.ui tiles, all appended through the kit's TilePainter. #EmptyLabel carries the one line
// an empty or filtered-to-nothing storefront shows.
//
// RIGHT: #RightPanel, hidden outright when nothing is selected: the ware's name, its category, its picture, then a
// scrolling #DetailBody whose appended containers (#CostRow, #RewardsList, #StatusList) take chips or
// Pages/ZigDetailLine.ui rows, CLEARED before each re-render, and the reroll price and the two actions at the foot.
//
// Every labeled button here is a Button + inner Label #Label, never a TextButton: an offer title, a price and a
// reward line are all parameterized Messages, and those only substitute on .TextSpans. The action buttons default
// Visible:false and the page flips exactly the ones a state offers, so there is never a control that does nothing.

$C.@PageOverlay {
  LayoutMode: Middle;

  $F.@ZigDecoratedFrame {
    @CloseButton = true;
    @Ornaments = true;
    Anchor: (Width: 1070, Height: 825);

    #Content {
      Anchor: (Top: 0);
      LayoutMode: Top;
      Padding: (Horizontal: 20, Top: 16, Bottom: 18);

      Group #TitleRow {
        LayoutMode: Left;
        Anchor: (Height: 34, Bottom: 6);

        Group #ShopIconSlot {
          Anchor: (Width: 22, Height: 22, Top: 6, Right: 10);
          ItemGrid #ShopIcon {
            Anchor: (Width: 22, Height: 22);
            SlotsPerRow: 1;
            AreItemsDraggable: false;
            DisplayItemQuantity: false;
            Style: $Z.@ZigIconGrid22;
          }
        }

        Label #ShopTitle {
          FlexWeight: 1;
          Text: "";
          Anchor: (Height: 34);
          Style: (FontSize: $ZT.@ZigFontTitle, TextColor: $ZK.@ZigAccent, FontName: "Secondary", RenderBold: true, RenderUppercase: true, LetterSpacing: 0.5, VerticalAlignment: Center);
        }
      }

      Group #HeaderRow {
        LayoutMode: Left;
        Anchor: (Height: 34, Bottom: 10);

        // One chip per wallet, side by side, each as wide as its words.
        Group #BalanceRow {
          LayoutMode: Left;
          FlexWeight: 1;
          Anchor: (Height: 30, Top: 2);
        }

        // The two list filters. Hidden until the page has runs to offer; an empty dropdown filtering nothing is noise.
        Group #FilterRow {
          LayoutMode: Left;
          Anchor: (Width: 340, Height: 34);
          Visible: false;

          $C.@DropdownBox #RunFilter {
            Anchor: (Width: 200, Height: $C.@SmallButtonHeight);
          }

          Group { Anchor: (Width: 8); }

          $C.@DropdownBox #KindFilter {
            Anchor: (Width: 132, Height: $C.@SmallButtonHeight);
          }
        }

        Label #OfferCount {
          Text: "";
          Anchor: (Width: 120, Height: 34, Left: 12);
          Style: (FontSize: $ZT.@ZigFontCaption, TextColor: $ZK.@ZigInkMuted, HorizontalAlignment: End, VerticalAlignment: Center);
        }
      }

      Group #Panes {
        LayoutMode: Left;
        FlexWeight: 1;

        Group #LeftPanel {
          FlexWeight: 1;
          Background: (TexturePath: "../Pages/Memories/MemoriesRunes.png", Border: 15);
          LayoutMode: Top;
          Padding: (Left: 16, Right: 6, Vertical: 14);

          Group #OfferList {
            FlexWeight: 1;
            LayoutMode: TopScrolling;
            ScrollbarStyle: $C.@DefaultScrollbarStyle;
            // The scrollbar rides the right edge of this list, so the tiles keep clear of it here.
            Padding: (Right: 10);
          }

          Label #EmptyLabel {
            Text: "";
            Visible: false;
            Anchor: (Height: 40, Top: 8);
            Style: (FontSize: $ZT.@ZigFontBody, TextColor: $ZK.@ZigInkMuted, HorizontalAlignment: Center, Wrap: true);
          }
        }

        Group #RightPanel {
          Anchor: (Width: 420, Left: 12);
          Background: (TexturePath: "../Pages/Memories/ContainerBackgroundSecondary.png", Border: 23);
          LayoutMode: Top;
          Padding: (Horizontal: 24, Top: 24, Bottom: 20);

          Label #DetailTitle {
            Text: "";
            Anchor: (Bottom: 2);
            Style: (FontSize: $ZT.@ZigFontDisplay, TextColor: $ZK.@ZigInkStrong, FontName: "Secondary", RenderBold: true, RenderUppercase: true, LetterSpacing: 0.5, HorizontalAlignment: Center, Wrap: true);
          }

          Label #DetailCategory {
            Text: "";
            Visible: false;
            Anchor: (Height: 20);
            Style: (FontSize: $ZT.@ZigFontCaption, TextColor: $ZK.@ZigInkMuted, RenderBold: true, RenderUppercase: true, LetterSpacing: 1, HorizontalAlignment: Center, VerticalAlignment: Center);
          }

          Group #DetailPicRow {
            LayoutMode: Center;
            Anchor: (Height: $ZK.@ZigPicLarge, Vertical: 12);

            $ZW.@ZigPicture #DetailPic {
              @Size = $ZK.@ZigPicLarge;
            }
          }

          Group #DetailBody {
            FlexWeight: 1;
            LayoutMode: TopScrolling;
            ScrollbarStyle: $C.@DefaultScrollbarStyle;
            Padding: (Right: 8);

            Label #Flavor {
              Text: "";
              Visible: false;
              Anchor: (Bottom: 12);
              Style: (FontSize: $ZT.@ZigFontBody, TextColor: $ZK.@ZigInkBody, HorizontalAlignment: Center, Wrap: true);
            }

            Group { Anchor: (Height: 1, Bottom: 12); Background: (Color: $ZK.@ZigDivider); }

            Label #CostHeader {
              Text: "";
              Anchor: (Height: 20, Bottom: 6);
              Style: $Z.@ZigSectionHeaderStyle;
            }

            Group #CostRow {
              LayoutMode: Left;
              Anchor: (Height: 30, Bottom: 6);
            }

            Label #LimitLabel {
              Text: "";
              Visible: false;
              Anchor: (Height: 20, Bottom: 12);
              Style: (FontSize: $ZT.@ZigFontCaption, TextColor: $ZK.@ZigInkMuted, VerticalAlignment: Center);
            }

            Label #RewardsHeader {
              Text: "";
              Visible: false;
              Anchor: (Height: 20, Top: 6, Bottom: 6);
              Style: $Z.@ZigSectionHeaderStyle;
            }

            Group #RewardsList {
              LayoutMode: Top;
              Anchor: (Bottom: 12);
            }

            Group #StatusList {
              LayoutMode: Top;
              Anchor: (Bottom: 12);
            }
          }

          Group #RerollCostRow {
            LayoutMode: Left;
            Visible: false;
            Anchor: (Height: 30, Top: 6, Bottom: 6);
          }

          Group #ActionRow {
            LayoutMode: Left;
            Anchor: (Height: 40, Top: 6);

            Group { FlexWeight: 1; }

            Button #RerollBtn {
              Style: $Z.@ZigRichRowBtnStyle;
              Anchor: (Width: 130, Height: 36, Right: 8);
              Visible: false;
              Label #Label {
                FlexWeight: 1;
                Text: "";
                Style: (FontSize: $ZT.@ZigFontBody, TextColor: #c6d4e4, HorizontalAlignment: Center, VerticalAlignment: Center);
              }
            }

            Button #BuyBtn {
              Style: $Z.@ZigRichPrimaryBtnStyle;
              Anchor: (Width: 160, Height: 36);
              Visible: false;
              Label #Label {
                FlexWeight: 1;
                Text: "";
                Style: (FontSize: $ZT.@ZigFontBody, TextColor: #eef4fb, HorizontalAlignment: Center, VerticalAlignment: Center);
              }
            }

            Group { FlexWeight: 1; }
          }
        }
      }
    }
  }
}
