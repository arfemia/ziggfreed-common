$Z = "../Common/ZigButtons.ui";

// One line of a commerce detail panel: a step and its count, a reward and its picture, or a reason
// something is out of reach. ONE template for all three, because the three differ in what they SAY
// rather than in what they are, and a page that appended three near-identical templates would be
// three places to fix a spacing change.
//
// The icon slot is hidden until a line has a picture to show. A reward with no item behind it (a
// payout of experience, a title) renders as its line alone rather than borrowing an unrelated item's
// picture, which would read as a promise of that item.
//
// All text lands on #LineText.TextSpans: a Message on a Label's .Text neither substitutes {0} nor
// renders markup.

Group #ZigCommerceLine {
  LayoutMode: Left;
  Anchor: (Height: 22, Bottom: 2);

  Group #LineIconSlot {
    Anchor: (Width: 20, Height: 20, Right: 8);
    Visible: false;
    ItemGrid #LineIcon {
      Anchor: (Width: 20, Height: 20);
      SlotsPerRow: 1;
      AreItemsDraggable: false;
      DisplayItemQuantity: false;
      Style: $Z.@ZigIconGrid20;
    }
  }

  Label #LineText {
    FlexWeight: 1;
    Text: "";
    Style: (FontSize: 12, TextColor: #c6d4e4, VerticalAlignment: Center);
  }
}
