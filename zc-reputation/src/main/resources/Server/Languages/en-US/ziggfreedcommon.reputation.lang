# What the reputation module says to players. The file name is the key PREFIX: an entry here resolves
# as ziggfreedcommon.reputation.<key>.

# The seven ranks of the server's one ladder, used wherever a reputation names no rank of its own.
rank.hated = Hated
rank.unfriendly = Unfriendly
rank.neutral = Neutral
rank.friendly = Friendly
rank.honored = Honored
rank.revered = Revered
rank.exalted = Exalted
# Shown when the server has no usable ladder (fewer than two ranks).
rank.none = Unranked

# How a requirement on a reputation reading is named when no pack names its own reputation.
factor.reputation = standing with a reputation
factor.reputation_rank = a rank with a reputation
# A lock line's name for a rank gate on a reputation that names itself: {0} the rank, {1} the reputation.
factor.rank_with = {0} with {1}

# A reputation reward as it reads in a reward list: {0} the amount, {1} the reputation's name.
reward.gain = +{0, number} {1}
reward.loss = {0, number} {1}

# The notice when a player's rank rises during play: {0} the new rank, then the reputation's name.
feedback.rank.title = You are now {0}
feedback.rank.with = with {0}

# The notice when standing past the top rank earns a reward that waits to be collected: {0} the reputation's
# name.
feedback.beyond.title = A reward from {0} is waiting
feedback.beyond.line = Collect it on your Reputation page.

# A REPUTATION_RANK step: {1} is the rank it names. The .any twin reads when a step names no rank.
objective.reputation_rank = Reach {1}
objective.reputation_rank.any = Reach a new rank

# The Reputation page.
page.title = Reputation
page.lead = How well the people and powers of this world know you. Help them out to climb the ranks, and each rank opens something new.
page.empty.title = Nobody knows you yet
page.empty = Help someone out and they show up here.
# The list's one section.
page.section = Who knows you

# A row's second line. {0} how far, {1} the next rank.
row.next = {0, number} to {1}
# Past the top rank: {0} how much more earns the next reward.
row.reward = {0, number} to the next reward
row.top = Top rank reached

# The reading page. The pill under the name: {0} the rank held.
detail.rank = Your rank: {0}
# Over the bar: {0} how far into the rank, {1} the whole rank, {2} the next rank.
detail.standing = {0, number} / {1, number} toward {2}
# Past the top: {0} earned toward the next reward, {1} what each reward takes.
detail.standing.reward = {0, number} / {1, number} toward the next reward
detail.standing.top = Top rank reached

# How to earn it, when the reputation says nothing of its own.
block.earn = How to earn
earn.kills = Defeating certain creatures earns it.
earn.default = Help them out: their quests and requests raise it.
# How to earn's last line, while worn gear moves each gain: {0} by how much, in whole percent (always its size;
# the key says which way).
earn.gear.more = Your gear raises what you earn here by {0, number}%.
earn.gear.less = Your gear lowers what you earn here by {0, number}%.

# Every rank, with the standing it takes and what it opens.
block.ranks = Ranks
block.ranks.meta = Standing needed
# Something a rank opens: {0} what it is, {1} where to find it.
unlock.at = {0} at {1}
unlock.open = Unlocked

# Past the top rank: {0} the top rank's name; the meta line {0} how much earned each payout takes.
block.beyond = Past {0}
block.beyond.meta = Every {0, number} earned
# {0} the earned standing the next payout lands at.
beyond.next = The next reward comes at {0, number} earned.
# How many rewards wait to be collected: {0} the count.
beyond.waiting = {0, number} {0, plural, one {reward is} other {rewards are}} waiting for you.
# The button that pays them.
beyond.collect = Collect
# After a press: {0} how many rewards it paid.
beyond.toast.collected = You collected {0, number} {0, plural, one {reward} other {rewards}}.
beyond.toast.no_room = Your inventory is full. Make room to collect these rewards.
beyond.toast.failed = These rewards could not be paid right now. They are still waiting for you.

# The numbers behind the standing.
block.standing = Your standing
standing.earned = Earned
standing.cap = The most you can earn

# The track category every reputation sits in, wherever tracks are listed by category.
track.category = Reputation

# The shared menu's tab.
menu.tab = Reputation

# A Records column ranking standing, for a reputation that names itself nothing.
stat.standing = Standing

# The reputation editor, the in-game wizard an admin makes or changes a reputation in (the Reputation Tool and
# /zigauthor open Reputation open it). Its title, steps, fields and hints.
author.title = Reputation Editor
author.step.which = Which reputation
author.step.name = Name and picture
author.step.earn = How it's earned
author.step.ranks = Ranks
author.step.beyond = Past the top rank
author.step.members = Who belongs
author.note.which = Pick a reputation made here to change it, or leave this blank to make a new one. A reputation that comes with a mod or pack is changed in its own files or in the Asset Editor.
author.field.edit = Reputation to change
author.field.name = Name
author.hint.name = What players see, typed in English. Its id is made from this name the first time you save, and never changes after.
author.field.description = Description
author.field.icon = Picture
author.hint.icon = The item whose picture shows beside it on the Reputation page.
author.note.earn = Defeating a creature in a group can earn standing here, or cost it with a number below zero. Quests, achievements and conversations pay it through a Reputation reward that names it.
author.field.kill.1 = First creature group
author.field.kill.2 = Second creature group
author.field.kill.3 = Third creature group
author.field.amount = Standing per kill
author.header.lines = How to earn
author.note.lines = Up to three lines for the How to earn part of the Reputation page, such as: Finish the guild's quests.
author.field.earn.1 = First line
author.field.earn.2 = Second line
author.field.earn.3 = Third line
author.note.ranks = Every reputation shares the seven ranks from Hated to Exalted. You can add up to three ranks of its own above Exalted, each starting at the standing you set. A new rank shows on the Reputation page as soon as you save.
author.field.rank.1 = First rank above Exalted
author.field.rank.2 = Second rank above Exalted
author.field.rank.3 = Third rank above Exalted
author.field.from = Starts at
author.note.beyond = Past its top rank, a reward waits on the Reputation page each time a player earns this much more standing. Leave it at 0 for no rewards.
author.field.every = Standing per reward
author.field.item.1 = First item
author.field.item.2 = Second item
author.field.count = How many
author.field.loot = Loot table
author.note.members = Characters in it treat players by their standing here. A character already in the world follows it from its next spawn. Pick a character below, or point the Reputation Tool at one.
author.field.add = Add a character
author.field.remove = Take out a character

# The editor's preview. {0} the typed name.
author.preview.name = {0}
author.preview.unnamed = A reputation with no name yet
author.preview.new = Saving makes a new reputation.
# {0} the reputation's id.
author.preview.id = Saved as {0}
# {0} the characters' roles, listed.
author.preview.members = Characters: {0}
author.preview.members.none = No characters yet, so nobody's attitude follows it.
# {0} the creature group, {1} the standing each kill moves.
author.preview.kill.gain = Defeating {0}: +{1, number}
author.preview.kill.loss = Defeating {0}: {1, number}
# {0} the rank's name, {1} the standing it starts at.
author.preview.rank = {0} from {1, number}
# {0} the standing each reward takes, {1} how many rewards each one pays.
author.preview.beyond = Past the top rank, every {0, number}: {1, number} {1, plural, one {reward} other {rewards}}
