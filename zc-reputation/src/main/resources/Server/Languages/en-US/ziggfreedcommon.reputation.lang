# What the reputation module says to players. The file name is the key PREFIX: an entry here resolves
# as ziggfreedcommon.reputation.<key>.

# The seven ranks of the server's one ladder, used wherever a reputation names no rank of its own.
rank.hated = Hated
rank.unfriendly = Unfriendly
rank.neutral = Neutral
rank.friendly = Friendly
rank.honored = Honored
rank.revered = Revered
rank.exalted = Exalted
# Shown when the server has no usable ladder (fewer than two ranks).
rank.none = Unranked

# How a requirement on a reputation reading is named when no pack names its own reputation.
factor.reputation = standing with a reputation
factor.reputation_earned = standing earned with a reputation
factor.reputation_rank = a rank with a reputation
# A lock line's name for a rank gate on a reputation that names itself: {0} the rank, {1} the reputation.
factor.rank_with = {0} with {1}

# A reputation reward as it reads in a reward list: {0} the amount, {1} the reputation's name.
reward.gain = +{0, number} {1}
reward.loss = {0, number} {1}

# The notice when a player's rank rises during play: {0} the new rank, then the reputation's name.
feedback.rank.title = You are now {0}
feedback.rank.with = with {0}

# A REPUTATION_RANK step: {1} is the rank it names. The .any twin reads when a step names no rank.
objective.reputation_rank = Reach {1}
objective.reputation_rank.any = Reach a new rank

# The Reputation page.
page.title = Reputation
page.lead = How well the people and powers of this world know you. Help them out to climb the ranks, and each rank opens something new.
page.empty.title = Nobody knows you yet
page.empty = Help someone out and they show up here.
# The list's one section.
page.section = Who knows you

# A row's second line. {0} how far, {1} the next rank.
row.next = {0, number} to {1}
# Past the top rank: {0} how much more earns the next reward.
row.reward = {0, number} to the next reward
row.top = Top rank reached
# With gear: {0} the line so far, {1} what gear adds (or takes, in the .loss line).
row.gear = {0} (+{1, number} from gear)
row.gear.loss = {0} ({1, number} from gear)

# The reading page. The pill under the name: {0} the rank held.
detail.rank = Your rank: {0}
# Over the bar: {0} how far into the rank, {1} the whole rank, {2} the next rank.
detail.standing = {0, number} / {1, number} toward {2}
# Past the top: {0} earned toward the next reward, {1} what each reward takes.
detail.standing.reward = {0, number} / {1, number} toward the next reward
detail.standing.top = Top rank reached
# At the foot of the page, for a reputation gear adds to.
hint.gear = Gear that adds to this counts toward your rank while you wear it.

# How to earn it, when the reputation says nothing of its own.
block.earn = How to earn
earn.kills = Defeating certain creatures earns it.
earn.gear = Some gear adds to it while you wear it.
earn.default = Help them out: their quests and requests raise it.

# Every rank, with the standing it takes and what it opens.
block.ranks = Ranks
block.ranks.meta = Standing needed
# Something a rank opens: {0} what it is, {1} where to find it.
unlock.at = {0} at {1}
unlock.open = Unlocked

# Past the top rank: {0} the top rank's name; the meta line {0} how much earned each payout takes.
block.beyond = Past {0}
block.beyond.meta = Every {0, number} earned
# {0} the earned standing the next payout lands at.
beyond.next = The next reward comes at {0, number} earned.

# The numbers behind the standing.
block.standing = Your standing
standing.earned = Earned
standing.gear = From gear you wear
# What gear adds: {0} the amount.
standing.gear.count = +{0, number}
standing.cap = The most you can earn
# The gear sets worn that add to this standing: the block, and one line per set, {0} the set and {1} what its
# worn tier does.
block.gear_sets = Sets you wear
gear_set.line = {0}: {1}

# The shared menu's tab.
menu.tab = Reputation
