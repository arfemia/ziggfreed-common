$C = "../Common.ui";
$F = "../Common/ZigFrames.ui";
$Z = "../Common/ZigButtons.ui";
$ZT = "../Common/ZigType.ui";

// The Reputation page (com.ziggfreed.common.reputation.page.ReputationPage): every reputation the player
// has met on the left, the one being read on the right.
//
// Inside the shared menu frame: the frame's rail comes first (ui/menu/ZigMenu, the Reputation tab
// selected), then the list and the detail. The frame owns the size, the padding and the close button.
//
// LEFT: the title and the scrolling #ReputationList the page appends Pages/ZigSelectRow.ui into, one row
// per met reputation (its picture, its name and rank, what comes next, gear, and its standing in the
// row's badge). #EmptyListLabel carries the one line a player who has met nobody sees. Its width is
// ReputationPageLayout.LIST_WIDTH, half of MenuFrame.BODY_WIDTH (a document cannot read a Java constant, so
// ReputationPageDocumentTest holds the two together); the detail column flexes into the rest.
//
// RIGHT: the reputation's picture and name, the rank held (#DetailRank), and #DetailList, which takes one
// Pages/ZigDetailLine.ui per line. Picking a row reopens the page, so every build is a full one.
//
// #DetailIconSlot holds the reputation's Icon, drawn by ui/icon/IconRenderer into #IcoItem; it ships
// hidden and shows only when there is a picture to draw.
//
// Shipped once in ziggfreed-common; neutral Zig* ids. Smoke-test in-game.

$C.@PageOverlay {}

$F.@ZigMenuFrame {
  #Content {
    Group #LeftPanel {
      Anchor: (Width: 637);
      Background: (TexturePath: "../Common/ContainerPanelPatch.png", Border: 4);
      LayoutMode: Top;
      Padding: (Full: 14);

      Label #ReputationTitle {
        Text: "";
        Anchor: (Height: 32, Bottom: 4);
        Style: (FontSize: $ZT.@ZigFontTitle, TextColor: #ffd97a, RenderBold: true, VerticalAlignment: Center);
      }

      Group { Anchor: (Height: 1, Bottom: 8); Background: #1e2a36; }

      Group #ReputationList {
        FlexWeight: 1;
        LayoutMode: TopScrolling;
        ScrollbarStyle: $C.@DefaultScrollbarStyle;
        Padding: (Right: 4);
      }

      Label #EmptyListLabel {
        Text: "";
        Visible: false;
        Anchor: (Height: 40, Top: 8);
        Style: (FontSize: $ZT.@ZigFontCaption, TextColor: #8696a8, HorizontalAlignment: Center, Wrap: true);
      }
    }

    Group #RightPanel {
      FlexWeight: 1;
      LayoutMode: Top;
      Padding: (Full: 20);

      Group #DetailHeader {
        LayoutMode: Left;
        Anchor: (Height: 30, Bottom: 4);

        Group #DetailIconSlot {
          Anchor: (Width: 28, Height: 28, Right: 8);
          Visible: false;

          ItemGrid #IcoItem {
            Anchor: (Width: 28, Height: 28);
            Visible: false;
            SlotsPerRow: 1;
            AreItemsDraggable: false;
            DisplayItemQuantity: false;
            Style: $Z.@ZigIconGrid28;
          }

          AssetImage #IcoTex {
            Anchor: (Width: 28, Height: 28);
            Visible: false;
            FallbackTexturePath: "UI/Custom/Pages/Memories/MissingIcon.png";
          }
        }

        Label #DetailTitle {
          FlexWeight: 1;
          Text: "";
          Anchor: (Height: 30);
          Style: (FontSize: $ZT.@ZigFontDisplay, TextColor: #ffd97a, RenderBold: true, VerticalAlignment: Center);
        }
      }

      Label #DetailRank {
        Text: "";
        Anchor: (Height: 20, Bottom: 8);
        Style: (FontSize: $ZT.@ZigFontBody, TextColor: #96a9be, RenderBold: true, VerticalAlignment: Center);
      }

      Group { Anchor: (Height: 1, Bottom: 12); Background: #1e2a36; }

      Group #DetailList {
        FlexWeight: 1;
        LayoutMode: TopScrolling;
        ScrollbarStyle: $C.@DefaultScrollbarStyle;
        Padding: (Right: 4);
      }
    }
  }
}
