$C = "../Common.ui";
$F = "../Common/ZigFrames.ui";
$ZX = "../Common/ZigText.ui";
$ZW = "../Common/ZigKit.ui";

// The Reputation page (com.ziggfreed.common.reputation.page.ReputationPage): every reputation the player
// has met on the left, the one being read on the right.
//
// Inside the shared menu frame: the frame's rail comes first (ui/menu/ZigMenu, the Reputation tab
// selected), then the list and the reading page. The frame owns the size, the padding and the close button.
//
// LEFT (#LeftPanel): the title, a short lead saying what a reputation is, and #ReputationList, where the kit's
// LedgerPainter appends one section of Pages/ZigLedgerRow.ui rows: a row per met reputation (its picture, its
// name, what comes next and gear on the meta line, its bar toward the next rank, and its rank in the
// standing's colour). Its width is ReputationPageLayout.LIST_WIDTH, a third of MenuFrame.BODY_WIDTH (a document
// cannot read a Java constant, so ReputationPageDocumentTest holds the two together).
//
// RIGHT (#RightPanel): the bordered card the reading page fills, after a gutter. #Page is the kit's
// @ZigDetailPage, painted by DetailPainter: the picture, the name and the rank pill, the standing on its bar,
// the description whole, then the blocks (how to earn it, the ranks with what each opens, past the top, the
// numbers). #ReputationEmpty takes its place when the player has met nobody. Picking a row reopens the page,
// so every build is a full one.
//
// Shipped once in ziggfreed-common; neutral Zig* ids. Smoke-test in-game.

$C.@PageOverlay {}

$F.@ZigMenuFrame {
  #Content {
    Group #LeftPanel {
      Anchor: (Width: 424);
      LayoutMode: Top;
      Padding: (Full: 12);

      Label #ReputationTitle {
        Anchor: (Height: 28, Bottom: 4);
        Text: "";
        Style: (...$ZX.@ZigTitleStyle, VerticalAlignment: Center, WrapMaxLines: 1);
      }

      Label #ReputationLead {
        Anchor: (Bottom: 12);
        Text: "";
        Style: (...$ZX.@ZigCaptionStyle, VerticalAlignment: Start, Wrap: true);
      }

      Group #ReputationList {
        FlexWeight: 1;
        LayoutMode: TopScrolling;
        ScrollbarStyle: $C.@DefaultScrollbarStyle;
        Padding: (Right: 8);
      }
    }

    Group #ListGutter {
      Anchor: (Width: 12);
    }

    Group #RightPanel {
      FlexWeight: 1;
      LayoutMode: Top;
      Background: (TexturePath: "../Common/ContainerPanelPatch.png", Border: 4);

      $ZW.@ZigDetailPage #Page {
        FlexWeight: 1;
      }

      $ZW.@ZigEmptyState #ReputationEmpty {
        FlexWeight: 1;
        Visible: false;
      }
    }
  }
}
