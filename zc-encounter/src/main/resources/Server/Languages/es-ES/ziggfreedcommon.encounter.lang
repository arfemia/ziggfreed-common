# El marco de encuentros: el nombre de respaldo de la barra de jefe, el nombre del ejemplo incluido y
# la familia de comandos /zigencounter (textos de ayuda, listados y respuestas).
# El nombre del archivo es el PREFIJO de clave: una entrada aquí se resuelve como ziggfreedcommon.encounter.<key>.

bar.default = Jefe
example.name = Encuentro de ejemplo

admin.desc.family = Inspeccionar y dirigir los encuentros de este servidor.
admin.desc.list = Listar cada encuentro en curso, con su ejecución y su estado.
admin.desc.inspect = Mostrar la ejecución de un encuentro: su objetivo, sus miembros y quién ha ganado qué.
admin.desc.spawn = Levantar un guion de encuentro, junto a ti, en el punto de aparición de un mundo o en unas coordenadas.
admin.desc.end = Retirar un encuentro en curso; un combate ya empezado cuenta como derrota del grupo.
admin.desc.state = Forzar el guion de un encuentro a un estado.
admin.desc.validate = Auditar cada guion de encuentro, fila de vinculación y regla de participación cargados.
admin.desc.reload = Releer los archivos del propietario sobre las vinculaciones y las reglas de participación.
admin.desc.arg.ref = Un encuentro en curso: un prefijo de su id de ejecución tal como lo muestra list, o su id de guion.
admin.desc.arg.asset = El id del guion de encuentro, su nombre de archivo bajo Server/EncounterManager.
admin.desc.arg.world = El mundo donde levantarlo. Por defecto el tuyo, o el mundo por defecto desde la consola.
admin.desc.arg.x = La coordenada X donde levantarlo; indica las tres o ninguna.
admin.desc.arg.y = La coordenada Y donde levantarlo; indica las tres o ninguna.
admin.desc.arg.z = La coordenada Z donde levantarlo; indica las tres o ninguna.
admin.desc.arg.state = El nombre de estado propio del guion.
admin.desc.arg.substate = El subestado, o el predeterminado del guion si se omite.

