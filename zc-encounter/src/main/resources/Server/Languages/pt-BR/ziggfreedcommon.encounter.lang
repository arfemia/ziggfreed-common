# O framework de encontros: o nome reserva da barra de chefe, o nome do exemplo incluído e a
# família de comandos /zigencounter (textos de ajuda, listagens e respostas).
# O nome do arquivo é o PREFIXO da chave: uma entrada aqui é resolvida como ziggfreedcommon.encounter.<key>.

bar.default = Chefe
example.name = Encontro de exemplo

admin.desc.family = Inspecionar e conduzir os encontros deste servidor.
admin.desc.list = Listar cada encontro em andamento, com sua execução e seu estado.
admin.desc.inspect = Mostrar a execução de um encontro: seu alvo, seus membros e quem ganhou o quê.
admin.desc.spawn = Erguer um script de encontro, junto a você, no ponto de surgimento de um mundo ou em coordenadas.
admin.desc.end = Remover um encontro em andamento; um combate já iniciado conta como derrota do grupo.
admin.desc.state = Forçar o script de um encontro para um estado.
admin.desc.validate = Auditar cada script de encontro, linha de vínculo e regra de participação carregados.
admin.desc.reload = Reler os arquivos do proprietário sobre os vínculos de encontro e as regras de participação.
admin.desc.arg.ref = Um encontro em andamento: um prefixo do id de execução como o list mostra, ou o id do script.
