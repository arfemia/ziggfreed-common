# Каркас столкновений: запасное имя полосы босса, имя поставляемого примера и семейство команд
# /zigencounter (справка, списки и ответы).
# Имя файла является ПРЕФИКСОМ ключа: запись здесь разрешается как ziggfreedcommon.encounter.<key>.

bar.default = Босс
example.name = Пример столкновения

admin.desc.family = Просмотр и управление столкновениями этого сервера.
admin.desc.list = Перечислить каждое идущее столкновение с его забегом и состоянием.
admin.desc.inspect = Показать забег столкновения: его цель, участников и кто что заработал.
admin.desc.spawn = Поставить скрипт столкновения: рядом с вами, в точке появления мира или по координатам.
admin.desc.end = Убрать идущее столкновение; начатый бой засчитывается как поражение группы.
admin.desc.state = Принудительно перевести скрипт столкновения в состояние.
admin.desc.validate = Проверить каждый загруженный скрипт столкновения, строку привязки и правило участия.
admin.desc.reload = Перечитать файлы владельца над привязками столкновений и правилами участия.
admin.desc.arg.ref = Идущее столкновение: начало его идентификатора забега, как показывает list, или идентификатор скрипта.
