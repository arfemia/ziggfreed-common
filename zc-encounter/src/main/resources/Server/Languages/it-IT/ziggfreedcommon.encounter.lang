# Il framework degli incontri: il nome di riserva della barra del boss, il nome dell'esempio incluso e
# la famiglia di comandi /zigencounter (testi di aiuto, elenchi e risposte).
# Il nome del file è il PREFISSO della chiave: una voce qui si risolve come ziggfreedcommon.encounter.<key>.

bar.default = Boss
example.name = Incontro di esempio

admin.desc.family = Ispezionare e guidare gli incontri di questo server.
admin.desc.list = Elencare ogni incontro in corso, con la sua esecuzione e il suo stato.
admin.desc.inspect = Mostrare l'esecuzione di un incontro: il bersaglio, i membri e chi ha guadagnato cosa.
admin.desc.spawn = Avviare uno script di incontro, accanto a te, al punto di comparsa di un mondo o a delle coordinate.
admin.desc.end = Rimuovere un incontro in corso; un combattimento già iniziato conta come sconfitta del gruppo.
admin.desc.state = Forzare lo script di un incontro in uno stato.
admin.desc.validate = Verificare ogni script di incontro, riga di collegamento e regola di partecipazione caricati.
admin.desc.reload = Rileggere i file del proprietario sui collegamenti degli incontri e sulle regole di partecipazione.
admin.desc.arg.ref = Un incontro in corso: un prefisso del suo id di esecuzione come lo mostra list, o l'id del suo script.
admin.desc.arg.asset = L'id dello script di incontro, il suo nome di file sotto Server/EncounterManager.
admin.desc.arg.world = Il mondo in cui avviarlo. Per impostazione predefinita il tuo, o il mondo predefinito dalla console.
admin.desc.arg.x = La coordinata X in cui avviarlo; indica tutte e tre o nessuna.
admin.desc.arg.y = La coordinata Y in cui avviarlo; indica tutte e tre o nessuna.
admin.desc.arg.z = La coordinata Z in cui avviarlo; indica tutte e tre o nessuna.
admin.desc.arg.state = Il nome di stato proprio dello script.
admin.desc.arg.substate = Il sottostato, o quello predefinito dello script se omesso.

