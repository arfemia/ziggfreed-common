# Das Begegnungs-Framework: der Ersatzname der Bossleiste, der Name des mitgelieferten Beispiels und
# die Befehlsfamilie /zigencounter (Hilfetexte, Listen und Antworten).
# Der Dateiname ist das Schlüssel-PRÄFIX: ein Eintrag hier heißt ziggfreedcommon.encounter.<key>.

bar.default = Boss
example.name = Beispielbegegnung

admin.desc.family = Die Begegnungen dieses Servers ansehen und steuern.
admin.desc.list = Jede laufende Begegnung mit ihrem Durchlauf und Zustand auflisten.
admin.desc.inspect = Den Durchlauf einer Begegnung zeigen: Ziel, Mitglieder und wer sich was verdient hat.
admin.desc.spawn = Ein Begegnungsskript aufstellen: bei dir, am Spawnpunkt einer Welt oder an Koordinaten.
admin.desc.end = Eine laufende Begegnung entfernen; ein begonnener Kampf zählt als Wipe.
admin.desc.state = Das Skript einer Begegnung in einen Zustand zwingen.
admin.desc.validate = Jedes geladene Begegnungsskript, jede Bindungszeile und jede Beteiligungsregel prüfen.
admin.desc.reload = Die Besitzerdateien über den Begegnungsbindungen und Beteiligungsregeln neu einlesen.
admin.desc.arg.ref = Eine laufende Begegnung: der Anfang ihrer Durchlauf-ID, wie list sie zeigt, oder ihre Skript-ID.
admin.desc.arg.asset = Die Skript-ID der Begegnung, ihr Dateiname unter Server/EncounterManager.
admin.desc.arg.world = Die Welt zum Aufstellen. Standard: deine, oder von der Konsole aus die Standardwelt.
admin.desc.arg.x = Die X-Koordinate zum Aufstellen; alle drei oder keine angeben.
admin.desc.arg.y = Die Y-Koordinate zum Aufstellen; alle drei oder keine angeben.
admin.desc.arg.z = Die Z-Koordinate zum Aufstellen; alle drei oder keine angeben.
admin.desc.arg.state = Der eigene Zustandsname des Skripts.
admin.desc.arg.substate = Der Unterzustand, oder der Standard des Skripts, wenn weggelassen.

admin.more = ... und {0} weitere, im Serverprotokoll.

