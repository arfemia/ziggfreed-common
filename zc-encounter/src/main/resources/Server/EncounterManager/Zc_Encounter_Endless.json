    },
    "BossWave": {
      "Value": "Zc_Boss_Wave_Rise",
      "Description": "The macro that raises a boss wave: Zc_Boss_Wave_Rise, the boss from a manual spawn marker in the prefab, unless written. The dungeon's Run.Endless.BossEvery says which waves are boss waves."
    },
    "Groups": {
      "Value": [ "Skeleton" ],
      "TypeHint": "String",
      "Description": "NPC groups holding everything the bands and the boss wave raise: while one of them lives within Range the wave stands, and when the run ends every one within Range is removed."
    },
    "Range": {
      "Value": 40,
      "Description": "How far from the script's entity a living creature of Groups keeps its wave standing. Cover the whole arena."
    },
    "PlayerRange": {
      "Value": 40,
      "Description": "How close to the script's entity a player must come to start the run, and to count as one of its members."
    },
    "Delay": {
      "Value": [ 3, 3 ],
      "Description": "Seconds from the first player in PlayerRange to the first wave."
    },
    "Breather": {
      "Value": [ 10, 10 ],
      "Description": "Seconds between a wave's last creature falling and the next wave: the time a party has to leave with its chest."
    },
    "WatchSeconds": {
      "Value": [ 3, 3 ],
      "Description": "Seconds a wave waits to see one of its creatures before the same wave rises again."
    }
  },
